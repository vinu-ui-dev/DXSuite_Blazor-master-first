{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DXSuite.Host (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dxsuite-host",
            "program": "${workspaceFolder}/src/DXSuite.Host/bin/Debug/net10.0/DXSuite.Host.dll",
            "cwd": "${workspaceFolder}/src/DXSuite.Host",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7112;http://localhost:5298"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
