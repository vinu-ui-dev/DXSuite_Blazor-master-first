{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DXSuite.Host (https)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/DXSuite.Host/bin/Debug/net10.0/DXSuite.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/DXSuite.Host",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://0.0.0.0:7112;http://0.0.0.0:5298"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "DXSuite.Host (Local)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/DXSuite.Host/bin/Debug/net10.0/DXSuite.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/DXSuite.Host",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Local",
                "ASPNETCORE_URLS": "http://localhost:5298"
            }
        }
    ]
}
