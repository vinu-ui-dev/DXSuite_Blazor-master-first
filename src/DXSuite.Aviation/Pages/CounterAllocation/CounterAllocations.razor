@page "/Flight-Data-Editor/Counter-Allocation"
@attribute [RequiresTenantFeature(AviationFeatureFlags.FlightDataEditorFeature)]
@rendermode InteractiveServer
@using DXSuite.Aviation.Entities
@using DXSuite.Aviation.Pages.FlightDataEditor
@using DXSuite.Aviation.Services.FlightDataEditor
@using DXSuite.Shared.Authorization
@using DXSuite.Shared.Multitenancy
@using Microsoft.AspNetCore.Components.Web

@* FSD 1.1 FDE / 1.2 ALC "Done means": the editor opens only for a user with its permission, direct
   URL too — this page is independently routable (it's also embedded as a tab of
   FlightDataEditor.razor, which has the same gate), so it must check on its own. This is the page
   access gate; canEdit (PermissionKeys.CounterAllocationEdit) below is the separate, narrower
   mutate-vs-view-only gate within the page. *@
@if (!accessResolved)
{
    <div class="dx-loading-overlay"><div class="dx-spinner"></div></div>
}
else if (!pageAuthorized)
{
    <div class="dx-alert dx-alert-warning">You do not have permission to access Counter Allocation.</div>
}
else
{
<div class="ca-toolbar">
    <div class="ca-toolbar-left">
        <span class="ca-rms-label">RMS Feed</span>
        <RmsFeedIndicator />
        <label class="ca-switch">
            <input type="checkbox" checked="@outageState.IsOn" disabled="@(!canEdit)" @onchange="ToggleManualMode" />
            <span class="ca-switch-track"><span class="ca-switch-thumb"></span></span>
        </label>
        <span>
            Allocation Outage mode
            @if (outageState.IsOn)
            {
                <text>on since @ToLocal(outageState.SwitchedOnUtc!.Value).ToString("HH:mm")</text>
            }
            else
            {
                <text>off</text>
            }
        </span>
        @if (!canEdit)
        {
            <span class="dx-badge dx-badge-gray">View only</span>
        }
    </div>
    <button class="dx-btn dx-btn-outline-blue dx-btn-sm" disabled title="No live RMS counter feed exists yet to update from.">Update modified counters back to feed</button>
</div>

<div class="ca-filters">
    <label class="ca-filter-label">From <input type="datetime-local" class="dx-form-control" @bind="fromLocal" @bind:after="RefreshAsync" /></label>
    <label class="ca-filter-label">To <input type="datetime-local" class="dx-form-control" @bind="toLocal" @bind:after="RefreshAsync" /></label>
    <label class="ca-filter-label">Zone
        <select class="dx-form-select" @bind="selectedZone">
            <option value="">All zones</option>
            @foreach (var z in zones)
            {
                <option value="@z">@z</option>
            }
        </select>
    </label>
    <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="SetNowWindow">NOW -1 H TO +12 H</button>
    <button class="dx-btn dx-btn-sm" @onclick="SetTomorrowWindow">TOMORROW</button>
    <button class="dx-btn @(showDummyData ? "dx-btn-blue" : "dx-btn-outline-blue") dx-btn-sm" @onclick="ToggleDummyDataAsync">
        @(showDummyData ? "Viewing Sample Data" : "View Sample Data")
    </button>
</div>

@if (outageState.IsOn)
{
    <div class="dx-alert dx-alert-info">
        Manual mode is on. There is no live RMS/CoreAPI allocation feed yet, so every allocation below was entered by hand.
    </div>
}

@if (showDummyData)
{
    <div class="dx-alert dx-alert-info">
        Viewing sample data for layout review. These allocations are generated in memory, aren't saved anywhere, and can't be added, edited, copied or deleted — turn off Sample Data to manage real allocations.
    </div>
}

@if (error is not null)
{
    <div class="dx-alert dx-alert-danger">@error</div>
}

<div class="ca-actions">
    @if (canEdit)
    {
        <span class="dx-text-muted">Click an empty spot on a counter's row to add an allocation there. Click one to change it. Ctrl+click to select several for copy or delete.</span>
    }
    else
    {
        <span class="dx-text-muted">You have view-only access to Counter Allocation — you can look, but not add, change, copy or delete allocations.</span>
    }
    <div class="ca-actions-right">
        <button class="dx-btn dx-btn-green dx-btn-sm" disabled="@(showDummyData || !canEdit)" @onclick="() => OpenAdd(null)">Add Allocation</button>
        <button class="dx-btn dx-btn-sm" disabled="@(showDummyData || !canEdit || selected.Count == 0)" @onclick="OpenCopy">Copy@(selected.Count > 0 ? $" ({selected.Count})" : "")</button>
        <button class="dx-btn dx-btn-outline-red dx-btn-sm" disabled="@(showDummyData || !canEdit || selected.Count == 0)" @onclick="DeleteSelectedAsync">Delete@(selected.Count > 0 ? $" ({selected.Count})" : "")</button>
    </div>
</div>

<div class="ca-grid-scroll">
    <div class="ca-grid" style="min-width:@(GridWidthPx.ToString("0"))px;">
        <div class="ca-grid-header">
            <div class="ca-row-label-spacer"></div>
            <div class="ca-timeline-header">
                @foreach (var tick in HourTicks())
                {
                    <div class="ca-tick @(tick.Hour == 0 ? "ca-tick-midnight" : "")" style="left:@(Pct(tick).ToString("0.###"))%;">@TickLabel(tick)</div>
                }
                @if (NowInWindow)
                {
                    <div class="ca-now-flag" style="left:@(Pct(NowLocal).ToString("0.###"))%;">@NowLocal.ToString("HH:mm")</div>
                }
            </div>
        </div>

        @foreach (var group in Groups)
        {
            <div class="ca-zone-header">@group.Key</div>
            @foreach (var counter in group.Counters)
            {
                <div class="ca-row">
                    <div class="ca-row-label">@counter.Id</div>
                    <div class="ca-timeline" @onclick="() => OnRowClick(counter.Id)">
                        @foreach (var a in counter.Allocations)
                        {
                            var left = Pct(a.StartLocal);
                            var width = Math.Max(0.6, Pct(a.EndLocal) - left);
                            <div class="ca-block ca-type-@a.Row.AllocationType.ToLowerInvariant() @(a.Row.IsManual ? "ca-manual" : "") @(selected.Contains(a.Row.CounterAllocationId) ? "ca-selected" : "")"
                                 style="left:@(left.ToString("0.###"))%; width:@(width.ToString("0.###"))%; background:@ColorFor(a.Row.AirlineCode);"
                                 @onclick="(MouseEventArgs e) => OnBlockClick(a.Row, e)" @onclick:stopPropagation="true">
                                <div class="ca-block-airline">@AirlineName(a.Row.AirlineCode) &middot; @a.Row.AllocationType@(a.Row.IsManual ? " · by hand" : "")</div>
                                <div class="ca-block-time">@a.StartLocal.ToString("HH:mm") to @a.EndLocal.ToString("HH:mm")</div>
                            </div>
                        }
                        @if (NowInWindow)
                        {
                            <div class="ca-now-line" style="left:@(Pct(NowLocal).ToString("0.###"))%;"></div>
                        }
                    </div>
                </div>
            }
        }

        @if (Groups.Count == 0)
        {
            <div class="ca-empty">No allocations in this window.</div>
        }
    </div>
</div>

<div class="ca-legend">
    <span><i class="ca-swatch ca-swatch-rms"></i> RMS allocation</span>
    <span><i class="ca-swatch ca-swatch-manual"></i> Changed by hand</span>
    <span><i class="ca-swatch ca-swatch-dedicated"></i> Dedicated</span>
    <span><i class="ca-swatch ca-swatch-info"></i> Info</span>
    <span><i class="ca-now-dot"></i> Now</span>
</div>

@if (modal is not null)
{
    <div class="dx-modal-overlay">
        <div class="dx-modal" style="width:480px;">
            <div class="dx-modal-header">
                <h3 style="margin:0;font-size:1.1rem;">@(modal.Id is null ? "New Allocation" : "Edit Allocation")</h3>
                <button class="dx-modal-close" aria-label="Close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="dx-modal-body">
                <div class="dx-form-group">
                    <label class="dx-form-label">Airline</label>
                    <select class="dx-form-select" @bind="modal.AirlineCode">
                        <option value="">Choose an airline</option>
                        @foreach (var kv in airlineNames.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).OrderBy(kv => kv.Value))
                        {
                            <option value="@kv.Key">@kv.Value (@kv.Key)</option>
                        }
                    </select>
                </div>

                @if (modal.Id is null)
                {
                    <div class="dx-form-group">
                        <label class="dx-form-label">From counter</label>
                        <select class="dx-form-select" @bind="modal.Counter">
                            @foreach (var c in allCounterIds)
                            {
                                <option value="@c">@c (@ZoneName(c))</option>
                            }
                        </select>
                    </div>
                    <div class="dx-form-group">
                        <label class="dx-form-label">To counter</label>
                        <select class="dx-form-select" @bind="modal.ToCounter">
                            @foreach (var c in allCounterIds)
                            {
                                <option value="@c">@c (@ZoneName(c))</option>
                            }
                        </select>
                    </div>
                    <p class="dx-text-muted">One allocation on each counter in the range (@CounterRange(modal.Counter, modal.ToCounter).Count).</p>
                }
                else
                {
                    <div class="dx-form-group">
                        <label class="dx-form-label">Counter</label>
                        <div>@modal.Counter @ZoneName(modal.Counter)</div>
                    </div>
                }

                <div class="dx-form-group">
                    <label class="dx-form-label">Start</label>
                    <input type="datetime-local" class="dx-form-control" @bind="modal.Start" />
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">End</label>
                    <input type="datetime-local" class="dx-form-control" @bind="modal.End" />
                </div>

                <div class="dx-form-group">
                    <label class="dx-form-label">Counter type</label>
                    <div class="ca-radio-row">
                        <label><input type="radio" name="ca-type" checked="@(modal.AllocationType == "Common")" @onchange="@(() => modal.AllocationType = "Common")" /> Common</label>
                        <label><input type="radio" name="ca-type" checked="@(modal.AllocationType == "Dedicated")" @onchange="@(() => modal.AllocationType = "Dedicated")" /> Dedicated</label>
                        <label><input type="radio" name="ca-type" checked="@(modal.AllocationType == "Info")" @onchange="@(() => modal.AllocationType = "Info")" /> Info</label>
                    </div>
                </div>

                @if (modal.AllocationType == "Dedicated")
                {
                    <div class="dx-form-group">
                        <label class="dx-form-label">Destination</label>
                        <input class="dx-form-control" @bind="modal.Destination" />
                    </div>
                    <div class="dx-form-group">
                        <label class="dx-form-label">Flight #</label>
                        <input class="dx-form-control" @bind="modal.FlightNumber" />
                    </div>
                }

                @if (modalError is not null)
                {
                    <p class="dx-text-danger">@modalError</p>
                }
            </div>
            <div class="dx-modal-footer">
                @if (modal.Id is not null)
                {
                    <button class="dx-btn dx-btn-outline-red" @onclick="DeleteFromModalAsync">Delete (@selected.Count)</button>
                }
                <span class="grow"></span>
                <button class="dx-btn" @onclick="CloseModal">Cancel</button>
                <button class="dx-btn dx-btn-blue" @onclick="SaveModalAsync">Save</button>
            </div>
        </div>
    </div>
}

@* View-only equivalent of the Edit Allocation modal above, for a user without canEdit (Airport
   staff per GTAA FSD 1.2 ALC: "others read it") — same facts, no Save/Delete/Cancel-as-edit. *@
@if (viewRow is not null)
{
    <div class="dx-modal-overlay">
        <div class="dx-modal" style="width:420px;">
            <div class="dx-modal-header">
                <h3 style="margin:0;font-size:1.1rem;">Allocation</h3>
                <button class="dx-modal-close" aria-label="Close" @onclick="CloseView">&times;</button>
            </div>
            <div class="dx-modal-body">
                <div class="dx-form-group">
                    <label class="dx-form-label">Counter</label>
                    <div>@viewRow.Row.Counter @ZoneName(viewRow.Row.Counter)</div>
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">Airline</label>
                    <div>@AirlineName(viewRow.Row.AirlineCode) (@viewRow.Row.AirlineCode)</div>
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">From</label>
                    <div>@viewRow.StartLocal.ToString("HH:mm")</div>
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">To</label>
                    <div>@viewRow.EndLocal.ToString("HH:mm")</div>
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">Counter type</label>
                    <div>@viewRow.Row.AllocationType@(viewRow.Row.AllocationType == "Dedicated" && viewRow.Row.Destination is { } dest ? $" — {dest}" : "")</div>
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">Source</label>
                    <div>@(viewRow.Row.IsManual ? "Entered by hand" : "RMS")</div>
                </div>
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn dx-btn-blue" @onclick="CloseView">Close</button>
            </div>
        </div>
    </div>
}

@if (copyTargetDate is not null)
{
    <div class="dx-modal-overlay">
        <div class="dx-modal" style="width:360px;">
            <div class="dx-modal-header">
                <h3 style="margin:0;font-size:1.1rem;">Copy @selected.Count allocation@(selected.Count > 1 ? "s" : "") to</h3>
                <button class="dx-modal-close" aria-label="Close" @onclick="CloseCopy">&times;</button>
            </div>
            <div class="dx-modal-body">
                <div class="dx-form-group">
                    <label class="dx-form-label">Date</label>
                    <input type="date" class="dx-form-control" @bind="copyTargetDate" />
                </div>
                <p class="dx-text-muted">Keeps each allocation's counter, airline, type and time of day; only the date moves.</p>
                @if (copyError is not null)
                {
                    <p class="dx-text-danger">@copyError</p>
                }
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn" @onclick="CloseCopy">Cancel</button>
                <button class="dx-btn dx-btn-blue" @onclick="SaveCopyAsync">Copy</button>
            </div>
        </div>
    </div>
}

@if (showOutageConfirm)
{
    <div class="dx-modal-overlay">
        <div class="dx-modal" style="width:420px;">
            <div class="dx-modal-header">
                <h3 style="margin:0;font-size:1.1rem;">Turn off allocation outage mode</h3>
                <button class="dx-modal-close" aria-label="Close" @onclick="CancelOutageOff">&times;</button>
            </div>
            <div class="dx-modal-body">
                <p>
                    Allocations already entered by hand stay exactly as they are &mdash; turning this off doesn't remove or
                    change anything. This build has no live RMS/CoreAPI feed yet, so there's nothing to automatically
                    return counters to; the "Update modified counters back to feed" button above stays disabled until
                    that feed exists.
                </p>
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn" @onclick="CancelOutageOff">Cancel</button>
                <button class="dx-btn dx-btn-blue" @onclick="ConfirmOutageOff">Turn off</button>
            </div>
        </div>
    </div>
}
}
