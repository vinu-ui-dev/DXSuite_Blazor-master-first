    // The time columns order the list by best-known time, the same time the window keeps each flight by (FDE-10).
    private async Task DepartureSortByDepartTime() {
        if (DepartureDepartTimeSortByDesc) {
            fEDepartureFlights = fEDepartureFlights.OrderBy(x => listWindow!.BestKnownTime(x!)).ToList();
            ClearSort();
        } else {
            fEDepartureFlights = fEDepartureFlights.OrderByDescending(x => listWindow!.BestKnownTime(x!)).ToList();
