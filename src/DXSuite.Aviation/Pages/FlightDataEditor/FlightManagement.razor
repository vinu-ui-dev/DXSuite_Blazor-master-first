    /// <summary>Whether either list holds an Outage Edit, which the review button offers to settle (FDE-08).</summary>
    public bool HoldsOutageEdit =>
        fEDepartureFlights.Any(FlightListCue.IsOutageEdit) || fEArrivalFlights.Any(FlightListCue.IsOutageEdit);

    /// <summary>
    /// Re-reads both lists in the page's window, for changes the hub never reports, such as the flights Use Feed
    /// removes.
    /// </summary>
    public async Task ReloadFlightListsAsync() {
        await GetDepartureFlights(listWindow!);
        if (CoreApiUnreachable) return;
        await GetArrivalFlights(listWindow!);
        if (displayDeparture) {
            await DisplayDepartures();
        } else {
            await DisplayArrivals();
        }
    }

