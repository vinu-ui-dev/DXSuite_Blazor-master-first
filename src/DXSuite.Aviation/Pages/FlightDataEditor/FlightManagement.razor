    #region Dispose
    // The source is cancelled but not disposed: the clock loop may still be reading its token.
    public async ValueTask DisposeAsync() {
        stopping.Cancel();
        if (liveUpdates is not null) {
            await liveUpdates.DisposeAsync();
        }
    }
