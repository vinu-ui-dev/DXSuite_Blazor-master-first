    /// <summary>
    /// Updates Airline name based on the provided airline code (FLC) by searching the local list of airlines.
    /// </summary>
    /// <param name="FLC"> Airline Code E.G. YYZ</param>
    /// <returns></returns>
    private string UpdateAirline(string FLC) {
        TblAirline? tblAirline = airlines.FirstOrDefault(x => x.AirlineCode == FLC);
        if (tblAirline != null) {
            string? airline = tblAirline.CarrierName;

            if (airline != null) return airline;
        }

        return "No Airline Found";
    }
    /// <summary>
    /// Sets CoreAPI's flight Outage mode switch, offered only where the instance allows it (FDE-03). A refused or
    /// unanswered call leaves the mode as it was and says so.
    /// </summary>
    private async Task SetOutageSwitchAsync(bool on) {
        if (!FeedMode.SwitchAllowed || CoreApiUnreachable) return;
        var result = await coreApi.SetOverrideToggleAsync(on);
        ObserveCoreApi(result);
        await audit.OutageSwitchedAsync(on, result);
        if (result.Succeeded) {
            outageSwitchOn = on;
            outageSwitchError = null;
        } else {
            outageSwitchError = FlightSaveError.Describe(result, $"Could not switch flight Outage mode {(on ? "on" : "off")}");
        }
        await InvokeAsync(StateHasChanged);
    }
