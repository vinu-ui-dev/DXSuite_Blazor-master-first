    //API Calls and Helpers for fetching flight data, feed status, airlines, locations, gates, carousels, statuses, and user settings
    #region API Calls and Helpers
    // A failed load keeps what the page already shows, so each failure is reported here rather than leaving
    // a list silently empty or stale. Keyed by what was loaded, so a later successful load clears its entry.
    // Concurrent because hub handlers reload off the render thread while rendering lists the failures.
    private readonly System.Collections.Concurrent.ConcurrentDictionary<string, string> coreApiLoadFailures = new();

    /// <summary>
    /// The value of a successful CoreAPI call; null on failure, with the failure shown on the page until the same
    /// load next succeeds.
    /// </summary>
    private T? Loaded<T>(CoreApiResult<T> result, string what) where T : class {
        ObserveCoreApi(result);
        if (result.Outcome == CoreApiOutcome.Unreachable) {
            // The unreachable banner stands for every load that found no server.
            return null;
        }
        if (result.Succeeded) {
            coreApiLoadFailures.TryRemove(what, out _);
            return result.Value;
        }
        coreApiLoadFailures[what] = FlightSaveError.Describe(result, $"Could not load {what}");
        return null;
    }
    /// <summary>
    /// Loads the departures in the window. CoreAPI chooses what it serves for the window, so each flight is kept
    /// only if its best-known time is in it.
    /// </summary>
    private async Task GetDepartureFlights(FlightListWindow window) {
        List<FEDepartureFlight?>? temp = Loaded(await coreApi.GetDeparturesAsync(window.Start, window.End), "departures");
        if (temp != null) {
            fEDepartureFlights = temp.Where(f => f != null && window.Contains(f!)).ToList();
        }
        await InvokeAsync(StateHasChanged);
    }
    /// <summary>
    /// Loads the arrivals in the window, keeping each flight only if its best-known time is in it.
    /// </summary>
    private async Task GetArrivalFlights(FlightListWindow window) {
        List<FEArrivalFlight?>? temp = Loaded(await coreApi.GetArrivalsAsync(window.Start, window.End), "arrivals");
        if (temp != null) {
            fEArrivalFlights = temp.Where(f => f != null && window.Contains(f!)).ToList();
        }
        await InvokeAsync(StateHasChanged);
    }
