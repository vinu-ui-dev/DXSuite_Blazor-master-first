@using DXSuite.Connectors.Services.CoreApi
@using DXSuite.Connectors.Services.CoreApi.Models
@using System.Linq;
@using System.Text.RegularExpressions
@inject CoreApiClient coreApi
@inject FlightEditAudit audit
@inject IConfiguration config;
@rendermode InteractiveServer

@if (showDialog) {
    <div class="dx-modal-overlay">
        @*Pop up Div*@
        <div class="dx-modal" style="width:40vw">
            @* Row Layout Div *@
            <div class="dx-modal-header">
                @* row div Flight# and Close button *@
                <span>Add Flight (Scheduling Window: @(((DateTime)homePage!.feedWindow.WindowStart!).ToString("HH:mm MMM dd")) to @(((DateTime)homePage!.feedWindow.WindowEnd!).AddSeconds(-1).ToString("HH:mm MMM dd")))</span>
                <button class="dx-modal-close" type="button" @onclick="() => showDialog = false">&times;</button>
            </div>
            <div class="dx-modal-body" style="padding-top:0; margin-top:20px">
                <CoreApiUnreachableBanner Shown="ReadOnly" />
                @if (saveError is { } error) {
                    <div class="dx-alert dx-alert-danger fde-save-error">@error</div>
                }
                @* A disabled fieldset keeps what the user typed while CoreAPI is unreachable, ready for when it returns. *@
                <fieldset class="fde-add-fields" disabled="@ReadOnly" style="border:0; padding:0; margin:0; min-width:0">
                @* row div Text Input field for Flight Code, Number, and STD*@
                <div class="dx-form-row">
                    <div class="dx-form-group">
                        <div class="dx-form-row" style="padding:10px">
                            <div class="dx-form-group" style="gap:0px; margin-bottom:0px;">
                                <div class="dx-form-label">Flight</div>
                                <div style="position:relative;">
                                    <input type="text" id="flightCodeInput" style="text-transform:uppercase; width:100%" class="dx-form-control @(flcErr ? "invalid" : "")" value="@(departureFlight.FLC)" placeholder="e.g. DL" onblur="@(() => { FilteredFlightAirlineSuggestions.Clear(); flcErr = false; flcErrMsg = ""; flnErr = false; flnErrMsg = ""; })" oninput="@((ChangeEventArgs e) => FilterFlightAirlineSuggestions(e))" />
                                    @if (FilteredFlightAirlineSuggestions.Any()) {
                                        <ul class="list-group" style="position:absolute; z-index: 1005; top:100%">
                                            @foreach (var suggestion in FilteredFlightAirlineSuggestions) {
                                                <li class="list-group-item list-group-item-action" style="cursor:pointer;" @onmousedown="@(() => SelectFlightAirlineSuggestion(suggestion))">
                                                    @suggestion
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                                @if (!FilteredFlightAirlineSuggestions.Any() && flcErr) {
                                    <span class="dx-form-validation">@flcErrMsg</span>
                                }
                            </div>
                            <div class="dx-form-group" style="gap:0px; margin-bottom:0px">
                                <div class="dx-form-label">Flight #</div>
                                <input type="text" id="flightNumberInput" @bind="departureFlight.FLN" placeholder="e.g. 123" style="text-transform:uppercase; width:100%" class="dx-form-control @(flnErr ? "invalid" : "")" onblur="@(() => { flcErr = false; flcErrMsg = ""; flnErr = false; flnErrMsg = ""; })" />
                                @if (flnErr) {
                                    <span class="dx-form-validation">@flnErrMsg</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="dx-form-group">
                        <div class="item">
                            <div class="dx-form-label">Scheduled Time (STD)</div>
                            <input type="datetime-local" min="@(((DateTime)homePage!.feedWindow.WindowStart!).ToString("yyyy-MM-ddTHH:mm"))" max="@(((DateTime)homePage!.feedWindow.WindowEnd!).AddSeconds(-1).ToString("yyyy-MM-ddTHH:mm"))" id="scheduledInput" class="dx-form-control @(stdErr ? "invalid" : "")" style="width:100%" @bind="departureFlight.ScheduledTime" onblur="@(() => { stdErr = false; stdErrMsg = ""; })" />
                            @if (stdErr) {
                                <span class="dx-form-validation">@stdErrMsg</span>
                            }
                        </div>
                    </div>
                </div>
                @* row div Estimated Departing/ArrivalTime (ETD/A) and Status with text inputs below*@
                <div class="dx-form-row">
                    <div class="dx-form-group">
                        <div class="item">
                            <div class="dx-form-label">Departing Time (ETD)</div>
                            <input type="datetime-local" min="@(((DateTime)homePage!.feedWindow.WindowStart!).ToString("yyyy-MM-ddTHH:mm"))" max="@(((DateTime)homePage!.feedWindow.WindowEnd!).AddSeconds(-1).ToString("yyyy-MM-ddTHH:mm"))" id="estimatedInput" class="dx-form-control @(etdErr ? "invalid" : "")" style="width:100%" @bind="departureFlight.EstimatedTime" onblur="@(() => { etdErr = false; etdErrMsg = ""; })" />
                            @if (etdErr) {
                                <span class="dx-form-validation">@etdErrMsg</span>
                            }
                        </div>
                    </div>
                    <div class="dx-form-group">
                        <div class="item">
                            <div class="dx-form-label">Status</div>
                            <select id="statusInput" class="dx-form-control @(statusErr ? "invalid" : "")" style="width:100%" @bind="departureFlight.RCP" onblur="@(() => { statusErr = false; statusErrMsg = ""; })">
                                <option selected value="">Select Status </option>
                                @foreach (TblFlightStatus status in statuses) {
                                    <option value="@status.StatusId">@status.StatusName</option>
                                }
                            </select>
                            @if (statusErr) {
                                <span class="dx-form-validation">@statusErrMsg</span>
                            }
                        </div>
                    </div>
                </div>
                @* row div Actual Time (ATD/ATA) and Gate with Text Inputs below*@
                <div class="dx-form-row">
                    <div class="dx-form-group">
                        <div class="item">
                            <div class="dx-form-label">Actual Time (ATD)</div>
                            <input type="datetime-local" min="@(((DateTime)homePage!.feedWindow.WindowStart!).ToString("yyyy-MM-ddTHH:mm"))" max="@(((DateTime)homePage!.feedWindow.WindowEnd!).AddSeconds(-1).ToString("yyyy-MM-ddTHH:mm"))" id="actualInput" class="dx-form-control @(atdErr ? "invalid" : "")" style="width:100%" @bind="departureFlight.ActualTime" onblur="@(() => { atdErr = false; atdErrMsg = ""; })" />
                            @if (atdErr) {
                                <span class="dx-form-validation">@atdErrMsg</span>
                            }
                        </div>
                    </div>
                    <div class="dx-form-group">
                        <div class="item">
                            <div class="dx-form-label">Gate</div>
                            <input type="text" id="gateInput" style="text-transform:uppercase; width:100%" class="dx-form-control @(gatErr ? "invalid" : "")" value="@(departureFlight.GAT)" placeholder="e.g. A1" onblur="@(() => { FilteredGateSuggestions.Clear(); gatErr = false; gatErrMsg = ""; })" oninput="@((ChangeEventArgs e) => FilterGATSuggestions(e))" />
                            @if (!FilteredGateSuggestions.Any() && gatErr) {
                                <span class="dx-form-validation">@gatErrMsg</span>
                            }
                            @if (FilteredGateSuggestions.Any()) {
                                <ul class="list-group" style="position:absolute; z-index: 1005;">
                                    @foreach (var suggestion in FilteredGateSuggestions) {
                                        <li class="list-group-item list-group-item-action" style="cursor:pointer;" @onmousedown="@(() => SelectGateSuggestion(suggestion))">
                                            @suggestion
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
                @* row div Destination / Origin and Text Input below*@
                <div class="dx-form-row">
                    <div class="dx-form-group">
                        <div class="item">
                            <div class="dx-form-label">Destination</div>
                            <input type="text" id="destinationInput" style="text-transform:uppercase" class="dx-form-control @(destErr ? "invalid" : "")" value="@(departureFlight.DES)" placeholder="e.g. YYZ" onblur="@(() => { FilteredDestSuggestions.Clear(); destErr = false; destErrMsg = ""; })" oninput="@((ChangeEventArgs e) => FilterDESSuggestions(e))" />
                            @if (!FilteredDestSuggestions.Any() && destErr) {
                                <span class="dx-form-validation">@destErrMsg</span>
                            }
                            @if (FilteredDestSuggestions.Any()) {
                                <ul class="list-group" style="position:absolute; z-index: 1005;">
                                    @foreach (var suggestion in FilteredDestSuggestions) {
                                        <li class="list-group-item list-group-item-action" style="cursor:pointer;" @onmousedown="@(() => SelectDestSuggestion(suggestion))">
                                            @suggestion
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                    <div class="dx-form-group" style="justify-content:center;">
                        <div class="item">
                            @if (departureFlight.DES != null) {
                                @UpdateLocation(departureFlight.DES)
                            }
                        </div>
                    </div>
                </div>
                @* row div Roll On / Off*@
                <div style="margin: 10px 10px 0px 10px">
                    Roll On / Off
                </div>
                @* row div Public checkbox, baggage checkbox, staff checkbox, throw checkbox*@
                <div class="dx-form-row">
                    <div class="item">
                        Public
                        <InputCheckbox class="dx-checkbox" @bind-Value="publicCheckbox" />
                    </div>
                    <div class="item">
                        Baggage
                        <InputCheckbox class="dx-checkbox" @bind-Value="baggageCheckbox" />
                    </div>
                    <div class="item">
                        Staff
                        <InputCheckbox class="dx-checkbox" @bind-Value="staffCheckbox" />
                    </div>
                    <div class="item">
                        Throw
                        <InputCheckbox class="dx-checkbox" @bind-Value="throwCheckbox" />
                    </div>
                </div>
                @* row div Code Share and Flight # label*@
                <div class="item">
                    <div class="dx-table">
                        <div class="dx-table-header" style="grid-template-columns: 1fr 1fr .2fr;">
                            <div>Code Share</div>
                            <div>Flight#</div>
                            <div />
                        </div>
                        <div class="dx-scrollable" style="min-block-size:200px;overflow-y:auto;">
                            <div class="dx-table-row" style="grid-template-columns: 1fr 1fr .2fr;">
                                <div class="dx-form-group" style="position: relative; padding-bottom:0px">
                                    <input type="text" id="codeShareCodeInput" style="text-transform:uppercase; position:relative" class="dx-form-control @(codeShareErr ? "invalid" : "")" @bind="codeShareSearch.FLC" placeholder="e.g. DL" onblur="@(() => ValidateCodeShareGroup())" oninput="@((ChangeEventArgs e) => FilterCodeShareFlightAirlineSuggestions(e))" />
                                    @if (!FilteredCodeShareAirlineSuggestions.Any() && codeShareErr) {
                                        @if (codeShareFlightErrMsg == "" || codeShareFlightErrMsg.IsWhiteSpace()) {
                                            <span class="dx-form-validation" style="color:transparent">.</span>
                                        } else {
                                            <span class="dx-form-validation">@codeShareFlightErrMsg</span>
                                        }
                                    }
                                    @if (FilteredCodeShareAirlineSuggestions.Any()) {
                                        <ul class="list-group" style="position:absolute; z-index: 1005; top:100%">
                                            @foreach (var suggestion in FilteredCodeShareAirlineSuggestions) {
                                                <li class="list-group-item list-group-item-action" style="cursor:pointer;" @onmousedown="@(() => selectingCodeShareFlightSuggestion = true)" @onclick="@(() => SelectCodeShareAirlineSuggestion(suggestion))">
                                                    @suggestion
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <div class="dx-form-group" style="padding-bottom:0px">
                                    <input type="text" @bind="codeShareSearch.FLN" placeholder="e.g. 123" onblur="@(() => ValidateCodeShareGroup())" style="text-transform:uppercase" class="dx-form-control @(codeShareErr ? "invalid" : "")" />
                                    @if (!FilteredCodeShareAirlineSuggestions.Any() && codeShareErr) {
                                        @if (codeShareNumErrMsg == "" || codeShareNumErrMsg.IsWhiteSpace()) {
                                            <span class="dx-form-validation" style="color:transparent">.</span>
                                        } else {
                                            <span class="dx-form-validation">@codeShareNumErrMsg</span>
                                        }
                                    }
                                </div>
                                <div class="dx-form-group" style="padding:0">
                                    <button type="button" @onclick="() => SaveCodeShare()" disabled="@disableAddCodeShare" class="dx-btn dx-btn-blue dx-btn-sm" style="margin: 10px; width:25px; margin-bottom:0px"><i class="bi bi-plus-lg"></i></button>
                                    @if (!FilteredCodeShareAirlineSuggestions.Any() && codeShareErr) {
                                        <span class="dx-form-validation" style="color:transparent">.</span>
                                    }
                                </div>
                            </div>
                            @foreach (FECodeShare codeshare in CodeShares) {
                                <div class="dx-table-row" style="grid-template-columns: 1fr 1fr .2fr;">
                                    <div>@UpdateAirline(codeshare.FLC!)</div>
                                    <div>@codeshare.FLN</div>
                                    <button type="button" @onclick="() => RemoveCodeShare(codeshare)" class="dx-modal-close" style="color:var(--dx-red); width:25px">&times;</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <KeepAfterFeedReturnsBox @bind-Box="keep" />
                </fieldset>
            </div>
            <div class="dx-modal-footer">
                @* Save & close button and cancel button*@
                <button type="button" class="dx-btn dx-btn-gray" @onclick="() => Close()">Cancel</button>
                <button class="dx-btn dx-btn-blue fde-save" disabled="@(saving || ReadOnly)" @onclick="() => SaveAndClose()">Save & Close</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    public FlightManagement? homePage { get; set; }

    /// <summary>CoreAPI is unreachable: the form shows its values but takes no change (FDE-11).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    public bool showDialog = false;

    private bool selectingCodeShareFlightSuggestion;

    public List<TblLocation> locations { get; set; } = new();
    public List<TblAirline> airlines { get; set; } = new();
    public List<TblGate> gates { get; set; } = new();
    public List<TblFlightStatus> statuses { get; set; } = new();
    private bool publicCheckbox = true;
    private bool baggageCheckbox = true;
    private bool staffCheckbox = true;
    private bool throwCheckbox = true;
    // Taken as the form opens, so the kind follows the mode the user saw (FDE-04).
    private KeepAfterFeedReturns keep;
    private List<FECodeShare> CodeShares = new();
    private FEDepartureFlight departureFlight = new();
    private FECodeShare codeShareSearch = new();

    private List<string> FilteredDestSuggestions { get; set; } = new();
    private List<string> FilteredGateSuggestions { get; set; } = new();
    private List<string> FilteredCodeShareAirlineSuggestions { get; set; } = new();
    private List<string> FilteredFlightAirlineSuggestions { get; set; } = new();

    private bool disableAddCodeShare = true;

    private string? saveError;
    private bool saving;

    #region Data Validation Vars
    private bool flcErr = false;
    private string flcErrMsg = "";
    private bool flnErr = false;
    private string flnErrMsg = "";
    private bool stdErr = false;
    private string stdErrMsg = "";
    private bool etdErr = false;
    private string etdErrMsg = "";
    private bool statusErr = false;
    private string statusErrMsg = "";
    private bool atdErr = false;
    private string atdErrMsg = "";
    private bool gatErr = false;
    private string gatErrMsg = "";
    private bool destErr = false;
    private string destErrMsg = "";
    private bool codeShareErr = false;
    private string codeShareFlightErrMsg = "";
    private string codeShareNumErrMsg = "";
    #endregion

    #region API Calls and Helpers
    /// <summary>
    /// Adds a new departure flight.
    /// </summary>
    /// <param name="newFlight"></param>
    private Task<CoreApiResult<int>> AddDepartureFlight(FEDepartureFlight newFlight) => coreApi.AddDepartureAsync(newFlight);
    /// <summary>
    /// Updates the location information based on the IATA code.
    /// </summary>
    /// <param name="DES"></param>
    /// <returns></returns>
    private string UpdateLocation(string DES) {
        TblLocation? tblLocation = locations.FirstOrDefault(x => x.IataCode == DES);
        if (tblLocation != null) {
            string? location = String.Format("{0}, {1}", tblLocation.Name, tblLocation.Country);

            if (location != null) return location;
        }
        return "";
    }
    /// <summary>
    /// Updates the airline information based on the airline code.
    /// </summary>
    /// <param name="FLC"></param>
    /// <returns></returns>
    private string UpdateAirline(string FLC) {
        TblAirline? tblAirline = airlines.FirstOrDefault(x => x.AirlineCode == FLC);
        if (tblAirline != null) {
            string? airline = tblAirline.CarrierName;

            if (airline != null) return airline;
        }

        return "No Airline Found";
    }
    #endregion
    #region Save, Reset, Initialize
    public void ShowDialog() {
        ResetDialog();
        showDialog = true;
        StateHasChanged();
    }
    public void Close() {
        ResetDialog();
        showDialog = false;

        StateHasChanged();
    }
    /// <summary>
    /// Re-Initializes the dialog state, clearing all input fields, resetting checkboxes, and preparing for a new flight entry.
    /// </summary>
    private void ResetDialog() {
        locations = homePage!.locations;
        airlines = homePage!.airlines;
        gates = homePage!.gates;
        statuses = homePage!.statuses;

        departureFlight = new();
        saveError = null;
        codeShareSearch = new();
        CodeShares.Clear();
        FilteredDestSuggestions.Clear();
        FilteredGateSuggestions.Clear();
        FilteredCodeShareAirlineSuggestions.Clear();
        FilteredFlightAirlineSuggestions.Clear();
        (publicCheckbox, baggageCheckbox, staffCheckbox, throwCheckbox) = RollCategories.AllShown;
        keep = KeepAfterFeedReturns.ForAdd(homePage!.FeedMode);

        flcErr = false;
        flcErrMsg = "";
        flnErr = false;
        flnErrMsg = "";
        stdErr = false;
        stdErrMsg = "";
        etdErr = false;
        etdErrMsg = "";
        statusErr = false;
        statusErrMsg = "";
        atdErr = false;
        atdErrMsg = "";
        gatErr = false;
        gatErrMsg = "";
        destErr = false;
        destErrMsg = "";
        codeShareErr = false;
        codeShareFlightErrMsg = "";
        codeShareNumErrMsg = "";

        StateHasChanged();
    }
    /// <summary>
    /// Adds the flight with every field the user set (FDE-05). When CoreAPI does not take it the form stays open
    /// with the error (FDE-06).
    /// </summary>
    public async Task SaveAndClose() {
        if (saving || !await ValidateData()) return;
        saving = true;
        try {
            saveError = null;
            RollChosen.WriteAll(departureFlight);
            keep.WriteKind(departureFlight);
            departureFlight.CodeShares = CodeShares;
            departureFlight.GAT = departureFlight.GAT?.ToUpper();
            departureFlight.FLC = departureFlight.FLC?.ToUpper();
            departureFlight.DES = departureFlight.DES?.ToUpper();
            var result = await AddDepartureFlight(departureFlight);
            homePage!.ObserveCoreApi(result);
            await audit.AddedAsync(departureFlight, RollChosen, keep.Kind, result);
            if (!result.Succeeded) {
                saveError = FlightSaveError.Describe(result);
                return;
            }
            Close();
        } finally {
            saving = false;
            StateHasChanged();
        }
    }
    public async Task<bool> ValidateData() {
        ValidateFlightGroup();
        ValidateDestGroup();
        ValidateGatGroup();
        ValidateTimeGroup();
        ValidateStatusGroup();
        ValidateCodeShareGroup();
        ValidateCodeShareList();
        await InvokeAsync(StateHasChanged);
        return !flcErr && !flnErr && !stdErr && !etdErr && !statusErr && !atdErr && !gatErr && !destErr && !codeShareErr;
    }
    private RollCategories RollChosen => new(publicCheckbox, baggageCheckbox, staffCheckbox, throwCheckbox);
    #endregion
    #region Autofill Sans CodeShare
    /// <summary>
    /// Filters the destination suggestions based on the user's input.
    /// </summary>
    /// <param name="e"></param>
    private void FilterDESSuggestions(ChangeEventArgs e) {
        var input = e.Value?.ToString() ?? string.Empty;
        departureFlight.DES = input;
        departureFlight.DES = departureFlight.DES?.ToUpper();

        FilteredDestSuggestions.Clear();
        if (!string.IsNullOrWhiteSpace(input)) {
            List<TblLocation?> tempLocations = locations.Where(x => x.IataCode.StartsWith(input, StringComparison.OrdinalIgnoreCase)).Take(10).ToList()!;
            foreach (TblLocation? tblLocation in tempLocations) {
                if (tblLocation != null) {
                    FilteredDestSuggestions.Add(tblLocation.IataCode);
                }
            }
        }
    }
    private void SelectDestSuggestion(string suggestion) {
        departureFlight.DES = suggestion;
        FilteredDestSuggestions.Clear();
        StateHasChanged();
    }
    private void SelectGateSuggestion(string suggestion) {
        departureFlight.GAT = suggestion;
        FilteredGateSuggestions.Clear();
        StateHasChanged();
    }

    private void FilterGATSuggestions(ChangeEventArgs e) {
        var input = e.Value?.ToString() ?? string.Empty;
        departureFlight.GAT = input;
        departureFlight.GAT = departureFlight.GAT?.ToUpper();

        FilteredGateSuggestions.Clear();
        if (!string.IsNullOrWhiteSpace(input)) {
            List<TblGate?> tempGates = gates.Where(x => x.Gat.StartsWith(input, StringComparison.OrdinalIgnoreCase)).Take(10).ToList()!;
            foreach (TblGate? tblGate in tempGates) {
                if (tblGate != null) {
                    FilteredGateSuggestions.Add(tblGate.Gat);
                }
            }
        }
    }

    private void FilterFlightAirlineSuggestions(ChangeEventArgs e) {
        var input = e.Value?.ToString() ?? string.Empty;
        departureFlight.FLC = input;
        departureFlight.FLC = departureFlight.FLC?.ToUpper();

        FilteredFlightAirlineSuggestions.Clear();
        if (!string.IsNullOrWhiteSpace(input)) {
            List<TblAirline?> tempAirlines = airlines.Where(x => x.AirlineCode.StartsWith(input, StringComparison.OrdinalIgnoreCase)).Take(10).ToList()!;
            foreach (TblAirline? tblAirline in tempAirlines) {
                if (tblAirline != null) {
                    FilteredFlightAirlineSuggestions.Add(tblAirline.AirlineCode);
                }
            }
        }
    }
    private void SelectFlightAirlineSuggestion(string suggestion) {
        departureFlight.FLC = suggestion;
        FilteredFlightAirlineSuggestions.Clear();
        StateHasChanged();
    }
    private void ValidateFlightGroup() {
        flcErr = false;
        flcErrMsg = "";
        flnErr = false;
        flnErrMsg = "";

        if (string.IsNullOrWhiteSpace(departureFlight.FLC)) {
            flcErr = true;
            flcErrMsg = "Required.";
        }
        if (string.IsNullOrWhiteSpace(departureFlight.FLN)) {
            flnErr = true;
            flnErrMsg = "Required.";
        }

        bool validGroup = airlines.Any(x =>
            string.Equals(
                x.AirlineCode,
                departureFlight.FLC,
                StringComparison.OrdinalIgnoreCase
            )
        );
        if (homePage!.fEDepartureFlights.Exists(x => x!.ScheduledTime! == departureFlight.ScheduledTime! && ((x!.FLC == departureFlight.FLC && x.FLN == departureFlight.FLN) || x!.CodeShares.Exists(cs => departureFlight.FLC == cs.FLC && departureFlight.FLN == cs.FLN)))) {
            flcErr = true;
            flnErr = true;
            flcErrMsg = "Existing Flight.";
        }
        if (!validGroup && !String.IsNullOrWhiteSpace(departureFlight.FLC)) {
            flcErr = true;
            flcErrMsg = "Invalid Airline Code.";
        }
        bool existingCodeShare = ((CodeShares.FirstOrDefault(x => x.FLN == departureFlight.FLN && x.FLC == departureFlight.FLC) != null) || (CodeShares.FirstOrDefault(cs => cs.FLN == departureFlight.FLN && cs.FLC == departureFlight.FLC) != null));
        if (existingCodeShare) {
            flcErr = true;
            flnErr = true;
            flcErrMsg = "Existing Flight.";
        }
        bool validNum = false;
        if (departureFlight.FLN != null && departureFlight.FLN != "" && !departureFlight.FLN.IsWhiteSpace()) {
            validNum = Regex.IsMatch(departureFlight.FLN, @"^\d+$");
            if (!validNum) {
                flnErr = true;
                flnErrMsg = "Invalid #.";
            }
        }
        FilteredFlightAirlineSuggestions.Clear();
        StateHasChanged();
    }
    #endregion
    #region Data Validation
    private void ValidateStatusGroup() {
        statusErr = false;
        statusErrMsg = "";

        bool validGroup = statuses.Any(x =>
            string.Equals(
                x.StatusId,
                departureFlight.RCP
            )
        );
        if (!validGroup) {
            statusErr = true;
            statusErrMsg = "Required.";
        }

        StateHasChanged();
    }

    private void ValidateDestGroup() {
        destErr = false;
        destErrMsg = "";

        if (string.IsNullOrWhiteSpace(departureFlight.DES)) {
            destErr = true;
            destErrMsg = "Required.";
        }

        bool validGroup = locations.Any(x =>
            string.Equals(
                x.IataCode,
                departureFlight.DES,
                StringComparison.OrdinalIgnoreCase
            )
        );

        if (!validGroup && !string.IsNullOrWhiteSpace(departureFlight.DES)) {
            destErr = true;
            destErrMsg = "Invalid Value.";
        }
        FilteredDestSuggestions.Clear();
        StateHasChanged();
    }
    private void ValidateGatGroup() {
        gatErr = false;
        gatErrMsg = "";

        if (string.IsNullOrWhiteSpace(departureFlight.GAT)) {
            return;
        }
        bool validGroup = gates.Any(x =>
            string.Equals(
                x.Gat,
                departureFlight.GAT,
                StringComparison.OrdinalIgnoreCase
            )
        );

        if (!validGroup) {
            gatErr = true;
            gatErrMsg = "Invalid Value.";
        }
        FilteredGateSuggestions.Clear();
        StateHasChanged();
    }

    private void ValidateTimeGroup() {
        stdErr = false;
        stdErrMsg = "";
        etdErr = false;
        etdErrMsg = "";
        atdErr = false;
        atdErrMsg = "";

        if (departureFlight.ScheduledTime == null) {
            stdErr = true;
            stdErrMsg = "Required.";
        } else if (!InWindowRange(departureFlight.ScheduledTime)) {
            stdErr = true;
            stdErrMsg = "Outside of Scheduling Window.";
        }
        if (departureFlight.EstimatedTime == null) {
            etdErr = true;
            etdErrMsg = "Required.";
        } else if (!InWindowRange(departureFlight.EstimatedTime)) {
            etdErr = true;
            etdErrMsg = "Outside of Scheduling Window.";
        }
        if (departureFlight.ActualTime == null) {
            atdErr = true;
            atdErrMsg = "Required.";
        } else if (!InWindowRange(departureFlight.ActualTime)) {
            atdErr = true;
            atdErrMsg = "Outside of Scheduling Window.";
        }
        StateHasChanged();
    }

    private bool InWindowRange(DateTime? dateTime) {
        return (dateTime != null && dateTime >= homePage!.feedWindow.WindowStart! && dateTime < homePage!.feedWindow.WindowEnd!);
    }

    #endregion
    #region CodeShares
    private void FilterCodeShareFlightAirlineSuggestions(ChangeEventArgs e) {
        var input = e.Value?.ToString() ?? string.Empty;

        FilteredCodeShareAirlineSuggestions.Clear();
        if (!string.IsNullOrWhiteSpace(input)) {
            List<TblAirline?> tempAirlines = airlines.Where(x => x.AirlineCode.StartsWith(input, StringComparison.OrdinalIgnoreCase)).Take(10).ToList()!;
            foreach (TblAirline? tblAirline in tempAirlines) {
                if (tblAirline != null) {
                    FilteredCodeShareAirlineSuggestions.Add(tblAirline.AirlineCode);
                }
            }
        }
    }
    private void SelectCodeShareAirlineSuggestion(string suggestion) {
        codeShareSearch.FLC = suggestion;
        FilteredCodeShareAirlineSuggestions.Clear();
        selectingCodeShareFlightSuggestion = false;
        ValidateCodeShareGroup();
    }
    private void ValidateCodeShareGroup() {
        codeShareErr = false;
        codeShareFlightErrMsg = "";
        codeShareNumErrMsg = "";
        codeShareSearch.FLC = codeShareSearch.FLC?.ToUpper();
        departureFlight.FLC = departureFlight.FLC?.ToUpper();
        disableAddCodeShare = true;
        if (selectingCodeShareFlightSuggestion) {
            return;
        }
        if (string.IsNullOrWhiteSpace(codeShareSearch.FLC) && string.IsNullOrWhiteSpace(codeShareSearch.FLN)) {
            return;
        }
        bool validGroup = airlines.Any(x =>
            string.Equals(
                x.AirlineCode,
                codeShareSearch.FLC,
                StringComparison.OrdinalIgnoreCase
            )
        );
        bool existingFlight = homePage!.fEDepartureFlights.Exists(x => x!.ScheduledTime! == departureFlight.ScheduledTime! && ((x!.FLC == codeShareSearch.FLC && x.FLN == codeShareSearch.FLN) || x!.CodeShares.Exists(cs => codeShareSearch.FLC == cs.FLC && codeShareSearch.FLN == cs.FLN)));
        if (existingFlight) {
            codeShareErr = true;
            codeShareFlightErrMsg = "Existing Flight.";
        }
        bool maxCodeSharesMet = CodeShares.Count >= config.GetValue<int>("CoreAPI:MaxCodeShares");
        if (maxCodeSharesMet) {
            codeShareErr = true;
            codeShareFlightErrMsg = "Maximum Code Shares Reached.";
        }
        if (!validGroup && !String.IsNullOrWhiteSpace(codeShareSearch.FLC)) {
            codeShareErr = true;
            codeShareFlightErrMsg = "Invalid Airline Code.";
        }
        bool existingCodeShare = ((CodeShares.FirstOrDefault(x => x.FLN == codeShareSearch.FLN && x.FLC == codeShareSearch.FLC) != null) || (departureFlight.CodeShares.FirstOrDefault(cs => cs.FLN == codeShareSearch.FLN && cs.FLC == codeShareSearch.FLC) != null));
        if (existingCodeShare) {
            codeShareErr = true;
            codeShareFlightErrMsg = "Existing Flight.";
        }
        bool masterFlight = ((departureFlight.FLC == codeShareSearch.FLC && departureFlight.FLN == codeShareSearch.FLN));
        if (masterFlight) {
            codeShareErr = true;
            codeShareFlightErrMsg = "Existing Flight.";
        }
        bool validNum = false;
        if (codeShareSearch.FLN != null && codeShareSearch.FLN != "" && !codeShareSearch.FLN.IsWhiteSpace()) {
            validNum = Regex.IsMatch(codeShareSearch.FLN, @"^\d+$");
            if (!validNum) {
                codeShareErr = true;
                codeShareNumErrMsg = "Invalid #.";
            }
        }
        if (validGroup && int.TryParse(codeShareSearch.FLN, out _) && !masterFlight && !existingCodeShare && !existingFlight && !maxCodeSharesMet && validNum) {
            disableAddCodeShare = false;
        }
        FilteredCodeShareAirlineSuggestions.Clear();
        StateHasChanged();
    }
    private void ValidateCodeShareList() {
        codeShareErr = false;
        codeShareFlightErrMsg = "";
        codeShareNumErrMsg = "";
        @foreach (FECodeShare codeshare in CodeShares) {
            if (homePage!.fEDepartureFlights.Exists(x => x!.ScheduledTime! == departureFlight.ScheduledTime! && ((x!.FLC == codeshare.FLC && x.FLN == codeshare.FLN) || x!.CodeShares.Exists(cs => codeshare.FLC == cs.FLC && codeshare.FLN == cs.FLN)))) {
                codeShareErr = true;
                codeShareFlightErrMsg = "Code share(s) match existing flights";
            }
        }
    }
    private void SaveCodeShare() {

        FECodeShare? tempCodeShare = CodeShares.FirstOrDefault(x => x.FLN == codeShareSearch.FLN && x.FLC == codeShareSearch.FLC);
        if (tempCodeShare == null) {
            CodeShares.Add(new FECodeShare() { FLN = codeShareSearch.FLN, FLC = codeShareSearch.FLC });
        }
        codeShareSearch.FLC = string.Empty;
        codeShareSearch.FLN = string.Empty;
        disableAddCodeShare = true;
        StateHasChanged();
    }
    private void RemoveCodeShare(FECodeShare fECodeShare) {
        CodeShares.Remove(fECodeShare);
        StateHasChanged();
    }
    #endregion
}
