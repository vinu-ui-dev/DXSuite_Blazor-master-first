    private RenderFragment CuppsToggle(string title, string description, bool value, Action<bool> setter) =>
        @<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:12px 0; border-bottom:1px solid #f0f0f0;">
            <div style="max-width:560px;">
                <strong style="font-size:0.9rem;">@title</strong>
                <div class="dx-text-muted" style="font-size:0.82rem; margin-top:2px;">@description</div>
            </div>
            <label class="dx-toggle">
                <input type="checkbox" checked="@value" @onchange="@(e => setter((bool)e.Value!))" />
                <span class="dx-toggle-slider"></span>
            </label>
        </div>;

    private async Task CreateAirline()
    {
        if (Validate().Any(i => i.IsError)) return;

        isCreating = true;
        errorMessage = "";
        try
        {
            var code = data.Iata.Trim().ToUpperInvariant();
            var name = data.NameEn.Trim();
            var icao = string.IsNullOrWhiteSpace(data.Icao) ? null : data.Icao.Trim().ToUpperInvariant();

            await using var db = await AviationDbFactory.CreateDbContextAsync();

            var exists = await db.TblAirlines.AnyAsync(a => a.AirlineCode == code);
            if (exists)
            {
                errorMessage = $"An airline with IATA code {code} already exists.";
                return;
            }

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"INSERT INTO dbo.tblAirline (Airline_Code, CarrierName, ICAO, DisplayWithinSettingsMenu) VALUES ({code}, {name}, {icao}, {data.Active})");

            var created = await db.TblAirlines
                .Where(a => a.AirlineCode == code)
                .Select(a => new { a.RecordId, a.AirlineCode, a.CarrierName, a.Icao, a.DisplayWithinSettingsMenu })
                .FirstOrDefaultAsync();

            if (created == null)
            {
                errorMessage = "The airline was not saved. Try again.";
                return;
            }

            var dcsLabel = data.DcsMode == "airline" ? "Airline" : data.DcsProvider;
            var result = new NewAirlineResult(
                created.RecordId, created.AirlineCode, created.CarrierName ?? created.AirlineCode, created.Icao, created.DisplayWithinSettingsMenu,
                data.Alliance, data.Terminal1, data.Terminal3,
                data.DcsMode == "provider", dcsLabel, data.BackgroundColor,
                data.HasWordmark, data.HasSquareMark, data.HasReversedWordmark);

            await OnCreated.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating airline {Code}", data.Iata);
            errorMessage = "Couldn't create the airline. Check the details and try again.";
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();
}
