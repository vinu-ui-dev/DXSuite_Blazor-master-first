    private void HandleAirlineCreated(AddAirlineWizard.NewAirlineResult result)
    {
        var row = new AirlineRow(result.RecordId, result.Code, result.Name, result.Icao, result.Active);
        allAirlines = allAirlines.Where(a => a.RecordId != row.RecordId).Append(row).ToList();
        onboarded = allAirlines.Where(a => a.Shown).OrderBy(a => a.Name).ToList();

        var extra = ExtraFor(row.Code);
        extra.Alliance = result.Alliance;
        extra.Dcs = result.DcsLabel;
        extra.WordmarkColor = result.BackgroundColor;
        extra.WordmarkStatus = result.HasWordmark ? "Approved" : "Not uploaded";
        extra.SquareMarkStatus = result.HasSquareMark ? "Approved" : "Not uploaded";
        extra.ReversedWordmarkStatus = result.HasReversedWordmark ? "Approved" : "No file";
        extra.Accounts = 1;

        statusMessage = $"{row.Name} created.";
        statusIsError = false;

        OpenProfile(row, false);
    }

    private async Task Onboard(AirlineRow row)
    {
        statusMessage = "";
        try
        {
            if (!row.Shown)
            {
                await using var db = await AviationDbFactory.CreateDbContextAsync();
                await db.Database.ExecuteSqlInterpolatedAsync(
                    $"UPDATE dbo.tblAirline SET DisplayWithinSettingsMenu = 1 WHERE RecordID = {row.RecordId}");

                row = row with { Shown = true };
                allAirlines = allAirlines.Select(a => a.RecordId == row.RecordId ? row : a).ToList();
                onboarded = allAirlines.Where(a => a.Shown).OrderBy(a => a.Name).ToList();
                statusMessage = $"{row.Name} onboarded.";
                statusIsError = false;

                await AirlineAudit.OnboardedAsync(row.RecordId, row.Code, row.Name);
            }

            searchTerm = "";
            searchResults.Clear();
            OpenProfile(row, false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error onboarding airline {Code}", row.Code);
            statusMessage = $"Couldn't onboard {row.Name}.";
            statusIsError = true;
        }
    }

    private async Task Deactivate()
    {
        if (profileAirline == null) return;
        try
        {
            await using var db = await AviationDbFactory.CreateDbContextAsync();
            await db.Database.ExecuteSqlInterpolatedAsync(
                $"UPDATE dbo.tblAirline SET DisplayWithinSettingsMenu = 0 WHERE RecordID = {profileAirline.RecordId}");

            var updated = profileAirline with { Shown = false };
            allAirlines = allAirlines.Select(a => a.RecordId == updated.RecordId ? updated : a).ToList();
            onboarded = allAirlines.Where(a => a.Shown).OrderBy(a => a.Name).ToList();
            statusMessage = $"{updated.Name} removed from the active list.";
            statusIsError = false;

            await AirlineAudit.RemovedFromActiveListAsync(updated.RecordId, updated.Code, updated.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deactivating airline {Code}", profileAirline.Code);
            statusMessage = $"Couldn't remove {profileAirline.Name}.";
            statusIsError = true;
        }
        CloseProfile();
    }

