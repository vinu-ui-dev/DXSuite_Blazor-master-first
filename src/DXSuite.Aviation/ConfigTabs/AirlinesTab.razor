    /* The profile header: back button and airline tile are the same size and sit on one centre line. */
    .al-profile-head { align-items: center; min-height: 64px; padding-top: 12px; padding-bottom: 12px; }
    .al-head { display: flex; align-items: center; gap: 14px; min-width: 0; }
    .al-head-title { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .al-head-title h4 { margin: 0; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .al-back {
