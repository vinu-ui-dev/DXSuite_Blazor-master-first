@if (editTemplate is not null)
{
    <div class="dx-modal-overlay">
        <div class="dx-modal" style="width:560px;">
            <div class="dx-modal-header">
                <h3 style="margin:0;font-size:1.1rem;">@(isCreatingTemplate ? "Create Counter Template" : "Edit Counter Template")</h3>
                <button class="dx-modal-close" aria-label="Close" @onclick="CloseTemplateModal">&times;</button>
            </div>
            <div class="dx-modal-body">
                <div class="dx-form-group">
                    <label class="dx-form-label">Template Name</label>
                    <input class="dx-form-control" maxlength="50" @bind="editTemplate.Name" @bind:event="oninput" />
                    <div class="dx-text-muted" style="font-size:0.72rem;">@editTemplate.Name.Length / 50</div>
                </div>

                <div class="dx-form-group">
                    <label class="dx-form-label">Select Template Type</label>
                    <div style="display:flex; gap:16px; align-items:center;">
                        <label class="dx-text-muted" style="opacity:0.6;"><input type="radio" disabled /> Standard</label>
                        <label><input type="radio" checked /> Custom</label>
                    </div>
                    <div class="dx-text-muted" style="font-size:0.78rem;">Standard templates are written by GTAA admins.</div>
                </div>

                <div class="dx-form-group">
                    <label class="dx-form-label">Image Layout</label>
                    <label style="display:block; margin-bottom:4px;">
                        <input type="radio" name="tmpl-layout" checked="@editTemplate.ImagesSeparate" @onchange="() => editTemplate.ImagesSeparate = true" />
                        Separate English and French images (4 images)
                    </label>
                    <label>
                        <input type="radio" name="tmpl-layout" checked="@(!editTemplate.ImagesSeparate)" @onchange="() => editTemplate.ImagesSeparate = false" />
                        Bilingual images, English and French on one image (2 images)
                    </label>
                </div>

                @if (editTemplate.ImagesSeparate)
                {
                    <div style="display:flex; gap:24px; margin-bottom:8px;">
                        <div style="flex:1;">
                            <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:6px;">English Images</div>
                            @TemplateUploadSlot("Full Screen", "1920 x 980")
                            @TemplateUploadSlot("Half Screen", "960 x 980")
                        </div>
                        <div style="flex:1;">
                            <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:6px;">French Images</div>
                            @TemplateUploadSlot("Full Screen", "1920 x 980")
                            @TemplateUploadSlot("Half Screen", "960 x 980")
                        </div>
                    </div>
                }
                else
                {
                    <div style="margin-bottom:8px; max-width:280px;">
                        @TemplateUploadSlot("Full Screen", "1920 x 980")
                        @TemplateUploadSlot("Half Screen", "960 x 980")
                    </div>
                }

                <div class="dx-text-muted" style="font-size:0.78rem; margin-bottom:12px;">
                    Each image goes to @profileAirline!.Name content for approval on its own. Agents can pick the template once all its images are approved.
                </div>

                <div style="display:flex; gap:16px;">
                    <div style="flex:1;">
                        <label class="dx-form-label">Start Date</label>
                        <input type="date" class="dx-form-control" value="@editTemplate.StartDate.ToString("yyyy-MM-dd")"
                               @onchange="e => editTemplate.StartDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : editTemplate.StartDate" />
                    </div>
                    <div style="flex:1;">
                        <label class="dx-form-label">End Date (optional)</label>
                        <input type="date" class="dx-form-control" value="@(editTemplate.EndDate?.ToString("yyyy-MM-dd"))"
                               @onchange="e => editTemplate.EndDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null" />
                    </div>
                </div>
                <div class="dx-text-muted" style="font-size:0.78rem; margin-top:6px;">From 00:01 on the start date to 23:59 on the end date, airport time.</div>
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn dx-btn-gray" @onclick="CloseTemplateModal">CLOSE</button>
                <button class="dx-btn dx-btn-blue" @onclick="SaveTemplate">SUBMIT</button>
            </div>
        </div>
    </div>
}

