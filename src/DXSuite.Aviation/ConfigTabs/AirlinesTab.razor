            <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 10px; background:#f5f5f5;">
                <strong>@title</strong>
                <span class="dx-badge @badgeClass" style="@badgeStyle">@lang</span>
            </div>
            <div style="height:@(size == "full" ? "140px" : "90px"); background:@extra.WordmarkColor; color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:4px;">
                <div style="font-weight:800; font-size:@(size == "full" ? "1rem" : "0.85rem");">@line1</div>
                <div style="font-size:0.8rem;">@profileAirline!.Name</div>
            </div>
            <div style="padding:8px 10px 0; font-size:0.78rem;">
                @($"checkin-{langCode.ToLowerInvariant()}-{size}.png") &middot; Language <span class="dx-badge @badgeClass" style="@badgeStyle">@lang</span>
            </div>
            <div style="margin:8px 10px; padding:6px 8px; font-size:0.72rem; font-family:monospace; color:#666; background:#fafafa; border-radius:4px; word-break:break-all;">
                Image@langCode (@size) = @AssetPath(profileAirline!.Code, langCode, size)
            </div>
            <div style="padding:0 10px 10px; display:flex; flex-direction:column; gap:6px;">
                <button class="dx-btn dx-btn-gray dx-btn-sm" disabled="@isViewOnlyAirlines" @onclick='() => SimulateUpload("wordmark")'>CHOOSE FROM LIBRARY</button>
                <button class="dx-btn dx-btn-gray dx-btn-sm" disabled>UPLOAD (PROTOTYPE SAMPLE)</button>
            </div>
        </div>;
}
