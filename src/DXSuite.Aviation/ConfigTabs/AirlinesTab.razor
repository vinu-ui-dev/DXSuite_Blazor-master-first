    private void SaveTemplate()
    {
        if (editTemplate is null || profileAirline is null || isViewOnlyAirlines) return;
        var list = TemplatesFor(profileAirline.Code);
        var existing = list.FirstOrDefault(x => x.Id == editTemplate.Id);
        if (existing is not null) list.Remove(existing);
        if (string.IsNullOrWhiteSpace(editTemplate.NameEn)) editTemplate.NameEn = editTemplate.Name.ToUpperInvariant();
        list.Add(editTemplate);
        CloseTemplateModal();
    }

