@code {
    private sealed record AirlineRow(int RecordId, string Code, string Name, string? Icao, bool Shown);

    private sealed class AirlineExtra
    {
        public string Dcs = "—";
        public string Alliance = "None";
        public int Accounts = 0;
        public string WordmarkColor = "#555";
        public string WordmarkStatus = "Not uploaded";
