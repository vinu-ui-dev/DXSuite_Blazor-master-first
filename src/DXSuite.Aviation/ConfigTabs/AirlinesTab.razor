    private void OpenProfile(AirlineRow row, bool supervisor)
    {
        profileAirline = row;
        memberError = null;
        members = new();
        candidates = new();
        candidatesSearched = false;
        candidateQuery = "";
        _ = LoadSavedLogosAsync(row.Code);
        _ = LoadTemplatesAsync(row);
        if (canShowAdminUsersTab) _ = LoadMembersAsync(row);
        isSupervisorPreview = supervisor;
        viewMode = "profile";
        EnsureVisibleProfileTab();
    }

    private void CloseProfile()
    {
        viewMode = (isSupervisorPreview || isRealAirlineScope) ? "supervisor" : "list";
    }

    private void PreviewSupervisor()
    {
        var target = onboarded.FirstOrDefault();
        if (target == null) return;
        supervisorTarget = target;
        isSupervisorPreview = true;
        viewMode = "supervisor";
    }

    private void ExitSupervisorPreview()
    {
        isSupervisorPreview = false;
        viewMode = "list";
    }

    private void EnsureVisibleListTab()
    {
        if (subTab == "dcs" && !canSeeDcsProvidersTab)
            subTab = "airlines";
        else if (subTab == "alliances" && !canSeeAlliancesTab)
            subTab = "airlines";
        else if ((subTab == "logos" || subTab == "libdefaults") && !canSeeLogoLibrariesTab)
            subTab = "airlines";
    }

    private void EnsureVisibleProfileTab()
    {
        if (canShowAdminIdentityTab && profileTab == "identity") return;
        if (profileTab == "branding") return;
        if (canShowAdminCuppsTab && profileTab == "cupps") return;
        if (canShowAdminDcsTab && profileTab == "dcs") return;
        if (profileTab == "templates") return;
        if (canShowAdminUsersTab && profileTab == "users") return;

        profileTab = "branding";
    }

    // ── Logos: the real Director asset library (choose an approved file, or upload into it) ──────────────────────────

    private IAirlineLogoLibrary? logoLibrary;
    private AirlineLogoLibraryInfo? libraryInfo;
    private string? pickerKind;
    private bool pickerLoading;
    private IReadOnlyList<AirlineLogoFile> pickerFiles = [];
    private string? uploadKind;
    private DynamicComponent? uploaderHost;
    private Dictionary<string, object>? uploaderParameters;
    private readonly Dictionary<string, string> logoErrors = new();
    private readonly Dictionary<(string Code, string Kind), AirlineLogoState> savedLogos = new();

    private static string RoleLabel(string kind) => kind switch
    {
        "wordmark" => "Wordmark",
        "square" => "Square mark",
        _ => "Reversed wordmark",
    };

    private AirlineLogoState? SavedLogo(string kind) =>
        profileAirline is not null && savedLogos.TryGetValue((profileAirline.Code, kind), out var state) ? state : null;

    private static void SetLogoStatus(AirlineExtra extra, string kind, string status)
    {
        switch (kind)
        {
            case "wordmark": extra.WordmarkStatus = status; break;
            case "square": extra.SquareMarkStatus = status; break;
            case "reversed": extra.ReversedWordmarkStatus = status; break;
        }
    }

    private static string StatusOf(AirlineLogoState state) =>
        state.Pending is not null ? (state.PendingDeclined ? "Declined" : "Pending") : state.Live is not null ? "Approved" : "Not uploaded";

    /// <summary>
    /// The logos this airline has linked, so the Branding tab shows them after a reload. A new upload that Director
    /// approved since is promoted to the logo on screen here.
    /// </summary>
    private async Task LoadSavedLogosAsync(string code)
    {
        try
        {
            var states = await LogoLinks.LoadAsync(code);
            var extra = ExtraFor(code);
            foreach (var (role, state) in states)
            {
                savedLogos[(code, role)] = state;
                SetLogoStatus(extra, role, StatusOf(state));
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the saved logos of airline {Code}", code);
        }
    }

    // No library yet: an Admin's first Choose or Upload creates it (Airline wordmarks, 1200 x 400); anyone else is told.
    private async Task<bool> EnsureLibraryAsync(string kind)
    {
        if (libraryInfo != null) return true;
        if (logoLibrary == null) return false;
        try { libraryInfo = await logoLibrary.EnsureLibraryAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not create the airline logo library");
            DXSuite.Shared.Logging.AirlineFileLog.Write($"[LOGO-LIB] creating the library failed: {DXSuite.Shared.Logging.AirlineFileLog.Describe(ex)}");
        }
        if (libraryInfo == null)
            logoErrors[kind] = "No airline logo library exists yet, and only an Admin can create it. Ask an Admin to open this page once.";
        return libraryInfo != null;
    }

    private async Task OpenPickerAsync(string kind)
    {
        if (logoLibrary == null) return;
        logoErrors.Remove(kind);
        if (!await EnsureLibraryAsync(kind)) return;
        pickerKind = kind;
        pickerLoading = true;
        pickerFiles = [];
        logoErrors.Remove(kind);
        try { pickerFiles = await logoLibrary.ListApprovedAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not list the airline logo library");
            logoErrors[kind] = "The library could not be read. Try again.";
            pickerKind = null;
        }
        finally { pickerLoading = false; }
    }

    private void ClosePicker() => pickerKind = null;

    private async Task PickFileAsync(AirlineLogoFile file)
    {
        var kind = pickerKind;
        pickerKind = null;
        if (kind != null) await LinkLogoAsync(kind, file);
    }

    private async Task OpenUploadAsync(string kind)
    {
        logoErrors.Remove(kind);
        if (!await EnsureLibraryAsync(kind)) return;
        if (uploaderHost?.Instance is not IAirlineLogoUploader uploader)
        {
            logoErrors[kind] = "The upload dialog is not ready. Try again.";
            return;
        }
        uploadKind = kind;
        try
        {
            if (await uploader.OpenAsync() is { } problem) logoErrors[kind] = problem;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not open the logo uploader");
            logoErrors[kind] = "The upload dialog could not be opened. Try again.";
        }
    }

    private async Task OnLogoUploadedAsync(AirlineLogoFile file)
    {
        var kind = uploadKind;
        uploadKind = null;
        if (kind != null) await LinkLogoAsync(kind, file);
    }

    /// <summary>
    /// Points the airline's logo role at a library file. An approved file goes live at once; a new upload waits on the
    /// library's approval chain (Director &gt; Approvals) and the logo on screen stays as it was until it is approved.
    /// </summary>
    private async Task LinkLogoAsync(string kind, AirlineLogoFile file)
    {
        if (profileAirline is null || isViewOnlyAirlines) return;
        var code = profileAirline.Code;
        try
        {
            await LogoLinks.LinkAsync(code, kind, file);
            logoErrors.Remove(kind);
            await LoadSavedLogosAsync(code);
            statusMessage = file.Approved
                ? $"{RoleLabel(kind)} set for {profileAirline.Name}."
                : $"{RoleLabel(kind)} uploaded for {profileAirline.Name}. It is waiting for approval in Director > Approvals; the logo on screen stays until it is approved.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not link the {Role} logo of airline {Code}", kind, code);
            logoErrors[kind] = "The logo could not be saved. Try again.";
        }
    }

    // ── Save, retire and reactivate ────────────────────────────────────────────────────────────────────────────────────

    private async Task SaveProfileAsync()
    {
        if (profileAirline is null || !canEditProfile || isSavingProfile) return;
        var extra = ExtraFor(profileAirline.Code);

        if (string.IsNullOrWhiteSpace(extra.NameEn)) { Fail("Enter the English airline name."); return; }
        if (extra.DcsProviderMode && extra.DcsProviderId is null) { Fail("Choose the DCS provider, or switch the airline to check passengers in itself."); return; }

        isSavingProfile = true;
        try
        {
            var result = await AirlineApi.UpdateAsync(profileAirline.RecordId, new AirlineUpdateDto(
                extra.NameEn.Trim(), extra.NameFr.Trim(), extra.CuppsName.Trim(),
                extra.FlagCanada, extra.FlagUnitedStates, extra.FlagInternational,
                extra.WordmarkColor,
                extra.AllianceId,
                extra.DcsProviderMode ? extra.DcsProviderId : null,
                extra.TerminalZoneIds.ToArray(),
                extra.SunflowerOption, extra.AslVideos, extra.DestinationZone));
            if (!result.Success) { Fail(result.Error ?? "The airline could not be saved."); return; }

            await ReloadAirlinesAsync();
            Succeed($"{profileAirline?.Name} saved.");
        }
        finally { isSavingProfile = false; }
    }

    private async Task RetireAirlineAsync()
    {
        if (profileAirline is null || !isAdminUser || isSavingProfile) return;
        isSavingProfile = true;
        try
        {
            var result = await AirlineApi.RetireAsync(profileAirline.RecordId);
            if (!result.Success) { Fail(result.Error ?? "The airline could not be retired."); return; }
            await AirlineAudit.RemovedFromActiveListAsync(profileAirline.RecordId, profileAirline.Code, profileAirline.Name);
            await ReloadAirlinesAsync();
            Succeed($"{profileAirline?.Name} retired. It is hidden from CUPPS and counter allocation.");
        }
        finally { isSavingProfile = false; }
    }

    private async Task ReactivateAirlineAsync()
    {
        if (profileAirline is null || !isAdminUser || isSavingProfile) return;
        isSavingProfile = true;
        try
        {
            var result = await AirlineApi.ReactivateAsync(profileAirline.RecordId);
            if (!result.Success) { Fail(result.Error ?? "The airline could not be reactivated."); return; }
            await ReloadAirlinesAsync();
            Succeed($"{profileAirline?.Name} is active again.");
        }
        finally { isSavingProfile = false; }
    }

    private void Fail(string message) { statusMessage = message; statusIsError = true; }
    private void Succeed(string message) { statusMessage = message; statusIsError = false; }

    // ── Members of the airline's user group ─────────────────────────────────────────────────────────────────────────

    private async Task LoadMembersAsync(AirlineRow row)
    {
        membersLoading = true;
        memberError = null;
        try
        {
            var loaded = await AirlineApi.GetMembersAsync(row.RecordId);
            if (profileAirline?.RecordId == row.RecordId) members = loaded.ToList();
        }
        catch (Exception ex)
        {
            memberError = DXSuite.Shared.Services.UserFacingError.From(ex, "The members could not be loaded right now. Please try again.");
        }
        finally
        {
            membersLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnCandidateKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchCandidatesAsync();
    }

    private async Task SearchCandidatesAsync()
    {
        if (profileAirline is null || candidateQuery.Trim().Length < 2) return;
        memberBusy = true;
        try
        {
            candidates = (await AirlineApi.SearchCandidatesAsync(profileAirline.RecordId, candidateQuery.Trim())).ToList();
            candidatesSearched = true;
        }
        finally { memberBusy = false; }
    }

    private async Task AddMemberAsync(AirlineMemberDto user)
    {
        if (profileAirline is null || !canEditProfile || memberBusy) return;
        memberBusy = true;
        memberError = null;
        try
        {
            var result = await AirlineApi.AddMemberAsync(profileAirline.RecordId, user.UserId, string.IsNullOrEmpty(addRoleName) ? null : addRoleName);
            if (!result.Success) { memberError = result.Error; return; }
            candidates = candidates.Where(c => c.UserId != user.UserId).ToList();
            await LoadMembersAsync(profileAirline);
            await ReloadAirlinesAsync();
        }
        finally { memberBusy = false; }
    }

    private async Task RemoveMemberAsync(AirlineMemberDto user)
    {
        if (profileAirline is null || !canEditProfile || memberBusy) return;
        memberBusy = true;
        memberError = null;
        try
        {
            var result = await AirlineApi.RemoveMemberAsync(profileAirline.RecordId, user.UserId);
            if (!result.Success) { memberError = result.Error; return; }
            await LoadMembersAsync(profileAirline);
            await ReloadAirlinesAsync();
        }
        finally { memberBusy = false; }
    }

    // ── Counter templates Director holds for the airline ────────────────────────────────────────────────────────────

    private async Task LoadTemplatesAsync(AirlineRow row)
    {
        templatesLoading = true;
        templatesError = null;
        profileTemplates = [];
        try
        {
            var (templates, _) = await CuppsLiveData.GetPageOptionsAsync(row.RecordId, row.Code);
            if (profileAirline?.RecordId == row.RecordId) profileTemplates = templates;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the counter templates of airline {Code}", row.Code);
            templatesError = "The counter templates could not be loaded.";
        }
        finally
        {
            templatesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private RenderFragment LogoCard(string title, bool optional, string chainName, string status, string kind, string dims, string? customNote = null) =>
        @<div style="border:1px solid var(--dx-border-color,#dee2e6); border-radius:6px; padding:16px; max-width:640px; margin-bottom:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <div>
                    <strong>@title</strong>
                    <span class="dx-badge @(status == "Approved" ? "dx-badge-green" : status == "Pending" ? "dx-badge-orange" : "dx-badge-gray")" style="margin-left:6px;">@status</span>
                </div>
                <div style="display:flex; gap:8px;">
                    <button class="dx-btn dx-btn-gray dx-btn-sm" disabled="@(isViewOnlyAirlines || logoLibrary == null)" @onclick="() => OpenPickerAsync(kind)">@(isAdminProfile ? "CHOOSE FROM LIBRARY" : "CHOOSE AN EARLIER LOGO")</button>
                    <button class="dx-btn dx-btn-blue dx-btn-sm" disabled="@(isViewOnlyAirlines || logoLibrary == null)" @onclick="() => OpenUploadAsync(kind)">@(isAdminProfile ? "UPLOAD TO LIBRARY" : status is "No file" or "Not uploaded" ? "UPLOAD" : "REPLACE")</button>
                </div>
            </div>
            <div class="dx-alert dx-alert-info" style="font-size:0.78rem; padding:8px 10px; margin-bottom:10px;">
                @if (isAdminProfile)
                {
                    if (libraryInfo != null)
                    {
                        @:Draws from @libraryInfo.Name@(libraryInfo.Width > 0 ? $", Aspect Ratio {libraryInfo.Width} x {libraryInfo.Height}" : "") &middot; approved on that library's chain (GTAA admins)
                    }
                    else
                    {
                        @:No Airline wordmarks asset library yet. An Admin's first Choose or Upload creates it.
                    }
                }
                else
                {
                    @:Approved by GTAA on the @chainName chain (GTAA admins)<br />a library every airline uploads to; you see only your airline's files
                }
            </div>
            @if (SavedLogo(kind) is { } saved)
            {
                @if (saved.Live is { } live)
                {
                    <div style="height:90px; display:flex; align-items:center; justify-content:center; border-radius:4px; background:repeating-conic-gradient(#f3f3f3 0% 25%, #fff 0% 50%) 50% / 16px 16px;">
                        <LogoPreview Src="@live.Path" Alt="@title" Style="max-width:100%; max-height:100%; object-fit:contain;" />
                    </div>
                    <div class="dx-text-muted" style="font-size:0.75rem; margin-top:4px;">On screen now &middot; @live.Name</div>
                    <div class="dx-text-muted" style="font-size:0.8rem; margin-top:6px;">
                        @(customNote ?? $"Drawn on Standard Counter templates. The library's constraint: Aspect Ratio {dims}.")
                    </div>
                }
                else
                {
                    <div style="height:90px; border:2px dashed #ccc; border-radius:4px; display:flex; align-items:center; justify-content:center; color:#999; font-size:0.85rem;">No logo on screen yet</div>
                }
                @if (saved.Pending is { } waiting)
                {
                    <div class="dx-alert @(saved.PendingDeclined ? "dx-alert-danger" : "dx-alert-warning")" style="font-size:0.8rem; padding:8px 10px; margin-top:10px;">
                        @if (saved.PendingDeclined)
                        {
                            @:<strong>@waiting.Name</strong> was declined (or removed) in Director &gt; Approvals. Upload another file to replace it.
                        }
                        else
                        {
                            @:<strong>@waiting.Name</strong> is waiting for approval in Director &gt; Approvals. The logo on screen stays until it is approved.
                        }
                    </div>
                }
            }
            else
            {
                <div style="height:90px; border:2px dashed #ccc; border-radius:4px; display:flex; align-items:center; justify-content:center; color:#999; font-size:0.85rem;">No file</div>
                <div class="dx-text-muted" style="font-size:0.8rem; margin-top:6px;">
                    @(customNote ?? $"The library's constraint: the same shape as {dims}, that size or larger. PNG or SVG with a transparent background, up to 5 MB.")
                </div>
            }
            @if (logoErrors.TryGetValue(kind, out var logoError))
            {
                <div class="dx-alert dx-alert-danger" style="font-size:0.8rem; padding:8px 10px; margin-top:10px;">@logoError</div>
            }
        </div>;
}
