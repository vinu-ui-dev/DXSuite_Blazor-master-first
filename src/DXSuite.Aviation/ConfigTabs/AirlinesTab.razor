@rendermode InteractiveServer
@using DXSuite.Aviation.Entities
@using DXSuite.Aviation.Services
@using DXSuite.Shared.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject IDbContextFactory<AviationDbContext> AviationDbFactory
@inject ILogger<AirlinesTab> Logger
@inject ISessionState SessionState
@inject AirlineAudit AirlineAudit
@inject DXSuite.Shared.Services.Identity.IUserGroupService UserGroupService

<div class="dx-card" style="display:flex; flex-direction:column; height:100%; overflow:hidden;">

@if (viewMode == "list")
{
    <div class="dx-panel-header">
        <h4>Airlines</h4>
        @if (isViewOnlyAirlines || isAirlineSupervisorRole)
        {
            <span class="dx-badge dx-badge-gray">View only</span>
        }
        else
        {
        <div class="dx-panel-controls" style="position:relative;">
            <input @ref="searchInputRef" type="text" class="dx-search-input" autocomplete="off"
                   value="@searchTerm" @oninput="OnSearchInput"
                   placeholder="Search @allAirlines.Count airlines to onboard..." />
            <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="OpenAddAirline">+ ADD AIRLINE</button>

            @if (searchResults.Count > 0)
            {
                <div class="dx-typeahead-dropdown" style="top:40px; left:0; right:auto; width:340px;">
                    @foreach (var r in searchResults)
                    {
                        <button class="dx-typeahead-item" style="display:flex; justify-content:space-between; align-items:center;"
                                @onclick="() => Onboard(r)">
                            <span>@r.Name <span class="dx-text-muted">(@r.Code)</span></span>
                            @if (r.Shown)
                            {
                                <span class="dx-badge dx-badge-green">onboarded</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
        }
    </div>

    <div class="dx-tab-nav" style="border-radius:0; overflow:hidden; flex-shrink:0;">
        <button class="dx-tab-btn @(subTab == "airlines" ? "active" : "")" @onclick="@(() => subTab = "airlines")">Airlines</button>
        @if (!isAirlineSupervisorRole)
        {
            <button class="dx-tab-btn @(subTab == "dcs" ? "active" : "")" @onclick="@(() => subTab = "dcs")">DCS Providers</button>
            <button class="dx-tab-btn @(subTab == "alliances" ? "active" : "")" @onclick="@(() => subTab = "alliances")">Alliances</button>
            <button class="dx-tab-btn @(subTab == "logos" ? "active" : "")" @onclick="@(() => subTab = "logos")">Logo libraries</button>
        }
    </div>

    <div class="dx-panel-content" style="flex:1; min-height:0; overflow-y:auto; padding:0;">

    @if (subTab == "airlines")
    {
        <div class="dx-text-muted" style="padding:10px 20px; font-size:0.85rem; border-bottom:1px solid var(--dx-border-color,#eee);">
            Airlines onboarded for this airport. Search above to onboard any of the @allAirlines.Count airlines in the master list.
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="dx-alert @(statusIsError ? "dx-alert-danger" : "dx-alert-success")" style="margin:12px 20px;">@statusMessage</div>
        }

        @if (onboarded.Count == 0)
        {
            <div style="text-align:center; padding:40px 20px;">
                <h5>No airlines onboarded yet</h5>
                <p class="dx-text-muted">Search above and pick an airline to onboard it.</p>
            </div>
        }
        else
        {
            <div class="dx-table" style="border-left:none; border-right:none;">
                <div class="dx-table-header" style="@AirlineGridCols">
                    <div>Airline</div>
                    <div>IATA</div>
                    <div>ICAO</div>
                    <div>DCS</div>
                    <div>Alliance</div>
                    <div>Accounts</div>
                    <div>Status</div>
                    <div></div>
                </div>
                @foreach (var a in onboarded)
                {
                    var extra = ExtraFor(a.Code);
                    <div class="dx-table-row" style="@AirlineGridCols">
                        <div style="display:flex; align-items:center; gap:10px; min-width:0;">
                            <div class="al-tile" style="background:@ColorFor(a.Code);">@a.Code</div>
                            <a href="javascript:void(0)" @onclick="() => OpenProfile(a, false)">@a.Name</a>
                        </div>
                        <div>@a.Code</div>
                        <div>@(a.Icao ?? "—")</div>
                        <div>@extra.Dcs</div>
                        <div>@extra.Alliance</div>
                        <div>@extra.Accounts</div>
                        <div><span class="dx-badge dx-badge-green">Active</span></div>
                        <div style="text-align:right;"><button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="() => OpenProfile(a, false)">@(isViewOnlyAirlines || isAirlineSupervisorRole ? "VIEW" : "EDIT")</button></div>
                    </div>
                }
            </div>
            <div class="dx-text-muted" style="padding:10px 20px; font-size:0.85rem;">@onboarded.Count airlines</div>
        }
    }
    else if (subTab == "dcs")
    {
        <div class="dx-text-muted" style="padding:10px 20px; font-size:0.85rem; border-bottom:1px solid var(--dx-border-color,#eee);">
            Demo preview &mdash; departure control system providers used by onboarded airlines.
        </div>
        <div class="dx-table" style="border-left:none; border-right:none;">
            <div class="dx-table-header" style="grid-template-columns: 200px 1fr;">
                <div>Provider</div>
                <div>Airlines</div>
            </div>
            @foreach (var g in onboarded.GroupBy(a => ExtraFor(a.Code).Dcs))
            {
                <div class="dx-table-row" style="grid-template-columns: 200px 1fr;">
                    <div>@g.Key</div>
                    <div>@string.Join(", ", g.Select(a => a.Name))</div>
                </div>
            }
        </div>
    }
    else if (subTab == "alliances")
    {
        <div class="dx-text-muted" style="padding:10px 20px; font-size:0.85rem; border-bottom:1px solid var(--dx-border-color,#eee);">
            Demo preview &mdash; alliance membership of onboarded airlines.
        </div>
        <div class="dx-table" style="border-left:none; border-right:none;">
            <div class="dx-table-header" style="grid-template-columns: 200px 1fr;">
                <div>Alliance</div>
                <div>Airlines</div>
            </div>
            @foreach (var g in onboarded.GroupBy(a => ExtraFor(a.Code).Alliance))
            {
                <div class="dx-table-row" style="grid-template-columns: 200px 1fr;">
                    <div>@g.Key</div>
                    <div>@string.Join(", ", g.Select(a => a.Name))</div>
                </div>
            }
        </div>
    }
    else if (subTab == "logos")
    {
        <div class="dx-text-muted" style="padding:10px 20px; font-size:0.85rem; border-bottom:1px solid var(--dx-border-color,#eee);">
            Demo preview &mdash; the wordmark chain every airline uploads to; GTAA admins approve new logos here.
        </div>
        <div style="padding:16px 20px; display:flex; flex-wrap:wrap; gap:16px;">
            @foreach (var a in onboarded)
            {
                var extra = ExtraFor(a.Code);
                <div style="width:160px; border:1px solid var(--dx-border-color,#dee2e6); border-radius:6px; overflow:hidden;">
                    <div style="height:70px; background:@extra.WordmarkColor; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; text-align:center; padding:4px;">@a.Name</div>
                    <div style="padding:8px; font-size:0.8rem; display:flex; justify-content:space-between; align-items:center;">
                        @a.Code
                        <span class="dx-badge @(extra.WordmarkStatus == "Approved" ? "dx-badge-green" : extra.WordmarkStatus == "Pending" ? "dx-badge-orange" : "dx-badge-gray")">@extra.WordmarkStatus</span>
                    </div>
                </div>
            }
        </div>
    }

    </div>

    @if (onboarded.Count > 0 && !isViewOnlyAirlines)
    {
        <div style="padding:10px 20px; border-top:1px solid var(--dx-border-color,#eee); flex-shrink:0;">
            <button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="PreviewSupervisor">Preview: sign in as airline supervisor</button>
            <span class="dx-text-muted" style="font-size:0.8rem; margin-left:8px;">Demo only &mdash; shows what an airline-scoped user would see, without a separate login.</span>
        </div>
    }
}
else if (viewMode == "wizard")
{
    <AddAirlineWizard OnCancel="CloseAddAirline" OnCreated="HandleAirlineCreated" />
}
else if (viewMode == "supervisor")
{
    @* ---- Restricted view: what an airline-scoped supervisor would see ---- *@
    <div class="dx-panel-header">
        <h4>Airlines</h4>
        @if (!isRealAirlineScope)
        {
            <button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="ExitSupervisorPreview">Exit preview</button>
        }
    </div>
    <div class="dx-text-muted" style="padding:10px 20px; font-size:0.85rem; border-bottom:1px solid var(--dx-border-color,#eee);">
        @if (isRealAirlineScope)
        {
            @:Signed in as @(SessionState.User?.FriendlyName ?? SessionState.UserName). You see @supervisorTarget!.Name only, the airline whose user group you are in.
        }
        else
        {
            @:You see @supervisorTarget!.Name only, the airline whose user group you are in.
        }
    </div>
    <div class="dx-panel-content" style="flex:1; min-height:0; overflow-y:auto; padding:0;">
        <div class="dx-table" style="border-left:none; border-right:none;">
            <div class="dx-table-header" style="@SupervisorGridCols">
                <div>Airline</div>
                <div>IATA</div>
                <div>ICAO</div>
                <div>Alliance</div>
                <div>Status</div>
                <div></div>
            </div>
            @{ var extraSup = ExtraFor(supervisorTarget.Code); }
            <div class="dx-table-row" style="@SupervisorGridCols">
                <div style="display:flex; align-items:center; gap:10px; min-width:0;">
                    <div class="al-tile" style="background:@ColorFor(supervisorTarget.Code);">@supervisorTarget.Code</div>
                    <a href="javascript:void(0)" @onclick="() => OpenProfile(supervisorTarget, true)">@supervisorTarget.Name</a>
                </div>
                <div>@supervisorTarget.Code</div>
                <div>@(supervisorTarget.Icao ?? "—")</div>
                <div>@extraSup.Alliance</div>
                <div><span class="dx-badge dx-badge-green">Active</span></div>
                <div style="text-align:right;"><button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="() => OpenProfile(supervisorTarget, true)">OPEN</button></div>
            </div>
        </div>
    </div>
}
else
{
    @* ---- Airline profile ---- *@
    var extra = ExtraFor(profileAirline!.Code);
    <div class="dx-panel-header">
        <div style="display:flex; align-items:center; gap:12px;">
            @if (!isRealAirlineScope)
            {
                <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="CloseProfile">&larr;</button>
            }
            <div class="al-tile al-tile-lg" style="background:@ColorFor(profileAirline.Code);">@profileAirline.Code</div>
            <h4 style="margin:0;">@profileAirline.Name</h4>
            <span class="dx-badge dx-badge-green">Active</span>
        </div>
        @if (!isSupervisorPreview && !isRealAirlineScope && !isViewOnlyAirlines)
        {
            <button class="dx-btn dx-btn-outline-red dx-btn-sm" @onclick="Deactivate">Remove from active list</button>
        }
    </div>

    @if (isViewOnlyAirlines)
    {
        <div class="dx-alert dx-alert-info" style="margin:12px 20px;">
            You have view-only access here &mdash; you can look, but not upload logos, change templates or remove an airline.
        </div>
    }
    else if (isRealAirlineScope)
    {
        <div class="dx-alert dx-alert-info" style="margin:12px 20px;">
            Signed in as @(SessionState.User?.FriendlyName ?? SessionState.UserName).
            You see @profileAirline.Name's Branding and Counter templates only. The rest of the airline profile is for GTAA admins.
        </div>
    }
    else if (isSupervisorPreview)
    {
        <div class="dx-alert dx-alert-info" style="margin:12px 20px;">
            Signed in as @(DemoSupervisorNames.TryGetValue(profileAirline.Code, out var n) ? n : "Airline User").
            You see @profileAirline.Name's Branding and Counter templates only. The rest of the airline profile is for GTAA admins.
        </div>
    }

    <div class="dx-tab-nav" style="border-radius:0; overflow:hidden; flex-shrink:0;">
        @if (isAdminProfile)
        {
            <button class="dx-tab-btn @(profileTab == "identity" ? "active" : "")" @onclick="@(() => profileTab = "identity")">Identity</button>
        }
        <button class="dx-tab-btn @(profileTab == "branding" ? "active" : "")" @onclick="@(() => profileTab = "branding")">Branding</button>
        @if (isAdminProfile)
        {
            <button class="dx-tab-btn @(profileTab == "cupps" ? "active" : "")" @onclick="@(() => profileTab = "cupps")">CUPPS options</button>
            <button class="dx-tab-btn @(profileTab == "dcs" ? "active" : "")" @onclick="@(() => profileTab = "dcs")">DCS</button>
        }
        <button class="dx-tab-btn @(profileTab == "templates" ? "active" : "")" @onclick="@(() => profileTab = "templates")">Counter templates</button>
        @if (isAdminProfile)
        {
            <button class="dx-tab-btn @(profileTab == "users" ? "active" : "")" @onclick="@(() => profileTab = "users")">Users</button>
        }
    </div>

    <div class="dx-panel-content" style="flex:1; min-height:0; overflow-y:auto;">
        @if (profileTab == "identity" && isAdminProfile)
        {
            <div class="dx-form-group" style="padding:16px 20px;">
                <div style="display:flex; gap:16px; margin-bottom:12px;">
                    <div style="flex:1;">
                        <label class="dx-form-label">Airline name (English)</label>
                        <input class="dx-form-control" value="@(string.IsNullOrEmpty(extra.NameEn) ? profileAirline.Name : extra.NameEn)" @onchange="e => extra.NameEn = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div style="flex:1;">
                        <label class="dx-form-label">Airline name (French)</label>
                        <input class="dx-form-control" value="@(string.IsNullOrEmpty(extra.NameFr) ? profileAirline.Name : extra.NameFr)" @onchange="e => extra.NameFr = e.Value?.ToString() ?? string.Empty" />
                    </div>
                </div>

                <div style="display:flex; gap:16px; margin-bottom:16px;">
                    <div style="flex:1;">
                        <label class="dx-form-label">IATA code</label>
                        <input class="dx-form-control" value="@profileAirline.Code" disabled />
                    </div>
                    <div style="flex:1;">
                        <label class="dx-form-label">ICAO code</label>
                        <input class="dx-form-control" value="@(profileAirline.Icao ?? "")" disabled />
                    </div>
                    <div style="flex:1;">
                        <label class="dx-form-label">Name shown in CUPPS</label>
                        <input class="dx-form-control" value="@(string.IsNullOrEmpty(extra.CuppsName) ? profileAirline.Name : extra.CuppsName)" @onchange="e => extra.CuppsName = e.Value?.ToString() ?? string.Empty" />
                    </div>
                </div>

                <div style="margin-bottom:16px; max-width:420px;">
                    <label class="dx-form-label">Alliance</label>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <select class="dx-form-control" @bind="extra.Alliance" style="flex:1;">
                            @foreach (var a in AllianceOptions)
                            {
                                <option value="@a">@a</option>
                            }
                        </select>
                        @if (extra.Alliance != "None")
                        {
                            <span style="background:#111; color:#fff; border-radius:4px; padding:6px 10px; font-size:0.72rem; font-weight:700; letter-spacing:0.04em; white-space:nowrap;">
                                &#9678; @extra.Alliance.ToUpperInvariant()
                            </span>
                        }
                    </div>
                    <div class="dx-text-muted" style="font-size:0.78rem; margin-top:4px;">Its footer logo shows in the upper left of the screen footer at every counter this airline holds.</div>
                </div>

                <div style="margin-bottom:16px;">
                    <label class="dx-form-label">Operates in</label>
                    <div style="display:flex; gap:20px;">
                        <label><input type="checkbox" @bind="extra.Terminal1" /> Terminal 1</label>
                        <label><input type="checkbox" @bind="extra.Terminal3" /> Terminal 3</label>
                    </div>
                    <div class="dx-text-muted" style="font-size:0.78rem; margin-top:4px;">Limits which counters and zones appear for this airline. Counters themselves come from the RMS allocation feed.</div>
                </div>

                <div>
                    <label class="dx-form-label">Status</label>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <label class="dx-toggle">
                            <input type="checkbox" checked="@extra.IsActive" @onchange="@(e => extra.IsActive = e.Value is true)" />
                            <span class="dx-toggle-slider"></span>
                        </label>
                        <span>@(extra.IsActive ? "Active. Available in CUPPS once a counter is allocated." : "Inactive.")</span>
                    </div>
                </div>
            </div>
        }
        else if (profileTab == "branding")
        {
            @if (isAdminProfile)
            {
                <div class="dx-alert dx-alert-info" style="font-size:0.85rem; margin-bottom:12px;">
                    One slot per logo role. Each role draws from its own airport-wide Asset Library, set on Logo libraries: choose an approved logo already there, or upload one into it. Uploads are approved on that library's chain (GTAA admins), not the airline's. You have approval bypass, so an upload is approved when you save, and logged.
                </div>
            }
            else
            {
                <div class="dx-text-muted" style="font-size:0.85rem; margin-bottom:12px;">
                    Demo preview &mdash; each upload would go to GTAA for approval. The logo on screen stays until GTAA approves the new one.
                </div>
            }

            @LogoCard("Wordmark", false, "Airline wordmarks", extra.WordmarkStatus, "wordmark", "1200 x 400", "90 KB",
                new[] { "1200 x 400", "400 x 200", "4000 x 1333, 7.7 MB", "1000 x 400" })

            @LogoCard("Square mark (optional)", true, "Airline square marks", extra.SquareMarkStatus, "square", "512 x 512", "30 KB",
                new[] { "512 x 512", "600 x 300", "128 x 128" },
                "Shown in the CUPPS header and on counter tiles. The library's constraint: the same shape as 256 x 256, that size or larger. PNG or SVG with a transparent background, up to 1 MB.")

            @LogoCard("Reversed wordmark (optional)", true, "Airline reversed wordmarks", extra.ReversedWordmarkStatus, "reversed", "1200 x 400", "",
                new[] { "1200 x 400" },
                "For dark backgrounds. The library's constraint: the same shape as 1200 x 400, that size or larger. PNG or SVG with a transparent background, up to 5 MB.")

            @if (extra.Alliance != "None")
            {
                <div style="border:1px solid var(--dx-border-color,#dee2e6); border-radius:6px; padding:16px; max-width:640px; margin-bottom:16px;">
                    <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:8px;">Alliance</div>
                    <div style="display:flex; align-items:center; gap:14px;">
                        <div style="background:#111; color:#fff; border-radius:6px; padding:14px 18px; text-align:center; min-width:120px;">
                            <div style="font-size:1.4rem;">&#9678;</div>
                            <div style="font-weight:700; font-size:0.8rem; letter-spacing:0.05em;">@extra.Alliance.ToUpperInvariant()</div>
                        </div>
                        <div style="font-size:0.85rem;">
                            <strong>@extra.Alliance.</strong> Its footer logo shows in the counter footer at every counter @profileAirline.Name holds.<br />
                            <span class="dx-text-muted">Set by GTAA. Contact GTAA to change the alliance or its logo.</span>
                        </div>
                    </div>
                </div>
            }

            <div style="border:1px solid var(--dx-border-color,#dee2e6); border-radius:6px; padding:16px; max-width:640px; margin-bottom:16px;">
                <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:10px;">Standard template colours</div>
                <div style="display:flex; gap:40px; margin-bottom:8px;">
                    <div>
                        <div class="dx-text-muted" style="font-size:0.8rem; margin-bottom:4px;">Background</div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="width:22px; height:22px; border-radius:4px; display:inline-block; background:@extra.WordmarkColor; border:1px solid #ccc;"></span>
                            <span>@extra.WordmarkColor</span>
                        </div>
                    </div>
                    <div>
                        <div class="dx-text-muted" style="font-size:0.8rem; margin-bottom:4px;">Text</div>
                        <span>Automatic (best contrast)</span>
                    </div>
                </div>
                <div class="dx-text-muted" style="font-size:0.8rem;">Set by GTAA.</div>
            </div>

            <div style="border:1px solid var(--dx-border-color,#dee2e6); border-radius:6px; padding:16px; max-width:640px; margin-bottom:16px;">
                <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:10px;">Preview</div>
                <div style="height:110px; background:@extra.WordmarkColor; color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:4px;">
                    <div style="font-size:1.4rem; font-weight:800;">@profileAirline.Name.ToUpperInvariant()</div>
                    <div style="font-size:0.95rem;">Check-In</div>
                    <div style="font-size:0.8rem;">Enregistrement</div>
                </div>
                <div class="dx-text-muted" style="font-size:0.8rem; margin-top:8px;">
                    Standard template, full screen. Shows the approved wordmark until a new one is approved.
                </div>
            </div>

            <div class="dx-text-muted" style="font-size:0.8rem;">Created 2026-09-02. Changes apply to CUPPS when saved.</div>
        }
        else if (profileTab == "cupps" && isAdminProfile)
        {
            <div style="padding:16px 20px;">
            <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:8px;">Flag options agents can show</div>
            <div style="margin-bottom:6px;">
                <label style="margin-right:16px;"><input type="checkbox" @bind="extra.FlagCanada" /> Canada</label>
                <label style="margin-right:16px;"><input type="checkbox" @bind="extra.FlagUnitedStates" /> United States</label>
                <label><input type="checkbox" @bind="extra.FlagInternational" /> International</label>
            </div>
            <div class="dx-text-muted" style="font-size:0.78rem; margin-bottom:20px;">"None" is always available.</div>

            <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:10px;">Features in CUPPS</div>

            <div style="display:flex; justify-content:space-between; align-items:flex-start; max-width:640px; padding:10px 0; border-bottom:1px solid var(--dx-border-color,#eee);">
                <div style="padding-right:16px;">
                    <strong>International Sunflower option</strong>
                    <div class="dx-text-muted" style="font-size:0.8rem;">Agents can add the Sunflower symbol to the counter screen footer, after the alliance logo.</div>
                </div>
                <label class="dx-toggle">
                    <input type="checkbox" checked="@extra.SunflowerOption" @onchange="@(e => extra.SunflowerOption = e.Value is true)" />
                    <span class="dx-toggle-slider"></span>
                </label>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:flex-start; max-width:640px; padding:10px 0; border-bottom:1px solid var(--dx-border-color,#eee);">
                <div style="padding-right:16px;">
                    <strong>ASL videos</strong>
                    <div class="dx-text-muted" style="font-size:0.8rem;">Agents can turn on ASL videos. They play on full screen displays only.</div>
                </div>
                <label class="dx-toggle">
                    <input type="checkbox" checked="@extra.AslVideos" @onchange="@(e => extra.AslVideos = e.Value is true)" />
                    <span class="dx-toggle-slider"></span>
                </label>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:flex-start; max-width:640px; padding:10px 0; margin-bottom:16px;">
                <div style="padding-right:16px;">
                    <strong>Destination Zone</strong>
                    <div class="dx-text-muted" style="font-size:0.8rem;">Agents can enter a destination on dedicated counters. Where it is allowed is set in Business Rules.</div>
                </div>
                <label class="dx-toggle">
                    <input type="checkbox" checked="@extra.DestinationZone" @onchange="@(e => extra.DestinationZone = e.Value is true)" />
                    <span class="dx-toggle-slider"></span>
                </label>
            </div>

            <div class="dx-text-muted" style="font-size:0.78rem;">
                Screens always show English and French. Who may post free text is a role permission, set on Settings &gt; Roles. Counter templates are set up on the airline's Counter templates tab after it is created.
            </div>
            </div>
        }
        else if (profileTab == "dcs" && isAdminProfile)
        {
            <div style="padding:16px 20px;">
            <div style="display:flex; gap:16px;">
                <div style="flex:1; max-width:320px; border:2px solid @(extra.Dcs == "Airline" ? "#0d6efd" : "var(--dx-border-color,#dee2e6)"); border-radius:6px; padding:16px; cursor:pointer;" @onclick="@(() => SetDcsMode(extra, false))">
                    <strong>Airline</strong>
                    <div class="dx-text-muted" style="font-size:0.85rem; margin-top:6px;">Agents sign in to CUPPS with this airline's accounts at the counters it holds.</div>
                </div>
                <div style="flex:1; max-width:320px; border:2px solid @(extra.Dcs != "Airline" ? "#0d6efd" : "var(--dx-border-color,#dee2e6)"); border-radius:6px; padding:16px; cursor:pointer;" @onclick="@(() => SetDcsMode(extra, true))">
                    <strong>Operates under a DCS provider</strong>
                    <div class="dx-text-muted" style="font-size:0.85rem; margin-top:6px;">A ground handler such as @(extra.Dcs == "Airline" ? "Swissport" : extra.Dcs) checks passengers in. Its handlers act for this airline at the counters it holds.</div>
                </div>
            </div>
            <div class="dx-text-muted" style="font-size:0.8rem; margin-top:20px;">Created 2026-09-02. Changes apply to CUPPS when saved.</div>
            </div>
        }
        else if (profileTab == "users" && isAdminProfile)
        {
            var members = UsersFor(profileAirline!.Code);
            <div style="padding:16px 20px;">
            <div class="dx-panel-header" style="padding:0 0 10px;">
                <span></span>
                <button class="dx-btn dx-btn-blue dx-btn-sm">MANAGE MEMBERS</button>
            </div>
            <div class="dx-table" style="border-left:none; border-right:none;">
                <div class="dx-table-header" style="grid-template-columns: 2fr 120px 1fr;">
                    <div>Account</div>
                    <div>Kind</div>
                    <div>Role</div>
                </div>
                @foreach (var m in members)
                {
                    <div class="dx-table-row" style="grid-template-columns: 2fr 120px 1fr;">
                        <div>@m.Account</div>
                        <div>@m.Kind</div>
                        <div><span class="dx-badge dx-badge-gray">@m.Role</span></div>
                    </div>
                }
                @if (members.Count == 0)
                {
                    <div class="dx-table-row" style="grid-template-columns: 1fr;">
                        <div class="dx-text-muted" style="padding:16px; text-align:center;">No members yet.</div>
                    </div>
                }
            </div>
            <div class="dx-text-muted" style="font-size:0.8rem; margin-top:12px;">
                These are the members of the @profileAirline.Name user group. Shared counter accounts and Individual accounts are told apart by kind; agents and supervisors by role.
            </div>
            <div class="dx-text-muted" style="font-size:0.8rem; margin-top:16px;">Created 2026-09-02. Changes apply to CUPPS when saved.</div>
            </div>
        }
        else
        {
            var templates = TemplatesFor(profileAirline!.Code).Where(t => showRetired || !t.Retired).ToList();

            <div class="dx-panel-header">
                <h4 style="margin:0; font-size:1rem;">Counter templates</h4>
                <div class="dx-panel-controls" style="display:flex; align-items:center; gap:16px;">
                    <label style="font-size:0.85rem; display:flex; align-items:center; gap:6px; margin:0;">
                        <input type="checkbox" @bind="showRetired" /> Show retired
                    </label>
                    @if (!isViewOnlyAirlines)
                    {
                        <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="OpenCreateTemplate">CREATE COUNTER TEMPLATE</button>
                    }
                </div>
            </div>

            <div class="dx-text-muted" style="font-size:0.85rem; padding:10px 20px; border-bottom:1px solid var(--dx-border-color,#eee);">
                You see @profileAirline.Name's Counter templates only@(isViewOnlyAirlines ? "." : ". The rest of the airline profile is for GTAA admins.")
            </div>

            <div class="dx-table" style="border-left:none; border-right:none;">
                <div class="dx-table-header" style="@TemplateGridCols">
                    <div>Preview</div>
                    <div>Name shown in CUPPS</div>
                    <div>Type</div>
                    <div>Available</div>
                    <div>Status</div>
                    <div></div>
                </div>
                <div class="dx-table-group">@profileAirline.Name.ToUpperInvariant()</div>
                @foreach (var t in templates)
                {
                    <div class="dx-table-row" style="@TemplateGridCols">
                        <div>
                            <div style="width:70px; height:40px; border-radius:4px; background:@(t.Type == "Standard" ? "#111" : extra.WordmarkColor); color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.55rem; font-weight:700; text-align:center; padding:2px;">@t.NameEn</div>
                        </div>
                        <div>
                            <div style="font-weight:600;">@t.Name</div>
                            @if (!string.IsNullOrEmpty(t.Counters))
                            {
                                <div class="dx-text-muted" style="font-size:0.78rem;">Showing now at @t.Counters</div>
                            }
                        </div>
                        <div><span class="dx-badge @(t.Type == "Standard" ? "dx-badge-gray" : "dx-badge-blue")">@t.Type</span></div>
                        <div style="font-size:0.85rem;">
                            @(t.StartDate.ToString("MMM d, yyyy"))@(t.EndDate is { } end ? $" to {end:MMM d, yyyy}" : ", no end date")
                        </div>
                        <div style="display:flex; gap:4px; flex-wrap:wrap; align-items:flex-start;">
                            @if (t.Retired)
                            {
                                <span class="dx-badge dx-badge-gray">Retired</span>
                            }
                            else
                            {
                                @if (t.InCupps) { <span class="dx-badge dx-badge-green">In CUPPS</span> }
                                @if (t.IsDefault) { <span class="dx-badge dx-badge-blue">Default</span> }
                                @if (!string.IsNullOrEmpty(t.Status)) { <span class="dx-badge dx-badge-orange">@t.Status</span> }
                            }
                        </div>
                        <div style="text-align:right;">
                            @if (t.Type == "Standard" || isViewOnlyAirlines)
                            {
                                <button class="dx-btn dx-btn-outline-blue dx-btn-sm" @onclick="() => OpenViewTemplate(t)">VIEW</button>
                            }
                            else
                            {
                                <button class="dx-btn dx-btn-outline-blue dx-btn-sm" @onclick="() => OpenEditTemplate(t)">EDIT</button>
                            }
                        </div>
                    </div>
                }
                @if (templates.Count == 0)
                {
                    <div class="dx-table-row" style="grid-template-columns: 1fr;">
                        <div class="dx-text-muted" style="padding:16px; text-align:center;">No counter templates yet.</div>
                    </div>
                }
            </div>

            @if (isAdminProfile)
            {
                var firstCustom = templates.FirstOrDefault(t => t.Type == "Custom") ?? templates.FirstOrDefault();
                var libraryFiles = LibraryFilesFor(profileAirline.Code)
                    .Concat(DemoAirlineManualUploads.TryGetValue(profileAirline.Code, out var manual) ? manual : Enumerable.Empty<LibraryFileRow>())
                    .ToList();

                <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin:20px 0 10px;">Template libraries</div>
                <div class="dx-text-muted" style="font-size:0.8rem; margin-bottom:10px;">
                    Made when the airline was created, on the airline's own chain, in the instance default mode. The template's four image slots draw from them. Both require the tenant metadata field Language.
                </div>
                <div class="dx-table" style="border-left:none; border-right:none; margin-bottom:20px;">
                    <div class="dx-table-header" style="grid-template-columns: 2fr 120px 1fr 1fr 110px;">
                        <div>Template library</div>
                        <div>Size</div>
                        <div>Language field</div>
                        <div>Delivery</div>
                        <div></div>
                    </div>
                    <div class="dx-table-row" style="grid-template-columns: 2fr 120px 1fr 1fr 110px;">
                        <div>
                            <div style="font-weight:600;">@profileAirline.Name templates, full</div>
                            <div class="dx-text-muted" style="font-size:0.78rem;">Asset Library 2424 &middot; chain: @profileAirline.Name chain</div>
                        </div>
                        <div>1920 x 980</div>
                        <div>Language, required</div>
                        <div>
                            UNC share
                            <div class="dx-text-muted" style="font-size:0.78rem;">Ink backup: GTAA/@profileAirline.Name templates</div>
                        </div>
                        <div style="text-align:right;"><button class="dx-btn dx-btn-outline-blue dx-btn-sm">EDIT LOCATION</button></div>
                    </div>
                    <div class="dx-table-row" style="grid-template-columns: 2fr 120px 1fr 1fr 110px;">
                        <div>
                            <div style="font-weight:600;">@profileAirline.Name templates, half</div>
                            <div class="dx-text-muted" style="font-size:0.78rem;">Asset Library 2425 &middot; chain: @profileAirline.Name chain</div>
                        </div>
                        <div>960 x 980</div>
                        <div>Language, required</div>
                        <div>
                            UNC share
                            <div class="dx-text-muted" style="font-size:0.78rem;">Ink backup: none</div>
                        </div>
                        <div style="text-align:right;"><button class="dx-btn dx-btn-outline-blue dx-btn-sm">EDIT LOCATION</button></div>
                    </div>
                </div>

                @if (firstCustom is not null)
                {
                    <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:10px;">Custom Template "@firstCustom.Name": Image slots</div>
                    <div style="margin-bottom:16px;">
                        <span class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-right:10px;">Images</span>
                        <label style="margin-right:16px; font-size:0.9rem;">
                            <input type="radio" name="admin-imgmode" checked="@(extra.ImagesMode == "separate")" @onchange='() => SetImagesMode("separate")' />
                            Separate English and French images
                        </label>
                        <label style="font-size:0.9rem;">
                            <input type="radio" name="admin-imgmode" checked="@(extra.ImagesMode == "bilingual")" @onchange='() => SetImagesMode("bilingual")' />
                            One bilingual image
                        </label>
                    </div>
                    <div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:20px;">
                        @if (extra.ImagesMode == "separate")
                        {
                            @TemplateSlot("English, full", "English", "EN", "dx-badge-blue", "", "CHECK-IN", "full", extra)
                            @TemplateSlot("French, full", "French", "FR", "", "background:#eee5ff;color:#5b3dab;", "ENREGISTREMENT", "full", extra)
                        }
                        else
                        {
                            @TemplateSlot("Bilingual, full", "Bilingual", "BI", "dx-badge-gray", "", "CHECK-IN / ENREGISTREMENT", "full", extra)
                        }
                    </div>
                }

                <div class="dx-text-muted" style="font-size:0.8rem; margin-bottom:16px;">
                    A file uploaded in a slot is stamped with that slot's Language (EN slots English, FR slots French, a bilingual template's slots Bilingual). In the library the value is read-only, and it goes to the Ink copy as Ink metadata.
                </div>

                <div class="dx-text-muted" style="font-size:0.75rem; text-transform:uppercase; margin-bottom:10px;">In the two libraries</div>
                <div class="dx-table" style="border-left:none; border-right:none; margin-bottom:20px;">
                    <div class="dx-table-header" style="grid-template-columns: 1.6fr 110px 100px 1.6fr 1.4fr 1.2fr;">
                        <div>File</div>
                        <div>Size</div>
                        <div>Language</div>
                        <div>Set by</div>
                        <div>Ink metadata</div>
                        <div>Used in</div>
                    </div>
                    @foreach (var f in libraryFiles)
                    {
                        <div class="dx-table-row" style="grid-template-columns: 1.6fr 110px 100px 1.6fr 1.4fr 1.2fr;">
                            <div>
                                <div style="font-weight:600;">@f.File</div>
                                <div class="dx-text-muted" style="font-size:0.78rem;">@profileAirline.Name templates, @(f.Size == "1920 x 980" ? "full" : "half")</div>
                            </div>
                            <div>@f.Size</div>
                            <div><span class="dx-badge @(f.Language == "English" ? "dx-badge-blue" : f.Language == "French" ? "" : "dx-badge-green")" style="@(f.Language == "French" ? "background:#eee5ff;color:#5b3dab;" : "")">@f.Language</span></div>
                            <div style="font-size:0.82rem;">&#128274; @f.SetBy</div>
                            <div class="dx-text-muted" style="font-size:0.82rem;">@f.InkMetadata</div>
                            <div class="dx-text-muted" style="font-size:0.82rem;">@f.UsedIn</div>
                        </div>
                    }
                </div>

                <div style="border:1px solid var(--dx-border-color,#dee2e6); border-radius:6px; padding:16px; max-width:640px; margin-bottom:16px;">
                    <div style="font-weight:600; margin-bottom:10px;">Upload straight to a library</div>
                    <div style="display:flex; gap:16px; align-items:flex-end; margin-bottom:12px;">
                        <div style="flex:1;">
                            <label class="dx-form-label">Library</label>
                            <select class="dx-form-control" @bind="uploadLibraryChoice">
                                <option value="full">@profileAirline.Name templates, full</option>
                                <option value="half">@profileAirline.Name templates, half</option>
                            </select>
                        </div>
                        <div style="flex:1;">
                            <label class="dx-form-label">Language (required)</label>
                            <select class="dx-form-control" @bind="uploadLanguageChoice">
                                <option value="">Choose...</option>
                                <option value="English">English</option>
                                <option value="French">French</option>
                                <option value="Bilingual">Bilingual</option>
                            </select>
                        </div>
                    </div>
                    <button class="dx-btn dx-btn-blue dx-btn-sm" disabled="@string.IsNullOrEmpty(uploadLanguageChoice)" @onclick="UploadSampleToLibrary">UPLOAD SAMPLE FILE</button>
                    <div class="dx-text-muted" style="font-size:0.78rem; margin-top:8px;">Only here is Language picked by hand. After upload it is read-only.</div>
                </div>
            }
        }
    </div>
}

@if (viewTemplate is not null)
{
