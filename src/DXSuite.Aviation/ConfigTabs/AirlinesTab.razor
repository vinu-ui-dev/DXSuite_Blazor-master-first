</style>

@code {
    private sealed record AirlineRow(int RecordId, string Code, string Name, string? Icao, bool Shown, AirlineDetailDto Detail);

    /// <summary>The airline's profile as it is edited: read from the server when loaded, written back on Save changes.</summary>
    private sealed class AirlineExtra
    {
        public string Alliance = "None";
        public int? AllianceId;
        public string Dcs = "Airline";
        public int? DcsProviderId;
        public bool DcsProviderMode;
        public string WordmarkColor = "#0071BC";
        public string WordmarkStatus = "Not uploaded";
        public string SquareMarkStatus = "Not uploaded";
        public string ReversedWordmarkStatus = "No file";

        // Identity tab (admin profile)
        public string NameEn = "";
        public string NameFr = "";
        public string CuppsName = "";
        public HashSet<int> TerminalZoneIds = new();

        // CUPPS options tab (admin profile)
        public bool FlagCanada = true;
        public bool FlagUnitedStates = true;
        public bool FlagInternational = true;
        public bool SunflowerOption;
        public bool AslVideos = true;
        public bool DestinationZone = true;
    }

    private static AirlineExtra ExtraFrom(AirlineDetailDto d) => new()
    {
        Alliance = d.AllianceName ?? "None",
        AllianceId = d.AllianceId,
        Dcs = d.DcsProviderName ?? "Airline",
        DcsProviderId = d.DcsProviderId,
        DcsProviderMode = d.DcsProviderId is not null,
        WordmarkColor = string.IsNullOrWhiteSpace(d.BackgroundColour) ? "#0071BC" : d.BackgroundColour,
        NameEn = d.NameEnglish,
        NameFr = d.NameFrench,
        CuppsName = d.CuppsName,
        TerminalZoneIds = d.TerminalZoneIds.ToHashSet(),
        FlagCanada = d.IsCanada,
        FlagUnitedStates = d.IsUnitedStates,
        FlagInternational = d.IsInternational,
        SunflowerOption = d.SunflowerOption,
        AslVideos = d.AslVideos,
        DestinationZone = d.DestinationZone,
    };

    private AirlineLookupsDto lookups = AirlineLookupsDto.Empty;
    private readonly Dictionary<string, AirlineExtra> extras = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyDictionary<string, AirlineLogoState>> allLogoStates = new(StringComparer.OrdinalIgnoreCase);

    private bool showRetiredAirlines;
    private bool isSavingProfile;

    private bool isAdminUser => SessionState.RoleEnum == Roles.Role.Admin;
    private bool canEditProfile => isAdminProfile && !isViewOnlyAirlines && canManageAirlineListActions;

    // Members of the airline's user group
    private List<AirlineMemberDto> members = new();
    private bool membersLoading;
    private bool memberBusy;
    private string? memberError;
    private string candidateQuery = "";
    private string addRoleName = "";
    private List<AirlineMemberDto> candidates = new();
    private bool candidatesSearched;

    // Counter templates Director holds for the airline (read-only until the template API exists)
    private IReadOnlyList<Template> profileTemplates = [];
    private bool templatesLoading;
    private string? templatesError;

    private List<AirlineRow> allAirlines = new();
    private List<AirlineRow> onboarded = new();
    private List<AirlineRow> searchResults = new();
    private string searchTerm = "";
    private Microsoft.AspNetCore.Components.ElementReference searchInputRef;

    private string subTab = "airlines";
    private string viewMode = "list";
    private AirlineRow? profileAirline;
    private AirlineRow? supervisorTarget;
    private string profileTab = "branding";

    // Approvals happen in Director, so the Branding tab re-reads the links each time it is opened.
    private void OpenBrandingTab()
    {
        profileTab = "branding";
        if (profileAirline is not null) _ = LoadSavedLogosAsync(profileAirline.Code);
    }
    private bool isSupervisorPreview;
    private bool isRealAirlineScope;
    private bool isViewOnlyAirlines;

    private bool canSeeDcsProvidersTab;
    private bool canSeeAlliancesTab;
    private bool canSeeLogoLibrariesTab;
    private bool canSeeProfileIdentityTab;
    private bool canSeeProfileCuppsTab;
    private bool canSeeProfileDcsTab;
    private bool canSeeProfileUsersTab;
    private const string AirlineSupervisorRoleName = "Airline Supervisor";

    // The full 6-tab profile (Identity, Branding, CUPPS options, DCS, Counter templates, Users) is
    // only for GTAA Admin/Architect browsing the real cross-airline list — not the demo supervisor
    // preview, a real airline-scoped supervisor, or RMU's view-only pass, which all keep the
    // existing restricted 2-tab (Branding, Counter templates) profile.
    private bool isAdminProfile => !isRealAirlineScope && !isSupervisorPreview && !isViewOnlyAirlines;

    private bool canManageAirlineListActions =>
        SessionState.RoleEnum == Roles.Role.Admin ||
        SessionState.RoleEnum == Roles.Role.Architect;

    private bool CanUseAdminProfileTabs => isAdminProfile;
    private bool canShowAdminIdentityTab => CanUseAdminProfileTabs && canSeeProfileIdentityTab;
    private bool canShowAdminCuppsTab => CanUseAdminProfileTabs && canSeeProfileCuppsTab;
    private bool canShowAdminDcsTab => CanUseAdminProfileTabs && canSeeProfileDcsTab;
    private bool canShowAdminUsersTab => CanUseAdminProfileTabs && canSeeProfileUsersTab;

    private string statusMessage = "";
    private bool statusIsError;

    private const string AirlineGridCols = "grid-template-columns: 2.4fr 80px 80px 1.2fr 1.6fr 100px 100px;";
    private const string SupervisorGridCols = "grid-template-columns: 2fr 70px 70px 160px 90px 90px;";

    protected override async Task OnInitializedAsync()
    {
        logoLibrary = Services.GetService(typeof(IAirlineLogoLibrary)) as IAirlineLogoLibrary;
        if (logoLibrary != null)
        {
            uploaderParameters = new() { ["OnUploaded"] = EventCallback.Factory.Create<AirlineLogoFile>(this, OnLogoUploadedAsync) };
            try { libraryInfo = await logoLibrary.GetLibraryAsync(); }
            catch (Exception ex) { Logger.LogError(ex, "Could not read the airline logo library"); DXSuite.Shared.Logging.AirlineFileLog.Write($"[LOGO-LIB] reading the library failed: {DXSuite.Shared.Logging.AirlineFileLog.Describe(ex)}"); }
        }

        canSeeDcsProvidersTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlinesDcsProvidersTab);
        canSeeAlliancesTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlinesAlliancesTab);
        canSeeLogoLibrariesTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlinesLogoLibrariesTab);
        canSeeProfileIdentityTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlineProfileIdentityTab);
        canSeeProfileCuppsTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlineProfileCuppsTab);
        canSeeProfileDcsTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlineProfileDcsTab);
        canSeeProfileUsersTab = await SessionState.HasPermissionAsync(PermissionKeys.AirlineProfileUsersTab);

        await LoadAirlines();
        EnsureVisibleListTab();

        // GTAA FSD 1.2 3.2: "Airline supervisors see only their own airline and may upload or
        // replace its logos." Admin and Architect get the full cross-airline list (Architect is
        // this tab's own default-granted role); anyone else reaches this tab only via a role
        // explicitly granted config-tab:airlines (e.g. the Airline Supervisor custom role) and is
        // scoped to whichever onboarded airline their user group names, with no way back to the
        // full list — distinct from the "Preview: sign in as airline supervisor" button below,
        // which is an admin's own demo toggle, not a real restriction.
        if (SessionState.RoleEnum != Roles.Role.Admin && SessionState.RoleEnum != Roles.Role.Architect && SessionState.User is not null)
        {
            var myGroups = await UserGroupService.GetGroupsForUserAsync(SessionState.User.UserId);
            var myGroupNames = myGroups
                .Select(g => g.GroupName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .ToList();

            var myAirline = onboarded.FirstOrDefault(a =>
                myGroupNames.Any(g => string.Equals(g, a.Name, StringComparison.OrdinalIgnoreCase)
                                   || string.Equals(g, a.Code, StringComparison.OrdinalIgnoreCase)));

            if (myAirline is null)
            {
                var normalizedGroups = myGroupNames.Select(NormalizeAirlineKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
                myAirline = onboarded.FirstOrDefault(a =>
                    normalizedGroups.Contains(NormalizeAirlineKey(a.Name))
                    || normalizedGroups.Contains(NormalizeAirlineKey(a.Code)));
            }

            var isAirlineSupervisor = string.Equals(SessionState.ActualRoleName, AirlineSupervisorRoleName, StringComparison.OrdinalIgnoreCase);
            if (myAirline is null && isAirlineSupervisor && onboarded.Count == 1)
            {
                myAirline = onboarded[0];
            }

            if (myAirline != null)
            {
                isRealAirlineScope = true;
                supervisorTarget = myAirline;
                viewMode = "supervisor";
            }
            else if (isAirlineSupervisor)
            {
                isRealAirlineScope = true;
                supervisorTarget = null;
                onboarded.Clear();
                allAirlines.Clear();
                searchResults.Clear();
                viewMode = "supervisor";
            }
            else
            {
                // No airline-named group match (e.g. RMU, whose group is "RMU" not an airline name):
                // per the GTAA FSD 1.2 Alliances/Logo Roles screen (DXME-536), RMU sees the full
                // cross-airline list and can open any profile, but strictly to look, not to change.
                isViewOnlyAirlines = true;
            }
        }
    }

    private async Task LoadAirlines()
    {
        lookups = await AirlineApi.GetLookupsAsync();

        IReadOnlyList<AirlineDetailDto> details = [];
        try
        {
            details = await AirlineApi.GetAirlinesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load the airlines");
            statusMessage = DXSuite.Shared.Services.UserFacingError.From(ex, "The airlines could not be loaded right now. Please try again.");
            statusIsError = true;
        }

        extras.Clear();
        allAirlines = details
            .Where(d => !string.IsNullOrWhiteSpace(d.Code))
            .Select(d => new AirlineRow(
                d.AirlineId,
                d.Code.Trim().ToUpperInvariant(),
                string.IsNullOrWhiteSpace(d.NameEnglish) ? d.Code.Trim().ToUpperInvariant() : d.NameEnglish.Trim(),
                d.Icao,
                !d.Retired,
                d))
            .DistinctBy(a => a.Code)
            .OrderBy(a => a.Name)
            .ToList();

        foreach (var a in allAirlines) extras[a.Code] = ExtraFrom(a.Detail);
        onboarded = allAirlines.OrderBy(a => a.Name).ToList();
    }

    /// <summary>Re-reads the airlines from the server and keeps the open profile pointing at its fresh row.</summary>
    private async Task ReloadAirlinesAsync()
    {
        var openId = profileAirline?.RecordId;
        await LoadAirlines();
        if (openId is { } id) profileAirline = allAirlines.FirstOrDefault(a => a.RecordId == id) ?? profileAirline;
        if (profileAirline is not null) await LoadSavedLogosAsync(profileAirline.Code);
    }

    private static string NormalizeAirlineKey(string value)
    {
        var chars = value
            .Trim()
            .ToUpperInvariant()
            .Where(char.IsLetterOrDigit)
            .ToArray();
        return new string(chars);
    }

    private AirlineExtra ExtraFor(string code)
    {
        if (!extras.TryGetValue(code, out var extra))
        {
            extra = new AirlineExtra();
            extras[code] = extra;
        }
        return extra;
    }

    private string ColorFor(string code)
    {
        if (extras.TryGetValue(code, out var extra)) return extra.WordmarkColor;
        var hash = 0;
        foreach (var c in code) hash = hash * 31 + c;
        var hue = Math.Abs(hash) % 360;
        return $"hsl({hue},45%,38%)";
    }

    private string AllianceNameOf(int? id) => lookups.Alliances.FirstOrDefault(a => a.Id == id)?.Name ?? "None";

    private static string CreatedNote() => "Changes apply to CUPPS when saved.";

    private IEnumerable<(string Name, List<string> Airlines)> DcsGroups()
    {
        yield return ("Airline", onboarded.Where(a => a.Detail.DcsProviderId is null).Select(a => a.Name).ToList());
        foreach (var provider in lookups.DcsProviders)
            yield return (provider.Name, onboarded.Where(a => a.Detail.DcsProviderId == provider.Id).Select(a => a.Name).ToList());
    }

    private IEnumerable<(string Name, List<string> Airlines)> AllianceGroups()
    {
        yield return ("None", onboarded.Where(a => a.Detail.AllianceId is null).Select(a => a.Name).ToList());
        foreach (var alliance in lookups.Alliances)
            yield return (alliance.Name, onboarded.Where(a => a.Detail.AllianceId == alliance.Id).Select(a => a.Name).ToList());
    }

    private async Task OpenLogosSubTab()
    {
        subTab = "logos";
        foreach (var a in onboarded.ToList())
        {
            try { allLogoStates[a.Code] = await LogoLinks.LoadAsync(a.Code); }
            catch (Exception ex) { Logger.LogWarning(ex, "Could not read the logos of airline {Code}", a.Code); }
        }
    }

    private static void ToggleTerminal(AirlineExtra extra, int zoneId, bool on)
    {
        if (on) extra.TerminalZoneIds.Add(zoneId);
        else extra.TerminalZoneIds.Remove(zoneId);
    }

    private static void SetDcsMode(AirlineExtra extra, bool providerMode)
    {
        extra.DcsProviderMode = providerMode;
        if (!providerMode) extra.DcsProviderId = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        searchResults = searchTerm.Length < 2
            ? new List<AirlineRow>()
            : allAirlines
                .Where(a => a.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            a.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .OrderBy(a => a.Name)
                .Take(15)
                .ToList();
    }

    private async Task FocusSearch()
    {
        await searchInputRef.FocusAsync();
    }

    private async Task OpenAddAirline()
    {
        if (canManageAirlineListActions)
        {
            viewMode = "wizard";
        }
        else
        {
            await FocusSearch();
        }
    }

    private void CloseAddAirline()
