    protected override async Task OnInitializedAsync()
    {
        await LoadAirlines();

        isAirlineSupervisorRole = SessionState.ActualRoleId == 6
            || string.Equals(SessionState.ActualRoleName, "Director Airline_Supervisor", StringComparison.OrdinalIgnoreCase);

        // GTAA FSD 1.2 3.2: "Airline supervisors see only their own airline and may upload or
        // replace its logos." Admin and Architect get the full cross-airline list (Architect is
        // this tab's own default-granted role); anyone else reaches this tab only via a role
        // explicitly granted config-tab:airlines (e.g. the Airline Supervisor custom role) and is
        // scoped to whichever onboarded airline their user group names, with no way back to the
        // full list — distinct from the "Preview: sign in as airline supervisor" button below,
        // which is an admin's own demo toggle, not a real restriction.
        if (SessionState.RoleEnum != Roles.Role.Admin && SessionState.RoleEnum != Roles.Role.Architect && SessionState.User is not null)
        {
            var myGroups = await UserGroupService.GetGroupsForUserAsync(SessionState.User.UserId);
            var myAirline = onboarded.FirstOrDefault(a =>
                myGroups.Any(g => string.Equals(g.GroupName, a.Name, StringComparison.OrdinalIgnoreCase)));
            if (myAirline != null)
            {
                isRealAirlineScope = true;
                supervisorTarget = myAirline;
                viewMode = "supervisor";
            }
            else
            {
                // No airline-named group match (e.g. RMU, whose group is "RMU" not an airline name):
                // per the GTAA FSD 1.2 Alliances/Logo Roles screen (DXME-536), RMU sees the full
                // cross-airline list and can open any profile, but strictly to look, not to change.
                isViewOnlyAirlines = true;
            }
        }
    }

    private async Task LoadAirlines()
    {
        await using var db = await AviationDbFactory.CreateDbContextAsync();

        // Project only the real columns present on this database's tblAirline table.
        // Several columns on the shared TblAirline entity (logo path, status flags,
        // PIN fields) don't exist on this environment's table, so selecting the full
        // entity throws. See CounterAllocations.razor.cs for the same pattern.
        var rows = await db.TblAirlines
            .Select(a => new { a.RecordId, a.AirlineCode, a.CarrierName, a.Icao, a.DisplayWithinSettingsMenu })
            .ToListAsync();

        allAirlines = rows
            .Select(r => new AirlineRow(r.RecordId, r.AirlineCode, string.IsNullOrWhiteSpace(r.CarrierName) ? r.AirlineCode : r.CarrierName!, r.Icao, r.DisplayWithinSettingsMenu))
            .ToList();

        onboarded = allAirlines.Where(a => a.Shown).OrderBy(a => a.Name).ToList();
    }

    private AirlineExtra ExtraFor(string code)
    {
        if (!DemoExtras.TryGetValue(code, out var extra))
        {
            extra = new AirlineExtra();
            DemoExtras[code] = extra;
        }
        return extra;
    }

    private static string ColorFor(string code)
    {
        if (DemoExtras.TryGetValue(code, out var extra)) return extra.WordmarkColor;
        var hash = 0;
        foreach (var c in code) hash = hash * 31 + c;
        var hue = Math.Abs(hash) % 360;
        return $"hsl({hue},45%,38%)";
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        searchResults = searchTerm.Length < 2
            ? new List<AirlineRow>()
            : allAirlines
                .Where(a => a.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            a.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .OrderBy(a => a.Name)
                .Take(15)
                .ToList();
    }

