        viewMode = "list";
    }

    private async Task HandleAirlineCreated(AddAirlineWizard.NewAirlineResult result)
    {
        await LoadAirlines();

        statusMessage = result.Warning ?? $"{result.Name} created.";
        statusIsError = result.Warning is not null;

        var row = allAirlines.FirstOrDefault(a => a.RecordId == result.RecordId);
        if (row is null) { viewMode = "list"; return; }
