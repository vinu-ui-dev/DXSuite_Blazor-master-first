    private static string AssetPath(string code, string lang, string size)
    {
        var hash = 0;
        foreach (var c in code + lang + size) hash = hash * 31 + c;
        var folder = Math.Abs(code.GetHashCode()) % 900 + 100;
        var suffix = (Math.Abs(hash) % 0xffff).ToString("x4");
        return $@"\\gtaa-dxmedia\MediaAssets\2424\{folder}\checkin-{lang.ToLowerInvariant()}-{size}-{suffix}.png";
    }

    private static string LibraryAssetPath(string kind, string code)
    {
        var hash = 0;
        foreach (var c in code + kind) hash = hash * 31 + c;
        var sub = Math.Abs(code.GetHashCode()) % 90 + 10;
        var suffix = (Math.Abs(hash) % 0xffff).ToString("x4");
        return $@"\\gtaa-dxmedia\MediaAssets\2301\{sub}\{kind}-{code.ToLowerInvariant()}-{suffix}.png";
    }

