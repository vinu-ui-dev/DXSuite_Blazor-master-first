@page "/slc/screenshots"
@rendermode InteractiveServer
@using DXSuite.SLC.Data
@using DXSuite.SLC.Components.Modals
@using DXSuite.Shared.Multitenancy
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject ITenantContext TenantContext
@implements IDisposable

<h3>Display View</h3>
<div id="mainContent" class="container" style="margin-top: 50px;">
    @if (brightsignDevices == null)
    {
        <div class="loading-overlay">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div style="position:absolute; left:40px; top:100px;">
            <H1 style="color:#dfdfdf">Player Count: @brightsignDevices.Count.ToString()</H1>
        </div>
        <div style="display:flex; flex-wrap:wrap;">
            @foreach (ViewLastMonitor deviceRecord in brightsignDevices)
            {
                @if (deviceRecord.ValueVarchar != null && deviceRecord.ValueVarchar != "")
                {
                    <div style="padding:10px; height:170px; width:212px; background-color:#DFDFDF;margin:2px; border-radius:8px;">
                        <img style="height:108px; width:192px;@((deviceRecord.DeviceHeartbeat > DateTime.Now.AddMinutes(-10))?"border:solid 3px #51b848;":"border:solid 3px #ed2024;") cursor:pointer;"
                             src="@deviceRecord.ValueVarchar"
                             @onclick="() => OpenScreenshotModal(deviceRecord.DeviceId)"/>
                        <div style="width:192px;padding-top:5px;padding-bottom:10px;">
                            <a target="blank" href="@String.Format("http://{0}",deviceRecord.Ipaddress)">@deviceRecord.DeviceDescription</a>
                            <a target="blank" href="@String.Format("http://{0}",deviceRecord.Ipaddress)" style="float:right; font-size:8px;">@deviceRecord.Ipaddress</a>
                            <br />
                            <text style="@((deviceRecord.LocalHeartbeat > DateTime.Now.AddMinutes(-10))?"color:#51b848;":"color:#ed2024;")">@deviceRecord.LocalHeartbeat.ToString()</text>
                        </div>
                    </div>
                }
                else if (deviceRecord.ValueVarbinary != null && deviceRecord.ValueVarbinary.Length > 0)
                {
                    <div style="padding:10px; height:170px; width:212px; background-color:#DFDFDF;margin:2px; border-radius:8px;">
                        <img style="height:108px; width:192px;@((deviceRecord.DeviceHeartbeat > DateTime.Now.AddMinutes(-10))?"border:solid 3px #51b848;":"border:solid 3px #ed2024;") cursor:pointer;"
                             src="@GetImageSource(deviceRecord.ValueVarbinary, "image/png")"
                             @onclick="() => OpenScreenshotModal(deviceRecord.DeviceId)" />
                        <div style="width:192px;padding-top:5px;padding-bottom:10px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">
                            <text>@deviceRecord.DeviceDescription</text><br/>
                            <text style="@((deviceRecord.LocalHeartbeat > DateTime.Now.AddMinutes(-10))?"color:#51b848;":"color:#ed2024;")">@deviceRecord.LocalHeartbeat.ToString()</text>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
<ScreenshotModal @ref="screenshotModal" />

@code {
    private IList<ViewLastMonitor>? brightsignDevices;
    private Timer? refreshTimer;
    private ScreenshotModal? screenshotModal;
    private string? customerId;

    protected override async Task OnInitializedAsync()
    {
        customerId = TenantContext.IsPopulated ? TenantContext.CustomerCode : null;
        if (customerId is not null)
        {
            brightsignDevices = await GetBrightSignPlayersAsync(customerId);
            refreshTimer = new Timer(RefreshData, null, 30000, 30000);
        }
    }

    private async Task<IList<ViewLastMonitor>> GetBrightSignPlayersAsync(string custId)
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<SlcPulseDbContext>();
        return await db.ViewLastMonitors
            .AsNoTracking()
            .Where(x => x.CustomerId == custId && x.MonitorItemId == 10)
            .OrderBy(y => y.DeviceDescription)
            .ToListAsync();
    }

    private async void RefreshData(object? _)
    {
        if (customerId is not null)
        {
            brightsignDevices = await GetBrightSignPlayersAsync(customerId);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenScreenshotModal(string deviceId)
    {
        if (screenshotModal != null)
            await screenshotModal.Open(deviceId);
    }

    private string GetImageSource(byte[] bytes, string contentType = "image/png")
    {
        if (bytes == null || bytes.Length == 0) return string.Empty;
        return $"data:{contentType};base64,{Convert.ToBase64String(bytes)}";
    }

    public void Dispose() { refreshTimer?.Dispose(); }
}
