@using System.Xml
@inject IWebHostEnvironment env
@inject ITenantMediaPathResolver MediaPaths
@inject ILogger<PlaylistDisplay_ConcourseEntry> Logger
@rendermode InteractiveServer

@if (Location != null)
{
    @if (mediaFiles.Count > 0)
    {
        var mediaFile = mediaFiles[currentMediaIndex];

        <div style="@((ContentHeight != 0.0)? "height:" + (ContentHeight * ScaleFactor).ToString() + "px;":"") @((ContentWidth != 0)? "width:" + (ContentWidth * ScaleFactor).ToString() + "px;":"") background-color: black; overflow: hidden; position: relative; border: 1px solid #ccc; box-sizing: border-box;">

            @if (mediaFile.WebPath.ToUpper().Contains(".MP4") || mediaFile.WebPath.ToUpper().Contains(".AVI"))
            {
                <video src="@mediaFile.WebPath" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; object-position: center center;" autoplay muted loop />
            }
            else
            {
                <img src="@mediaFile.WebPath" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; object-position: center center;" />
            }

            @if (IsConcourseDisplay())
            {
                <div style="position: absolute; @GetClockPosition(); color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); font-family: Arial, sans-serif; z-index: 10;">
                    <div style="font-size: @(60 * ScaleFactor)px; font-weight: bold; line-height: 1;">@DateTime.Now.ToString("h:mm tt")</div>
                    <div style="font-size: @(50 * ScaleFactor)px; line-height: 1; margin-top: @(5 * ScaleFactor)px;">@DateTime.Now.ToString("MMMM d, yyyy")</div>
                </div>

                <div style="position: absolute; @GetGatePosition(); color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); font-family: Arial, sans-serif; font-size: @(72 * ScaleFactor)px; font-weight: bold; z-index: 10;">
                    @GetGateText()
                </div>
            }
        </div>
    }
    else
    {
        <div style="@((ContentHeight != 0.0)? "height:" + (ContentHeight * ScaleFactor).ToString() + "px;":"") @((ContentWidth != 0)? "width:" + (ContentWidth * ScaleFactor).ToString() + "px;":"") background-color: #333; overflow: hidden; position: relative; border: 1px solid #ccc; box-sizing: border-box; display: flex; align-items: center; justify-content: center; color: white; font-size: 12px;">
            <div style="text-align: center;">
                <div>No content for @PlaylistName</div>
                <div style="font-size: 10px; margin-top: 5px;">@((ContentWidth * ScaleFactor).ToString("F0"))x@((ContentHeight * ScaleFactor).ToString("F0"))px</div>
            </div>

            @if (IsConcourseDisplay())
            {
                <div style="position: absolute; @GetClockPosition(); color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); font-family: Arial, sans-serif; z-index: 10;">
                    <div style="font-size: @(60 * ScaleFactor)px; font-weight: bold; line-height: 1;">@DateTime.Now.ToString("h:mm tt")</div>
                    <div style="font-size: @(50 * ScaleFactor)px; line-height: 1; margin-top: @(5 * ScaleFactor)px;">@DateTime.Now.ToString("MMMM d, yyyy")</div>
                </div>

                <div style="position: absolute; @GetGatePosition(); color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); font-family: Arial, sans-serif; font-size: @(72 * ScaleFactor)px; font-weight: bold; z-index: 10;">
                    @GetGateText()
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public TblLocation? Location { get; set; }
    [Parameter] public string? PlaylistName { get; set; }
    [Parameter] public double ContentHeight { get; set; }
    [Parameter] public double ContentWidth { get; set; }
    [Parameter] public double ScaleFactor { get; set; }
    [Parameter] public int? ConstraintId { get; set; } = null;

    private string? baseDirectory;
    private List<MediaFile> mediaFiles = new List<MediaFile>();
    private int currentMediaIndex = 0;
    private bool isPlaying = true;

    protected override async Task OnInitializedAsync()
    {
        await UpdateMediaFiles();
        StartMediaLoop();
    }

    public async Task RefreshMediaFiles()
    {
        await UpdateMediaFiles();
        await InvokeAsync(StateHasChanged);
    }

    private async void StartMediaLoop()
    {
        while (isPlaying)
        {
            await Task.Delay(7000);
            if (mediaFiles.Count > 0)
            {
                currentMediaIndex = (currentMediaIndex + 1) % mediaFiles.Count;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task UpdateMediaFiles()
    {
        try
        {
            DateTime now = DateTime.Now;
            baseDirectory = MediaPaths.GetRoot();

            if (baseDirectory != null && Location != null)
            {
                string uploadDirectory = (IsConcourseDisplay() || ConstraintId == null)
                    ? Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString())
                    : Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString(), ConstraintId.ToString());

                List<MediaFile> tempMediaFiles = new List<MediaFile>();

                foreach (string file in System.IO.Directory.GetFiles(uploadDirectory, "", SearchOption.AllDirectories)
                    .Where(s => !s.EndsWith(".metadata") && !s.EndsWith(".db")))
                {
                    List<MetadataField> metadata = new List<MetadataField>();
                    string metadataFilePath = file + ".metadata";

                    if (System.IO.File.Exists(metadataFilePath))
                    {
                        XmlDocument doc = new XmlDocument();
                        doc.Load(metadataFilePath);
                        XmlNodeList nodes = doc.SelectNodes("usermetadata");

                        foreach (XmlNode node in nodes)
                        {
                            foreach (XmlNode line in node)
                            {
                                metadata.Add(new MetadataField
                                {
                                    Name = line.Attributes["name"].Value,
                                    DataType = line.Attributes["datatype"].Value,
                                    Value = line.Attributes["value"].Value
                                });
                            }
                        }
                    }

                    MetadataField? location = metadata.FirstOrDefault(x => x.Name == "Location");
                    if (location == null || location.Value != Location.LocationId.ToString()) continue;

                    MetadataField? displaysField = metadata.FirstOrDefault(x => x.Name == "Displays");
                    bool isForThisDisplay = displaysField == null
                        || displaysField.Value.Split(' ').Select(d => d.Trim()).Where(d => !string.IsNullOrEmpty(d)).Contains(PlaylistName);
                    if (!isForThisDisplay) continue;

                    MetadataField? endDate = metadata.FirstOrDefault(x => x.Name == "EndDate");
                    MetadataField? endTimeField = metadata.FirstOrDefault(x => x.Name == "EndTime");
                    bool isExpired = false;
                    DateTime? parsedEndDate = null;

                    if (endDate != null && DateTime.TryParse(endDate.Value, out DateTime parsedDate))
                    {
                        parsedEndDate = (endTimeField != null && TimeSpan.TryParse(endTimeField.Value, out TimeSpan endTimeSpan))
                            ? parsedDate.Date.Add(endTimeSpan)
                            : parsedDate.Date.AddDays(1).AddSeconds(-1);

                        if (parsedEndDate < now)
                            isExpired = true;
                    }

                    bool isWithinSchedule = true;
                    MetadataField? startTimeField = metadata.FirstOrDefault(x => x.Name == "StartTime");
                    if (startTimeField != null && endTimeField != null)
                    {
                        if (TimeSpan.TryParse(startTimeField.Value, out TimeSpan startTime) &&
                            TimeSpan.TryParse(endTimeField.Value, out TimeSpan endTime))
                        {
                            TimeSpan currentTime = now.TimeOfDay;
                            isWithinSchedule = startTime > endTime
                                ? currentTime >= startTime || currentTime <= endTime
                                : currentTime >= startTime && currentTime <= endTime;
                        }
                    }

                    MetadataField? startDate = metadata.FirstOrDefault(x => x.Name == "StartDate");
                    if (startDate != null && DateTime.TryParse(startDate.Value, out DateTime parsedStartDate))
                    {
                        if (now.Date < parsedStartDate.Date)
                            isWithinSchedule = false;
                    }

                    if (isExpired || !isWithinSchedule) continue;

                    string webPath = (IsConcourseDisplay() || ConstraintId == null)
                        ? $"/MediaAssets/{Location.LocationId}/{Path.GetFileName(file)}"
                        : $"/MediaAssets/{Location.LocationId}/{ConstraintId}/{Path.GetFileName(file)}";

                    tempMediaFiles.Add(new MediaFile
                    {
                        WebPath = webPath,
                        DiskPath = file,
                        Metadata = metadata,
                        IsExpired = isExpired,
                        EndDate = parsedEndDate,
                    });
                }

                mediaFiles = tempMediaFiles.OrderBy(x => x.EndDate ?? DateTime.MaxValue).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating media files");
        }
    }

    private string GetClockPosition() => PlaylistName switch
    {
        "ConcourseAWest" or "ConcourseBWest" => $"top: {10 * ScaleFactor}px; left: {10 * ScaleFactor}px;",
        _ => $"top: {10 * ScaleFactor}px; right: {10 * ScaleFactor}px;"
    };

    private string GetGatePosition() => PlaylistName switch
    {
        "ConcourseAWest" or "ConcourseBWest" => $"top: {10 * ScaleFactor}px; right: {10 * ScaleFactor}px;",
        _ => $"top: {10 * ScaleFactor}px; left: {10 * ScaleFactor}px;"
    };

    private string GetGateText() => PlaylistName switch
    {
        "ConcourseAWest" => "Gates A1-A25",
        "ConcourseAEast" => "Gates A26-A49",
        "ConcourseBWest" => "Gates B1-B22, B24",
        "ConcourseBEast" => "Gates B23, B25-B38",
        _ => "Gates"
    };

    private bool IsConcourseDisplay() => PlaylistName switch
    {
        "ConcourseAWest" or "ConcourseAEast" or "ConcourseBWest" or "ConcourseBEast" => true,
        _ => false
    };
}
