@code {
    [Parameter]
    public int? OverrideId { get; set; }

    private bool isLoading = true;
    private bool isAuthorized = false;
    private bool isSaving = false;
    private bool isNewOverride => !OverrideId.HasValue;
    private string? errorMessage;

    private string overrideName = "";
    private string? description;

    private bool isScheduled = false;
    private DateTime? startDate;
    private DateTime? endDate;
    private string? startTimeStr;
    private string? endTimeStr;
    private bool sunday, monday, tuesday, wednesday, thursday, friday, saturday;

    // Target mode: "displays" (default) or "devices"
    private string targetMode = "displays";

    private List<DeviceViewModel> allDevices = new();
    private HashSet<string> selectedDeviceIds = new();

    private List<DisplayViewModel> allDisplays = new();
    private HashSet<int> selectedDisplayIds = new();

    private string deviceSearchFilter = "";
    private bool showSelectedOnly = false;
    private string sortColumn = "DisplayName";
    private bool sortAscending = true;

    private List<ResolutionContent> resolutionContents = new();
    private bool showAddResolutionModal = false;
    private int newResolutionWidth = 1920;
    private int newResolutionHeight = 1080;

    private IEnumerable<DeviceViewModel> FilteredDevices
    {
        get
        {
            var filtered = allDevices.AsEnumerable();

            if (showSelectedOnly)
                filtered = filtered.Where(d => selectedDeviceIds.Contains(d.DeviceId));

            if (!string.IsNullOrWhiteSpace(deviceSearchFilter))
            {
                var filter = deviceSearchFilter.ToLower();
                filtered = filtered.Where(d =>
                    d.DeviceId.ToLower().Contains(filter) ||
                    (!string.IsNullOrEmpty(d.Description) && d.Description.ToLower().Contains(filter)) ||
                    (!string.IsNullOrEmpty(d.LocationName) && d.LocationName.ToLower().Contains(filter))
                );
            }

            filtered = sortColumn switch
            {
                "Status" => sortAscending
                    ? filtered.OrderByDescending(d => IsDeviceOnline(d.Heartbeat)).ThenBy(d => d.DeviceId)
                    : filtered.OrderBy(d => IsDeviceOnline(d.Heartbeat)).ThenBy(d => d.DeviceId),
                "DeviceId" => sortAscending
                    ? filtered.OrderBy(d => d.DeviceId)
                    : filtered.OrderByDescending(d => d.DeviceId),
                "Description" => sortAscending
                    ? filtered.OrderBy(d => d.Description ?? "").ThenBy(d => d.DeviceId)
                    : filtered.OrderByDescending(d => d.Description ?? "").ThenBy(d => d.DeviceId),
                "Location" => sortAscending
                    ? filtered.OrderBy(d => d.LocationName ?? "").ThenBy(d => d.DeviceId)
                    : filtered.OrderByDescending(d => d.LocationName ?? "").ThenBy(d => d.DeviceId),
                "Resolution" => sortAscending
                    ? filtered.OrderBy(d => d.DisplayWidth * d.DisplayHeight).ThenBy(d => d.DeviceId)
                    : filtered.OrderByDescending(d => d.DisplayWidth * d.DisplayHeight).ThenBy(d => d.DeviceId),
                _ => filtered.OrderBy(d => d.DeviceId)
            };

            return filtered;
        }
    }

    private IEnumerable<DisplayViewModel> FilteredDisplays
    {
        get
        {
            var filtered = allDisplays.AsEnumerable();

            if (showSelectedOnly)
                filtered = filtered.Where(d => selectedDisplayIds.Contains(d.DisplayId));

            if (!string.IsNullOrWhiteSpace(deviceSearchFilter))
            {
                var filter = deviceSearchFilter.ToLower();
                filtered = filtered.Where(d =>
                    d.DisplayName.ToLower().Contains(filter) ||
                    (!string.IsNullOrEmpty(d.LocationName) && d.LocationName.ToLower().Contains(filter))
                );
            }

            filtered = sortColumn switch
            {
                "DisplayName" => sortAscending
                    ? filtered.OrderBy(d => d.DisplayName)
                    : filtered.OrderByDescending(d => d.DisplayName),
                "Location" => sortAscending
                    ? filtered.OrderBy(d => d.LocationName ?? "").ThenBy(d => d.DisplayName)
                    : filtered.OrderByDescending(d => d.LocationName ?? "").ThenBy(d => d.DisplayName),
                "Resolution" => sortAscending
                    ? filtered.OrderBy(d => d.DisplayWidth * d.DisplayHeight).ThenBy(d => d.DisplayName)
                    : filtered.OrderByDescending(d => d.DisplayWidth * d.DisplayHeight).ThenBy(d => d.DisplayName),
                _ => filtered.OrderBy(d => d.DisplayName)
            };

            return filtered;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (sessionState != null && await sessionState.HasPermissionAsync(PermissionKeys.PageOverrides))
        {
            isAuthorized = true;
            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        try
        {
            var devices = await dbContext.TblDevices
                .AsNoTracking()
                .Include(d => d.Location)
                .Include(d => d.Display)
                .OrderBy(d => d.DeviceId)
                .ToListAsync();

            allDevices = devices.Select(d => new DeviceViewModel
            {
                DeviceId = d.DeviceId,
                Description = d.Description,
                LocationName = d.Location?.LocationName,
                DisplayWidth = d.Display?.DisplayWidth ?? 0,
                DisplayHeight = d.Display?.DisplayHeight ?? 0,
                Heartbeat = d.Heartbeat
            }).ToList();

            // Load all displays for display-targeting mode
            var displays = await dbContext.TblDisplays
                .AsNoTracking()
                .Include(d => d.Location)
                .Include(d => d.TblDevices)
                .OrderBy(d => d.DisplayName)
                .ToListAsync();

            allDisplays = displays.Select(d => new DisplayViewModel
            {
                DisplayId = d.DisplayId,
                DisplayName = d.DisplayName,
                LocationName = d.Location?.LocationName,
                DisplayWidth = d.DisplayWidth,
                DisplayHeight = d.DisplayHeight,
                DeviceCount = d.TblDevices.Count
            }).ToList();

            if (OverrideId.HasValue)
            {
                var existingOverride = await overrideService.GetOverrideByIdAsync(OverrideId.Value);
                if (existingOverride != null)
                {
                    overrideName = existingOverride.OverrideName;
                    description = existingOverride.Description;
                    isScheduled = existingOverride.IsScheduled;
                    startDate = existingOverride.StartDate;
                    endDate = existingOverride.EndDate;
                    startTimeStr = existingOverride.StartTime?.ToString("HH:mm");
                    endTimeStr = existingOverride.EndTime?.ToString("HH:mm");
                    sunday = existingOverride.Sunday;
                    monday = existingOverride.Monday;
                    tuesday = existingOverride.Tuesday;
                    wednesday = existingOverride.Wednesday;
                    thursday = existingOverride.Thursday;
                    friday = existingOverride.Friday;
                    saturday = existingOverride.Saturday;

                    var deviceIds = await overrideService.GetDeviceIdsForOverrideAsync(OverrideId.Value);
                    selectedDeviceIds = new HashSet<string>(deviceIds);

                    var displayIds = await overrideService.GetDisplayIdsForOverrideAsync(OverrideId.Value);
                    selectedDisplayIds = new HashSet<int>(displayIds);

                    // Restore the mode that was last used: default to displays unless only devices were saved
                    if (selectedDeviceIds.Count > 0 && selectedDisplayIds.Count == 0)
                        targetMode = "devices";
                    else
                        targetMode = "displays";

                    var contents = await overrideService.GetContentForOverrideAsync(OverrideId.Value);
                    foreach (var content in contents.Where(c => c.DeviceId == null))
                    {
                        resolutionContents.Add(new ResolutionContent
                        {
                            Width = content.ResolutionWidth,
                            Height = content.ResolutionHeight,
                            ContentPath = content.ContentPath,
                            AssetId = content.AssetId,
                            Duration = content.Duration,
                            DeviceCount = GetDeviceCountForResolution(content.ResolutionWidth, content.ResolutionHeight)
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private int GetDeviceCountForResolution(int width, int height)
    {
        if (targetMode == "displays")
        {
            return allDisplays.Count(d =>
                selectedDisplayIds.Contains(d.DisplayId) &&
                (int)d.DisplayWidth == width &&
                (int)d.DisplayHeight == height);
        }
        return allDevices.Count(d =>
            selectedDeviceIds.Contains(d.DeviceId) &&
            (int)d.DisplayWidth == width &&
            (int)d.DisplayHeight == height);
    }

    private void OnDeviceSearchChanged(ChangeEventArgs e)
    {
        deviceSearchFilter = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        StateHasChanged();
    }

    private MarkupString GetSortCaret(string column)
    {
        if (sortColumn != column)
            return new MarkupString("");

        var caret = sortAscending ? "&#9650;" : "&#9660;";
        return new MarkupString($"<span class=\"sort-caret\">{caret}</span>");
    }

    private void ToggleDeviceSelection(string deviceId)
    {
        if (selectedDeviceIds.Contains(deviceId))
            selectedDeviceIds.Remove(deviceId);
        else
            selectedDeviceIds.Add(deviceId);
        StateHasChanged();
    }

    private void ToggleDisplaySelection(int displayId)
    {
        if (selectedDisplayIds.Contains(displayId))
            selectedDisplayIds.Remove(displayId);
        else
            selectedDisplayIds.Add(displayId);
        StateHasChanged();
    }

    private void OnTargetModeChanged(ChangeEventArgs e)
    {
        var mode = e.Value?.ToString() ?? "displays";
        if (targetMode == mode) return;
        targetMode = mode;
        deviceSearchFilter = "";
        showSelectedOnly = false;
        sortColumn = mode == "devices" ? "DeviceId" : "DisplayName";
        sortAscending = true;
        StateHasChanged();
    }

    private void SelectAllFiltered()
    {
        if (targetMode == "devices")
        {
            foreach (var device in FilteredDevices)
                selectedDeviceIds.Add(device.DeviceId);
        }
        else
        {
            foreach (var display in FilteredDisplays)
                selectedDisplayIds.Add(display.DisplayId);
        }
        StateHasChanged();
    }

    private void UnselectAll()
    {
        if (targetMode == "devices")
            selectedDeviceIds.Clear();
        else
            selectedDisplayIds.Clear();
        StateHasChanged();
    }

    private void ToggleShowSelected()
    {
        showSelectedOnly = !showSelectedOnly;
        StateHasChanged();
    }

    private void DetectResolutions()
    {
        List<(int Width, int Height, int Count)> resolutions;

        if (targetMode == "displays")
        {
            resolutions = allDisplays
                .Where(d => selectedDisplayIds.Contains(d.DisplayId) && d.DisplayWidth > 0 && d.DisplayHeight > 0)
                .GroupBy(d => new { Width = (int)d.DisplayWidth, Height = (int)d.DisplayHeight })
                .Select(g => (Width: g.Key.Width, Height: g.Key.Height, Count: g.Count()))
                .ToList();
        }
        else
        {
            resolutions = allDevices
                .Where(d => selectedDeviceIds.Contains(d.DeviceId) && d.DisplayWidth > 0 && d.DisplayHeight > 0)
                .GroupBy(d => new { Width = (int)d.DisplayWidth, Height = (int)d.DisplayHeight })
                .Select(g => (Width: g.Key.Width, Height: g.Key.Height, Count: g.Count()))
                .ToList();
        }

        foreach (var res in resolutions)
        {
            if (!resolutionContents.Any(r => r.Width == res.Width && r.Height == res.Height))
            {
                resolutionContents.Add(new ResolutionContent
                {
                    Width = res.Width,
                    Height = res.Height,
                    DeviceCount = res.Count,
                    Duration = 7
                });
            }
            else
            {
                var existing = resolutionContents.First(r => r.Width == res.Width && r.Height == res.Height);
                existing.DeviceCount = res.Count;
            }
        }
        StateHasChanged();
    }

    private void RemoveResolution(ResolutionContent rc)
    {
        resolutionContents.Remove(rc);
        StateHasChanged();
    }

    private void ClearContent(ResolutionContent rc)
    {
        rc.ContentPath = null;
        rc.AssetId = null;
        StateHasChanged();
    }

    private async Task OnContentUpload(InputFileChangeEventArgs e, ResolutionContent rc)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > 500 * 1024 * 1024)
            {
                errorMessage = "File size must be less than 500MB.";
                return;
            }

            var uploadPath = Path.Combine(MediaPaths.GetRoot(), "MediaAssets", "OverrideContent");
            Directory.CreateDirectory(uploadPath);

            var extension = Path.GetExtension(file.Name);
            var uniqueFileName = $"{Guid.NewGuid()}{extension}";
            var filePath = Path.Combine(uploadPath, uniqueFileName);

            await using var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            await using var fileStream = new FileStream(filePath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            rc.ContentPath = $"/OverrideContent/{uniqueFileName}";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
        }
    }

    private void ShowAddResolutionModal()
    {
        newResolutionWidth = 1920;
        newResolutionHeight = 1080;
        showAddResolutionModal = true;
    }

    private void HideAddResolutionModal()
    {
        showAddResolutionModal = false;
    }

    private void AddCustomResolution()
    {
        if (newResolutionWidth <= 0 || newResolutionHeight <= 0)
        {
            errorMessage = "Please enter valid width and height values.";
            return;
        }

        if (!resolutionContents.Any(r => r.Width == newResolutionWidth && r.Height == newResolutionHeight))
        {
            resolutionContents.Add(new ResolutionContent
            {
                Width = newResolutionWidth,
                Height = newResolutionHeight,
                DeviceCount = GetDeviceCountForResolution(newResolutionWidth, newResolutionHeight),
                Duration = 7
            });
        }

        HideAddResolutionModal();
        StateHasChanged();
    }

    private void SelectAllDays() { sunday = monday = tuesday = wednesday = thursday = friday = saturday = true; }
    private void SelectWeekdays() { sunday = saturday = false; monday = tuesday = wednesday = thursday = friday = true; }
    private void SelectWeekends() { monday = tuesday = wednesday = thursday = friday = false; sunday = saturday = true; }
    private void ClearDays() { sunday = monday = tuesday = wednesday = thursday = friday = saturday = false; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(overrideName))
        {
            errorMessage = "Override name is required.";
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            TblOverride overrideEntity;

            if (isNewOverride)
            {
                overrideEntity = new TblOverride
                {
                    OverrideName = overrideName,
                    Description = description,
                    IsScheduled = isScheduled,
                    StartDate = startDate,
                    EndDate = endDate,
                    StartTime = !string.IsNullOrEmpty(startTimeStr) ? TimeOnly.Parse(startTimeStr) : null,
                    EndTime = !string.IsNullOrEmpty(endTimeStr) ? TimeOnly.Parse(endTimeStr) : null,
                    Sunday = sunday, Monday = monday, Tuesday = tuesday, Wednesday = wednesday,
                    Thursday = thursday, Friday = friday, Saturday = saturday
                };
                overrideEntity = await overrideService.CreateOverrideAsync(overrideEntity, sessionState?.User?.UserPrincipalName);
            }
            else
            {
                var existing = await overrideService.GetOverrideByIdAsync(OverrideId!.Value);
                if (existing == null) { errorMessage = "Override not found."; return; }

                existing.OverrideName = overrideName;
                existing.Description = description;
                existing.IsScheduled = isScheduled;
                existing.StartDate = startDate;
                existing.EndDate = endDate;
                existing.StartTime = !string.IsNullOrEmpty(startTimeStr) ? TimeOnly.Parse(startTimeStr) : null;
                existing.EndTime = !string.IsNullOrEmpty(endTimeStr) ? TimeOnly.Parse(endTimeStr) : null;
                existing.Sunday = sunday; existing.Monday = monday; existing.Tuesday = tuesday;
                existing.Wednesday = wednesday; existing.Thursday = thursday;
                existing.Friday = friday; existing.Saturday = saturday;

                overrideEntity = await overrideService.UpdateOverrideAsync(existing, sessionState?.User?.UserPrincipalName);
            }

            await overrideService.SetDevicesForOverrideAsync(overrideEntity.OverrideId, selectedDeviceIds.ToList());
            await overrideService.SetDisplaysForOverrideAsync(overrideEntity.OverrideId, selectedDisplayIds.ToList());

            var existingContents = await overrideService.GetContentForOverrideAsync(overrideEntity.OverrideId);
            foreach (var ec in existingContents.Where(c => c.DeviceId == null))
                await overrideService.DeleteContentAsync(ec.OverrideContentId);

            foreach (var rc in resolutionContents.Where(r => !string.IsNullOrEmpty(r.ContentPath)))
            {
                await overrideService.SetContentForResolutionAsync(
                    overrideEntity.OverrideId, rc.Width, rc.Height, rc.ContentPath!, rc.AssetId, rc.Duration);
            }

            navMan.NavigateTo("/overrides");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving override: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel() { navMan.NavigateTo("/overrides"); }

    private bool IsDeviceOnline(DateTime heartbeat) => (DateTime.UtcNow - heartbeat).TotalMinutes <= 2;

    private string GetPreviewUrl(string? contentPath)
    {
        if (string.IsNullOrEmpty(contentPath)) return "";
        if (contentPath.StartsWith("http://") || contentPath.StartsWith("https://")) return contentPath;
        // ContentPath stored as relative (e.g. "/OverrideContent/guid.ext" or "/2062/guid.ext");
        // files live in wwwroot/MediaAssets/, so prepend for browser preview
        if (contentPath.StartsWith("/")) return "/MediaAssets" + contentPath;
        return contentPath;
    }

    private class DeviceViewModel
    {
        public string DeviceId { get; set; } = null!;
        public string? Description { get; set; }
        public string? LocationName { get; set; }
        public double DisplayWidth { get; set; }
        public double DisplayHeight { get; set; }
        public DateTime Heartbeat { get; set; }
    }

    private class DisplayViewModel
    {
        public int DisplayId { get; set; }
        public string DisplayName { get; set; } = "";
        public string? LocationName { get; set; }
        public double DisplayWidth { get; set; }
        public double DisplayHeight { get; set; }
        public int DeviceCount { get; set; }
    }

    private class ResolutionContent
    {
        public int Width { get; set; }
        public int Height { get; set; }
        public int DeviceCount { get; set; }
        public string? ContentPath { get; set; }
        public int? AssetId { get; set; }
        public int Duration { get; set; } = 7;
    }
}
