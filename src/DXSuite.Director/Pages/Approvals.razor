@page "/Approvals"
@using DXSuite.Shared.Authorization
@using DXSuite.Director.Components
@using DXSuite.Director.Components.Approvals
@inject NavigationManager navMan
@inject ISessionState sessionState
@inject IApprovalChainService approvalChainService
@inject IAssetApprovalService assetApprovalService
@inject IUserGroupService userGroupService
@inject IJSRuntime JSRuntime
@inject ITenantContext tenantContext
@rendermode InteractiveServer

@if(isLoading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @if (isAuthorized == false)
    {
        <div class="unauthorized-wrapper">
            <h1>Unauthorized</h1>
            <p>You do not have permission to access this page.</p>
            <a href="/director">Return Home</a>
        </div>
    }
    else
    {
        <div class="dx-page-header">
            <h2>CONTENT APPROVALS <DXSuite.Shared.Components.HelpLink Page="director/approvals" Title="Approvals help" /></h2>
        </div>

        <section style="padding: 20px; margin-top: 20px;">
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert @(statusMessageClass) alert-dismissible fade show" role="alert">
                    @statusMessage
                    <button type="button" class="dx-modal-close" @onclick="() => statusMessage = null">&times;</button>
                </div>
            }

            <!-- Tab bar on desktop; the select replaces it below the tablet breakpoint -->
            <div class="appr-tabs dx-tab-nav-collapsible">
                @if (isApprovalGroupMember || isGlobalAdmin)
                {
                    <button class="appr-tab @(activeTab == "my-queue" ? "active" : "")"
                            @onclick="@(() => SwitchTab("my-queue"))">
                        My Queue @if (MyQueueCount > 0) { <span class="appr-badge">@MyQueueCount</span> }
                    </button>
                }
                @if (isGlobalAdmin)
                {
                    <button class="appr-tab @(activeTab == "all-pending" ? "active" : "")"
                            @onclick="@(() => SwitchTab("all-pending"))">
                        All Pending @if (allPendingItems.Count > 0) { <span class="appr-badge">@allPendingItems.Count</span> }
                    </button>
                }
                <button class="appr-tab @(activeTab == "my-submissions" ? "active" : "")"
                        @onclick="@(() => SwitchTab("my-submissions"))">
                    My Submissions @if (mySubmissions.Count > 0) { <span class="appr-badge">@mySubmissions.Count</span> }
                </button>
            </div>
            <select class="dx-form-control dx-tab-select" @bind="activeTab" @bind:after="OnTabChanged">
                @if (isApprovalGroupMember || isGlobalAdmin)
                {
                    <option value="my-queue">My Queue@(MyQueueCount > 0 ? $" ({MyQueueCount})" : "")</option>
                }
                @if (isGlobalAdmin)
                {
                    <option value="all-pending">All Pending@(allPendingItems.Count > 0 ? $" ({allPendingItems.Count})" : "")</option>
                }
                <option value="my-submissions">My Submissions@(mySubmissions.Count > 0 ? $" ({mySubmissions.Count})" : "")</option>
            </select>

            <!-- My Queue Tab -->
            @if (activeTab == "my-queue")
            {
                @* Message approvals are part of Messaging, which a tenant may not have (DEV-06). *@
                @if (RequiresTenantFeatureAttribute.IsOpen(nameof(TenantFeatureFlags.Messaging), tenantContext))
                {
                    <MessageApprovalQueue OnCountChanged="SetMessageQueueCount" />
                }
                @if (MyQueueCount == 0)
                {
                    <div class="dx-alert dx-alert-info" role="alert">
                        <h4 class="alert-heading">No Pending Items</h4>
                        <p>There are no items in your approval queue at this time.</p>
                    </div>
                }
                else if (myQueueItems.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover appr-table">
                            <thead>
                                <tr>
                                    <th style="width: 110px;">Preview</th>
                                    <th>Asset Name</th>
                                    <th class="appr-col-optional">Location</th>
                                    <th class="appr-col-optional">Uploaded By</th>
                                    <th class="appr-col-secondary" style="width: 130px;">Your Group</th>
                                    <th class="appr-col-secondary" style="width: 80px;">Stage</th>
                                    <th class="appr-col-optional" style="width: 150px;">Submitted</th>
                                    <th style="width: 210px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in myQueueItems.Skip((queueCurrentPage - 1) * PageSize).Take(PageSize))
                                {
                                    <tr>
                                        <td class="appr-thumb-cell">
                                            <a href="@item.AssetPath" target="_blank" class="appr-thumb-link">
                                                @if (IsVideo(item.AssetPath))
                                                {
                                                    <video class="appr-thumb-img" muted preload="metadata">
                                                        <source src="@item.AssetPath" type="video/mp4" />
                                                    </video>
                                                }
                                                else
                                                {
                                                    <img class="appr-thumb-img" src="@item.AssetPath" alt="@(item.AssetName ?? "")" loading="lazy" />
                                                }
                                            </a>
                                        </td>
                                        <td><strong>@(item.AssetName ?? $"Asset #{item.AssetId}")</strong></td>
                                        <td class="appr-col-optional">@(item.LocationName ?? "--")</td>
                                        <td class="appr-col-optional">@(item.UploadedByName ?? "Unknown")</td>
                                        <td class="appr-col-secondary"><span class="appr-group-badge">@(item.GroupName ?? "--")</span></td>
                                        <td class="appr-col-secondary">
                                            @if (item.TotalStages > 0)
                                            {
                                                <span class="appr-stage-indicator">@item.CurrentStageOrder / @item.TotalStages</span>
                                            }
                                        </td>
                                        <td class="appr-col-optional">@item.SubmittedDate.ToString("MMM d, yyyy h:mm tt")</td>
                                        <td>
                                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                                <button class="dx-btn dx-btn-red appr-action-btn"
                                                        @onclick="() => DeclineChainItem(item)">
                                                    Decline
                                                </button>
                                                <button class="dx-btn dx-btn-gray appr-action-btn"
                                                        @onclick="() => ViewRequestDetail(item.ApprovalRequestId)">
                                                    Detail
                                                </button>
                                                <button class="dx-btn dx-btn-green appr-action-btn"
                                                        @onclick="() => ApproveChainItem(item)">
                                                    Approve
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ApprPager TotalItems="myQueueItems.Count" CurrentPage="queueCurrentPage"
                               PageSize="PageSize" OnPageChange="SetQueuePage" />
                }
            }

            <!-- All Pending Tab (GlobalAdmin only) -->
            @if (activeTab == "all-pending" && isGlobalAdmin)
            {
                @if (allPendingItems.Count == 0)
                {
                    <div class="dx-alert dx-alert-info" role="alert">
                        <h4 class="alert-heading">No Pending Items</h4>
                        <p>There are no items pending approval across any group.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover appr-table">
                            <thead>
                                <tr>
                                    <th style="width: 110px;">Preview</th>
                                    <th>Asset Name</th>
                                    <th class="appr-col-optional">Location</th>
                                    <th class="appr-col-optional">Uploaded By</th>
                                    <th class="appr-col-secondary" style="width: 130px;">Group</th>
                                    <th class="appr-col-secondary" style="width: 80px;">Stage</th>
                                    <th class="appr-col-optional" style="width: 150px;">Submitted</th>
                                    <th style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in allPendingItems.Skip((pendingCurrentPage - 1) * PageSize).Take(PageSize))
                                {
                                    <tr>
                                        <td class="appr-thumb-cell">
                                            <a href="@item.AssetPath" target="_blank" class="appr-thumb-link">
                                                @if (IsVideo(item.AssetPath))
                                                {
                                                    <video class="appr-thumb-img" muted preload="metadata">
                                                        <source src="@item.AssetPath" type="video/mp4" />
                                                    </video>
                                                }
                                                else
                                                {
                                                    <img class="appr-thumb-img" src="@item.AssetPath" alt="@(item.AssetName ?? "")" loading="lazy" />
                                                }
                                            </a>
                                        </td>
                                        <td><strong>@(item.AssetName ?? $"Asset #{item.AssetId}")</strong></td>
                                        <td class="appr-col-optional">@(item.LocationName ?? "--")</td>
                                        <td class="appr-col-optional">@(item.UploadedByName ?? "Unknown")</td>
                                        <td class="appr-col-secondary"><span class="appr-group-badge">@(item.GroupName ?? "--")</span></td>
                                        <td class="appr-col-secondary">
                                            @if (item.TotalStages > 0)
                                            {
                                                <span class="appr-stage-indicator">@item.CurrentStageOrder / @item.TotalStages</span>
                                            }
                                        </td>
                                        <td class="appr-col-optional">@item.SubmittedDate.ToString("MMM d, yyyy h:mm tt")</td>
                                        <td>
                                            <button class="dx-btn dx-btn-gray appr-action-btn"
                                                    @onclick="() => ViewRequestDetail(item.ApprovalRequestId)">
                                                Detail
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ApprPager TotalItems="allPendingItems.Count" CurrentPage="pendingCurrentPage"
                               PageSize="PageSize" OnPageChange="SetPendingPage" />
                }
            }

            <!-- My Submissions Tab -->
            @if (activeTab == "my-submissions")
            {
                @if (mySubmissions.Count == 0)
                {
                    <div class="dx-alert dx-alert-info" role="alert">
                        <h4 class="alert-heading">No Submissions</h4>
                        <p>You have not submitted any content for approval.</p>
                    </div>
                }
                else
                {
                    <div class="appr-filter-bar">
                        <div class="appr-filter-group">
                            <label class="appr-filter-label">Status</label>
                            <select class="dx-form-control appr-filter-select"
                                    @onchange="OnSubmissionFilterChange">
                                <option value="all">All</option>
                                <option value="0">Pending</option>
                                <option value="1">Approved</option>
                                <option value="2">Declined</option>
                            </select>
                        </div>
                        <span class="appr-filter-count">@FilteredSubmissions.Count result@(FilteredSubmissions.Count != 1 ? "s" : "")</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover appr-table">
                            <thead>
                                <tr>
                                    <th>Asset Name</th>
                                    <th class="appr-col-optional">Location</th>
                                    <th style="width: 130px;">Status</th>
                                    <th class="appr-col-optional" style="width: 150px;">Submitted</th>
                                    <th class="appr-col-optional" style="width: 150px;">Reviewed</th>
                                    <th style="width: 220px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in FilteredSubmissions.Skip((submissionsCurrentPage - 1) * PageSize).Take(PageSize))
                                {
                                    <tr>
                                        <td><strong>@(sub.AssetName ?? $"Asset #{sub.AssetId}")</strong></td>
                                        <td class="appr-col-optional">@(sub.LocationName ?? "--")</td>
                                        <td>
                                            @{
                                                var statusLabel = sub.ApprovalStatus switch { 0 => "Pending", 1 => "Approved", 2 => "Declined", _ => "Unknown" };
                                                var statusCss = sub.ApprovalStatus switch { 0 => "appr-sb-pending", 1 => "appr-sb-approved", 2 => "appr-sb-declined", _ => "" };
                                            }
                                            <span class="appr-status-badge @statusCss">@statusLabel</span>
                                            @if (sub.IsAutoApproved)
                                            {
                                                <span class="appr-auto-badge" title="Approved automatically by AI content moderation">AI Auto</span>
                                            }
                                        </td>
                                        <td class="appr-col-optional">@sub.SubmittedDate.ToString("MMM d, yyyy h:mm tt")</td>
                                        <td class="appr-col-optional">@(sub.ReviewedDate?.ToString("MMM d, yyyy h:mm tt") ?? "--")</td>
                                        <td>
                                            @if (sub.ApprovalStatus == 2)
                                            {
                                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                    <button class="dx-btn dx-btn-blue appr-action-btn"
                                                            @onclick="() => OpenResubmitModal(sub)">
                                                        Re-submit
                                                    </button>
                                                    @if (sub.DeclinedDate.HasValue)
                                                    {
                                                        var retDays = sub.DeclinedContentRetentionDays ?? 3;
                                                        var expiry = sub.DeclinedDate.Value.AddDays(retDays);
                                                        var daysLeft = Math.Max(0, (int)Math.Ceiling((expiry - DateTime.UtcNow).TotalDays));
                                                        <span class="appr-expiry-countdown">Auto-deletes in @daysLeft day@(daysLeft != 1 ? "s" : "")</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ApprPager TotalItems="FilteredSubmissions.Count" CurrentPage="submissionsCurrentPage"
                               PageSize="PageSize" OnPageChange="SetSubmissionsPage" />
                }
            }

            <!-- Re-submit Modal -->
            @if (showResubmitModal && resubmitTarget != null)
            {
                <div class="dx-modal-overlay">
                    <div class="dx-modal" style="max-width: 800px; width: 100%;">
                        <div class="dx-modal-header">
                            <span>Re-submit Content</span>
                            <button type="button" class="dx-modal-close" @onclick="CloseResubmitModal">&times;</button>
                        </div>
                        <div class="dx-modal-body">
                            <div style="font-weight: 600; margin-bottom: 12px;">@(resubmitTarget.AssetName ?? $"Asset #{resubmitTarget.AssetId}")</div>

                            @if (resubmitComments.Count > 0)
                            {
                                <h6 class="appr-section-label">Discussion</h6>
                                <div class="appr-comment-thread" style="margin-bottom: 12px;">
                                    @foreach (var comment in resubmitComments)
                                    {
                                        <div class="appr-comment-item">
                                            <span class="appr-comment-user">@comment.UserName</span>
                                            <span class="appr-comment-type-badge appr-ctb-@comment.CommentType">@comment.CommentType</span>
                                            <span class="appr-comment-timestamp">@comment.CreatedDate.ToString("MMM d, h:mm tt")</span>
                                            <div class="appr-comment-body">@comment.CommentText</div>
                                        </div>
                                    }
                                </div>
                            }

                            <h6 class="appr-section-label">Why are you re-submitting? (required)</h6>
                            <textarea class="dx-form-control" rows="3" maxlength="2000"
                                      placeholder="Explain what was changed or why the content should be reconsidered..."
                                      @bind="resubmitComment"></textarea>
                            <small class="form-text text-muted">@(resubmitComment?.Length ?? 0) / 2000</small>
                        </div>
                        <div class="dx-modal-footer">
                            <button class="dx-btn dx-btn-gray" @onclick="CloseResubmitModal">Cancel</button>
                            <button class="dx-btn dx-btn-blue" @onclick="ConfirmResubmit"
                                    disabled="@(string.IsNullOrWhiteSpace(resubmitComment))">Re-submit</button>
                        </div>
                    </div>
                </div>
            }

            <!-- Request Detail Panel -->
            @if (selectedDetail != null)
            {
                <div class="appr-detail-panel">
                    <div class="appr-detail-header">
                        <h5>Approval Detail — @(selectedDetail.AssetName ?? $"Asset #{selectedDetail.AssetApprovalId}")</h5>
                        <button class="dx-modal-close" @onclick="CloseDetail">&times;</button>
                    </div>
                    <div class="appr-detail-meta">
                        <span><strong>Location:</strong> @(selectedDetail.LocationName ?? "--")</span>
                        <span><strong>Uploaded by:</strong> @(selectedDetail.UploadedByName ?? "--")</span>
                        <span><strong>Status:</strong> <span class="appr-status-@selectedDetail.Status">@selectedDetail.Status</span></span>
                        <span><strong>Submitted:</strong> @selectedDetail.SubmittedDate.ToString("MMM d, yyyy h:mm tt")</span>
                    </div>
                    <h6 class="appr-section-label" style="margin-top: 16px;">Stage Progression</h6>
                    <div class="appr-stages-timeline">
                        @foreach (var stage in selectedDetail.Stages)
                        {
                            <div class="appr-stage-block @(stage.IsCurrentStage ? "appr-stage-current" : "")">
                                <div class="appr-stage-title">
                                    Stage @(stage.StageOrder + 1)
                                    @if (!string.IsNullOrEmpty(stage.StageName)) { <span>(@stage.StageName)</span> }
                                    — @stage.IntraStageOperator
                                    @if (stage.IsCurrentStage) { <span class="appr-current-label">CURRENT</span> }
                                </div>
                                @foreach (var group in stage.Groups)
                                {
                                    <div class="appr-group-detail">
                                        <span class="appr-group-name">@group.GroupName</span>
                                        <span class="appr-queue-status appr-qs-@group.QueueStatus">@group.QueueStatus</span>
                                        @if (!string.IsNullOrEmpty(group.ActingUserName))
                                        {
                                            <span class="appr-actor">by @group.ActingUserName</span>
                                        }
                                        @if (group.ActionDate.HasValue)
                                        {
                                            <span class="appr-action-date">@group.ActionDate.Value.ToString("MMM d, h:mm tt")</span>
                                        }
                                        @if (!string.IsNullOrEmpty(group.Notes))
                                        {
                                            <span class="appr-notes">"@group.Notes"</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (detailComments.Count > 0)
                    {
                        <h6 class="appr-section-label" style="margin-top: 16px;">Comments</h6>
                        <div class="appr-comment-thread">
                            @foreach (var comment in detailComments)
                            {
                                <div class="appr-comment-item">
                                    <span class="appr-comment-user">@comment.UserName</span>
                                    <span class="appr-comment-type-badge appr-ctb-@comment.CommentType">@comment.CommentType</span>
                                    <span class="appr-comment-timestamp">@comment.CreatedDate.ToString("MMM d, h:mm tt")</span>
                                    <div class="appr-comment-body">@comment.CommentText</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    }
}

<ApprovalActionModal @ref="approvalActionModal" OnConfirm="HandleModalConfirm" />

@code {
    private const int PageSize = 20;

    private bool isLoading = true;
    private bool isAuthorized = false;
    private bool isGlobalAdmin = false;
    private bool isApprovalGroupMember = false;
    private bool hasSubmissions = false;
    private string activeTab = "my-queue";
    private string? statusMessage;
    private string statusMessageClass = "alert-info";

    private List<ApprovalQueueItem> myQueueItems = new();
    private int messageQueueCount;

    // Messages wait in their own section of My Queue; the tab counts them with the uploads.
    private int MyQueueCount => myQueueItems.Count + messageQueueCount;

    private void SetMessageQueueCount(int count) => messageQueueCount = count;
    private List<ApprovalQueueItem> allPendingItems = new();

    private ApprovalRequestDetail? selectedDetail;
    private List<ApprovalCommentDto> detailComments = new();

    private ApprovalActionModal? approvalActionModal;

    private List<SubmissionItem> mySubmissions = new();

    private bool _isLoadingQueues = false;

    private bool showResubmitModal = false;
    private SubmissionItem? resubmitTarget;
    private string? resubmitComment;
    private List<ApprovalCommentDto> resubmitComments = new();

    // Pagination state per tab
    private int queueCurrentPage = 1;
    private int pendingCurrentPage = 1;
    private int submissionsCurrentPage = 1;

    // My Submissions status filter
    private string submissionStatusFilter = "all";

    private List<SubmissionItem> FilteredSubmissions =>
        submissionStatusFilter == "all"
            ? mySubmissions
            : mySubmissions.Where(s => s.ApprovalStatus.ToString() == submissionStatusFilter).ToList();

    private void OnSubmissionFilterChange(ChangeEventArgs e)
    {
        submissionStatusFilter = e.Value?.ToString() ?? "all";
        submissionsCurrentPage = 1;
    }

    // Named page-change handlers avoid inline block lambdas in Razor attributes
    private void SetQueuePage(int p) { queueCurrentPage = p; StateHasChanged(); }
    private void SetPendingPage(int p) { pendingCurrentPage = p; StateHasChanged(); }
    private void SetSubmissionsPage(int p) { submissionsCurrentPage = p; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        await sessionState.SessionLoaded.Task;

        isGlobalAdmin = sessionState.RoleEnum == Roles.Role.Admin;

        if (isGlobalAdmin)
        {
            isAuthorized = true;
        }
        else if (sessionState.User != null)
        {
            var groups = await userGroupService.GetGroupsForUserAsync(sessionState.User.UserId);
            isApprovalGroupMember = groups.Count > 0;

            mySubmissions = await approvalChainService.GetSubmissionsForUserAsync(sessionState.User.UserId);
            hasSubmissions = mySubmissions.Count > 0;

            isAuthorized = isApprovalGroupMember || hasSubmissions;
        }

        if (isAuthorized)
        {
            await LoadAllQueues();

            if (!isApprovalGroupMember && !isGlobalAdmin && hasSubmissions)
            {
                activeTab = "my-submissions";
            }
        }

        isLoading = false;
    }

    private async Task LoadAllQueues()
    {
        if (_isLoadingQueues) return;
        _isLoadingQueues = true;

        try
        {
            if (sessionState.User != null)
            {
                myQueueItems = await approvalChainService.GetPendingItemsForUserAsync(sessionState.User.UserId);
                mySubmissions = await approvalChainService.GetSubmissionsForUserAsync(sessionState.User.UserId);

                foreach (var sub in mySubmissions.Where(s => s.ApprovalStatus == 2))
                {
                    var approval = await assetApprovalService.GetApprovalByIdAsync(sub.AssetApprovalId);
                    if (approval?.Asset != null)
                    {
                        var chain = await approvalChainService.GetChainForLocationAsync(approval.Asset.LocationId);
                        sub.DeclinedContentRetentionDays = chain?.DeclinedContentRetentionDays ?? 3;
                    }
                }
            }

            if (isGlobalAdmin)
            {
                allPendingItems = await approvalChainService.GetAllPendingItemsAsync();
            }
        }
        finally
        {
            _isLoadingQueues = false;
        }
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        await OnTabChanged();
    }

    private async Task OnTabChanged()
    {
        // Reset to first page whenever switching views
        queueCurrentPage = 1;
        pendingCurrentPage = 1;
        submissionsCurrentPage = 1;
        await LoadAllQueues();
    }

    private async Task ApproveChainItem(ApprovalQueueItem item)
    {
        if (sessionState.User == null || approvalActionModal == null) return;

        var comments = await approvalChainService.GetCommentsAsync(item.AssetApprovalId);
        await approvalActionModal.Open("approve", item.AssetName, item.QueueEntryId,
            sessionState.User.UserId, item.GroupId, item.AssetApprovalId, item.ApprovalRequestId, comments);
    }

    private async Task DeclineChainItem(ApprovalQueueItem item)
    {
        if (sessionState.User == null || approvalActionModal == null) return;

        var comments = await approvalChainService.GetCommentsAsync(item.AssetApprovalId);
        await approvalActionModal.Open("decline", item.AssetName, item.QueueEntryId,
            sessionState.User.UserId, item.GroupId, item.AssetApprovalId, item.ApprovalRequestId, comments);
    }

    private async Task HandleModalConfirm(ApprovalActionModalResult modal)
    {
        ApprovalActionResult result;

        if (modal.ActionType == "approve")
        {
            result = await approvalChainService.ApproveAsync(modal.QueueEntryId, modal.UserId, modal.GroupId, modal.Notes);
            statusMessageClass = result.Success ? "alert-success" : "alert-warning";
        }
        else
        {
            result = await approvalChainService.DeclineAsync(modal.QueueEntryId, modal.UserId, modal.GroupId, modal.Notes);
            statusMessageClass = result.Outcome == "chain-declined" ? "alert-warning" : "alert-info";
        }

        if (!string.IsNullOrWhiteSpace(modal.Notes))
        {
            await approvalChainService.AddCommentAsync(
                modal.AssetApprovalId, modal.ApprovalRequestId, modal.UserId,
                modal.Notes.Trim(), modal.ActionType);
        }

        statusMessage = result.Message;
        await LoadAllQueues();
        StateHasChanged();
    }

    private async Task ViewRequestDetail(int approvalRequestId)
    {
        selectedDetail = await approvalChainService.GetRequestDetailAsync(approvalRequestId);
        if (selectedDetail != null)
        {
            detailComments = await approvalChainService.GetCommentsAsync(selectedDetail.AssetApprovalId);
        }
        StateHasChanged();
    }

    private void CloseDetail()
    {
        selectedDetail = null;
        detailComments = new();
    }

    private async Task OpenResubmitModal(SubmissionItem item)
    {
        resubmitTarget = item;
        resubmitComment = null;
        resubmitComments = await approvalChainService.GetCommentsAsync(item.AssetApprovalId);
        showResubmitModal = true;
        StateHasChanged();
    }

    private void CloseResubmitModal()
    {
        showResubmitModal = false;
        resubmitTarget = null;
    }

    private async Task ConfirmResubmit()
    {
        if (resubmitTarget == null || sessionState.User == null || string.IsNullOrWhiteSpace(resubmitComment)) return;

        await approvalChainService.AddCommentAsync(
            resubmitTarget.AssetApprovalId, null, sessionState.User.UserId,
            resubmitComment.Trim(), "resubmit");

        await assetApprovalService.ResubmitAsync(resubmitTarget.AssetApprovalId, sessionState.User.UserId, resubmitComment.Trim());

        var approval = await assetApprovalService.GetApprovalByIdAsync(resubmitTarget.AssetApprovalId);
        if (approval?.Asset != null)
        {
            await approvalChainService.SubmitToChainAsync(resubmitTarget.AssetApprovalId, approval.Asset.LocationId,
                uploadingUserId: approval.UploadedByUserId);
        }

        showResubmitModal = false;
        resubmitTarget = null;

        statusMessage = "Content has been re-submitted for approval.";
        statusMessageClass = "alert-success";

        await LoadAllQueues();
        StateHasChanged();
    }

    // Infer video from extension since ApprovalQueueItem does not carry AssetTypeId
    private static bool IsVideo(string? path) =>
        path != null && (path.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
                         path.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
                         path.EndsWith(".mov", StringComparison.OrdinalIgnoreCase));
}

