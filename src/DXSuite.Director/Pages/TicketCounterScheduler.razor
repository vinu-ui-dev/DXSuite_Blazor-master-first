    private DXSuite.Director.Components.LocationTypes.Custom.VideoWallPreview? wallPreview;

    /// <summary>
    /// Previews the wall with this airline's CURRENT form values, saved or not, so content can be
    /// checked in place before committing.
    /// </summary>
    private async Task PreviewAirlineContent(int groupId)
    {
        if (location == null || config == null || wallPreview == null) return;
        if (!contentStates.TryGetValue(groupId, out var state)) return;

        var airlineName = airlineGroups.FirstOrDefault(g => g.UserGroupId == groupId)?.GroupName ?? $"Group {groupId}";
        await wallPreview.OpenForAirline(location, config, displays, airlineName,
            new DXSuite.Director.Components.LocationTypes.Custom.VideoWallPreview.DraftAirlineContent
            {
                ConstraintId = state.ConstraintId,
                BackgroundPath = state.BackgroundPath,
                BackgroundMode = state.BackgroundMode,
                MaskPath = state.MaskPath,
                MaskMode = state.MaskMode,
                LogoPath = state.LogoPath,
                RoleLogos = state.RoleLogos.ToDictionary(
                    kv => kv.Key,
                    kv => new AirlineLogoContent(kv.Value.Path, kv.Value.Mode)),
                BackgroundOpacityPct = state.BackgroundOpacityPct,
                MaskOpacityPct = state.MaskOpacityPct
            });
    }

    private async Task SaveAirlineContent(int groupId)
    {
        if (!contentStates.TryGetValue(groupId, out var state)) return;
        state.SaveStatus = null;
        try
        {
            await defaultService.UpsertAsync(groupId, LocationId,
                state.ConstraintId,
                state.BackgroundPath, state.BackgroundMode,
                state.MaskPath, state.MaskMode,
                state.LogoPath,
                state.RoleLogos.ToDictionary(
                    kv => kv.Key,
                    kv => new AirlineLogoContent(kv.Value.Path, kv.Value.Mode)),
                state.BackgroundSegments.Select(s => new AirlineLayerSegment(s.Path ?? "", s.WidthPx)).ToList(),
                state.MaskSegments.Select(s => new AirlineLayerSegment(s.Path ?? "", s.WidthPx)).ToList(),
                state.BackgroundOpacityPct,
                state.MaskOpacityPct,
                state.StateName,
                BuildScheduleJson(state),
                state.IsDefaultState);

            // First save creates the row; refresh so the state carries its RowId
            if (state.RowId == 0)
                await ReloadGroupStatesAsync(groupId);
            if (contentStates.TryGetValue(groupId, out var saved))
            {
                saved.SaveStatus = "Saved.";
                saved.SaveIsError = false;
            }
            await PublishWallContentChangeAsync();
        }
        catch (Exception ex)
        {
            state.SaveStatus = ex.Message;
            state.SaveIsError = true;
        }
        StateHasChanged();
    }

    // Razor attribute expressions cannot contain double-quoted string literals, so each target
    // variant is a thin wrapper that delegates to the shared implementation.
    // Upload-in-progress markers keyed by "{groupId}:{slot}" so each file selector
    // shows its own spinner while its file streams over the circuit.
    private readonly HashSet<string> _activeUploads = new();
    private bool IsUploading(int groupId, string slot) => _activeUploads.Contains($"{groupId}:{slot}");

    private Task OnBackgroundFileUpload(InputFileChangeEventArgs e, int groupId) => OnLayerFileUpload(e, groupId, "background");
    private Task OnMaskFileUpload(InputFileChangeEventArgs e, int groupId)       => OnLayerFileUpload(e, groupId, "mask");
    private Task OnLogoFileUpload(InputFileChangeEventArgs e, int groupId)       => OnLayerFileUpload(e, groupId, "logo");
    private Task OnRoleLogoFileUpload(InputFileChangeEventArgs e, int groupId, string roleKey)
        => OnLayerFileUpload(e, groupId, $"role:{roleKey}");

    private Task OnBackgroundSegmentUpload(InputFileChangeEventArgs e, int groupId) => OnSegmentFileUpload(e, groupId, "background");
    private Task OnMaskSegmentUpload(InputFileChangeEventArgs e, int groupId)       => OnSegmentFileUpload(e, groupId, "mask");

    private async Task<(string RelativePath, string FullPath)?> SaveAirlineContentFileAsync(
        Microsoft.AspNetCore.Components.Forms.IBrowserFile? file, AirlineContentState state)
    {
        if (file == null) return null;
        if (file.Size > 200 * 1024 * 1024)
        {
            state.UploadError = "File must be under 200 MB.";
            return null;
        }

        var folder = Path.Combine(MediaPaths.GetRoot(), "MediaAssets", "AirlineContent");
        Directory.CreateDirectory(folder);

        var uniqueFileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
        var filePath       = Path.Combine(folder, uniqueFileName);

        await using var stream = file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
        await using var fs     = new FileStream(filePath, FileMode.Create);
        await stream.CopyToAsync(fs);

        return ($"/MediaAssets/AirlineContent/{uniqueFileName}", filePath);
    }

    // Native width drives side-by-side segment placement. ffprobe reads both video and
    // image dimensions; a failed probe leaves 0 (fill-remaining) for the user to correct.
    private async Task<int> ProbeMediaWidthAsync(string filePath)
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = FfmpegOptions.Value.ResolveBinary("ffprobe.exe", webHostEnv.ContentRootPath),
                Arguments = $"-v error -select_streams v:0 -show_entries stream=width -of csv=p=0 \"{filePath}\"",
                RedirectStandardOutput = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };
            using var process = System.Diagnostics.Process.Start(psi);
            if (process == null) return 0;
            var output = await process.StandardOutput.ReadToEndAsync();
            await process.WaitForExitAsync();
            return int.TryParse(output.Trim(), out var w) ? Math.Max(0, w) : 0;
        }
        catch { return 0; }
    }

    private async Task OnSegmentFileUpload(InputFileChangeEventArgs e, int groupId, string layerRole)
    {
        if (!contentStates.TryGetValue(groupId, out var state)) return;
        state.UploadError = null;
        var uploadKey = $"{groupId}:seg:{layerRole}";
        _activeUploads.Add(uploadKey);
        StateHasChanged();
        try
        {
            var saved = await SaveAirlineContentFileAsync(e.File, state);
            if (saved != null)
            {
                var list = layerRole == "mask" ? state.MaskSegments : state.BackgroundSegments;
                list.Add(new LayerSegmentState
                {
                    Path    = saved.Value.RelativePath,
                    WidthPx = await ProbeMediaWidthAsync(saved.Value.FullPath)
                });
            }
        }
        catch (Exception ex)
        {
            state.UploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _activeUploads.Remove(uploadKey);
            StateHasChanged();
        }
    }

    /// <param name="target">"mask", "background", "logo", or "role:{roleKey}"</param>
    private async Task OnLayerFileUpload(InputFileChangeEventArgs e, int groupId, string target)
    {
        if (!contentStates.TryGetValue(groupId, out var state)) return;
        state.UploadError = null;
        var uploadKey = $"{groupId}:{target}";
        _activeUploads.Add(uploadKey);
        StateHasChanged();

        try
        {
            var saved = await SaveAirlineContentFileAsync(e.File, state);
            if (saved == null) return;

            var relativePath = saved.Value.RelativePath;
            if (target == "mask")
            {
                state.MaskPath = relativePath;
                // Videos default to pixel-exact rendering; scaling modes are explicit opt-ins.
                if (LayerRenderMode.IsVideo(relativePath)) state.MaskMode = "native";
            }
            else if (target == "logo")
            {
                state.LogoPath = relativePath;
            }
            else if (target.StartsWith("role:"))
            {
                var slot = GetRoleSlot(state, target["role:".Length..]);
                slot.Path = relativePath;
                if (LayerRenderMode.IsVideo(relativePath)) slot.Mode = "native";
            }
            else
            {
                state.BackgroundPath = relativePath;
                if (LayerRenderMode.IsVideo(relativePath)) state.BackgroundMode = "native";
            }
        }
        catch (Exception ex)
        {
            state.UploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _activeUploads.Remove(uploadKey);
            StateHasChanged();
        }
    }

    private static bool IsWebUrl(string? path) =>
        !string.IsNullOrEmpty(path) &&
        (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
         path.StartsWith("https://", StringComparison.OrdinalIgnoreCase));

    private static string? NullIfEmpty(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    // Ordered side-by-side segments for one layer. When any exist the wall renders the
    // sequence (each at native width, wrapping back to segment 1 across the cluster)
    // instead of the layer's single file.
    private RenderFragment RenderSegmentEditor(List<LayerSegmentState> segments, int groupId, bool isMask) => __builder =>
    {
        <div class="tcs-content-row">
            <span class="tcs-content-label">Segments</span>
            <span class="tcs-path-hint">Optional side-by-side sequence — replaces the single file above and wraps back to segment 1 across the cluster</span>
        </div>
        @for (int i = 0; i < segments.Count; i++)
        {
            var seg = segments[i];
            var idx = i;
            <div class="tcs-content-row">
                <span class="tcs-content-label">#@(idx + 1)</span>
                <span class="tcs-path-hint" style="flex:1; overflow:hidden; text-overflow:ellipsis;">@seg.Path</span>
                <input type="number" class="dx-form-control dx-form-control-sm" style="width:110px;"
                       title="Native width (px); 0 fills the remaining cluster width"
                       value="@seg.WidthPx"
                       @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var w)) { seg.WidthPx = w; StateHasChanged(); } }" />
                @if (idx > 0)
                {
                    <button class="tcs-clear-btn" title="Move up"
                            @onclick="() => { segments.RemoveAt(idx); segments.Insert(idx - 1, seg); StateHasChanged(); }">↑</button>
                }
                <button class="tcs-clear-btn" title="Remove"
                        @onclick="() => { segments.RemoveAt(idx); StateHasChanged(); }">×</button>
            </div>
        }
        <div class="tcs-content-row">
            <span class="tcs-content-label">Add Segment</span>
            @if (isMask)
            {
                <InputFile OnChange="async (e) => await OnMaskSegmentUpload(e, groupId)" accept="image/*,video/*" class="tcs-file-input" />
            }
            else
            {
                <InputFile OnChange="async (e) => await OnBackgroundSegmentUpload(e, groupId)" accept="image/*,video/*" class="tcs-file-input" />
            }
            @if (IsUploading(groupId, isMask ? "seg:mask" : "seg:background"))
            {
                <span class="dx-spinner dx-spinner-sm"></span>
                <span class="tcs-path-hint">Uploading...</span>
            }
        </div>
    };

    private RenderFragment RenderLayerPreview(string? path) => __builder =>
    {
        if (string.IsNullOrEmpty(path)) return;
        if (IsWebUrl(path))
        {
            <div class="tcs-thumb tcs-thumb-web">
                <span class="bi bi-globe2"></span>
                <span>Web URL</span>
            </div>
        }
        else if (IsHtmlPath(path))
        {
            @* Live preview of the uploaded HTML — same iframe treatment as a web URL mask *@
            <iframe class="tcs-thumb tcs-thumb-html" src="@path"
                    scrolling="no" frameborder="0"
                    sandbox="allow-scripts allow-same-origin"></iframe>
        }
        else
        {
            var ext = Path.GetExtension(path).ToLowerInvariant();
            if (ext is ".mp4" or ".webm" or ".mov")
            {
                <video class="tcs-thumb" src="@path" muted preload="metadata"></video>
            }
            else
            {
                <img class="tcs-thumb" src="@path" alt="" />
            }
        }
    };

    private static bool IsHtmlPath(string? path) =>
        !string.IsNullOrEmpty(path) &&
        path.EndsWith(".html", StringComparison.OrdinalIgnoreCase);

    private void ApplyToWall()
    {
        applyWallStatus = "Wall controller update pending — platform implementation not yet available.";
        applyWallIsError = false;
    }
