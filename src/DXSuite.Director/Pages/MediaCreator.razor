    private void SaveStateForUndo()
    {
        if (canvasProject == null) return;
        try
        {
            var jsonState = JsonConvert.SerializeObject(canvasProject, JsonSettings);
            undoHistory.Push(jsonState);
            while (undoHistory.Count > MaxUndoSteps)
            {
                var temp = new Stack<string>();
                for (int i = 0; i < MaxUndoSteps - 1; i++)
                {
                    if (undoHistory.Count > 0) temp.Push(undoHistory.Pop());
                }
                undoHistory.Clear();
                while (temp.Count > 0) undoHistory.Push(temp.Pop());
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error saving undo state"); }
    }

    [JSInvokable]
    public async Task HandleUndo() { await PerformUndo(); }

    private async Task PerformUndo()
    {
        if (canvasProject == null || undoHistory.Count <= 1) return;
        try
        {
            if (undoHistory.Count > 0) undoHistory.Pop();
            if (undoHistory.Count > 0)
            {
                var previousState = undoHistory.Peek();
                canvasProject = JsonConvert.DeserializeObject<CanvasProject>(previousState, JsonSettings);
                selectedElement = null;
                BackgroundColorValue = canvasProject?.Background?.BackgroundColor ?? "#FFFFFF";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error performing undo"); }
    }

    private void RemoveElement(string elementId)
    {
        if (canvasProject == null) return;
        canvasProject.RemoveElement(elementId);
        if (selectedElement?.Id == elementId) selectedElement = null;
        SaveStateForUndo();
        StateHasChanged();
    }

    private UploadingAsSection? uploadingAs;
    private PreparedUpload? preparedUpload;
    private string? uploadIdentityError;

    // Called from a display or a non-playlist constraint, the image becomes an asset row here and needs an
    // owner. Otherwise it is handed to the media uploader, which carries its own picker.
    private bool UsesAssetRow => DisplayId.HasValue || (ConstraintId.HasValue && ConstraintId.Value != 0);

    private string? UploadBlockReason => UsesAssetRow && LocationId > 0 && uploadingAs is { IsBlocked: true } section ? section.BlockReason : null;

    private async Task GenerateImage()
    {
        if (canvasProject == null) return;

        preparedUpload = null;
        uploadIdentityError = null;
        if (UsesAssetRow && LocationId > 0)
        {
            preparedUpload = await uploadIdentity.PrepareAsync(sessionState.User?.UserId ?? 0, LocationId,
                uploadingAs?.PickedGroupId, uploadingAs?.Picks);
            if (!preparedUpload.IsValid)
            {
                uploadIdentityError = preparedUpload.Error;
                if (uploadingAs != null)
                    await uploadingAs.ReloadAfterRefusalAsync(preparedUpload.Error);
                return;
            }
        }

        isGenerating = true;
        StateHasChanged();
        try
        {
            var baseDirectory = MediaPaths.GetRoot();

            // DisplayId indicates invocation from a Display page — always use SQL path.
            // ConstraintId != 0 is the legacy check for non-playlist SQL content.
            if (DisplayId.HasValue || (ConstraintId.HasValue && ConstraintId.Value != 0))
            {
                // Staged out of the watched location folder until the asset row exists: the
                // manifest builder serves a media file that has no row as unapproved legacy content.
                var stagingFolder = Path.Combine(baseDirectory, "MediaAssets", "_staging", Guid.NewGuid().ToString("N"));
                Directory.CreateDirectory(stagingFolder);

                var fileName = await ImageGenerator.SaveCanvasImageAsync(canvasProject, baseDirectory, !isBackgroundTransparent, customFileName, stagingFolder);

                await CreateSqlAssetEntry(fileName);

                var targetDirectory = CanvasImageGenerationService.GetTargetDirectory(canvasProject, baseDirectory);
                Directory.CreateDirectory(targetDirectory);
                var finalPath = Path.Combine(targetDirectory, fileName);
                if (File.Exists(finalPath)) File.Delete(finalPath);
                File.Move(Path.Combine(stagingFolder, fileName), finalPath);
                try { Directory.Delete(stagingFolder, recursive: true); } catch { }

                var returnDisplayId = DisplayId ?? GetDisplayIdForConstraint(ConstraintId);
                Navigation.NavigateTo($"/display/{returnDisplayId}");
            }
            else
            {
                // No asset row is created on this path, so there is nothing to race and the image
                // is written straight to its folder before the metadata modal opens.
                var fileName = await ImageGenerator.SaveCanvasImageAsync(canvasProject, baseDirectory, !isBackgroundTransparent, customFileName);
                var filePath = GetGeneratedFilePath(fileName);
                var webPath = $"/MediaAssets/{LocationId}/{fileName}";
                var mediaFile = new MediaFile { DiskPath = filePath, WebPath = webPath, Metadata = new List<MetadataField>() };
                await ShowMediaUploaderForMetadata(mediaFile);
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error generating image"); }
        finally { isGenerating = false; StateHasChanged(); }
    }

    private void OnCanvasDragOver(DragEventArgs e) { e.DataTransfer.DropEffect = "move"; }
    private void OnCanvasDrop(DragEventArgs e) { }

    private void StartDrag(string elementId, MouseEventArgs e)
    {
        if (canvasProject == null) return;
        var element = canvasProject.Elements.FirstOrDefault(x => x.Id == elementId);
        if (element == null) return;
        isDragging = true;
        draggingElementId = elementId;
        dragStartMouseX = e.ClientX; dragStartMouseY = e.ClientY;
        dragStartElementX = element.X; dragStartElementY = element.Y;
        SelectElement(elementId);
    }

    private void OnCanvasMouseMove(MouseEventArgs e)
    {
        if (isResizing && resizingElementId != null && canvasProject != null) { HandleResize(e); return; }
        if (!isDragging || draggingElementId == null || canvasProject == null) return;
        var element = canvasProject.Elements.FirstOrDefault(x => x.Id == draggingElementId);
        if (element == null) return;
        var deltaX = e.ClientX - dragStartMouseX;
        var deltaY = e.ClientY - dragStartMouseY;
        var canvasDeltaX = deltaX / zoomLevel;
        var canvasDeltaY = deltaY / zoomLevel;
        var newX = dragStartElementX + canvasDeltaX;
        var newY = dragStartElementY + canvasDeltaY;
        (newX, newY) = SnapElementToGrid(element, newX, newY);
        element.X = newX; element.Y = newY;
        StateHasChanged();
    }

    private void OnCanvasMouseUp(MouseEventArgs e)
    {
        isDragging = false; draggingElementId = null;
        isResizing = false; resizingElementId = null; resizeDirection = "";
    }

    private void OnCanvasMouseLeave(MouseEventArgs e)
    {
        if (isDragging || isResizing)
        {
            isDragging = false; draggingElementId = null;
            isResizing = false; resizingElementId = null; resizeDirection = "";
            StateHasChanged();
        }
    }

    private void HandleResize(MouseEventArgs e)
    {
        if (canvasProject == null) return;
        var element = canvasProject.Elements.FirstOrDefault(x => x.Id == resizingElementId);
        if (element == null) return;

        var deltaX = (e.ClientX - resizeStartX) / zoomLevel;
        var deltaY = (e.ClientY - resizeStartY) / zoomLevel;

        var newX = resizeStartElementX;
        var newY = resizeStartElementY;
        var newWidth = resizeStartWidth;
        var newHeight = resizeStartHeight;

        switch (resizeDirection)
        {
            case "nw":
                newX = resizeStartElementX + deltaX;
                newY = resizeStartElementY + deltaY;
                newWidth = resizeStartWidth - deltaX;
                newHeight = resizeStartHeight - deltaY;
                break;
            case "ne":
                newY = resizeStartElementY + deltaY;
                newWidth = resizeStartWidth + deltaX;
                newHeight = resizeStartHeight - deltaY;
                break;
            case "sw":
                newX = resizeStartElementX + deltaX;
                newWidth = resizeStartWidth - deltaX;
                newHeight = resizeStartHeight + deltaY;
                break;
            case "se":
                newWidth = resizeStartWidth + deltaX;
                newHeight = resizeStartHeight + deltaY;
                break;
        }

        var minSize = 20;
        if (newWidth < minSize)
        {
            if (resizeDirection.Contains("w")) newX = resizeStartElementX + (resizeStartWidth - minSize);
            newWidth = minSize;
        }
        if (newHeight < minSize)
        {
            if (resizeDirection.Contains("n")) newY = resizeStartElementY + (resizeStartHeight - minSize);
            newHeight = minSize;
        }

        if (showGrid)
        {
            switch (resizeDirection)
            {
                case "nw":
                    var (snappedNwX, snappedNwY) = SnapToGrid(newX, newY);
                    if (Math.Abs(newX - snappedNwX) <= snapThreshold)
                    { var nwRight = newX + newWidth; newX = snappedNwX; newWidth = nwRight - newX; }
                    if (Math.Abs(newY - snappedNwY) <= snapThreshold)
                    { var nwBottom = newY + newHeight; newY = snappedNwY; newHeight = nwBottom - newY; }
                    break;
                case "ne":
                    var neTopRightX = newX + newWidth;
                    var (snappedNeX, snappedNeY) = SnapToGrid(neTopRightX, newY);
                    if (Math.Abs(neTopRightX - snappedNeX) <= snapThreshold)
                        newWidth = snappedNeX - newX;
                    if (Math.Abs(newY - snappedNeY) <= snapThreshold)
                    { var neBottom = newY + newHeight; newY = snappedNeY; newHeight = neBottom - newY; }
                    break;
                case "sw":
                    var swBottomY = newY + newHeight;
                    var (snappedSwX, snappedSwY) = SnapToGrid(newX, swBottomY);
                    if (Math.Abs(newX - snappedSwX) <= snapThreshold)
                    { var swRight = newX + newWidth; newX = snappedSwX; newWidth = swRight - newX; }
                    if (Math.Abs(swBottomY - snappedSwY) <= snapThreshold)
                        newHeight = snappedSwY - newY;
                    break;
                case "se":
                    var seRight = newX + newWidth;
                    var seBottom = newY + newHeight;
                    var (snappedSeX, snappedSeY) = SnapToGrid(seRight, seBottom);
                    if (Math.Abs(seRight - snappedSeX) <= snapThreshold)
                        newWidth = snappedSeX - newX;
                    if (Math.Abs(seBottom - snappedSeY) <= snapThreshold)
                        newHeight = snappedSeY - newY;
                    break;
            }
        }

        element.X = newX; element.Y = newY; element.Width = newWidth; element.Height = newHeight;
        StateHasChanged();
    }

    private (double width, double height) SnapDimensionsToGrid(double width, double height)
    {
        if (!showGrid) return (width, height);
        var snappedWidth = Math.Round(width / gridWidth) * gridWidth;
        if (Math.Abs(width - snappedWidth) <= snapThreshold) width = snappedWidth;
        var snappedHeight = Math.Round(height / gridHeight) * gridHeight;
        if (Math.Abs(height - snappedHeight) <= snapThreshold) height = snappedHeight;
        return (width, height);
    }

    private void StartResize(string elementId, string handle, MouseEventArgs e)
    {
        if (canvasProject == null) return;
        var element = canvasProject.Elements.FirstOrDefault(x => x.Id == elementId);
        if (element == null) return;
        isResizing = true; resizingElementId = elementId; resizeDirection = handle;
        resizeStartX = e.ClientX; resizeStartY = e.ClientY;
        resizeStartWidth = element.Width; resizeStartHeight = element.Height;
        resizeStartElementX = element.X; resizeStartElementY = element.Y;
        SelectElement(elementId);
    }

    private string GetGridBackgroundImage()
    {
        var encodedColor = gridColor.Replace("#", "%23");
        return $"url(\"data:image/svg+xml,%3csvg width='{gridWidth}' height='{gridHeight}' xmlns='http://www.w3.org/2000/svg'%3e%3cdefs%3e%3cpattern id='grid' width='{gridWidth}' height='{gridHeight}' patternUnits='userSpaceOnUse'%3e%3cpath d='M {gridWidth} 0 L 0 0 0 {gridHeight}' fill='none' stroke='{encodedColor}' stroke-width='1'/%3e%3c/pattern%3e%3c/defs%3e%3crect width='100%25' height='100%25' fill='url(%23grid)' /%3e%3c/svg%3e\")";
    }

    private (double x, double y) SnapToGrid(double x, double y)
    {
        if (!showGrid) return (x, y);
        var adjustedX = x - gridOffsetLeft; var adjustedY = y - gridOffsetTop;
        var snappedX = Math.Round(adjustedX / gridWidth) * gridWidth + gridOffsetLeft;
        var snappedY = Math.Round(adjustedY / gridHeight) * gridHeight + gridOffsetTop;
        if (Math.Abs(x - snappedX) <= snapThreshold && Math.Abs(y - snappedY) <= snapThreshold)
            return (snappedX, snappedY);
        return (x, y);
    }

    private (double x, double y) SnapElementToGrid(CanvasElement element, double proposedX, double proposedY)
    {
        if (!showGrid) return (proposedX, proposedY);
        var snapPoints = new[]
        {
            (proposedX, proposedY), (proposedX + element.Width, proposedY),
            (proposedX, proposedY + element.Height), (proposedX + element.Width, proposedY + element.Height),
            (proposedX + element.Width / 2, proposedY), (proposedX + element.Width / 2, proposedY + element.Height),
            (proposedX, proposedY + element.Height / 2), (proposedX + element.Width, proposedY + element.Height / 2),
        };
        foreach (var (pointX, pointY) in snapPoints)
        {
            var (snappedPointX, snappedPointY) = SnapToGrid(pointX, pointY);
            if (Math.Abs(pointX - snappedPointX) <= snapThreshold && Math.Abs(pointY - snappedPointY) <= snapThreshold)
            {
                var offsetX = pointX - proposedX; var offsetY = pointY - proposedY;
                return (snappedPointX - offsetX, snappedPointY - offsetY);
            }
        }
        return (proposedX, proposedY);
    }

    private async Task ZoomIn() { zoomLevel = Math.Min(zoomLevel * 1.2, 5.0); StateHasChanged(); }
    private async Task ZoomOut() { zoomLevel = Math.Max(zoomLevel / 1.2, 0.1); StateHasChanged(); }

    private async Task FitToScreen()
    {
        var viewportWidth = await JSRuntime.InvokeAsync<double>("getViewportWidth");
        var viewportHeight = await JSRuntime.InvokeAsync<double>("getViewportHeight");
        var availableWidth = Math.Max(viewportWidth - 370, 200);
        var availableHeight = Math.Max(viewportHeight - 200, 200);
        var scaleX = availableWidth / baseCanvasWidth;
        var scaleY = availableHeight / baseCanvasHeight;
        zoomLevel = Math.Min(Math.Min(scaleX, scaleY), 1.0);
        StateHasChanged();
    }

    private string GetJustifyContent(string textAlign) => textAlign.ToLower() switch { "center" => "center", "right" => "flex-end", _ => "flex-start" };

    private string GetTextShadowStyle(CanvasText textElement)
    {
        if (!textElement.HasShadow) return "";
        var shadowColorWithOpacity = ConvertToRgba(textElement.ShadowColor, textElement.ShadowOpacity);
        return $"filter: drop-shadow({textElement.ShadowOffsetX}px {textElement.ShadowOffsetY}px {textElement.ShadowBlur}px {shadowColorWithOpacity});";
    }

    private string ConvertToRgba(string hexColor, double opacity)
    {
        var hex = hexColor.TrimStart('#');
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);
        return $"rgba({r}, {g}, {b}, {opacity:F2})";
    }

    private void OnElementDragStart(DragEventArgs e, string elementId) { draggingZOrderElementId = elementId; e.DataTransfer.EffectAllowed = "move"; }
    private void OnElementDragOver(DragEventArgs e, string elementId)
    {
        if (draggingZOrderElementId != null && draggingZOrderElementId != elementId) { dragOverElementId = elementId; e.DataTransfer.DropEffect = "move"; StateHasChanged(); }
    }
    private void OnElementDragLeave(string elementId) { if (dragOverElementId == elementId) { dragOverElementId = null; StateHasChanged(); } }

    private void OnElementDrop(DragEventArgs e, string targetElementId)
    {
        if (draggingZOrderElementId == null || canvasProject == null || draggingZOrderElementId == targetElementId) { draggingZOrderElementId = null; return; }
        var draggedElement = canvasProject.Elements.FirstOrDefault(el => el.Id == draggingZOrderElementId);
        var targetElement = canvasProject.Elements.FirstOrDefault(el => el.Id == targetElementId);
        if (draggedElement != null && targetElement != null && draggedElement != canvasProject.Background && targetElement != canvasProject.Background)
        {
            var draggedIndex = canvasProject.Elements.IndexOf(draggedElement);
            var targetIndex = canvasProject.Elements.IndexOf(targetElement);
            canvasProject.Elements.RemoveAt(draggedIndex);
            if (draggedIndex < targetIndex) targetIndex--;
            canvasProject.Elements.Insert(targetIndex, draggedElement);
            for (int i = 0; i < canvasProject.Elements.Count; i++) canvasProject.Elements[i].ZIndex = i;
            StateHasChanged();
        }
        draggingZOrderElementId = null; dragOverElementId = null;
    }

    private async Task CreateSqlAssetEntry(string fileName)
    {
        try
        {
            var webPath = $"/MediaAssets/{LocationId}/{ConstraintId}/{fileName}";
            var newAsset = new TblAsset
            {
                AssetGroupId = 1,
                AssetPath = webPath,
                AssetTypeId = (int)Types.AssetType.Image,
                ConstraintId = ConstraintId ?? 0,
                LocationId = LocationId,
                AssetWidth = (int)Width,
                AssetHeight = (int)Height,
                UploadedByUserId = preparedUpload?.OwnerUserId ?? sessionState.User?.UserId,
                UploadedByUserGroupId = preparedUpload?.OwnerGroupId
            };
            dbContext.TblAssets.Add(newAsset);
            await dbContext.SaveChangesAsync();
            publicationInvalidator.AssetsChanged([newAsset.LocationId]);

            foreach (var (key, values) in preparedUpload?.Tags ?? new Dictionary<string, List<string>>())
                await contentMetadataService.SetMetadataAsync(newAsset.AssetId, key, values, sessionState.User?.UserId);

            var location = await dbContext.TblLocations.FindAsync(LocationId);
            if (location?.EnableContentApproval == true && sessionState.User != null)
            {
                var approval = new TblAssetApproval
                {
                    AssetId = newAsset.AssetId,
                    UploadedByUserId = sessionState.User.UserId,
                    ApprovalStatus = (int)ApprovalStatus.Pending,
                    SubmittedDate = DateTime.UtcNow,
                    ExtendedData = System.Text.Json.JsonSerializer.Serialize(new { source = "MediaCreator" })
                };
                dbContext.TblAssetApprovals.Add(approval);
                await dbContext.SaveChangesAsync();
                publicationInvalidator.AssetsChanged([LocationId]);
                await approvalChainService.SubmitToChainAsync(approval.AssetApprovalId, LocationId, true,
                    uploadingUserId: null, pickedRuleId: preparedUpload?.PickedRuleId);
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error creating SQL asset entry"); }
    }

    private int GetDisplayIdForConstraint(int? constraintId)
    {
        if (constraintId == null) return 0;
        var display = dbContext.TblDisplays.FirstOrDefault(d => d.ConstraintId == constraintId);
        return display?.DisplayId ?? 0;
    }

    private string GetGeneratedFilePath(string fileName)
    {
        var baseDirectory = MediaPaths.GetRoot();
        if (ConstraintId.HasValue && ConstraintId.Value != 0)
            return Path.Combine(baseDirectory, "MediaAssets", LocationId.ToString(), ConstraintId.Value.ToString(), fileName);
        else
            return Path.Combine(baseDirectory, "MediaAssets", LocationId.ToString(), fileName);
    }

    private async Task ShowMediaUploaderForMetadata(MediaFile mediaFile)
    {
