@page "/mediacreator"
@using Microsoft.AspNetCore.Components.Forms
@using DXSuite.Director.Models.Canvas
@using DXSuite.Director.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Drawing
@using System.IO
@using SkiaSharp
@using Newtonsoft.Json
@using DXSuite.Director.Components
@using static DXSuite.Director.Models.Types
@inject IJSRuntime JSRuntime
@inject IDirectorDBContext dbContext
@inject NavigationManager Navigation
@inject CanvasImageGenerationService ImageGenerator
@using Microsoft.AspNetCore.Hosting
@inject IConfiguration config
@inject IWebHostEnvironment env
@inject ITenantMediaPathResolver MediaPaths
@inject IFontService FontService
@inject JsonSerializerSettings JsonSettings
@inject ILogger<MediaCreator> Logger
@inject ISessionState sessionState
@inject IApprovalChainService approvalChainService
@inject IUploadIdentityService uploadIdentity
@inject IContentMetadataService contentMetadataService
@inject IPublicationInvalidator publicationInvalidator
@rendermode InteractiveServer

<PageTitle>Media Creator</PageTitle>

@* Inject custom font CSS *@
<style>
@((MarkupString)FontService.GetWebFontCss())
</style>

<style>
    .element-properties {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #ddd;
    }

    .fit-controls {
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .fit-controls button {
        width: 100%;
    }

    .position-controls, .size-controls {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 5px 10px;
        margin-bottom: 15px;
        align-items: center;
    }

    .position-controls label, .size-controls label {
        font-weight: 500;
        margin: 0;
    }

    .position-controls input, .size-controls input {
        width: 100%;
        padding: 4px 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .file-name-section {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .file-name-section label {
        margin: 0;
        font-weight: 500;
    }
</style>

<script>
    window.getViewportWidth = () => window.innerWidth;
    window.getViewportHeight = () => window.innerHeight;

    window.setupKeyboardListeners = (dotNetObjectRef) => {
        const handleKeyDown = (event) => {
            if (event.ctrlKey && event.key === 'z' && !event.shiftKey) {
                event.preventDefault();
                dotNetObjectRef.invokeMethodAsync('HandleUndo');
            }
        };

        document.addEventListener('keydown', handleKeyDown);

        return {
            dispose: () => {
                document.removeEventListener('keydown', handleKeyDown);
            }
        };
    };

    window.getCanvasMousePosition = (event) => {
        const canvas = document.getElementById('canvas-container');
        if (!canvas) return { x: 0, y: 0 };

        const rect = canvas.getBoundingClientRect();

        const canvasWidth = parseFloat(canvas.style.width) || canvas.offsetWidth;
        const canvasHeight = parseFloat(canvas.style.height) || canvas.offsetHeight;

        const displayedWidth = rect.width;
        const displayedHeight = rect.height;

        const scaleX = displayedWidth / canvasWidth;
        const scaleY = displayedHeight / canvasHeight;

        const mouseX = event.clientX - rect.left;
        const mouseY = event.clientY - rect.top;

        return {
            x: mouseX / scaleX,
            y: mouseY / scaleY
        };
    };
</script>

<div class="media-creator-container">
    <div class="creator-header">
        <div class="file-name-section">
            <label class="form-label">File Name:</label>
            <input type="text" class="dx-form-control" @bind="customFileName" placeholder="Custom_Canvas" style="width: 300px;" />
        </div>
        <div class="header-controls">
            <button class="dx-btn dx-btn-gray" @onclick="GoBack">Cancel</button>
            <button class="dx-btn dx-btn-blue" @onclick="GenerateImage" disabled="@(isGenerating || UploadBlockReason != null)" title="@UploadBlockReason">
                @if (isGenerating)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Generate Image
            </button>
        </div>
    </div>

    @if (UsesAssetRow && LocationId > 0)
    {
        <div class="dx-card" style="margin-bottom:12px;">
            <div class="dx-card-body" style="padding:8px 16px;">
                <UploadingAsSection @ref="uploadingAs" LocationId="@LocationId" OnChanged="StateHasChanged" />
                @if (!string.IsNullOrEmpty(uploadIdentityError))
                {
                    <div class="dx-text-red" style="font-size:0.8rem;">@uploadIdentityError</div>
                }
                else if (UploadBlockReason is { } blockReason)
                {
                    <div class="dx-text-red" style="font-size:0.8rem;">@blockReason</div>
                }
            </div>
        </div>
    }

    <div class="creator-workspace">
        <div class="canvas-area">
            <div class="canvas-toolbar">
                <div class="zoom-controls">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ZoomOut" title="Zoom Out">-</button>
                    <span class="zoom-level">@(Math.Round(zoomLevel * 100))%</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ZoomIn" title="Zoom In">+</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="FitToScreen" title="Fit to Screen">Fit</button>
                </div>
            </div>
            <div class="canvas-viewport">
                <div class="canvas-wrapper" style="width: @(Math.Max(baseCanvasWidth * zoomLevel, 1))px; height: @(Math.Max(baseCanvasHeight * zoomLevel, 1))px;">
                    <div class="canvas-container" id="canvas-container"
                         style="width: @(baseCanvasWidth)px; height: @(baseCanvasHeight)px; transform: scale(@zoomLevel); transform-origin: top left;"
                         @onmousemove="OnCanvasMouseMove"
                         @onmouseup="OnCanvasMouseUp"
                         @onmouseleave="OnCanvasMouseLeave"
                         @ondrop="OnCanvasDrop"
                         @ondragover="OnCanvasDragOver"
                         @ondragover:preventDefault="true">

                @if (canvasProject?.Background != null && !isBackgroundTransparent)
                {
                    <div class="canvas-background"
                         style="background-color: @canvasProject.Background.BackgroundColor; width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 0;">
                    </div>
                }

                @if (showGrid)
                {
                    <div class="grid-overlay"
                         style="position: absolute; top: @(gridOffsetTop)px; left: @(gridOffsetLeft)px; width: calc(100% - @(gridOffsetLeft)px); height: calc(100% - @(gridOffsetTop)px); z-index: 9999; pointer-events: none; background-image: @GetGridBackgroundImage(); background-size: @(gridWidth)px @(gridHeight)px;">
                    </div>
                }

                @if (canvasProject != null)
                {
                    @foreach (var element in canvasProject.GetElementsOrderedByZIndex().Where(e => e is not CanvasBackground))
                    {
                        <div class="canvas-element @(element.IsSelected ? "selected" : "") @(IsElementOutOfBounds(element) ? "out-of-bounds" : "")"
                             style="position: absolute; left: @(element.X)px; top: @(element.Y)px; width: @(element.Width)px; height: @(element.Height)px; z-index: @element.ZIndex; cursor: @(isDragging && draggingElementId == element.Id ? "grabbing" : "grab");"
                             @onclick="(e) => OnElementClick(element.Id, e)"
                             @onmousedown="(e) => StartDrag(element.Id, e)"
                             @onmousedown:stopPropagation="true"
                             draggable="false">

                            @if (element is CanvasImage img)
                            {
                                <img src="@img.Base64Data" style="width: 100%; height: 100%; object-fit: contain; filter: saturate(@(img.Saturation));" draggable="false" />
                            }
                            else if (element is CanvasColorBlock block)
                            {
                                <div style="width: 100%; height: 100%; background-color: @block.Color !important; opacity: @block.Opacity; position: relative; z-index: 1;"></div>
                            }
                            else if (element is CanvasText txt)
                            {
                                <div style="font-family: '@FontService.GetCssFontFamily(txt.FontFamily)'; font-size: @(txt.FontSize)px; color: @txt.FontColor; font-weight: @(txt.IsBold ? "bold" : "normal"); font-style: @(txt.IsItalic ? "italic" : "normal"); text-align: @txt.TextAlign; width: 100%; height: 100%; display: flex; align-items: center; justify-content: @GetJustifyContent(txt.TextAlign); @GetTextShadowStyle(txt)">
                                    @txt.Text
                                </div>
                            }

                            @if (element.IsSelected)
                            {
                                <div class="resize-handles">
                                    <div class="resize-handle nw" @onmousedown="(e) => StartResize(element.Id, resizeNw, e)" @onmousedown:stopPropagation="true"></div>
                                    <div class="resize-handle ne" @onmousedown="(e) => StartResize(element.Id, resizeNe, e)" @onmousedown:stopPropagation="true"></div>
                                    <div class="resize-handle sw" @onmousedown="(e) => StartResize(element.Id, resizeSw, e)" @onmousedown:stopPropagation="true"></div>
                                    <div class="resize-handle se" @onmousedown="(e) => StartResize(element.Id, resizeSe, e)" @onmousedown:stopPropagation="true"></div>
                                </div>
                            }
                        </div>
                    }
                }
                    </div>
                </div>
            </div>
        </div>

        <div class="controls-panel">
            <div class="control-section">
                <h4>Elements</h4>
                <div class="asset-list">
                    @if (canvasProject != null)
                    {
                        @foreach (var element in canvasProject.Elements.Where(e => e is not CanvasBackground).OrderByDescending(e => e.ZIndex))
                        {
                            <div class="asset-item @(element.IsSelected ? "selected" : "") @(dragOverElementId == element.Id && draggingZOrderElementId != null ? "drag-over" : "")"
                                 @onclick="() => SelectElement(element.Id)"
                                 draggable="true"
                                 @ondragstart="(e) => OnElementDragStart(e, element.Id)"
                                 @ondragover="(e) => OnElementDragOver(e, element.Id)"
                                 @ondragover:preventDefault="true"
                                 @ondragleave="() => OnElementDragLeave(element.Id)"
                                 @ondrop="(e) => OnElementDrop(e, element.Id)"
                                 @ondrop:preventDefault="true">
                                <div class="asset-info">
                                    <span class="drag-handle" title="Drag to reorder">&#8801;</span>
                                    @if (element is CanvasImage img)
                                    {
                                        <span class="element-name">Image: @img.FileName</span>
                                    }
                                    else if (element is CanvasText txt)
                                    {
                                        <span class="element-name">Text: @(txt.Text.Length > 20 ? txt.Text.Substring(0, 20) + "..." : txt.Text)</span>
                                    }
                                    else if (element is CanvasColorBlock blk)
                                    {
                                        <span class="element-name">Color Block</span>
                                    }
                                </div>
                                <button class="dx-btn dx-btn-red" style="padding: 2px 8px; font-size: 0.8rem;" @onclick="() => RemoveElement(element.Id)" @onclick:stopPropagation="true">
                                    X
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="control-section">
                <h4>Add Elements</h4>
                <div class="element-buttons">
                    <button class="btn btn-outline-primary" @onclick="ShowImageUploadModal">
                        Upload Image
                    </button>
                    <button class="btn btn-outline-primary" @onclick="AddTextElement">
                        Add Text
                    </button>
                    <button class="btn btn-outline-primary" @onclick="AddColorBlockElement">
                        Add Color Block
                    </button>
                </div>
            </div>

            <div class="control-section">
                <h4>Background</h4>
                <div class="mb-2">
                    <label class="form-check">
                        <input class="dx-checkbox" type="checkbox" @onchange="OnBackgroundTransparentChanged" checked="@isBackgroundTransparent" />
                        Transparent Background
                    </label>
                </div>
                @if (!isBackgroundTransparent)
                {
                    <div class="mb-2">
                        <label class="form-label">Background Color:</label>
                        <input type="color" class="form-control form-control-color" @bind="BackgroundColorValue" @bind:event="oninput" />
                    </div>
                }
            </div>

            <div class="control-section">
                <h4>Grid & Snap</h4>
                <div class="mb-2">
                    <label class="form-check">
                        <input class="dx-checkbox" type="checkbox" @bind="showGrid" />
                        Show Grid
                    </label>
                </div>
                @if (showGrid)
                {
                    <div class="grid-controls">
                        <div class="grid-control">
                            <label>Width (px):</label>
                            <input type="number" @bind="gridWidth" min="5" max="100" />
                        </div>

                        <div class="grid-control">
                            <label>Height (px):</label>
                            <input type="number" @bind="gridHeight" min="5" max="100" />
                        </div>

                        <div class="grid-control">
                            <label>Offset Top:</label>
                            <input type="number" @bind="gridOffsetTop" min="0" max="100" />
                        </div>

                        <div class="grid-control">
                            <label>Offset Left:</label>
                            <input type="number" @bind="gridOffsetLeft" min="0" max="100" />
                        </div>

                        <div class="grid-control">
                            <label>Snap Distance:</label>
                            <input type="number" @bind="snapThreshold" min="1" max="50" />
                        </div>

                        <div class="grid-control">
                            <label>Color:</label>
                            <input type="color" @bind="gridColor" @bind:event="oninput" />
                        </div>
                    </div>
                }
            </div>

            @if (selectedElement != null)
            {
                <div class="control-section">
                    <h4>Element Properties</h4>

                    @if (selectedElement is CanvasImage imageElement)
                    {
                        <div class="image-controls">
                            <label>Saturation:</label>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <input type="range" @bind="imageElement.Saturation" min="0" max="2" step="0.1" @bind:event="oninput" style="flex: 1;" />
                                <span style="font-size: 0.8em; color: #666; min-width: 60px;">@(Math.Round(imageElement.Saturation * 100))%</span>
                            </div>
                        </div>
                    }
                    else if (selectedElement is CanvasColorBlock colorBlockElement)
                    {
                        <div class="color-block-controls">
                            <label>Color:</label>
                            <input type="color" @bind="colorBlockElement.Color" @bind:event="oninput" style="width: 100%; margin-bottom: 10px;" />

                            <label>Opacity:</label>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <input type="range" @bind="colorBlockElement.Opacity" min="0" max="1" step="0.05" @bind:event="oninput" style="flex: 1;" />
                                <span style="font-size: 0.8em; color: #666; min-width: 40px;">@(Math.Round(colorBlockElement.Opacity * 100))%</span>
                            </div>
                        </div>
                    }
                    else if (selectedElement is CanvasText textElement)
                    {
                        <div class="text-controls">
                            <label>Text:</label>
                            <input type="text" @bind="textElement.Text" @bind:event="oninput" />

                            <label>Font:</label>
                            <select @bind="textElement.FontFamily">
                                @if (availableFonts != null)
                                {
                                    @foreach (var font in availableFonts)
                                    {
                                        <option value="@font">@font</option>
                                    }
                                }
                            </select>

                            <label>Size:</label>
                            <input type="number" @bind="textElement.FontSize" min="8" max="200" @bind:event="oninput" />

                            <label>Color:</label>
                            <input type="color" @bind="textElement.FontColor" @bind:event="oninput" />

                            <label>
                                <input type="checkbox" class="dx-checkbox" @bind="textElement.IsBold" />
                                Bold
                            </label>

                            <label>
                                <input type="checkbox" class="dx-checkbox" @bind="textElement.IsItalic" />
                                Italic
                            </label>

                            <label>Alignment:</label>
                            <select @bind="textElement.TextAlign">
                                <option value="left">Left</option>
                                <option value="center">Center</option>
                                <option value="right">Right</option>
                            </select>

                            <!-- Shadow Controls -->
                            <div class="shadow-controls" style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #ddd;">
                                <h6>Drop Shadow</h6>

                                <label>
                                    <input type="checkbox" class="dx-checkbox" @bind="textElement.HasShadow" @bind:event="onchange" />
                                    Enable Shadow
                                </label>

                                @if (textElement.HasShadow)
                                {
                                    <div class="shadow-grid">
                                        <div class="shadow-control">
                                            <label>Offset X:</label>
                                            <input type="number" @bind="textElement.ShadowOffsetX" min="-20" max="20" step="1" @bind:event="oninput" />
                                        </div>

                                        <div class="shadow-control">
                                            <label>Offset Y:</label>
                                            <input type="number" @bind="textElement.ShadowOffsetY" min="-20" max="20" step="1" @bind:event="oninput" />
                                        </div>

                                        <div class="shadow-control">
                                            <label>Blur:</label>
                                            <input type="number" @bind="textElement.ShadowBlur" min="0" max="20" step="1" @bind:event="oninput" />
                                        </div>

                                        <div class="shadow-control">
                                            <label>Color:</label>
                                            <input type="color" @bind="textElement.ShadowColor" @bind:event="oninput" />
                                        </div>
                                    </div>

                                    <div class="opacity-control">
                                        <label>Opacity:</label>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <input type="range" @bind="textElement.ShadowOpacity" min="0" max="1" step="0.1" @bind:event="oninput" style="flex: 1;" />
                                            <span style="font-size: 0.8em; color: #666; min-width: 40px;">@(Math.Round(textElement.ShadowOpacity * 100))%</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Common element properties -->
                    <div class="element-properties">
                        <h5>Position & Size</h5>

                        <div class="fit-controls">
                            <button class="btn btn-sm btn-outline-primary" @onclick="FitElementVertically">Fit Vertically</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="FitElementHorizontally">Fit Horizontally</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="CenterElementVertically">Center Vertically</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="CenterElementHorizontally">Center Horizontally</button>
                        </div>

                        <div class="position-controls">
                            <label>Left (X):</label>
                            <input type="number" @bind="ElementXRounded" @bind:event="oninput" step="1" />

                            <label>Top (Y):</label>
                            <input type="number" @bind="ElementYRounded" @bind:event="oninput" step="1" />
                        </div>

                        <div class="size-controls">
                            <label>Width:</label>
                            <input type="number" @bind="ElementWidthRounded" @bind:event="oninput" step="1" min="1" />

                            <label>Height:</label>
                            <input type="number" @bind="ElementHeightRounded" @bind:event="oninput" step="1" min="1" />
                        </div>
                    </div>
                </div>
            }


        </div>
    </div>
</div>

<!-- Image Upload Modal -->
@if (showImageUploadModal)
{
    <div class="modal fade show" style="display: flex; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background-color: var(--dx-blue); color: white;">
                    <h5 class="modal-title">Upload Image</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideImageUploadModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select an image file:</label>
                        <InputFile class="form-control mt-3" @ref="imageInput" OnChange="OnImageUpload" accept="image/*" />
                    </div>
                    @if (uploadError != null)
                    {
                        <div class="alert alert-danger">
                            @uploadError
                        </div>
                    }
                    @if (isUploading)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Uploading...</span>
                            </div>
                            <p class="mt-2">Uploading image...</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="dx-btn dx-btn-gray" @onclick="HideImageUploadModal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<MediaAssetUploader @ref="mediaUploaderModal" OnAssetSubmit="OnMediaUploaderSubmit" />

@code {
    [Parameter, SupplyParameterFromQuery] public int LocationId { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? ConstraintId { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? DisplayId { get; set; }
    [Parameter, SupplyParameterFromQuery] public double Width { get; set; } = 800;
    [Parameter, SupplyParameterFromQuery] public double Height { get; set; } = 600;

    private CanvasProject? canvasProject;
    private CanvasElement? selectedElement;
    private bool isGenerating = false;
    private InputFile? imageInput;
    private bool showImageUploadModal = false;
    private bool isUploading = false;
    private string? uploadError = null;
    private MediaAssetUploader? mediaUploaderModal;

    private Stack<string> undoHistory = new Stack<string>();
    private const int MaxUndoSteps = 20;

    private bool showGrid = false;
    private int gridWidth = 20;
    private int gridHeight = 20;
    private int gridOffsetTop = 0;
    private int gridOffsetLeft = 0;
    private int snapThreshold = 10;
    private string gridColor = "#cccccc";
    private bool isBackgroundTransparent = false;

    private double zoomLevel = 1.0;
    private double baseCanvasWidth => canvasProject?.CanvasWidth ?? 800;
    private double baseCanvasHeight => canvasProject?.CanvasHeight ?? 600;

    private bool isDragging = false;
    private string? draggingElementId = null;
    private double dragStartMouseX = 0;
    private double dragStartMouseY = 0;
    private double dragStartElementX = 0;
    private double dragStartElementY = 0;

    private string? draggingZOrderElementId = null;
    private string? dragOverElementId = null;

    private bool isResizing = false;
    private string? resizingElementId = null;
    private string resizeDirection = "";
    private double resizeStartX = 0;
    private double resizeStartY = 0;
    private double resizeStartWidth = 0;
    private double resizeStartHeight = 0;
    private double resizeStartElementX = 0;
    private double resizeStartElementY = 0;

    private const string resizeNw = "nw";
    private const string resizeNe = "ne";
    private const string resizeSw = "sw";
    private const string resizeSe = "se";

    private string backgroundColorValue = "#FFFFFF";
    private string customFileName = "";
    private List<string>? availableFonts;

    private string BackgroundColorValue
    {
        get => backgroundColorValue;
        set
        {
            backgroundColorValue = value;
            if (canvasProject?.Background != null)
            {
                canvasProject.Background.BackgroundColor = value;
                StateHasChanged();
            }
        }
    }

    private void OnBackgroundTransparentChanged(ChangeEventArgs e)
    {
        isBackgroundTransparent = (bool?)e.Value ?? false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        canvasProject = new CanvasProject(Width, Height, LocationId, ConstraintId);
        BackgroundColorValue = canvasProject.Background?.BackgroundColor ?? "#FFFFFF";

        var location = await dbContext.TblLocations.FirstOrDefaultAsync(x => x.LocationId == LocationId);
        availableFonts = await FontService.GetAvailableFontsAsync();

        if (baseCanvasWidth > 2000 || baseCanvasHeight > 1000)
        {
            var estimatedZoom = Math.Min(1200.0 / baseCanvasWidth, 600.0 / baseCanvasHeight);
            zoomLevel = Math.Max(estimatedZoom, 0.1);
        }

        SaveStateForUndo();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FitToScreen();
            await JSRuntime.InvokeVoidAsync("setupKeyboardListeners", DotNetObjectReference.Create(this));
        }
    }

    private void GoBack() { Navigation.NavigateTo($"/location/{LocationId}"); }

    private void SelectElement(string elementId)
    {
        if (canvasProject == null) return;
        foreach (var element in canvasProject.Elements)
            element.IsSelected = element.Id == elementId;
        selectedElement = canvasProject.Elements.FirstOrDefault(e => e.Id == elementId);
        StateHasChanged();
    }

    private void OnElementClick(string elementId, MouseEventArgs e)
    {
        if (!isDragging && !isResizing) SelectElement(elementId);
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        if (canvasProject == null || e.File == null) return;
        isUploading = true;
        uploadError = null;
        StateHasChanged();

        try
        {
            var file = e.File;
            if (!file.ContentType.StartsWith("image/")) { uploadError = "Please select a valid image file."; return; }
            if (file.Size > 10 * 1024 * 1024) { uploadError = "File size must be less than 10MB."; return; }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var buffer = memoryStream.ToArray();

            var base64 = Convert.ToBase64String(buffer);
            var dataUrl = $"data:{file.ContentType};base64,{base64}";

            using var skImage = SkiaSharp.SKImage.FromEncodedData(buffer);
            if (skImage == null) { uploadError = "Unable to process the image file."; return; }

            var canvasImage = new CanvasImage
            {
                FileName = file.Name,
                Base64Data = dataUrl,
                OriginalWidth = skImage.Width,
                OriginalHeight = skImage.Height,
                Width = skImage.Width,
                Height = skImage.Height
            };

            (canvasImage.X, canvasImage.Y) = SnapElementToGrid(canvasImage, 0, 0);
            canvasProject.AddElement(canvasImage);
            SelectElement(canvasImage.Id);
            SaveStateForUndo();
            HideImageUploadModal();
        }
        catch (Exception ex) { uploadError = $"Error uploading image: {ex.Message}"; }
        finally { isUploading = false; StateHasChanged(); }
    }

    private void ShowImageUploadModal() { showImageUploadModal = true; uploadError = null; StateHasChanged(); }
    private void HideImageUploadModal() { showImageUploadModal = false; uploadError = null; isUploading = false; StateHasChanged(); }

