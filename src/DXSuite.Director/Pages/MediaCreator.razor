    private async Task OnMediaUploaderSubmit() { Navigation.NavigateTo($"/location/{LocationId}"); }

    private async Task PopulateRequiredMetadata(MediaFile mediaFile)
    {
        mediaFile.Metadata.Add(new MetadataField { Name = "Location", DataType = "ovx_String", Value = LocationId.ToString() });
        var fileName = Path.GetFileName(mediaFile.DiskPath);
        mediaFile.Metadata.Add(new MetadataField { Name = "FileName", DataType = "ovx_String", Value = fileName });
        var nextPlayOrder = await GetNextPlayOrder();
        mediaFile.Metadata.Add(new MetadataField { Name = "PlayOrder", DataType = "ovx_String", Value = nextPlayOrder.ToString() });
    }

    private async Task<int> GetNextPlayOrder()
    {
        try
        {
            var baseDirectory = MediaPaths.GetRoot();
            var uploadDirectory = Path.Combine(baseDirectory, "MediaAssets", LocationId.ToString());
            if (!Directory.Exists(uploadDirectory)) return 1;
            int highestOrder = 0;
            foreach (string file in Directory.GetFiles(uploadDirectory, "*", SearchOption.AllDirectories).Where(s => !s.EndsWith(".metadata") && !s.EndsWith(".db")))
            {
                string metadataFilePath = file + ".metadata";
                if (File.Exists(metadataFilePath))
                {
                    try
                    {
                        var doc = new System.Xml.XmlDocument(); doc.Load(metadataFilePath);
                        var nodes = doc.SelectNodes("usermetadata");
                        foreach (System.Xml.XmlNode node in nodes)
                        {
                            foreach (System.Xml.XmlNode line in node.ChildNodes)
                            {
                                if (line.NodeType == System.Xml.XmlNodeType.Element && line.Name == "field" && line.Attributes?["name"]?.Value == "Location" && line.Attributes?["value"]?.Value == LocationId.ToString())
                                {
                                    foreach (System.Xml.XmlNode childNode in node.ChildNodes)
                                    {
                                        if (childNode.NodeType == System.Xml.XmlNodeType.Element && childNode.Name == "field" && childNode.Attributes?["name"]?.Value == "PlayOrder")
                                        {
                                            if (int.TryParse(childNode.Attributes?["value"]?.Value, out int order)) highestOrder = Math.Max(highestOrder, order);
                                        }
                                    }
                                    break;
                                }
                            }
                        }
                    }
                    catch (Exception ex) { Logger.LogError(ex, "Error reading metadata from {MetadataFilePath}", metadataFilePath); }
                }
            }
            return highestOrder + 1;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error determining next play order"); return 1; }
    }

    private void FitElementVertically() { if (selectedElement != null && canvasProject != null) { selectedElement.Y = 0; selectedElement.Height = canvasProject.CanvasHeight; StateHasChanged(); } }
    private void FitElementHorizontally() { if (selectedElement != null && canvasProject != null) { selectedElement.X = 0; selectedElement.Width = canvasProject.CanvasWidth; StateHasChanged(); } }
    private void CenterElementVertically() { if (selectedElement != null && canvasProject != null) { selectedElement.Y = (canvasProject.CanvasHeight - selectedElement.Height) / 2; StateHasChanged(); } }
    private void CenterElementHorizontally() { if (selectedElement != null && canvasProject != null) { selectedElement.X = (canvasProject.CanvasWidth - selectedElement.Width) / 2; StateHasChanged(); } }

    private int ElementXRounded { get => selectedElement != null ? (int)Math.Round(selectedElement.X) : 0; set { if (selectedElement != null) { selectedElement.X = value; StateHasChanged(); } } }
    private int ElementYRounded { get => selectedElement != null ? (int)Math.Round(selectedElement.Y) : 0; set { if (selectedElement != null) { selectedElement.Y = value; StateHasChanged(); } } }
    private int ElementWidthRounded { get => selectedElement != null ? (int)Math.Round(selectedElement.Width) : 0; set { if (selectedElement != null) { selectedElement.Width = Math.Max(1, value); StateHasChanged(); } } }
    private int ElementHeightRounded { get => selectedElement != null ? (int)Math.Round(selectedElement.Height) : 0; set { if (selectedElement != null) { selectedElement.Height = Math.Max(1, value); StateHasChanged(); } } }

    private bool IsElementOutOfBounds(CanvasElement element)
    {
        if (canvasProject == null) return false;
        return element.X < 0 || element.Y < 0 || element.X + element.Width > canvasProject.CanvasWidth || element.Y + element.Height > canvasProject.CanvasHeight;
    }

    private async Task CreateMetadataFile(MediaFile mediaFile)
    {
        try
        {
            var metadataFilePath = mediaFile.DiskPath + ".metadata";
            using (var writer = new StreamWriter(metadataFilePath))
            {
                await writer.WriteLineAsync("<usermetadata>");
                foreach (var metadata in mediaFile.Metadata)
                    await writer.WriteLineAsync($"  <field name=\"{metadata.Name}\" datatype=\"{metadata.DataType}\" value=\"{metadata.Value}\" />");
                await writer.WriteLineAsync("</usermetadata>");
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error creating metadata file"); }
    }
}
