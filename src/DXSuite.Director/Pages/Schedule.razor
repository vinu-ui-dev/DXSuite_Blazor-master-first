    private async Task DeleteScheduleEntry(int scheduleEventId)
    {
        using (var scope = scopeFactory.CreateScope())
        {
            var dataContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();
            if (await scheduleEvents.DeleteEventAsync(scheduleEventId)) {
                // LocationType must be re-included so the TVController route guard stays accurate after delete.
                display = await dataContext.TblDisplays
                    .Include(s => s.TblScheduleEvents)
                    .Include(d => d.Endpoint)
                    .Include(d => d.Location)
                        .ThenInclude(l => l.LocationType)
                    .FirstOrDefaultAsync(x => x.DisplayId == DisplayId);
                if (schedulePreview != null)
                {
                    await schedulePreview.RefreshSchedule(display);
                }
            }

        }
        ShowScheduleEvents();
    }

    private async Task SaveScheduleEntry()
    {
        using (var scope = scopeFactory.CreateScope())
        {
            var dataContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();

            if(display != null && newScheduleEvent != null && contentList.Count > 0){

                // Hard block on overlapping schedules: an entry that collides with an
                // existing one cannot be saved. Pre-existing overlaps between untouched
                // legacy entries are only flagged visually on the calendar.
                if (!newScheduleEvent.DefaultContent)
                {
                    overlapConflicts = ScheduleOverlapValidator.FindDisplayOverlaps(
                        display.TblScheduleEvents, newScheduleEvent);
                    if (overlapConflicts.Count > 0)
                    {
                        StateHasChanged();
                        return;
                    }
                }

                ContentAssignment contentAssignment = new ContentAssignment(contentList);

                if (display.UseClock)
                {
                    try
                    {
                        ContentAssignment? clockData = newScheduleEvent.DefaultContent
                            ? defaultContentEditor?.GetContentAssignmentWithClock()
                            : scheduleEditor?.GetContentAssignmentWithClock();

                        if (clockData != null)
                        {
                            contentAssignment.UseClock = clockData.UseClock;
                            contentAssignment.ClockX = clockData.ClockX;
                            contentAssignment.ClockY = clockData.ClockY;
                            contentAssignment.ClockWidth = clockData.ClockWidth;
                            contentAssignment.ClockHeight = clockData.ClockHeight;
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Error retrieving clock data");
                    }
                }

                await scheduleEvents.SaveEventAsync(newScheduleEvent, JsonConvert.SerializeObject(contentAssignment, JsonSettings));

                // Update .metadata files for all assets in this schedule event
                await UpdateScheduleMetadataFilesAsync(dataContext, contentAssignment);

                newScheduleEvent = null;
                contentList = new List<ContentItem>();
                // LocationType must be re-included so the TVController route guard stays accurate after save.
                display = await dataContext.TblDisplays
                    .Include(s => s.TblScheduleEvents)
                    .Include(d => d.Endpoint)
                    .Include(d => d.Location)
                        .ThenInclude(l => l.LocationType)
                    .FirstOrDefaultAsync(x => x.DisplayId == DisplayId);
                if (schedulePreview != null)
                {
                    await schedulePreview.RefreshSchedule(display);
                }
                showDefaultContentModal = false;
                showScheduleEntryModal = false;
                scheduleModalNotice = null;
                overlapConflicts.Clear();
                ShowScheduleEvents();
            }
        }
    }

    /// <summary>
    /// Writes/updates .metadata sidecar files for all assets in a schedule content assignment.
    /// For assets that appear in multiple schedule events, builds a JSON Schedule array.
    /// </summary>
    private async Task UpdateScheduleMetadataFilesAsync(IDirectorDBContext dataContext, ContentAssignment contentAssignment)
    {
        try
        {
            if (display == null) return;

            var assetIds = contentAssignment.Content.Select(c => c.AssetId).Distinct().ToList();
            if (assetIds.Count == 0) return;

            var assets = await dataContext.TblAssets
                .Where(a => assetIds.Contains(a.AssetId) && !a.IsDeleted)
                .ToListAsync();

            // Load all schedule events for this display to build composite Schedule arrays
            var allEvents = await dataContext.TblScheduleEvents
                .Where(e => e.DisplayId == display.DisplayId)
                .ToListAsync();

            var wwwroot = MediaPaths.GetRoot();

            foreach (var asset in assets)
            {
                var diskPath = Path.Combine(wwwroot, asset.AssetPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (!System.IO.File.Exists(diskPath)) continue;

                var metadataPath = diskPath + ".metadata";

                // Find all events that reference this asset
                var eventsForAsset = allEvents
                    .Where(e => !string.IsNullOrEmpty(e.ContentAssignment))
                    .Where(e =>
                    {
                        try
                        {
                            var ca = JsonConvert.DeserializeObject<ContentAssignment>(e.ContentAssignment, JsonSettings);
                            return ca?.Content?.Any(c => c.AssetId == asset.AssetId) == true;
                        }
                        catch { return false; }
                    })
                    .ToList();

                // Build Schedule array from all events
                var scheduleEntries = eventsForAsset.Select(e => new
                {
                    startDate = e.StartDate?.ToString("yyyy-MM-dd") ?? "",
                    endDate = e.EndDate?.ToString("yyyy-MM-dd") ?? "",
                    startTime = e.StartTime?.ToString("HH:mm:ss") ?? "",
                    endTime = e.EndTime?.ToString("HH:mm:ss") ?? "",
                    days = ConvertDayBoolsToArray(e)
                }).ToList();

                var scheduleJson = System.Text.Json.JsonSerializer.Serialize(scheduleEntries);

                // Write metadata XML
                WriteScheduleMetadataFile(metadataPath, asset.LocationId.ToString(), Path.GetFileName(diskPath), scheduleJson);

                metadataCache.Invalidate(diskPath);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating schedule metadata files");
        }
    }

    private static List<string> ConvertDayBoolsToArray(TblScheduleEvent evt)
    {
        var days = new List<string>();
        if (evt.Monday) days.Add("Mo");
        if (evt.Tuesday) days.Add("Tu");
        if (evt.Wednesday) days.Add("We");
        if (evt.Thursday) days.Add("Th");
        if (evt.Friday) days.Add("Fr");
        if (evt.Saturday) days.Add("Sa");
        if (evt.Sunday) days.Add("Su");
        return days;
    }

    private void WriteScheduleMetadataFile(string metadataPath, string locationId, string fileName, string scheduleJson)
    {
        try
        {
            System.Xml.XmlDocument doc;
            System.Xml.XmlNode root;

            if (System.IO.File.Exists(metadataPath))
            {
                doc = new System.Xml.XmlDocument();
                doc.Load(metadataPath);
                root = doc.SelectSingleNode("usermetadata") ?? doc.DocumentElement!;
            }
            else
            {
                doc = new System.Xml.XmlDocument();
                var decl = doc.CreateXmlDeclaration("1.0", "utf-8", null);
                doc.AppendChild(decl);
                root = doc.CreateElement("usermetadata");
                doc.AppendChild(root);
            }

            SetMetadataField(doc, root, "Location", "ovx_String", locationId);
            SetMetadataField(doc, root, "FileName", "ovx_String", fileName);
            SetMetadataField(doc, root, "Schedule", "ovx_Json", scheduleJson);

            doc.Save(metadataPath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error writing schedule metadata file {Path}", metadataPath);
        }
    }

    private static void SetMetadataField(System.Xml.XmlDocument doc, System.Xml.XmlNode root, string name, string datatype, string value)
    {
        var existing = root.SelectSingleNode($"field[@name='{name}']");
        if (existing != null)
        {
            existing.Attributes!["value"]!.Value = value;
        }
        else
        {
            var el = doc.CreateElement("field");
            el.SetAttribute("name", name);
            el.SetAttribute("datatype", datatype);
            el.SetAttribute("value", value);
            root.AppendChild(el);
        }
    }

    private string GetDayString(TblScheduleEvent scheduleEvent){
        StringBuilder result = new StringBuilder();
        int totalDays = 0;
        if(scheduleEvent.Sunday){
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Sunday) + ", ");
            totalDays++;
        }
        if (scheduleEvent.Monday)
        {
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Monday) + ", ");
            totalDays++;
        }
        if (scheduleEvent.Tuesday)
        {
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Tuesday) + ", ");
            totalDays++;
        }
        if (scheduleEvent.Wednesday)
        {
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Wednesday) + ", ");
            totalDays++;
        }
        if (scheduleEvent.Thursday)
        {
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Thursday) + ", ");
            totalDays++;
        }
        if (scheduleEvent.Friday)
        {
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Friday) + ", ");
            totalDays++;
        }
        if (scheduleEvent.Saturday)
        {
            result.AppendLine(CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(DayOfWeek.Saturday) + ", ");
            totalDays++;
        }
        if (totalDays == 7)
            return "Daily";
        else
            return result.ToString().Trim().TrimEnd(',');
    }

    private bool HasAnyDaySelected(TblScheduleEvent scheduleEvent)
    {
        return scheduleEvent.Sunday || scheduleEvent.Monday || scheduleEvent.Tuesday ||
               scheduleEvent.Wednesday || scheduleEvent.Thursday || scheduleEvent.Friday || scheduleEvent.Saturday;
    }

    private string GetContentSummary(TblScheduleEvent eventItem)
    {
        try
        {
            ContentAssignment? eventContentAssignment = JsonConvert.DeserializeObject<ContentAssignment>(eventItem.ContentAssignment);
            if (eventContentAssignment != null && eventContentAssignment.Content.Any())
            {
                var count = eventContentAssignment.Content.Count;
                return $"{count} content item{(count != 1 ? "s" : "")} assigned";
            }
            return "No content assigned";
        }
        catch
        {
            return "Content assignment error";
        }
    }

    private void OpenContentModal(ContentAssignment contentAssignment, TblScheduleEvent scheduleEvent)
    {
        selectedContentAssignment = contentAssignment;
        selectedScheduleEvent = scheduleEvent;
        showContentModal = true;
    }

    private void CloseContentModal()
    {
        showContentModal = false;
        selectedContentAssignment = null;
        selectedScheduleEvent = null;
    }

    private void DragStart(TblAsset asset)
    {
        dragMediaAsset = asset;

    }

    private void HandleDragEnter()
    {
        dropClass = "can-drop";
    }

    private void HandleDragLeave()
    {
        dropClass = "";
    }

    private async Task HandleDrop()
    {
        if (dragMediaAsset != null)
        {
            // In single-assets-only mode, replace the existing asset rather than appending
            if (singleAssetsOnly)
                contentList.Clear();
            contentList.Add(new ContentItem(dragMediaAsset));
        }
        dragMediaAsset = null;
    }

    private void OpenMediaUploader(MediaFile? editMediaFile)
    {
        TblEndpoint? endpoint = null;

        if(display.Endpoint is not null)
        {
            endpoint = display.Endpoint;
        }

        sessionState.LocationAccessMap.TryGetValue(display.LocationId, out var access);

        var config = new MediaUploadConfig
            {
                UploadFolder = baseDirectory,
                LocationId = display.LocationId,
                DisplayId = display.DisplayId,
                ConstraintId = display.ConstraintId,
                ExpectedWidth = display.DisplayWidth,
                ExpectedHeight = display.DisplayHeight,
                EditMediaFile = null,
                AddToSql = true,
                IsSchedulable = false,
                VideoMask = display.UseVideoMask,
                Endpoint = endpoint,
                EnableContentApproval = display.EnableContentApproval,
                UserAccess = access,
    };

        mediaUploaderModal.Open(config);
    }

    private void OpenMediaCreator()
    {
        var url = $"/mediacreator?LocationId={display.LocationId}&ConstraintId={display.ConstraintId}&Width={display.DisplayWidth}&Height={display.DisplayHeight}";
        navMan.NavigateTo(url);
    }

    private void OpenWebUploader()
    {
        webUploaderModal?.Open(display.LocationId, display.ConstraintId, display.DisplayWidth, display.DisplayHeight);
    }

    private void OpenWebAssetEditor(TblAsset asset)
    {
        webUploaderModal?.OpenForEdit(asset);
    }

    private void OpenStreamUploader()
    {
        streamUploaderModal?.Open(display.LocationId, display.ConstraintId);
    }

    private string GetDisplayUrl(string url)
    {
        try
        {
            var uri = new Uri(url);
            return uri.Host + (uri.PathAndQuery.Length > 1 ? uri.PathAndQuery : "");
        }
        catch
        {
            return url;
        }
    }

    private string GetAssetTypeName(int assetTypeId)
    {
        return assetTypeId switch
        {
            (int)Types.AssetType.Image => "Image",
            (int)Types.AssetType.Video => "Video",
            (int)Types.AssetType.Web => "Web",
            (int)Types.AssetType.Stream => "Stream",
            _ => "Unknown"
        };
    }
}

