    private string GetStatusColor() => GetDisplayStatusText() switch
    {
        "Showing override content"  => "var(--dx-orange)",
        "Showing scheduled content" => "var(--dx-green)",
        "Showing default content"   => "var(--dx-blue)",
        _                           => "var(--dx-gray)"
    };

    private string GetDisplayStatusText()
    {
        if (display == null) return "";
        if (display.DisplayMode == 1) return "Showing override content";

        var now = DateTime.Now;

        foreach (var evt in display.TblScheduleEvents.Where(x => !x.DefaultContent))
        {
            // Date bounds are inclusive and compared by calendar date so the start and end days
            // both count (matches the runtime evaluation in DisplayItem.GetActiveEvent).
            if (evt.StartDate != null && now.Date < evt.StartDate.Value.Date) continue;
            if (evt.EndDate != null && now.Date > evt.EndDate.Value.Date) continue;

            // The time of day is deliberately not evaluated here. This runs in Blazor Server, so
            // DateTime.Now is the Director host's clock, not the author's and not the display's,
            // and a badge that is right only when a display happens to sit in the host's zone is
            // worse than no badge: it is silently wrong in exactly the multi-zone case that matters.
            // Date range and day of week stay, because they are unambiguous.

            bool noDays = !evt.Sunday && !evt.Monday && !evt.Tuesday && !evt.Wednesday
                          && !evt.Thursday && !evt.Friday && !evt.Saturday;
            if (!noDays)
            {
                bool dayMatch = now.DayOfWeek switch
                {
                    DayOfWeek.Sunday    => evt.Sunday,
                    DayOfWeek.Monday    => evt.Monday,
                    DayOfWeek.Tuesday   => evt.Tuesday,
                    DayOfWeek.Wednesday => evt.Wednesday,
                    DayOfWeek.Thursday  => evt.Thursday,
                    DayOfWeek.Friday    => evt.Friday,
                    DayOfWeek.Saturday  => evt.Saturday,
                    _                   => false
                };
                if (!dayMatch) continue;
            }

            return "Showing scheduled content";
        }

        var defaultEvent = display.TblScheduleEvents.FirstOrDefault(x => x.DefaultContent);
        if (defaultEvent != null)
        {
            try
            {
                var ca = JsonConvert.DeserializeObject<ContentAssignment>(defaultEvent.ContentAssignment);
                if (ca?.Content?.Any() == true) return "Showing default content";
            }
            catch { }
        }

        return "No content assigned";
    }

