        if (display == null) return;

        var existingDefault = display.TblScheduleEvents.FirstOrDefault(x => x.DefaultContent);

        if (existingDefault != null)
        {
            newScheduleEvent = existingDefault;
            var assignment = JsonConvert.DeserializeObject<ContentAssignment?>(existingDefault.ContentAssignment);
            contentList = assignment?.Content ?? new List<ContentItem>();
            HydrateContentList(contentList);
            currentEditAssignment = assignment;
