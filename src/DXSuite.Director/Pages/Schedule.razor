    private void HandleCalendarEventMoved(DisplayCalendar.CalendarMove move)
    {
        var source = display?.TblScheduleEvents.FirstOrDefault(e => e.ScheduleEventId == move.ScheduleEventId);
        if (source == null) return;

        var working = CloneScheduleEvent(source);
        var notices = new List<string>();

        // Preserve the entry's duration while shifting its start time
        var effStart = working.StartTime != null ? (int)working.StartTime.Value.ToTimeSpan().TotalMinutes : 0;
        var effEnd = working.EndTime != null ? (int)working.EndTime.Value.ToTimeSpan().TotalMinutes : 1440;
        var duration = effStart > effEnd
            ? (1440 - effStart) + effEnd
            : effEnd - effStart;

        var newStart = move.NewStartMinutes;
        var newEnd = newStart + duration;
        working.StartTime = TimeOnly.MinValue.AddMinutes(newStart);
        working.EndTime = newEnd > 1439 ? new TimeOnly(23, 59) : TimeOnly.MinValue.AddMinutes(newEnd);

        bool hasDayFlags = working.Sunday || working.Monday || working.Tuesday || working.Wednesday
                           || working.Thursday || working.Friday || working.Saturday;

        // One context sentence describing what the drag changed, then the
        // review prompt; the series caveat is folded in where it applies.
        string? context = null;

        if (move.TargetDay != move.SourceDay)
        {
            if (hasDayFlags)
            {
                if (!DayFlagSet(working, move.TargetDay.DayOfWeek))
                {
                    SetDayFlag(working, move.TargetDay.DayOfWeek);
                    context = $"Moving this entry added {move.TargetDay.DayOfWeek} to its active days. The change applies to the whole series.";
                }
                else
                {
                    context = $"This entry already runs on {move.TargetDay.DayOfWeek}s. The new time applies to the whole series.";
                }
            }
            else if (working.StartDate != null && working.EndDate != null
                     && working.StartDate.Value.Date == working.EndDate.Value.Date)
            {
                working.StartDate = move.TargetDay.ToDateTime(TimeOnly.MinValue);
                working.EndDate = move.TargetDay.ToDateTime(TimeOnly.MinValue);
                context = $"This entry was moved to {move.TargetDay:MMM d} (from {move.SourceDay:MMM d}).";
            }
        }

        if (context == null && IsRecurring(working))
        {
            context = "This entry repeats. The new time applies to the whole series.";
        }

        notices.Add(context ?? "This entry's time was changed on the calendar.");
        notices.Add("Review the details below and Save Changes to confirm. Nothing is changed until you save.");
        OpenEditModalForWorkingCopy(source, working, string.Join(" ", notices));
    }

    private void HandleCalendarEventResized(DisplayCalendar.CalendarResize resize)
    {
        var source = display?.TblScheduleEvents.FirstOrDefault(e => e.ScheduleEventId == resize.ScheduleEventId);
        if (source == null) return;

        var working = CloneScheduleEvent(source);
        working.EndTime = TimeOnly.MinValue.AddMinutes(Math.Min(resize.NewEndMinutes, 1439));

        var notice = IsRecurring(working)
            ? "This entry's end time was changed on the calendar. It repeats, so the change applies to the whole series. Review it below and Save Changes to confirm."
            : "This entry's end time was changed on the calendar. Review it below and Save Changes to confirm.";
        OpenEditModalForWorkingCopy(source, working, notice);
    }

