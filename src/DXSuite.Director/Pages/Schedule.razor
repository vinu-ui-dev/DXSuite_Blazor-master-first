    protected override async Task OnInitializedAsync()
    {
        using (var scope = scopeFactory.CreateScope())
        {
            var dbContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();
            display = await dbContext.TblDisplays
                .Include(s => s.TblScheduleEvents)
                .Include(d => d.Endpoint)
                .Include(d => d.Location)
                    .ThenInclude(l => l.LocationType)
                .FirstOrDefaultAsync(x => x.DisplayId == DisplayId);
            if(display != null)
            {
                // TVController locations keep the legacy single-page workflow until their own rework
                if (display.Location?.LocationType?.ComponentTypeName?.EndsWith(".TVController") == true)
                {
                    navMan.NavigateTo($"/schedule-tv/{DisplayId}", replace: true);
                    return;
                }

                assetList = await dbContext.TblAssets
                    .Where(x => x.LocationId == display.LocationId
                             && x.ConstraintId == display.ConstraintId
                             && x.IsDeleted == false
                             // Mask files are supporting artifacts — hide them from the schedule asset picker
                             && (!display.UseVideoMask || !x.AssetPath.EndsWith("_mask.png")))
                    .ToListAsync();
                baseDirectory = MediaPaths.GetRoot();
                var displayExtData = ExtendedDataHelper.Parse<DisplayExtendedData>(display.ExtendedData);
                var locationExtData = ExtendedDataHelper.Parse<LocationExtendedData>(display.Location?.ExtendedData);
                singleAssetsOnly = UploadTypeSettings.ResolveSingleAssetsOnly(displayExtData, locationExtData);
                uploadTypes = UploadTypeSettings.Resolve(displayExtData, locationExtData);
                showFadeButton = displayExtData?.ShowFadeButton ?? false;
                showLiveView = locationExtData?.ShowLiveView ?? false;
                sessionState.LocationAccessMap.TryGetValue(display.LocationId, out userAccess);

                UpdateAspectRatio();
                scaleFactorHalf = ScaleService.GetScaleFactor(display.DisplayWidth, display.DisplayHeight, "half");
                scaleFactorFull = ScaleService.GetScaleFactor(display.DisplayWidth, display.DisplayHeight, "full");

                ShowScheduleEvents();
            }
        }

        // Deep-link support: /schedule/{id}?tab=assets|schedule
        var uri = navMan.ToAbsoluteUri(navMan.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tabValue))
        {
            var tab = tabValue.ToString();
            if (tab is "display" or "assets" or "schedule")
            {
                activeTab = tab;
            }
        }
    }

    private void SetActiveTab(string tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        navMan.NavigateTo(navMan.GetUriWithQueryParameter("tab", tab), replace: true);
    }

