        else
        {
            newScheduleEvent = new TblScheduleEvent()
            {
                DisplayId = display.DisplayId,
                ScheduleEventTypeId = 1,
                DefaultContent = true
            };
            contentList = new List<ContentItem>();
            currentEditAssignment = null;
        }

        showDefaultContentModal = true;
    }

