    // Editing always works on a detached copy so cancelling a modal (or an
    // unconfirmed calendar gesture) never dirties the rendered schedule state.
    private static TblScheduleEvent CloneScheduleEvent(TblScheduleEvent ev) => new()
    {
        ScheduleEventId = ev.ScheduleEventId,
        DisplayId = ev.DisplayId,
        ScheduleEventTypeId = ev.ScheduleEventTypeId,
        DefaultContent = ev.DefaultContent,
        StartDate = ev.StartDate,
        EndDate = ev.EndDate,
        StartTime = ev.StartTime,
        EndTime = ev.EndTime,
        Sunday = ev.Sunday,
        Monday = ev.Monday,
        Tuesday = ev.Tuesday,
        Wednesday = ev.Wednesday,
        Thursday = ev.Thursday,
        Friday = ev.Friday,
        Saturday = ev.Saturday,
        ContentAssignment = ev.ContentAssignment
    };

    private void OpenEditModalFor(TblScheduleEvent source, string? notice = null)
    {
        newScheduleEvent = CloneScheduleEvent(source);
        ContentAssignment? editAssignment = JsonConvert.DeserializeObject<ContentAssignment?>(source.ContentAssignment);
        contentList = editAssignment?.Content ?? new List<ContentItem>();
        HydrateContentList(contentList);
        currentEditAssignment = editAssignment;
        scheduleModalNotice = notice;
        overlapConflicts.Clear();
        showScheduleEntryModal = true;
    }

    // ContentAssignment JSON stores only AssetIds (the serializer strips the
    // Asset navigation), so previews must be re-linked to the loaded asset list.
    private void HydrateContentList(List<ContentItem> items)
    {
        if (assetList == null) return;
        foreach (var item in items)
        {
            item.Asset ??= assetList.FirstOrDefault(a => a.AssetId == item.AssetId);
        }
    }

    private static bool IsRecurring(TblScheduleEvent ev)
    {
        bool hasDayFlags = ev.Sunday || ev.Monday || ev.Tuesday || ev.Wednesday || ev.Thursday || ev.Friday || ev.Saturday;
        bool singleDay = ev.StartDate != null && ev.EndDate != null && ev.StartDate.Value.Date == ev.EndDate.Value.Date;
        return hasDayFlags || !singleDay;
    }

    private static bool DayFlagSet(TblScheduleEvent ev, DayOfWeek day) => day switch
    {
        DayOfWeek.Sunday    => ev.Sunday,
        DayOfWeek.Monday    => ev.Monday,
        DayOfWeek.Tuesday   => ev.Tuesday,
        DayOfWeek.Wednesday => ev.Wednesday,
        DayOfWeek.Thursday  => ev.Thursday,
        DayOfWeek.Friday    => ev.Friday,
        DayOfWeek.Saturday  => ev.Saturday,
        _                   => false
    };

    private static void SetDayFlag(TblScheduleEvent ev, DayOfWeek day)
    {
        switch (day)
        {
            case DayOfWeek.Sunday:    ev.Sunday = true; break;
            case DayOfWeek.Monday:    ev.Monday = true; break;
            case DayOfWeek.Tuesday:   ev.Tuesday = true; break;
            case DayOfWeek.Wednesday: ev.Wednesday = true; break;
            case DayOfWeek.Thursday:  ev.Thursday = true; break;
            case DayOfWeek.Friday:    ev.Friday = true; break;
            case DayOfWeek.Saturday:  ev.Saturday = true; break;
        }
    }

