@using DXSuite.Director.Entities
@using DXSuite.Director.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting

@using DXSuite.Director.Models
@using System.Xml
@inject IServiceScopeFactory scopeFactory;
@inject ILanguageProvider LanguageProvider
@inject IWebHostEnvironment env
@inject ITenantMediaPathResolver MediaPaths
@inject NavigationManager navMan;
@inject ILogger<AssetPlaylist_Languages_Zones> Logger
@rendermode InteractiveServer


@if (Location != null)
{
    <section class="body">
        <div class="dx-section">
            <div class="dx-section-header">
                <h3 class="dx-section-title">@((!string.IsNullOrEmpty(PlaylistName)) ? PlaylistName : "Playlist")</h3>
                <div style="display:flex; gap: 10px;">
                    <LanguageDropdown SelectedLanguageCodeChanged="OnLanguageChanged"/>
                    <button class="dx-btn dx-btn-blue" @onclick="@(() => OpenMediaUploader(null))">ADD MEDIA +</button>
                    <button class="dx-btn dx-btn-blue" @onclick="@(() => OpenMediaCreator())">CREATE MEDIA +</button>
                </div>
            </div>
            <div class="dx-asset-container">
                @if (filteredMediaFiles.Count() == 0)
                {
                    <h5>Click ADD MEDIA + to begin assigning content.</h5>
                }
                else
                {
                    @foreach (var mediaFile in filteredMediaFiles)
                    {
                        <div class="dx-asset-card" style="width:@ContainerWidth.ToString()px;">
                            <div class="dx-asset-preview" style="position:relative;">
                                @if (mediaFile.IsExpired)
                                {
                                    @if ((mediaFile.WebPath.ToUpper().Contains(".MP4")) || (mediaFile.WebPath.ToUpper().Contains(".AVI")))
                                    {
                                        <div style="opacity:0.8;">
                                            <video src="@mediaFile.WebPath" style="object-position:center center; width:100%; height:100%; object-fit:contain; background-color:white;" controlslist="nodownload noplaybackrate" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="opacity:0.5;">
                                            <img src="@mediaFile.WebPath" style="object-position:center center; width:100%; height:100%; object-fit:contain; background-color:white;" name="@mediaFile.WebPath" />
                                        </div>
                                    }
                                    <div style="position:absolute; top:50%; left:50%; transform: translate(-50%, -50%); color:white; text-shadow: 3px 3px 5px rgba(0, 0, 0, 0.7);">
                                        <h3 style="text-align:center;">CONTENT EXPIRED</h3>
                                    </div>
                                }
                                else
                                {
                                    @if ((mediaFile.WebPath.ToUpper().Contains(".MP4")) || (mediaFile.WebPath.ToUpper().Contains(".AVI")))
                                    {
                                        <div>
                                            <video src="@mediaFile.WebPath" style="object-position:center center; width:100%; height:100%; object-fit:contain; background-color:white;" controlslist="nodownload noplaybackrate" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <img src="@mediaFile.WebPath" style="object-position:center center; width:100%; height:100%; object-fit:contain; background-color:white;" name="@mediaFile.WebPath" />
                                        </div>
                                    }
                                }
                            </div>
                            <div class="dx-asset-info">
                                <table width="100%">
                                    <tr>
                                        <td width="30%"></td>
                                        <td width="35%">START</td>
                                        <td width="35%">END</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">DATE</td>
                                        <td width="35%" class="assigned" id="@String.Format("{0}_{1}", mediaFile.DiskPath, "StartDate")">
                                            @{
                                                var startDateField = mediaFile.Metadata.FirstOrDefault(x => x.Name == "StartDate");
                                                string startDate = (startDateField != null && DateTime.TryParse(startDateField.Value, out DateTime parsedStartDate))
                                                ? parsedStartDate.ToString("MM/dd/yyyy")
                                                : "Now";
                                            }
                                            @startDate
                                        </td>
                                        <td width="35%" class="assigned" id="@String.Format("{0}_{1}", mediaFile.DiskPath, "EndDate")">
                                            @{
                                                var endDateField = mediaFile.Metadata.FirstOrDefault(x => x.Name == "EndDate");
                                                string endDate = (endDateField != null && DateTime.TryParse(endDateField.Value, out DateTime parsedEndDate))
                                                ? parsedEndDate.ToString("MM/dd/yyyy")
                                                : "Never";
                                            }
                                            @endDate
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="30%">TIME</td>
                                        <td width="35%" class="assigned" id="@String.Format("{0}_{1}", mediaFile.DiskPath, "StartTime")">
                                            @{
                                                var startTimeMetadata = mediaFile.Metadata.FirstOrDefault(x => x.Name == "StartTime")?.Value;
                                                var startTime = DateTime.TryParse(startTimeMetadata, out DateTime parsedStartTime) ? parsedStartTime.ToString("h:mm tt") : "All Day";
                                            }
                                            @startTime
                                        </td>
                                        <td width="35%" class="assigned" id="@String.Format("{0}_{1}", mediaFile.DiskPath, "EndTime")">
                                            @{
                                                var endTimeMetadata = mediaFile.Metadata.FirstOrDefault(x => x.Name == "EndTime")?.Value;
                                                var endTime = DateTime.TryParse(endTimeMetadata, out DateTime parsedEndTime) ? parsedEndTime.ToString("h:mm tt") : "All Day";
                                            }
                                            @endTime
                                        </td>
                                    </tr>
                                    <tr style="border-top: 2px solid #CCC;">
                                        <td width="30%">LANG</td>
                                        <td width="35%" class="assigned" id="@String.Format("{0}_{1}", mediaFile.DiskPath, "Language")">
                                            @{
                                                var selectedLanguage = allLanguages.FirstOrDefault(x => x.LanguageCode == mediaFile.LanguageCode);
                                                var selectedLanguageName = (selectedLanguage is not null ? selectedLanguage.LanguageName : "");
                                            }
                                            @selectedLanguageName
                                        </td>
                                    </tr>
                                </table>
                                <div class="dx-asset-actions">
                                    <button name="@mediaFile.WebPath" class="dx-btn dx-btn-blue" @onclick="@(() => OpenMediaUploader(mediaFile))">Edit</button>
                                    <button name="@mediaFile.DiskPath" class="dx-btn dx-btn-red" @onclick="@(() => assetDeleteModal.Open(0, Location.LocationId, mediaFile))">Delete</button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}

<MediaAssetUploader @ref="mediaUploaderModal" OnAssetSubmit="UpdateMediaFiles">

</MediaAssetUploader>

<AssetDeleteConfirmation @ref="assetDeleteModal" OnAssetDeletedMediaFile="DeleteMediaFile">

</AssetDeleteConfirmation>

@code {
    [Parameter] public TblLocation? Location { get; set; }
    [Parameter] public string? PlaylistName { get; set; }
    [Parameter] public double contentHeight { get; set; }
    [Parameter] public double contentWidth { get; set; }
    [Parameter] public int constraintId { get; set; }
    [Parameter] public int? ContainerWidth { get; set; } = 300;

    public double scaleFactor { get; set; } = 0.2;
    private MediaAssetUploader? mediaUploaderModal { get; set; }
    private AssetDeleteConfirmation? assetDeleteModal { get; set; }
    private string? baseDirectory;

    List<MediaFile> mediaFiles = new List<MediaFile>();
    List<MediaFile> filteredMediaFiles = new List<MediaFile>();
    private bool alignAssetsVertically = false;

    private List<LanguageInfo> allLanguages = new();
    private string? selectedLanguageCode;

    protected override async Task OnInitializedAsync()
    {
        allLanguages = (await LanguageProvider.GetLanguagesAsync()).ToList();

        await UpdateMediaFiles();
    }

    private async Task DeleteMediaFile(MediaFile mediaFileToDelete)
    {
        bool deleteSuccess = false;
        if (mediaFileToDelete.DiskPath != null)
        {
            if (System.IO.File.Exists(mediaFileToDelete.DiskPath))
            {
                System.IO.File.Delete(mediaFileToDelete.DiskPath);
                deleteSuccess = true;
            }
            if (System.IO.File.Exists(mediaFileToDelete.DiskPath + ".metadata"))
            {
                System.IO.File.Delete(mediaFileToDelete.DiskPath + ".metadata");
            }
        }
        if (deleteSuccess)
        {
            mediaFiles.Remove(mediaFileToDelete);
            StateHasChanged();
        }
    }

    private async Task UpdateMediaFiles()
    {
        try
        {
            DateTime now = DateTime.Now;
            baseDirectory = MediaPaths.GetRoot();

            if (baseDirectory != null && Location != null)
            {
                string uploadDirectory = Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString(), constraintId.ToString());

                List<MediaFile> tempMediaFiles = new();

                foreach (string file in System.IO.Directory.GetFiles(uploadDirectory, "", SearchOption.AllDirectories)
                         .Where(s => !s.EndsWith(".metadata") && !s.EndsWith(".db")))
                {
                    List<MetadataField> metadata = new();
                    string metadataFilePath = file + ".metadata";

                    if (System.IO.File.Exists(metadataFilePath))
                    {
                        XmlDocument doc = new XmlDocument();
                        doc.Load(metadataFilePath);
                        XmlNodeList nodes = doc.SelectNodes("usermetadata");

                        foreach (XmlNode node in nodes)
                        {
                            foreach (XmlNode line in node)
                            {
                                metadata.Add(new MetadataField
                                {
                                    Name = line.Attributes["name"].Value,
                                    DataType = line.Attributes["datatype"].Value,
                                    Value = line.Attributes["value"].Value
                                });
                            }
                        }
                    }

                    var location = metadata.FirstOrDefault(x => x.Name == "Location");

                    if (location?.Value == Location.LocationId.ToString())
                    {
                        MediaFile mf = new()
                            {
                                WebPath = String.Format(@"/MediaAssets/{0}/{1}/{2}", Location.LocationId, constraintId.ToString(), Path.GetFileName(file)),
                                DiskPath = file,
                                Metadata = metadata,
                                LanguageCode = metadata.FirstOrDefault(x => x.Name == "Language")?.Value ?? "eng"
                            };
                        tempMediaFiles.Add(mf);
                    }
                }

                mediaFiles = tempMediaFiles;
                await OnLanguageChanged(selectedLanguageCode);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating media files");
        }
    }

    private void UpdateAspectRatio()
    {
        double aspectRatio = contentHeight / contentWidth;
        if (aspectRatio < 0.3)
        {
            alignAssetsVertically = true;
        }
    }

    private void OpenMediaUploader(MediaFile? editMediaFile)
    {
        var config = new MediaUploadConfig
        {
            UploadFolder = baseDirectory,
            LocationId = Location.LocationId,
            ConstraintId = constraintId,
            ExpectedWidth = contentWidth,
            ExpectedHeight = contentHeight,
            EditMediaFile = editMediaFile,
            AddToSql = false,
            IsSchedulable = true,
            LanguageMetadata = true,
            EnableContentApproval = Location.EnableContentApproval
        };

        mediaUploaderModal.Open(config);
    }

    private async Task OnLanguageChanged(string? languageCode)
    {
        selectedLanguageCode = languageCode;

        if (string.IsNullOrWhiteSpace(selectedLanguageCode))
        {
            filteredMediaFiles = mediaFiles;
        }
        else
        {
            filteredMediaFiles = mediaFiles.Where(mf => mf.LanguageCode == selectedLanguageCode).ToList();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OpenMediaCreator()
    {
        var url = $"/mediacreator?LocationId={Location.LocationId}&ConstraintId={constraintId}&Width={contentWidth}&Height={contentHeight}";
        navMan.NavigateTo(url);
    }

}
