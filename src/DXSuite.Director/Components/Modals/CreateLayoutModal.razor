    public void OpenForEdit(TblLocation location)
    {
        isOpen = true;
        isEditMode = true;
        editingLocationId = location.LocationId;
        currentStep = Step.ConfigureLayout;
        selectedType = LocationType.Layout;

        locationName = location.LocationName ?? "";
        resolutionWidth = (int)(location.BackgroundImageWidth ?? 1920);
        resolutionHeight = (int)(location.BackgroundImageHeight ?? 1080);
        selectedLocationGroupId = location.LocationGroupId;
        newGroupName = "";

        layoutZones.Clear();
        selectedLocation = null;
        errorMessage = null;

        // Parse existing layout configuration from ExtendedData
        if (!string.IsNullOrEmpty(location.ExtendedData))
        {
            try
            {
                var config = JsonSerializer.Deserialize<LayoutConfiguration>(location.ExtendedData, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (config != null)
                {
                    resolutionWidth = (int)config.AspectRatioWidth;
                    resolutionHeight = (int)config.AspectRatioHeight;
                    layoutZones = config.Zones ?? new List<LayoutZone>();
                    nextZoneNumber = layoutZones.Any() ? layoutZones.Max(z => z.ZoneNumber) + 1 : 1;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error parsing layout config");
            }
        }

        LoadDataAsync();
        StateHasChanged();
    }

    public void Close()
    {
        isOpen = false;
        isEditMode = false;
        editingLocationId = null;
        StateHasChanged();
    }

    private async void LoadDataAsync()
    {
        try
        {
            // Load location groups
            locationGroups = await dbContext.TblLocationGroups
                .OrderBy(g => g.SortOrder)
                .ThenBy(g => g.LocationGroupName)
                .ToListAsync();

            // Set default to first group if available
            if (locationGroups.Any() && selectedLocationGroupId == 0)
            {
                selectedLocationGroupId = locationGroups.First().LocationGroupId;
            }

            // Load available locations for Layout type
            availableLocations = await dbContext.TblLocations
                .Include(l => l.TblDisplays)
                .Include(l => l.LocationType)
                .Where(l => l.LocationTypeId == PLAYLIST_LOCATION_TYPE_ID || l.LocationTypeId == CARD_LOCATION_TYPE_ID)
                .OrderBy(l => l.LocationName)
                .ToListAsync();

            // Look up Floorplan and VideoWall type IDs (seeded by migration, not hardcoded)
            var fpType = await dbContext.TblLocationTypes
                .FirstOrDefaultAsync(t => t.LocationTypeName == "Floorplan");
            floorPlanLocationTypeId = fpType?.LocationTypeId;

            var vwType = await dbContext.TblLocationTypes
                .FirstOrDefaultAsync(t => t.LocationTypeName == "VideoWall");
            videoWallLocationTypeId = vwType?.LocationTypeId;

            // Bundle-hosted custom types, recognized by the ComponentTypeName sentinel
            var bundleTypes = await dbContext.TblLocationTypes
                .Where(t => t.ComponentTypeName == LocationBundleConstants.BundleComponentSentinel)
                .ToListAsync();
            customLocationTypeId = bundleTypes.FirstOrDefault(t => !t.LinkedToDisplay)?.LocationTypeId;
            customDisplayLocationTypeId = bundleTypes.FirstOrDefault(t => t.LinkedToDisplay)?.LocationTypeId;

            availableBundles = await dbContext.TblLocationBundles
                .AsNoTracking()
                .Where(b => b.IsEnabled)
                .OrderBy(b => b.Name)
                .ToListAsync();

            // Load all displays and locations for floorplan element management
            allDisplays = await dbContext.TblDisplays.AsNoTracking().OrderBy(d => d.DisplayName).ToListAsync();
            allLocations = await dbContext.TblLocations.AsNoTracking().OrderBy(l => l.LocationName).ToListAsync();

            // Load metadata definitions for Asset Library filters
            metadataDefinitions = await dbContext.TblMetadataDefinitions.OrderBy(m => m.DisplayName).ToListAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
        }
    }

    private void NextStep()
    {
        if (string.IsNullOrWhiteSpace(locationName))
        {
            errorMessage = "Please enter a location name";
            return;
        }
        if (selectedLocationGroupId == -1 && string.IsNullOrWhiteSpace(newGroupName))
        {
            errorMessage = "Please enter a name for the new group";
            return;
        }
        if (selectedLocationGroupId == 0 && (locationGroups == null || !locationGroups.Any()))
        {
            errorMessage = "No location groups available. Please create a new group.";
            selectedLocationGroupId = -1;
            return;
        }
        if (selectedType == null)
        {
            errorMessage = "Please select a location type";
            return;
        }

        errorMessage = null;
        currentStep = selectedType switch
        {
            LocationType.Playlist => Step.ConfigurePlaylist,
            LocationType.Card => Step.ConfigureCard,
            LocationType.Layout => Step.ConfigureLayout,
            LocationType.AssetLibrary => Step.ConfigureAssetLibrary,
            LocationType.FloorPlan => Step.ConfigureFloorPlan,
            LocationType.Panorama => Step.ConfigurePanorama,
            LocationType.VideoWall => Step.ConfigureVideoWall,
            LocationType.Custom => Step.ConfigureCustom,
            LocationType.CustomDisplay => Step.ConfigureCustom,
            _ => Step.SelectType
        };
    }

    private void PreviousStep()
    {
        errorMessage = null;
        currentStep = Step.SelectType;
    }

    private bool CanCreate()
    {
        return selectedType switch
        {
            LocationType.Playlist => resolutionWidth > 0 && resolutionHeight > 0,
            LocationType.Card => cardDisplays.Any(d => !string.IsNullOrWhiteSpace(d.Name) && d.Width > 0 && d.Height > 0),
            LocationType.Layout => layoutZones.Any(),
            LocationType.AssetLibrary => resolutionWidth > 0 && resolutionHeight > 0,
            LocationType.FloorPlan => resolutionWidth > 0 && resolutionHeight > 0,
            LocationType.Panorama => resolutionWidth > 0 && resolutionHeight > 0,
            LocationType.VideoWall => wallRows.Any(r => r.CounterCount > 0),
            LocationType.Custom => !string.IsNullOrEmpty(selectedBundleKey),
            LocationType.CustomDisplay => !string.IsNullOrEmpty(selectedBundleKey) && resolutionWidth > 0 && resolutionHeight > 0,
            _ => false
        };
    }

    // Card helpers
    private void AddCardDisplay()
    {
        cardDisplays.Add(new CardDisplayItem
        {
            Name = $"Display {cardDisplays.Count + 1}",
            Width = 1920,
            Height = 1080
        });
    }

    private void RemoveCardDisplay(CardDisplayItem display)
    {
