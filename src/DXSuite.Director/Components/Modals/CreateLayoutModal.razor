    // --- Floorplan element helpers ---

    private void AddVisualElement()
    {
        int? displayId = addVisualType == "display" && addVisualDisplayId > 0 ? addVisualDisplayId : null;
        int? locationId = addVisualType == "location" && addVisualLocationId > 0 ? addVisualLocationId : null;

        if (!displayId.HasValue && !locationId.HasValue)
            return;

        var name = displayId.HasValue
            ? allDisplays.FirstOrDefault(d => d.DisplayId == displayId.Value)?.DisplayName ?? ""
            : allLocations.FirstOrDefault(l => l.LocationId == locationId.Value)?.LocationName ?? "";

        visualElements.Add(new VisualElementItem
        {
            Type = addVisualType,
            DisplayId = displayId,
            LocationId = locationId,
            DisplayOrLocationName = name,
            Label = name,
            IconPath = string.IsNullOrWhiteSpace(addVisualIconPath) ? null : addVisualIconPath,
            Width = addVisualWidth,
            Height = addVisualHeight,
            Top = addVisualTop,
            Left = addVisualLeft,
            Latitude = (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap") ? addVisualLatitude : null,
            Longitude = (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap") ? addVisualLongitude : null,
            Position3DX = visualBackgroundMode == "3dmodel" ? addVisual3DX : null,
            Position3DY = visualBackgroundMode == "3dmodel" ? addVisual3DY : null,
            Position3DZ = visualBackgroundMode == "3dmodel" ? addVisual3DZ : null,
            ShowLivePreview = addVisualShowLivePreview,
            SortOrder = visualElements.Count
        });

        addVisualDisplayId = 0;
        addVisualLocationId = 0;
        addVisualIconPath = null;
        addVisualShowLivePreview = false;
        addVisualTop = 50;
        addVisualLeft = 50;
        addVisualLatitude = 0;
        addVisualLongitude = 0;
        addVisual3DX = 0;
        addVisual3DY = 0;
        addVisual3DZ = 0;
    }

    private void RemoveVisualElement(VisualElementItem item)
    {
        visualElements.Remove(item);
    }

    // --- Panorama helpers ---

    private void AddPanoDisplay()
    {
        panoDisplayItems.Add(new PanoDisplayItem { Name = $"Display {panoDisplayItems.Count + 1}" });
    }

    private void AddPanoGroup()
    {
        panoDisplayItems.Add(new PanoDisplayItem { Name = $"Group {panoDisplayItems.Count + 1}", IsGroup = true, Count = 4 });
