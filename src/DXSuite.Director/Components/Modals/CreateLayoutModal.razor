    }

    // Layout helpers
    private bool IsPlaylistLocation(TblLocation loc) => loc.LocationTypeId == PLAYLIST_LOCATION_TYPE_ID;

    private bool HasValidDimensions(TblLocation loc)
    {
        if (IsPlaylistLocation(loc))
        {
            return loc.BackgroundImageWidth > 0 && loc.BackgroundImageHeight > 0;
        }
        return loc.TblDisplays?.Any(d => d.DisplayWidth > 0 && d.DisplayHeight > 0) == true;
    }

    private string GetDimensionsDisplay(TblLocation loc)
    {
        if (IsPlaylistLocation(loc))
        {
            return $"{loc.BackgroundImageWidth} x {loc.BackgroundImageHeight}";
        }
        var display = loc.TblDisplays?.FirstOrDefault(d => d.DisplayWidth > 0 && d.DisplayHeight > 0);
        return display != null ? $"{display.DisplayWidth} x {display.DisplayHeight}" : "-";
    }

    private List<TblDisplay> GetDisplaysForLocation(TblLocation loc) => loc.TblDisplays?.ToList() ?? new List<TblDisplay>();

    private void SelectLocation(TblLocation loc)
    {
        if (!HasValidDimensions(loc)) return;

        if (IsPlaylistLocation(loc))
        {
            AddZoneFromPlaylist(loc);
        }
        else
        {
            selectedLocation = loc;
        }
    }

    private void ClearSelectedLocation() => selectedLocation = null;

    private void AddZoneFromPlaylist(TblLocation loc)
    {
        var sourceWidth = (decimal)(loc.BackgroundImageWidth ?? 1920);
        var sourceHeight = (decimal)(loc.BackgroundImageHeight ?? 1080);

        layoutZones.Add(new LayoutZone
        {
            ZoneNumber = nextZoneNumber++,
            SourceLocationId = loc.LocationId,
            SourceLocationName = loc.LocationName ?? $"Location {loc.LocationId}",
            SourceWidth = sourceWidth,
            SourceHeight = sourceHeight,
            Left = 0,
            Top = 0,
            Width = sourceWidth,
            Height = sourceHeight
        });
        StateHasChanged();
    }

    private void AddZoneFromDisplay(TblLocation loc, TblDisplay display)
    {
        if (display.DisplayWidth <= 0 || display.DisplayHeight <= 0) return;

        var sourceWidth = (decimal)display.DisplayWidth;
        var sourceHeight = (decimal)display.DisplayHeight;

        layoutZones.Add(new LayoutZone
        {
            ZoneNumber = nextZoneNumber++,
            SourceLocationId = loc.LocationId,
            SourceLocationName = loc.LocationName ?? $"Location {loc.LocationId}",
            SourceDisplayId = display.DisplayId,
            DisplayName = display.DisplayName,
            SourceWidth = sourceWidth,
            SourceHeight = sourceHeight,
            Left = 0,
            Top = 0,
            Width = sourceWidth,
            Height = sourceHeight
        });
        selectedLocation = null;
        StateHasChanged();
    }

    private void RemoveZone(LayoutZone zone)
    {
        layoutZones.Remove(zone);
        for (int i = 0; i < layoutZones.Count; i++)
            layoutZones[i].ZoneNumber = i + 1;
        nextZoneNumber = layoutZones.Count + 1;
    }

    private async Task CreateLocation()
    {
        try
        {
            isCreating = true;
            errorMessage = null;
            StateHasChanged();

            int locationId;

            switch (selectedType)
            {
                case LocationType.Playlist:
                    locationId = await CreatePlaylistLocation();
                    break;
                case LocationType.Card:
                    locationId = await CreateCardLocation();
                    break;
                case LocationType.Layout:
                    locationId = await CreateLayoutLocation();
                    break;
                case LocationType.AssetLibrary:
                    locationId = await CreateAssetLibraryLocation();
                    break;
                case LocationType.FloorPlan:
                    locationId = await CreateFloorPlanLocation();
                    break;
                case LocationType.Panorama:
                    locationId = await CreatePanoramaLocation();
                    break;
                case LocationType.VideoWall:
                    locationId = await CreateVideoWallLocation();
                    break;
                case LocationType.Custom:
                case LocationType.CustomDisplay:
                    locationId = await CreateCustomLocation();
                    break;
                default:
                    throw new InvalidOperationException("Invalid location type");
            }

            // Auto-grant "full" access to the creating user
            try
            {
                if (sessionState.User != null)
                {
                    await locationAccessService.CreateRuleAsync(locationId, sessionState.User.UserId, null, "full", null, sessionState.User.UserId.ToString());

                    // Refresh this circuit synchronously so the caller's reload already sees
                    // the new location; the broadcast covers the user's other open circuits.
                    await sessionState.RefreshLocationAccessAsync();
                    if (tenantContext.IsPopulated)
                        accessBroadcast.NotifyUser(tenantContext.TenantId, sessionState.User.UserId);
                }
            }
            catch (Exception accessEx)
            {
                Logger.LogWarning(accessEx, "Failed to auto-create access rule for location {LocationId}", locationId);
            }

            await OnLayoutCreated.InvokeAsync(locationId);
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create location: {ex.Message}";
            Logger.LogError(ex, "Error creating location");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private async Task<int> GetOrCreateLocationGroupIdAsync()
    {
        if (selectedLocationGroupId == -1)
        {
            // Create a new location group
            var newGroup = new TblLocationGroup
            {
                LocationGroupName = newGroupName,
                SortOrder = 0,
                CreateDate = DateTime.UtcNow
            };
            dbContext.TblLocationGroups.Add(newGroup);
            await dbContext.SaveChangesAsync();
            return newGroup.LocationGroupId;
        }

        return selectedLocationGroupId;
    }

    private async Task<int> CreatePlaylistLocation()
    {
        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = PLAYLIST_LOCATION_TYPE_ID,
            LocationGroupId = groupId,
            BackgroundImageWidth = resolutionWidth,
            BackgroundImageHeight = resolutionHeight,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();
        return location.LocationId;
    }

    private async Task<int> CreateCardLocation()
    {
        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = CARD_LOCATION_TYPE_ID,
            LocationGroupId = groupId,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();

        // Create displays for this location
        foreach (var displayItem in cardDisplays.Where(d => !string.IsNullOrWhiteSpace(d.Name)))
        {
            var display = new TblDisplay
            {
                DisplayName = displayItem.Name,
                LocationId = location.LocationId,
                DisplayWidth = displayItem.Width,
                DisplayHeight = displayItem.Height,
                DisplayTypeId = (int)Types.DisplayType.StandardDisplay,
                CreateDate = DateTime.UtcNow
            };
            dbContext.TblDisplays.Add(display);
        }

        await dbContext.SaveChangesAsync();
        return location.LocationId;
    }

    private async Task<int> CreateCustomLocation()
    {
        var typeId = selectedType == LocationType.CustomDisplay ? customDisplayLocationTypeId : customLocationTypeId;
        if (!typeId.HasValue)
            throw new InvalidOperationException("Custom location type not found in database. Run the AddLocationBundles migration.");

        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = typeId.Value,
            LocationGroupId = groupId,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow,
            ExtendedData = ExtendedDataHelper.UpdateProperty<LocationExtendedData>(null,
                ed => ed.Bundle = new LocationBundleAssignment { BundleKey = selectedBundleKey })
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();

        if (selectedType == LocationType.CustomDisplay)
        {
            dbContext.TblDisplays.Add(new TblDisplay
            {
                DisplayName = $"{locationName} Display",
                LocationId = location.LocationId,
                DisplayWidth = resolutionWidth,
                DisplayHeight = resolutionHeight,
                DisplayTypeId = (int)Types.DisplayType.StandardDisplay,
                CreateDate = DateTime.UtcNow
            });
            await dbContext.SaveChangesAsync();
        }

        return location.LocationId;
    }

    private async Task<int> CreateLayoutLocation()
    {
        var groupId = await GetOrCreateLocationGroupIdAsync();

        var config = new LayoutConfiguration
        {
            AspectRatioWidth = resolutionWidth,
            AspectRatioHeight = resolutionHeight,
            Zones = layoutZones
        };

        var extendedData = JsonSerializer.Serialize(config, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = LAYOUT_LOCATION_TYPE_ID,
            LocationGroupId = groupId,
            BackgroundImageWidth = resolutionWidth,
            BackgroundImageHeight = resolutionHeight,
            ExtendedData = extendedData,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();
        return location.LocationId;
    }

    private async Task SaveLayout()
    {
        if (!editingLocationId.HasValue)
        {
            errorMessage = "No location to edit";
            return;
        }

        try
        {
            isCreating = true;
            errorMessage = null;
            StateHasChanged();

            var location = await dbContext.TblLocations
                .FirstOrDefaultAsync(l => l.LocationId == editingLocationId.Value);

            if (location == null)
            {
                errorMessage = "Location not found";
                return;
            }

            var removedDisplayIds = new List<int>();
            location.LocationName = locationName;
            location.BackgroundImageWidth = resolutionWidth;
            location.BackgroundImageHeight = resolutionHeight;

            if (selectedType == LocationType.Layout)
            {
                var config = new LayoutConfiguration
                {
                    AspectRatioWidth = resolutionWidth,
                    AspectRatioHeight = resolutionHeight,
                    Zones = layoutZones
                };
                location.ExtendedData = JsonSerializer.Serialize(config, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            }
            else if (selectedType == LocationType.FloorPlan)
            {
                location.ExtendedData = ExtendedDataHelper.UpdateProperty<LocationExtendedData>(location.ExtendedData, ed =>
                {
                    ed.BackgroundMode = visualBackgroundMode == "image" ? null : visualBackgroundMode;
                    if (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap")
                    {
                        ed.MapCenterLatitude = mapCenterLatitude;
                        ed.MapCenterLongitude = mapCenterLongitude;
                        ed.MapZoomLevel = mapZoomLevel;
                        ed.OfflineTilePath = visualBackgroundMode == "offlinemap" ? offlineTilePath : null;
                    }
                    if (visualBackgroundMode == "3dmodel")
                    {
                        ed.ModelFilePath = modelFilePath;
                        ed.HotspotScale = hotspotScale;
                    }
                });

                // Save new background image if uploaded
                if (visualBackgroundBytes != null && visualBackgroundFile != null)
                {
                    var ext = Path.GetExtension(visualBackgroundFile.Name).ToLowerInvariant();
                    var folder = Path.Combine(MediaPaths.GetRoot(), "images", "Visual Backgrounds");
                    Directory.CreateDirectory(folder);
                    var fileName = $"{location.LocationId}_{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}{ext}";
                    await File.WriteAllBytesAsync(Path.Combine(folder, fileName), visualBackgroundBytes);
                    location.BackgroundImagePath = $"images/Visual Backgrounds/{fileName}";
                }

                // Sync floor plan elements: update existing, create new, delete removed
                var existingIds = visualElements.Where(e => e.ElementId.HasValue).Select(e => e.ElementId!.Value).ToHashSet();
                var dbElements = await floorPlanService.GetElementsForLocationAsync(location.LocationId);
                foreach (var dbEl in dbElements.Where(e => !existingIds.Contains(e.FloorPlanElementId)))
                    await floorPlanService.DeleteElementAsync(dbEl.FloorPlanElementId);

                for (int i = 0; i < visualElements.Count; i++)
                {
                    var el = visualElements[i];
                    el.SortOrder = i;
                    if (el.ElementId.HasValue)
                    {
                        await floorPlanService.UpdateElementAsync(new TblFloorPlanElement
                        {
                            FloorPlanElementId = el.ElementId.Value,
                            LocationId = location.LocationId,
                            ChildDisplayId = el.DisplayId,
                            ChildLocationId = el.LocationId,
                            IconPath = el.IconPath,
                            IconLabel = el.Label,
                            ElementWidth = el.Width,
                            ElementHeight = el.Height,
                            PositionTop = el.Top,
                            PositionLeft = el.Left,
                            SortOrder = el.SortOrder,
                            Latitude = el.Latitude,
                            Longitude = el.Longitude,
                            Position3DX = el.Position3DX,
                            Position3DY = el.Position3DY,
                            Position3DZ = el.Position3DZ,
                            ShowLivePreview = el.ShowLivePreview
                        });
                    }
                    else
                    {
                        var created = await floorPlanService.CreateElementAsync(new TblFloorPlanElement
                        {
                            LocationId = location.LocationId,
                            ChildDisplayId = el.DisplayId,
                            ChildLocationId = el.LocationId,
                            IconPath = el.IconPath,
                            IconLabel = el.Label,
                            ElementWidth = el.Width,
                            ElementHeight = el.Height,
                            PositionTop = el.Top,
                            PositionLeft = el.Left,
                            SortOrder = el.SortOrder,
                            Latitude = el.Latitude,
                            Longitude = el.Longitude,
                            Position3DX = el.Position3DX,
                            Position3DY = el.Position3DY,
                            Position3DZ = el.Position3DZ,
                            ShowLivePreview = el.ShowLivePreview
                        });
                        el.ElementId = created.FloorPlanElementId;
                    }
                }
            }
            else if (selectedType == LocationType.Panorama)
            {
                // Save new background image if uploaded
                if (panoBackgroundBytes != null && panoBackgroundFile != null)
                {
                    var ext = Path.GetExtension(panoBackgroundFile.Name).ToLowerInvariant();
                    var folder = Path.Combine(MediaPaths.GetRoot(), "images", "Visual Backgrounds");
                    Directory.CreateDirectory(folder);
                    var fileName = $"{location.LocationId}_{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}{ext}";
                    await File.WriteAllBytesAsync(Path.Combine(folder, fileName), panoBackgroundBytes);
                    location.BackgroundImagePath = $"images/Visual Backgrounds/{fileName}";
                }

                // Build config from panoDisplayItems. Reuse existing DB display records where
                // available (DisplayId > 0 / ExistingDisplayIds set); create new TblDisplay rows
                // for items added during this edit session.
                var panoConfig = new PanoramaConfiguration { ScaleFactor = panoScaleFactor };

                foreach (var item in panoDisplayItems)
                {
                    if (item.IsGroup)
                    {
                        var group = new PanoramaGroup
                        {
                            GroupName = item.Name,
                            PositionTop = item.PositionTop,
                            PositionLeft = item.PositionLeft,
                            Spacing = item.Spacing,
                            Direction = item.Direction,
                            ZIndex = item.ZIndex,
                            DisplayScale = item.DisplayScale
                        };

                        for (int i = 0; i < item.Count; i++)
                        {
                            if (i < item.ExistingDisplayIds.Count)
                            {
                                group.DisplayIds.Add(item.ExistingDisplayIds[i]);
                            }
                            else
                            {
                                var d = new TblDisplay
                                {
                                    DisplayName = $"{item.Name} {i + 1}",
                                    LocationId = location.LocationId,
                                    DisplayWidth = item.DisplayWidth,
                                    DisplayHeight = item.DisplayHeight,
                                    DisplayTypeId = 1,
                                    SortOrder = i,
                                    CreateDate = DateTime.UtcNow
                                };
                                dbContext.TblDisplays.Add(d);
                                await dbContext.SaveChangesAsync();
                                group.DisplayIds.Add(d.DisplayId);
                            }
                        }

                        panoConfig.Groups.Add(group);
                    }
                    else
                    {
                        int displayId;
                        if (item.DisplayId > 0)
                        {
                            var existing = await dbContext.TblDisplays.FindAsync(item.DisplayId);
                            if (existing != null)
                            {
                                existing.DisplayName = item.Name;
                                existing.DisplayWidth = item.DisplayWidth;
                                existing.DisplayHeight = item.DisplayHeight;
                            }
                            displayId = item.DisplayId;
                        }
                        else
                        {
                            var d = new TblDisplay
                            {
                                DisplayName = item.Name,
                                LocationId = location.LocationId,
                                DisplayWidth = item.DisplayWidth,
                                DisplayHeight = item.DisplayHeight,
                                DisplayTypeId = 1,
                                CreateDate = DateTime.UtcNow
                            };
                            dbContext.TblDisplays.Add(d);
                            await dbContext.SaveChangesAsync();
                            displayId = d.DisplayId;
                        }

                        panoConfig.Placements.Add(new PanoramaPlacement
                        {
                            DisplayId = displayId,
                            PositionTop = item.PositionTop,
                            PositionLeft = item.PositionLeft,
                            ZIndex = item.ZIndex,
                            DisplayScale = item.DisplayScale
                        });
                    }
                }

                location.ExtendedData = JsonSerializer.Serialize(panoConfig, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            }
            else if (selectedType == LocationType.VideoWall)
            {
                // Collect old display IDs before overwriting config — used for orphan cleanup after save
                var oldDisplayIds = new HashSet<int>();
                if (!string.IsNullOrEmpty(location.ExtendedData))
                {
                    try
                    {
                        var oldConfig = JsonSerializer.Deserialize<VideoWallConfiguration>(location.ExtendedData,
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (oldConfig?.Layout?.Groups != null)
                            foreach (var g in oldConfig.Layout.Groups)
                                foreach (var id in g.DisplayIds)
                                    oldDisplayIds.Add(id);
                    }
                    catch { }
                }

                if (wallBgBytes != null && wallBgFile != null)
                {
                    var ext = Path.GetExtension(wallBgFile.Name).ToLowerInvariant();
                    var folder = Path.Combine(MediaPaths.GetRoot(), "images", "Visual Backgrounds");
                    Directory.CreateDirectory(folder);
                    var fileName = $"{location.LocationId}_{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}{ext}";
                    await File.WriteAllBytesAsync(Path.Combine(folder, fileName), wallBgBytes);
                    location.BackgroundImagePath = $"images/Visual Backgrounds/{fileName}";
                }

                // Always restore the correct dimensions for VideoWall. SaveLayout() writes resolutionWidth/Height
                // unconditionally above, but those variables are not loaded during OpenForEditVideoWall — only
                // wallBgWidth/wallBgHeight are, so use them to correct the overwrite.
                if (wallBgWidth > 0) location.BackgroundImageWidth = wallBgWidth;
                if (wallBgHeight > 0) location.BackgroundImageHeight = wallBgHeight;

                var wallConfig = new VideoWallConfiguration
                {
                    BackgroundImagePath = location.BackgroundImagePath,
                    BackgroundScaleFactor = wallBackgroundScaleFactor,
                    ContentScaleFactor = wallContentScaleFactor,
                    CounterWidthPx = wallCounterWidthPx,
                    WrappedOutputsEnabled = wallWrappedOutputsEnabled,
                    OutputWidth = wallOutputWidth,
                    OutputHeight = wallOutputHeight,
                    ContentTopOffsetPx = wallContentTopOffsetPx,
                    LogoRoles = wallLogoRoles.ToList()
                };

                var newDisplayIds = new HashSet<int>();

                foreach (var row in wallRows)
                {
                    var group = new PanoramaGroup
                    {
                        GroupName = row.Name,
                        Role = "counter-row",
                        AllowAirlineAllocation = true,
                        Direction = "horizontal",
                        Gaps    = row.Gaps,
                        Spacing = row.Gaps.Count == 1 ? row.Gaps[0] : 0,
                        PositionTop = row.VerticalPositionPx,
                        PositionLeft = row.HorizontalStartPx,
                        DisplayScale = row.DisplayScale,
                        ZIndex = row.ZIndex,
                        AllocationLeftPx = row.AllocationLeftPx,
                        AllocationRightPx = row.AllocationRightPx
                    };

                    for (int i = 0; i < row.CounterCount; i++)
                    {
                        if (i < row.ExistingDisplayIds.Count)
                        {
                            var existingId = row.ExistingDisplayIds[i];
                            var existing = await dbContext.TblDisplays.FindAsync(existingId);
                            if (existing != null)
                            {
                                existing.DisplayName = $"{row.Name} {i + 1}";
                                existing.DisplayWidth = wallCounterWidthPx;
                                existing.DisplayHeight = (int)row.CounterHeightPx;
                            }
                            group.DisplayIds.Add(existingId);
                            newDisplayIds.Add(existingId);
                        }
                        else
                        {
                            var d = new TblDisplay
                            {
                                DisplayName = $"{row.Name} {i + 1}",
                                LocationId = location.LocationId,
                                DisplayWidth = wallCounterWidthPx,
                                DisplayHeight = (int)row.CounterHeightPx,
                                DisplayTypeId = 1,
                                SortOrder = i,
                                CreateDate = DateTime.UtcNow
                            };
                            dbContext.TblDisplays.Add(d);
                            await dbContext.SaveChangesAsync();
                            group.DisplayIds.Add(d.DisplayId);
                            newDisplayIds.Add(d.DisplayId);
                        }
                    }

                    wallConfig.Layout.Groups.Add(group);
                }

                foreach (var layer in wallLayers)
                {
                    // ImageWidthPx is the per-tile width stored on TblDisplay; the full canvas
                    // width (layer.WidthPx) is reconstructed on load via DisplayWidth × loop count.
                    int imageWidthPx = layer.WidthPx / Math.Max(1, layer.HorizontalImageLoop);
                    int layerDisplayId;

                    if (layer.ExistingDisplayIds.Count > 0)
                    {
                        layerDisplayId = layer.ExistingDisplayIds[0];
                        var existing = await dbContext.TblDisplays
                            .Include(d => d.Constraint)
                            .FirstOrDefaultAsync(d => d.DisplayId == layerDisplayId);
                        if (existing != null)
                        {
                            existing.DisplayName   = layer.Name;
                            existing.DisplayWidth  = imageWidthPx;
                            existing.DisplayHeight = layer.HeightPx;
                            await EnsureLayerConstraintAsync(
                                dbContext, existing, imageWidthPx, layer.HeightPx, location.LocationId, layer.Name);
                        }
                    }
                    else
                    {
                        var d = new TblDisplay
                        {
                            DisplayName   = layer.Name,
                            LocationId    = location.LocationId,
                            DisplayWidth  = imageWidthPx,
                            DisplayHeight = layer.HeightPx,
                            DisplayTypeId = 1,
                            SortOrder     = 0,
                            CreateDate    = DateTime.UtcNow
                        };
                        dbContext.TblDisplays.Add(d);
                        await dbContext.SaveChangesAsync();
                        await EnsureLayerConstraintAsync(
                            dbContext, d, imageWidthPx, layer.HeightPx, location.LocationId, layer.Name);
                        layerDisplayId = d.DisplayId;
                    }

                    newDisplayIds.Add(layerDisplayId);
                    wallConfig.Layout.Groups.Add(new PanoramaGroup
                    {
                        GroupName              = layer.Name,
                        Role                   = layer.Role,
                        AllowAirlineAllocation = false,
                        PositionTop            = layer.PositionTop,
                        PositionLeft           = layer.PositionLeft,
                        ZIndex                 = layer.ZIndex,
                        HorizontalImageLoop    = Math.Max(1, layer.HorizontalImageLoop),
                        DisplayIds             = new List<int> { layerDisplayId }
                    });
                }

                foreach (var zone in wallLogoZones)
                {
                    int zoneDisplayId;

                    if (zone.ExistingDisplayIds.Count > 0)
                    {
                        zoneDisplayId = zone.ExistingDisplayIds[0];
                        var existing = await dbContext.TblDisplays
                            .FirstOrDefaultAsync(d => d.DisplayId == zoneDisplayId);
                        if (existing != null)
                        {
                            existing.DisplayName   = zone.Name;
                            existing.DisplayWidth  = zone.WidthPx;
                            existing.DisplayHeight = zone.HeightPx;
                            await EnsureLayerConstraintAsync(
                                dbContext, existing, zone.WidthPx, zone.HeightPx, location.LocationId, zone.Name);
                        }
                    }
                    else
                    {
                        var d = new TblDisplay
                        {
                            DisplayName   = zone.Name,
                            LocationId    = location.LocationId,
                            DisplayWidth  = zone.WidthPx,
                            DisplayHeight = zone.HeightPx,
                            DisplayTypeId = 1,
                            SortOrder     = 0,
                            CreateDate    = DateTime.UtcNow
                        };
                        dbContext.TblDisplays.Add(d);
                        await dbContext.SaveChangesAsync();
                        await EnsureLayerConstraintAsync(
                            dbContext, d, zone.WidthPx, zone.HeightPx, location.LocationId, zone.Name);
                        zoneDisplayId = d.DisplayId;
                    }

                    newDisplayIds.Add(zoneDisplayId);
                    wallConfig.Layout.Groups.Add(new PanoramaGroup
                    {
                        GroupName              = zone.Name,
                        Role                   = "logo",
                        AllowAirlineAllocation = false,
                        PositionTop            = zone.PositionTop,
                        PositionLeft           = zone.PositionLeft,
                        ZIndex                 = zone.ZIndex,
                        LogoRoleKey            = string.IsNullOrWhiteSpace(zone.LogoRoleKey) ? null : zone.LogoRoleKey,
                        DisplayIds             = new List<int> { zoneDisplayId }
                    });
                }

                // Remove displays that were in the old config but are no longer in the new one
                var orphanIds = oldDisplayIds.Except(newDisplayIds).ToList();
                if (orphanIds.Any())
                {
                    var orphans = await dbContext.TblDisplays.Where(d => orphanIds.Contains(d.DisplayId)).ToListAsync();
                    dbContext.TblDisplays.RemoveRange(orphans);
                    removedDisplayIds.AddRange(orphanIds);
                }

                location.ExtendedData = JsonSerializer.Serialize(wallConfig, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            }

            await dbContext.SaveChangesAsync();

            // Zones, walls and displays all changed under this one location, so its publication and every
            // display still attached to it are rebuilt.
            publicationInvalidator.LocationChanged(location.LocationId);
            foreach (var displayId in await dbContext.TblDisplays.Where(d => d.LocationId == location.LocationId).Select(d => d.DisplayId).ToListAsync())
                publicationInvalidator.DisplayChanged(displayId);
            foreach (var displayId in removedDisplayIds)
                publicationInvalidator.DisplayRemoved(displayId);

            await OnLayoutCreated.InvokeAsync(location.LocationId);
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Error saving location");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    // --- Asset Library Creation ---

    private async Task<int> CreateAssetLibraryLocation()
    {
        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = ASSET_LIBRARY_LOCATION_TYPE_ID,
            LocationGroupId = groupId,
            BackgroundImageWidth = resolutionWidth,
            BackgroundImageHeight = resolutionHeight,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();

        // Create global constraint with the chosen resolution and mode
        var constraint = new TblConstraint
        {
            ConstraintName = locationName,
            OwningLocationId = location.LocationId,
            IsGlobal = true,
            ResolutionWidth = resolutionWidth,
            ResolutionHeight = resolutionHeight,
            ResolutionMode = assetLibraryResolutionMode,
            CreateDate = DateTime.UtcNow
        };
        dbContext.TblConstraints.Add(constraint);
        await dbContext.SaveChangesAsync();

        location.ExtendedData = ExtendedDataHelper.UpdateProperty<LocationExtendedData>(location.ExtendedData, ed =>
        {
            ed.GlobalConstraintId = constraint.ConstraintId;
        });
        await dbContext.SaveChangesAsync();

        // A library's participating keys are rule rows with policies at their defaults; a library targets nothing.
        var metadataKeys = assetLibraryMetadataKeys
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(k => new LocationMetadataRuleInput(k))
            .ToList();
        if (metadataKeys.Count > 0)
        {
            // The location already exists; its fields can be added again from Content metadata, so a failure
            // here must not stop the creator's access grant that follows.
            try
            {
                await locationMetadataRules.SaveAsync(location.LocationId, targetContentByMetadata: false, matchMode: "all",
                    metadataKeys, sessionState.User?.UserId.ToString() ?? "system");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to save content metadata fields for new asset library {LocationId}", location.LocationId);
            }
        }

        return location.LocationId;
    }

    // --- FloorPlan Creation ---

    private async Task<int> CreateFloorPlanLocation()
    {
        if (!floorPlanLocationTypeId.HasValue)
            throw new InvalidOperationException("Floorplan location type not found in database.");

        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = floorPlanLocationTypeId.Value,
            LocationGroupId = groupId,
            BackgroundImageWidth = resolutionWidth,
            BackgroundImageHeight = resolutionHeight,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();

        // Save ExtendedData with background mode config
        location.ExtendedData = ExtendedDataHelper.UpdateProperty<LocationExtendedData>(location.ExtendedData, ed =>
        {
            ed.BackgroundMode = visualBackgroundMode == "image" ? null : visualBackgroundMode;
            if (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap")
            {
                ed.MapCenterLatitude = mapCenterLatitude;
                ed.MapCenterLongitude = mapCenterLongitude;
                ed.MapZoomLevel = mapZoomLevel;
                ed.OfflineTilePath = visualBackgroundMode == "offlinemap" ? offlineTilePath : null;
            }
            if (visualBackgroundMode == "3dmodel")
            {
                ed.ModelFilePath = modelFilePath;
                ed.HotspotScale = hotspotScale;
            }
        });
        await dbContext.SaveChangesAsync();

        // Save background image to disk (image mode)
        if (visualBackgroundMode == "image" && visualBackgroundBytes != null && visualBackgroundFile != null)
        {
            var ext = Path.GetExtension(visualBackgroundFile.Name).ToLowerInvariant();
            var folder = Path.Combine(MediaPaths.GetRoot(), "images", "Visual Backgrounds");
            Directory.CreateDirectory(folder);
            var fileName = $"{location.LocationId}_{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}{ext}";
            var filePath = Path.Combine(folder, fileName);
            await File.WriteAllBytesAsync(filePath, visualBackgroundBytes);
            location.BackgroundImagePath = $"images/Visual Backgrounds/{fileName}";
            await dbContext.SaveChangesAsync();
        }

        // Save GLB model to disk (3D model mode)
        if (visualBackgroundMode == "3dmodel" && modelFileBytes != null)
        {
            var modelFolder = Path.Combine(MediaPaths.GetRoot(), "models", location.LocationId.ToString());
            Directory.CreateDirectory(modelFolder);
            var glbPath = Path.Combine(modelFolder, "model.glb");
            await File.WriteAllBytesAsync(glbPath, modelFileBytes);
            modelFilePath = $"models/{location.LocationId}/model.glb";
            location.ExtendedData = ExtendedDataHelper.UpdateProperty<LocationExtendedData>(location.ExtendedData, ed =>
            {
                ed.ModelFilePath = modelFilePath;
            });
            await dbContext.SaveChangesAsync();
        }

        return location.LocationId;
    }

    // --- Panorama Creation ---

    private async Task<int> CreatePanoramaLocation()
    {
        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = PANORAMA_LOCATION_TYPE_ID,
            LocationGroupId = groupId,
            BackgroundImageWidth = resolutionWidth,
            BackgroundImageHeight = resolutionHeight,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();

        // Save background image
        if (panoBackgroundBytes != null && panoBackgroundFile != null)
        {
            var ext = Path.GetExtension(panoBackgroundFile.Name).ToLowerInvariant();
            var folder = Path.Combine(MediaPaths.GetRoot(), "images", "Visual Backgrounds");
            Directory.CreateDirectory(folder);
            var fileName = $"{location.LocationId}_{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}{ext}";
            var filePath = Path.Combine(folder, fileName);
            await File.WriteAllBytesAsync(filePath, panoBackgroundBytes);
            location.BackgroundImagePath = $"images/Visual Backgrounds/{fileName}";
            await dbContext.SaveChangesAsync();
        }

        // Build PanoramaConfiguration and create displays
        var panoConfig = new PanoramaConfiguration { ScaleFactor = panoScaleFactor };

        foreach (var item in panoDisplayItems)
        {
            if (item.IsGroup)
            {
                var group = new PanoramaGroup
                {
                    GroupName = item.Name,
                    PositionTop = item.PositionTop,
                    PositionLeft = item.PositionLeft,
                    Spacing = item.Spacing,
                    Direction = item.Direction,
                    ZIndex = item.ZIndex,
                    DisplayScale = item.DisplayScale
                };

                for (int i = 0; i < item.Count; i++)
                {
                    var display = new TblDisplay
                    {
                        DisplayName = $"{item.Name} {i + 1}",
                        LocationId = location.LocationId,
                        DisplayWidth = item.DisplayWidth,
                        DisplayHeight = item.DisplayHeight,
                        DisplayTypeId = 1,
                        SortOrder = i,
                        CreateDate = DateTime.UtcNow
                    };
                    dbContext.TblDisplays.Add(display);
                    await dbContext.SaveChangesAsync();
                    group.DisplayIds.Add(display.DisplayId);
                }

                panoConfig.Groups.Add(group);
            }
            else
            {
                var display = new TblDisplay
                {
                    DisplayName = item.Name,
                    LocationId = location.LocationId,
                    DisplayWidth = item.DisplayWidth,
                    DisplayHeight = item.DisplayHeight,
                    DisplayTypeId = 1,
                    CreateDate = DateTime.UtcNow
                };
                dbContext.TblDisplays.Add(display);
                await dbContext.SaveChangesAsync();

                panoConfig.Placements.Add(new PanoramaPlacement
                {
                    DisplayId = display.DisplayId,
                    PositionTop = item.PositionTop,
                    PositionLeft = item.PositionLeft,
                    ZIndex = item.ZIndex,
                    DisplayScale = item.DisplayScale
                });
            }
        }

        location.ExtendedData = JsonSerializer.Serialize(panoConfig, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
        await dbContext.SaveChangesAsync();

        return location.LocationId;
    }

    // --- VideoWall Creation ---

    private async Task<int> CreateVideoWallLocation()
    {
        if (!videoWallLocationTypeId.HasValue)
            throw new InvalidOperationException("VideoWall location type not found in database.");

        var groupId = await GetOrCreateLocationGroupIdAsync();

        var location = new TblLocation
        {
            LocationName = locationName,
            LocationTypeId = videoWallLocationTypeId.Value,
            LocationGroupId = groupId,
            BackgroundImageWidth = wallBgWidth > 0 ? wallBgWidth : null,
            BackgroundImageHeight = wallBgHeight > 0 ? wallBgHeight : null,
            SortOrder = 0,
            CreateDate = DateTime.UtcNow
        };

        dbContext.TblLocations.Add(location);
        await dbContext.SaveChangesAsync();

        if (wallBgBytes != null && wallBgFile != null)
        {
            var ext = Path.GetExtension(wallBgFile.Name).ToLowerInvariant();
            var folder = Path.Combine(MediaPaths.GetRoot(), "images", "Visual Backgrounds");
            Directory.CreateDirectory(folder);
            var fileName = $"{location.LocationId}_{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}{ext}";
            await File.WriteAllBytesAsync(Path.Combine(folder, fileName), wallBgBytes);
            location.BackgroundImagePath = $"images/Visual Backgrounds/{fileName}";
            await dbContext.SaveChangesAsync();
        }

        var wallConfig = new VideoWallConfiguration
        {
            BackgroundImagePath = location.BackgroundImagePath,
            BackgroundScaleFactor = wallBackgroundScaleFactor,
            ContentScaleFactor = wallContentScaleFactor,
            CounterWidthPx = wallCounterWidthPx,
            WrappedOutputsEnabled = wallWrappedOutputsEnabled,
            OutputWidth = wallOutputWidth,
            OutputHeight = wallOutputHeight,
            ContentTopOffsetPx = wallContentTopOffsetPx,
            LogoRoles = wallLogoRoles.ToList()
        };

        foreach (var row in wallRows)
        {
            var group = new PanoramaGroup
            {
                GroupName = row.Name,
                Role = "counter-row",
                AllowAirlineAllocation = true,
                Direction = "horizontal",
                Gaps    = row.Gaps,
                Spacing = row.Gaps.Count == 1 ? row.Gaps[0] : 0,
                PositionTop = row.VerticalPositionPx,
                PositionLeft = row.HorizontalStartPx,
                DisplayScale = row.DisplayScale,
                ZIndex = row.ZIndex,
                AllocationLeftPx = row.AllocationLeftPx,
                AllocationRightPx = row.AllocationRightPx
            };

            for (int i = 0; i < row.CounterCount; i++)
            {
                var display = new TblDisplay
                {
                    DisplayName = $"{row.Name} {i + 1}",
                    LocationId = location.LocationId,
                    DisplayWidth = wallCounterWidthPx,
                    DisplayHeight = (int)row.CounterHeightPx,
                    DisplayTypeId = 1,
                    SortOrder = i,
                    CreateDate = DateTime.UtcNow
                };
                dbContext.TblDisplays.Add(display);
                await dbContext.SaveChangesAsync();
                group.DisplayIds.Add(display.DisplayId);
            }

            wallConfig.Layout.Groups.Add(group);
        }

        foreach (var layer in wallLayers)
        {
            var display = new TblDisplay
            {
                DisplayName = layer.Name,
                LocationId = location.LocationId,
                DisplayWidth = layer.WidthPx,
                DisplayHeight = layer.HeightPx,
                DisplayTypeId = 1,
                SortOrder = 0,
                CreateDate = DateTime.UtcNow
            };
            dbContext.TblDisplays.Add(display);
            await dbContext.SaveChangesAsync();

            wallConfig.Layout.Groups.Add(new PanoramaGroup
            {
                GroupName = layer.Name,
                Role = layer.Role,
                AllowAirlineAllocation = false,
                PositionTop = layer.PositionTop,
                PositionLeft = layer.PositionLeft,
                ZIndex = layer.ZIndex,
                DisplayIds = new List<int> { display.DisplayId }
            });
        }

        foreach (var zone in wallLogoZones)
        {
            var display = new TblDisplay
            {
                DisplayName = zone.Name,
                LocationId = location.LocationId,
                DisplayWidth = zone.WidthPx,
                DisplayHeight = zone.HeightPx,
                DisplayTypeId = 1,
                SortOrder = 0,
                CreateDate = DateTime.UtcNow
            };
            dbContext.TblDisplays.Add(display);
            await dbContext.SaveChangesAsync();
            await EnsureLayerConstraintAsync(
                dbContext, display, zone.WidthPx, zone.HeightPx, location.LocationId, zone.Name);

            wallConfig.Layout.Groups.Add(new PanoramaGroup
            {
                GroupName = zone.Name,
                Role = "logo",
                AllowAirlineAllocation = false,
                PositionTop = zone.PositionTop,
                PositionLeft = zone.PositionLeft,
                ZIndex = zone.ZIndex,
                LogoRoleKey = string.IsNullOrWhiteSpace(zone.LogoRoleKey) ? null : zone.LogoRoleKey,
                DisplayIds = new List<int> { display.DisplayId }
            });
        }

        location.ExtendedData = JsonSerializer.Serialize(wallConfig, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
        await dbContext.SaveChangesAsync();

        return location.LocationId;
    }

    // --- Edit mode openers ---

    public async void OpenForEditVisual(TblLocation location)
    {
        isOpen = true;
        isEditMode = true;
        editingLocationId = location.LocationId;
        currentStep = Step.ConfigureFloorPlan;
        selectedType = LocationType.FloorPlan;
        locationName = location.LocationName ?? "";
        resolutionWidth = (int)(location.BackgroundImageWidth ?? 1920);
        resolutionHeight = (int)(location.BackgroundImageHeight ?? 1080);
        selectedLocationGroupId = location.LocationGroupId;
        errorMessage = null;

        visualBackgroundFile = null;
        visualBackgroundBytes = null;
        visualBackgroundPreviewUrl = !string.IsNullOrEmpty(location.BackgroundImagePath)
            ? location.BackgroundImagePath : null;

        // Parse extended data for background mode config
        if (!string.IsNullOrEmpty(location.ExtendedData))
        {
            try
            {
                var ed = JsonSerializer.Deserialize<LocationExtendedData>(location.ExtendedData, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (ed != null)
                {
                    visualBackgroundMode = ed.BackgroundMode ?? "image";
                    mapCenterLatitude = ed.MapCenterLatitude ?? 40.7128;
                    mapCenterLongitude = ed.MapCenterLongitude ?? -74.0060;
                    mapZoomLevel = ed.MapZoomLevel ?? 15;
                    offlineTilePath = ed.OfflineTilePath;
                    modelFilePath = ed.ModelFilePath;
                    hotspotScale = ed.HotspotScale ?? 1.0;
                }
            }
            catch { /* ignore parse errors */ }
        }

        // Load existing floor plan elements
        visualElements.Clear();
        var elements = await floorPlanService.GetElementsForLocationAsync(location.LocationId);
        visualElements = elements.Select(e => new VisualElementItem
        {
            ElementId = e.FloorPlanElementId,
            Type = e.ChildDisplayId.HasValue ? "display" : "location",
            DisplayId = e.ChildDisplayId,
            LocationId = e.ChildLocationId,
            DisplayOrLocationName = e.ChildDisplay?.DisplayName ?? e.ChildLocation?.LocationName ?? "",
            Label = e.ChildDisplay?.DisplayName ?? e.ChildLocation?.LocationName ?? "",
            IconPath = e.IconPath,
            Width = e.ElementWidth,
            Height = e.ElementHeight,
            Top = e.PositionTop,
            Left = e.PositionLeft,
            SortOrder = e.SortOrder,
            Latitude = e.Latitude,
            Longitude = e.Longitude,
            Position3DX = e.Position3DX,
            Position3DY = e.Position3DY,
            Position3DZ = e.Position3DZ,
            ShowLivePreview = e.ShowLivePreview
        }).ToList();

        LoadDataAsync();
        StateHasChanged();
    }

    public async void OpenForEditPanorama(TblLocation location)
    {
        isOpen = true;
        isEditMode = true;
        editingLocationId = location.LocationId;
        currentStep = Step.ConfigurePanorama;
        selectedType = LocationType.Panorama;
        locationName = location.LocationName ?? "";
        resolutionWidth = (int)(location.BackgroundImageWidth ?? 1920);
        resolutionHeight = (int)(location.BackgroundImageHeight ?? 1080);
        selectedLocationGroupId = location.LocationGroupId;
        errorMessage = null;

        panoBackgroundPreviewUrl = !string.IsNullOrEmpty(location.BackgroundImagePath)
            ? location.BackgroundImagePath : null;
        panoBackgroundFile = null;
        panoBackgroundBytes = null;
        panoDisplayItems.Clear();

        // Parse existing panorama configuration
        if (!string.IsNullOrEmpty(location.ExtendedData))
        {
            try
            {
                var config = JsonSerializer.Deserialize<PanoramaConfiguration>(location.ExtendedData, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (config != null)
                {
                    panoScaleFactor = config.ScaleFactor;
                    // Load existing placements as individual display items
                    foreach (var p in config.Placements)
                    {
                        var display = await dbContext.TblDisplays.FindAsync(p.DisplayId);
                        panoDisplayItems.Add(new PanoDisplayItem
                        {
                            DisplayId = p.DisplayId,
                            Name = display?.DisplayName ?? $"Display {p.DisplayId}",
                            DisplayWidth = display?.DisplayWidth ?? 1920,
                            DisplayHeight = display?.DisplayHeight ?? 1080,
                            PositionTop = p.PositionTop,
                            PositionLeft = p.PositionLeft,
                            ZIndex = p.ZIndex,
                            DisplayScale = p.DisplayScale
                        });
                    }
                    // Load existing groups
                    foreach (var g in config.Groups)
                    {
                        var firstDisplay = g.DisplayIds.Any() ? await dbContext.TblDisplays.FindAsync(g.DisplayIds.First()) : null;
                        panoDisplayItems.Add(new PanoDisplayItem
                        {
                            ExistingDisplayIds = g.DisplayIds.ToList(),
                            Name = g.GroupName,
                            IsGroup = true,
                            Count = g.DisplayIds.Count,
                            Spacing = g.Spacing,
                            Direction = g.Direction,
                            DisplayWidth = firstDisplay?.DisplayWidth ?? 1920,
                            DisplayHeight = firstDisplay?.DisplayHeight ?? 1080,
                            PositionTop = g.PositionTop,
                            PositionLeft = g.PositionLeft,
                            ZIndex = g.ZIndex,
                            DisplayScale = g.DisplayScale
                        });
                    }
                }
            }
            catch { /* ignore parse errors */ }
        }

        LoadDataAsync();
        StateHasChanged();
    }

    public async void OpenForEditVideoWall(TblLocation location)
    {
        // The caller's entity may be stale (tab lists are no-tracking snapshots), and editing from
        // stale config re-saves the old values. Always re-read the last saved state.
        var fresh = await dbContext.TblLocations.AsNoTracking()
            .FirstOrDefaultAsync(l => l.LocationId == location.LocationId);
        if (fresh != null) location = fresh;

        isOpen = true;
        isEditMode = true;
        editingLocationId = location.LocationId;
        currentStep = Step.ConfigureVideoWall;
        selectedType = LocationType.VideoWall;
        locationName = location.LocationName ?? "";
        selectedLocationGroupId = location.LocationGroupId;
        errorMessage = null;

        wallBgFile = null;
        wallBgBytes = null;
        wallBgPreviewUrl = !string.IsNullOrEmpty(location.BackgroundImagePath) ? location.BackgroundImagePath : null;
        wallBgWidth = (int)(location.BackgroundImageWidth ?? 0);
        wallBgHeight = (int)(location.BackgroundImageHeight ?? 0);
        wallRows.Clear();
        wallLayers.Clear();
        wallLogoZones.Clear();
        wallLogoRoles.Clear();

        if (!string.IsNullOrEmpty(location.ExtendedData))
        {
            try
            {
                var config = JsonSerializer.Deserialize<VideoWallConfiguration>(location.ExtendedData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (config != null)
                {
                    wallCounterWidthPx = config.CounterWidthPx;
                    wallBackgroundScaleFactor = config.BackgroundScaleFactor;
                    wallContentScaleFactor = config.ContentScaleFactor;
                    wallWrappedOutputsEnabled = config.WrappedOutputsEnabled;
                    wallOutputWidth  = config.OutputWidth  > 0 ? config.OutputWidth  : 3840;
                    wallOutputHeight = config.OutputHeight > 0 ? config.OutputHeight : 2160;
                    wallContentTopOffsetPx = config.ContentTopOffsetPx;
                    wallLogoRoles = config.LogoRoles?.OrderBy(r => r.SortOrder).ToList() ?? new();
                    foreach (var g in config.Layout.Groups)
                    {
                        if (g.AllowAirlineAllocation)
                        {
                            // Recover counter height from the first display in the group
                            var firstDisplay = g.DisplayIds.Any()
                                ? await dbContext.TblDisplays.FindAsync(g.DisplayIds.First()) : null;
                            wallRows.Add(new WallRowItem
                            {
                                Name = g.GroupName,
                                CounterCount = g.DisplayIds.Count,
                                CounterHeightPx = firstDisplay?.DisplayHeight ?? 1080,
                                // Backward compat: if stored config has a Gaps list use it,
                                // otherwise initialize from the legacy Spacing value.
                                Gaps = g.Gaps.Count > 0 ? g.Gaps.ToList() : new List<double> { g.Spacing },
                                VerticalPositionPx = g.PositionTop,
                                HorizontalStartPx = g.PositionLeft,
                                DisplayScale = g.DisplayScale,
                                ZIndex = g.ZIndex > 0 ? g.ZIndex : 10,
                                AllocationLeftPx = g.AllocationLeftPx,
                                AllocationRightPx = g.AllocationRightPx,
                                ExistingDisplayIds = g.DisplayIds.ToList()
                            });
                        }
                        else if (string.Equals(g.Role, "logo", StringComparison.OrdinalIgnoreCase))
                        {
                            // Logo zone: dimensions stored directly (no HorizontalImageLoop).
                            var zoneDisplay = g.DisplayIds.Any()
                                ? await dbContext.TblDisplays.FindAsync(g.DisplayIds.First()) : null;
                            // A zone referencing a role missing from the catalog (hand-edited or
                            // partially-imported config) gets the role recovered so the assignment
                            // survives the round-trip instead of being silently reset.
                            if (!string.IsNullOrWhiteSpace(g.LogoRoleKey) &&
                                wallLogoRoles.All(r => r.Key != g.LogoRoleKey))
                            {
                                wallLogoRoles.Add(new LogoRoleDefinition
                                {
                                    Key = g.LogoRoleKey, Name = $"{g.LogoRoleKey} (recovered)",
                                    SortOrder = wallLogoRoles.Count
                                });
                            }

                            wallLogoZones.Add(new WallLogoZoneItem
                            {
                                Name               = g.GroupName,
                                WidthPx            = (int)(zoneDisplay?.DisplayWidth  ?? 1073),
                                HeightPx           = (int)(zoneDisplay?.DisplayHeight ?? 648),
                                PositionTop        = g.PositionTop,
                                PositionLeft       = g.PositionLeft,
                                ZIndex             = g.ZIndex,
                                LogoRoleKey        = string.IsNullOrWhiteSpace(g.LogoRoleKey) ? null : g.LogoRoleKey,
                                ExistingDisplayIds = g.DisplayIds.ToList()
                            });
                        }
                        else
                        {
                            // Recover layer dimensions from the single display.
                            // DisplayWidth stores the per-tile image width; multiply by the loop
                            // count to reconstruct the full canvas width that the user edits.
                            var layerDisplay = g.DisplayIds.Any()
                                ? await dbContext.TblDisplays.FindAsync(g.DisplayIds.First()) : null;
                            var loopCount = Math.Max(1, g.HorizontalImageLoop);
                            wallLayers.Add(new WallLayerItem
                            {
                                Name                = g.GroupName,
                                Role                = g.Role ?? "custom",
                                WidthPx             = (int)(layerDisplay?.DisplayWidth ?? 6144) * loopCount,
                                HeightPx            = (int)(layerDisplay?.DisplayHeight ?? 700),
                                HorizontalImageLoop = loopCount,
                                PositionTop         = g.PositionTop,
                                PositionLeft        = g.PositionLeft,
                                ZIndex              = g.ZIndex,
                                ExistingDisplayIds  = g.DisplayIds.ToList()
                            });
                        }
                    }
                }
            }
            catch { /* ignore parse errors */ }
        }

        LoadDataAsync();
        StateHasChanged();
    }

    // --- File upload handlers ---

    private async Task OnVisualBackgroundUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 20 * 1024 * 1024) { errorMessage = "File too large (max 20 MB)"; return; }

        visualBackgroundFile = file;
        using var stream = file.OpenReadStream(20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        visualBackgroundBytes = ms.ToArray();

        // Auto-detect image dimensions
        try
        {
            using var ms2 = new MemoryStream(visualBackgroundBytes);
            using var img = System.Drawing.Image.FromStream(ms2);
            resolutionWidth = img.Width;
            resolutionHeight = img.Height;
        }
        catch { /* not an image format we can parse; leave dimensions as-is */ }

        visualBackgroundPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(visualBackgroundBytes)}";
        errorMessage = null;
        StateHasChanged();
    }

    private async Task OnModelFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 50 * 1024 * 1024) { errorMessage = "Model file too large (max 50 MB)"; return; }

        modelFile = file;
        using var stream = file.OpenReadStream(50 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
