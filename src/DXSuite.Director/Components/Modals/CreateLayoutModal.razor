    /// <summary>
    /// Consolidated wrapped layer URL per player output. Strip height is the
    /// background layer's height; the canvas row width is the background layer's
    /// full width, so URLs only appear once a background layer is defined.
    /// </summary>
    private IEnumerable<string> GetWrappedOutputUrls()
    {
        if (!wallWrappedOutputsEnabled || !isEditMode || editingLocationId is not int locId)
            yield break;
        var bgLayer = wallLayers.FirstOrDefault(l =>
            string.Equals(l.Role, "background", StringComparison.OrdinalIgnoreCase));
        int stripH = bgLayer?.HeightPx ?? 0;
        if (bgLayer == null || stripH <= 0 || wallOutputWidth <= 0 || wallOutputHeight < stripH)
            yield break;

        int strips = Math.Max(1, wallOutputHeight / stripH);
        int span = strips * wallOutputWidth;
        int outputs = (int)Math.Ceiling((double)bgLayer.WidthPx / span);
        for (int n = 0; n < outputs; n++)
            yield return $"/videowall/layer?locationId={locId}&layers=background,mask,counter,logo" +
                         $"&left={n * span}&wrap={wallOutputWidth}x{stripH}&outh={wallOutputHeight}";
    }

    private IReadOnlyList<RenditionSetStatus> GetRenditionStatuses()
    {
        try
        {
            return isEditMode && editingLocationId is int locId
                ? renditionService.GetStatuses(locId)
                : Array.Empty<RenditionSetStatus>();
        }
        catch { return Array.Empty<RenditionSetStatus>(); }
    }

    private class WallRowItem
    {
        public string Name { get; set; } = "Counter Row";
        public int CounterCount { get; set; } = 8;
        public double CounterHeightPx { get; set; } = 1080;
        public double VerticalPositionPx { get; set; } = 0;
        public double HorizontalStartPx { get; set; } = 0;
        /// <summary>
        /// Cyclic gap pattern. Gaps[i] is the pixel gap after display i (before display i+1).
        /// Replaces the legacy Spacing field; single-element list is equivalent to uniform spacing.
        /// </summary>
        public List<double> Gaps { get; set; } = new() { 0 };
        public double DisplayScale { get; set; } = 1.0;
        public int ZIndex { get; set; } = 10;
        public double? AllocationLeftPx { get; set; }
        public double? AllocationRightPx { get; set; }
        public List<int> ExistingDisplayIds { get; set; } = new();
    }

    // Non-blocking sanity check: inverted bounds on a row, or authored bounds of
    // neighboring rows crossing each other. Overlaps still apply verbatim.
    private string? AllocationBoundsWarning()
    {
        foreach (var row in wallRows)
            if (row.AllocationLeftPx.HasValue && row.AllocationRightPx.HasValue
                && row.AllocationLeftPx.Value >= row.AllocationRightPx.Value)
                return $"Row '{row.Name}': Allocation Left is at or beyond Allocation Right.";

        var ordered = wallRows.OrderBy(r => r.HorizontalStartPx).ToList();
        for (int i = 0; i < ordered.Count - 1; i++)
            if (ordered[i].AllocationRightPx is double right
                && ordered[i + 1].AllocationLeftPx is double left && right > left)
                return $"Rows '{ordered[i].Name}' and '{ordered[i + 1].Name}' have overlapping allocation bounds ({right:0} > {left:0}). They will render as authored.";

        return null;
    }

    /// <summary>
    /// Creates a constraint for a wall layer display if one does not exist, or updates the
    /// resolution of an existing constraint to match the current image dimensions.
    /// The constraint enforces the per-tile asset size so the status selector and upload
    /// validation use the tiled image width rather than the full canvas width.
    /// </summary>
    private async Task EnsureLayerConstraintAsync(
        IDirectorDBContext db, TblDisplay display,
        int widthPx, int heightPx, int locationId, string layerName)
    {
        if (display.ConstraintId > 0)
        {
            var c = await db.TblConstraints.FindAsync(display.ConstraintId);
            if (c != null)
            {
                c.ResolutionWidth  = widthPx;
                c.ResolutionHeight = heightPx;
            }
        }
        else
        {
            var c = new TblConstraint
            {
                ConstraintName   = layerName,
                OwningLocationId = locationId,
                IsGlobal         = false,
                ResolutionWidth  = widthPx,
                ResolutionHeight = heightPx,
                ResolutionMode   = "exact",
                CreateDate       = DateTime.UtcNow
            };
            db.TblConstraints.Add(c);
            await db.SaveChangesAsync();
            display.ConstraintId = c.ConstraintId;
        }
        await db.SaveChangesAsync();
    }

    private class WallLayerItem
    {
        public string Name { get; set; } = "Layer";
        public string Role { get; set; } = "mask";
        public int WidthPx { get; set; } = 6144;
        public int HeightPx { get; set; } = 700;
        public double PositionTop { get; set; } = 0;
        public double PositionLeft { get; set; } = 0;
        public int ZIndex { get; set; } = 1;
        /// <summary>
        /// How many times the image tiles horizontally. WidthPx is the full canvas width;
        /// image width = WidthPx / HorizontalImageLoop.
        /// </summary>
        public int HorizontalImageLoop { get; set; } = 1;
        public List<int> ExistingDisplayIds { get; set; } = new();
    }

    /// <summary>
    /// One explicitly-positioned logo zone on the video wall canvas. Each zone is backed by a
    /// TblDisplay (for the asset constraint) and a PanoramaGroup with Role="logo". The airline
    /// whose logo appears here is resolved at runtime by whichever counter cluster's X range
    /// contains this zone's midpoint.
    /// </summary>
    private class WallLogoZoneItem
    {
        public string Name { get; set; } = "Logo Zone";
        /// <summary>Full canvas width of the zone in pixels.</summary>
        public int WidthPx { get; set; } = 1073;
        public int HeightPx { get; set; } = 648;
        public double PositionTop { get; set; } = 0;
        public double PositionLeft { get; set; } = 0;
        public int ZIndex { get; set; } = 20;
        /// <summary>Key of the wall logo role this zone renders; empty/null = the legacy default role.</summary>
        public string? LogoRoleKey { get; set; }
        public List<int> ExistingDisplayIds { get; set; } = new();
    }

    private void AddLogoRole()
    {
        var name = $"Role {wallLogoRoles.Count + 1}";
        wallLogoRoles.Add(new LogoRoleDefinition
        {
            Key = UniqueRoleKey(name), Name = name, SortOrder = wallLogoRoles.Count
        });
    }

    private void RemoveLogoRole(LogoRoleDefinition role)
    {
        if (wallLogoZones.Any(z => z.LogoRoleKey == role.Key))
        {
            errorMessage = $"Role '{role.Name}' is still assigned to a logo zone — reassign those zones first.";
            return;
        }
        wallLogoRoles.Remove(role);
        errorMessage = null;
    }

    // Keys are slugged once at creation and survive renames — zone assignments and
    // airline uploads reference the key, so renaming a role must not orphan them.
    private string UniqueRoleKey(string name)
    {
        var slug = new string(name.ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
        if (string.IsNullOrEmpty(slug)) slug = "role";
        var key = slug;
        int n = 2;
        while (wallLogoRoles.Any(r => r.Key == key)) key = $"{slug}-{n++}";
        return key;
    }

