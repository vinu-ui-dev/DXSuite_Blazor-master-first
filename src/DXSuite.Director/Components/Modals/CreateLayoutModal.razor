                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3 py-2">@errorMessage</div>
                }
            </div>

            <div class="modal-footer">
                @if (currentStep == Step.SelectType)
                {
                    <button class="dx-btn dx-btn-gray" @onclick="Close">Cancel</button>
                    <button class="dx-btn dx-btn-blue" @onclick="NextStep" disabled="@(string.IsNullOrWhiteSpace(locationName) || selectedType == null)">Next</button>
                }
                else
                {
