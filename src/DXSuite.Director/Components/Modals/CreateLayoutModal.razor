@using DXSuite.Director.Entities
@using DXSuite.Director.Models
@using DXSuite.Director.Models.LocationBundles
@using DXSuite.Director.Services
@using DXSuite.Director.Services.LocationBundles
@using DXSuite.Shared.Services.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting
@using System.Text.Json
@inject IDirectorDBContext dbContext
@inject ILogger<CreateLayoutModal> Logger
@inject IDirectorLocationAccessService locationAccessService
@inject ISessionState sessionState
@inject ITenantContext tenantContext
@inject LocationAccessBroadcastService accessBroadcast
@inject IWebHostEnvironment webHostEnvironment
@inject ITenantMediaPathResolver MediaPaths
@inject IFloorPlanService floorPlanService
@inject IMetadataDefinitionService metadataDefinitionService
@inject ILocationMetadataRuleService locationMetadataRules
@inject IBackgroundRenditionService renditionService
@inject IPublicationInvalidator publicationInvalidator

@if (isOpen)
{
    <div class="modal-overlay">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4>@(isEditMode ? (selectedType == LocationType.FloorPlan ? "Edit Floorplan" : selectedType == LocationType.Panorama ? "Edit Panorama" : selectedType == LocationType.VideoWall ? "Edit Video Wall" : "Edit Layout") : "Create Location")</h4>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="Close"></button>
            </div>

            <div class="modal-body">
                @if (currentStep == Step.SelectType)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Location Name</label>
                        <input type="text" class="dx-form-control" @bind="locationName" placeholder="Enter location name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Location Group</label>
                        <div class="d-flex gap-2">
                            <select class="form-select" @bind="selectedLocationGroupId" style="flex: 1;">
                                @if (locationGroups != null)
                                {
                                    @foreach (var group in locationGroups)
                                    {
                                        <option value="@group.LocationGroupId">@group.LocationGroupName</option>
                                    }
                                }
                                <option value="-1">+ Create New Group</option>
                            </select>
                        </div>
                        @if (selectedLocationGroupId == -1)
                        {
                            <input type="text" class="dx-form-control mt-2" @bind="newGroupName" placeholder="Enter new group name" />
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Location Type</label>
                        <div class="location-type-options">
                            <div class="type-option @(selectedType == LocationType.Playlist ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.Playlist">
                                <div class="type-icon"><i class="fa fa-list"></i></div>
                                <div class="type-name">Playlist</div>
                                <div class="type-desc">Sequential media playback</div>
                            </div>
                            <div class="type-option @(selectedType == LocationType.Card ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.Card">
                                <div class="type-icon"><i class="fa fa-th-large"></i></div>
                                <div class="type-name">Card</div>
                                <div class="type-desc">Multiple displays with scheduling</div>
                            </div>
                            <div class="type-option @(selectedType == LocationType.Layout ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.Layout">
                                <div class="type-icon"><i class="fa fa-border-all"></i></div>
                                <div class="type-name">Layout</div>
                                <div class="type-desc">Compose multiple locations into zones</div>
                            </div>
                            <div class="type-option @(selectedType == LocationType.AssetLibrary ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.AssetLibrary">
                                <div class="type-icon"><i class="fa fa-database"></i></div>
                                <div class="type-name">Asset Library</div>
                                <div class="type-desc">Shared content pool for multiple locations</div>
                            </div>
                            <div class="type-option @(selectedType == LocationType.FloorPlan ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.FloorPlan">
                                <div class="type-icon"><i class="fa fa-map"></i></div>
                                <div class="type-name">Floorplan</div>
                                <div class="type-desc">Interactive map with positioned displays</div>
                            </div>
                            <div class="type-option @(selectedType == LocationType.Panorama ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.Panorama">
                                <div class="type-icon"><i class="fa fa-tv"></i></div>
                                <div class="type-name">Panorama</div>
                                <div class="type-desc">Display wall with positioned screens</div>
                            </div>
                            <div class="type-option @(selectedType == LocationType.VideoWall ? "type-active" : "")"
                                 @onclick="() => selectedType = LocationType.VideoWall">
                                <div class="type-icon"><i class="bi bi-grid-3x3"></i></div>
                                <div class="type-name">Video Wall</div>
                                <div class="type-desc">Airport counter video wall with airline scheduling</div>
                            </div>
                            @if (customLocationTypeId.HasValue)
                            {
                                <div class="type-option @(selectedType == LocationType.Custom ? "type-active" : "")"
                                     @onclick="() => selectedType = LocationType.Custom">
                                    <div class="type-icon"><i class="fa fa-puzzle-piece"></i></div>
                                    <div class="type-name">Custom</div>
                                    <div class="type-desc">Uploaded bundle experience</div>
                                </div>
                            }
                            @if (customDisplayLocationTypeId.HasValue)
                            {
                                <div class="type-option @(selectedType == LocationType.CustomDisplay ? "type-active" : "")"
                                     @onclick="() => selectedType = LocationType.CustomDisplay">
                                    <div class="type-icon"><i class="fa fa-puzzle-piece"></i></div>
                                    <div class="type-name">Custom Display</div>
                                    <div class="type-desc">Uploaded bundle with managed displays</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (currentStep == Step.ConfigurePlaylist)
                {
                    <p class="text-muted mb-3">Set the resolution for this playlist location. This determines the aspect ratio for content.</p>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label fw-bold">Width</label>
                            <input type="number" class="dx-form-control" @bind="resolutionWidth" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Height</label>
                            <input type="number" class="dx-form-control" @bind="resolutionHeight" min="1" />
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">Common: 1920x1080 (16:9), 1080x1920 (9:16 portrait), 3840x2160 (4K)</small>
                    </div>
                }
                else if (currentStep == Step.ConfigureCustom)
                {
                    <p class="text-muted mb-3">
                        Choose the uploaded bundle this location renders. The location tracks the bundle's
                        current version; settings and version pinning are available afterward via Configure.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bundle</label>
                        @if (availableBundles == null || availableBundles.Count == 0)
                        {
                            <p class="text-muted">No bundles uploaded yet. Upload one in Configuration &gt; Location Bundles first.</p>
                        }
                        else
                        {
                            <select class="form-select" @bind="selectedBundleKey">
                                <option value="">(select a bundle)</option>
                                @foreach (var bundle in availableBundles)
                                {
                                    <option value="@bundle.BundleKey">@bundle.Name (v@(bundle.CurrentVersion))</option>
                                }
                            </select>
                        }
                    </div>
                    @if (selectedType == LocationType.CustomDisplay)
                    {
                        <p class="text-muted mb-2">This type manages displays. A first display is created now; more can be added in Edit.</p>
                        <div class="row">
                            <div class="col-6">
                                <label class="form-label fw-bold">Display Width</label>
                                <input type="number" class="dx-form-control" @bind="resolutionWidth" min="1" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Display Height</label>
                                <input type="number" class="dx-form-control" @bind="resolutionHeight" min="1" />
                            </div>
                        </div>
                    }
                }
                else if (currentStep == Step.ConfigureCard)
                {
                    <p class="text-muted mb-3">Add displays for this card location. Each display can have independent content and scheduling.</p>

                    <div class="displays-list">
                        @foreach (var display in cardDisplays)
                        {
                            <div class="display-item">
                                <div class="display-item-header">
                                    <input type="text" class="dx-form-control form-control-sm" @bind="display.Name" placeholder="Display name" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCardDisplay(display)">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                                <div class="display-item-resolution">
                                    <input type="number" class="dx-form-control form-control-sm" @bind="display.Width" placeholder="Width" min="1" />
                                    <span>x</span>
                                    <input type="number" class="dx-form-control form-control-sm" @bind="display.Height" placeholder="Height" min="1" />
                                </div>
                            </div>
                        }
                    </div>

                    <button class="btn btn-outline-primary btn-sm mt-2" @onclick="AddCardDisplay">
                        <i class="fa fa-plus me-1"></i> Add Display
                    </button>
                }
                else if (currentStep == Step.ConfigureLayout)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Layout Resolution</label>
                        <p class="text-muted small mb-2">The native resolution of the target display.</p>
                        <div class="row">
                            <div class="col-6">
                                <input type="number" class="dx-form-control" @bind="resolutionWidth" min="1" placeholder="Width" />
                            </div>
                            <div class="col-6">
                                <input type="number" class="dx-form-control" @bind="resolutionHeight" min="1" placeholder="Height" />
                            </div>
                        </div>
                    </div>

                    <div class="available-locations mb-3">
                        <label class="form-label fw-bold">Add Zones</label>
                        <p class="text-muted small mb-2">Select existing Playlist or Card locations to add as zones.</p>
                        @if (availableLocations != null)
                        {
                            @foreach (var loc in availableLocations)
                            {
                                var hasDimensions = HasValidDimensions(loc);
                                var isPlaylist = IsPlaylistLocation(loc);
                                <div class="location-item @(hasDimensions ? "" : "disabled")"
                                     @onclick="() => SelectLocation(loc)">
                                    <div class="location-item-info">
                                        <span class="location-item-name">@loc.LocationName</span>
                                        <span class="@(isPlaylist ? "dx-badge dx-badge-blue" : "dx-badge dx-badge-gray")">
                                            @(isPlaylist ? "Playlist" : "Card")
                                        </span>
                                    </div>
                                    @if (hasDimensions)
                                    {
                                        <span class="location-item-size">@GetDimensionsDisplay(loc)</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning small">No dimensions</span>
                                    }
                                </div>
                            }
                        }
                    </div>

                    @if (selectedLocation != null && !IsPlaylistLocation(selectedLocation))
                    {
                        <div class="display-selector-panel mb-3">
                            <label class="form-label fw-bold">Select Display from @selectedLocation.LocationName</label>
                            @foreach (var display in GetDisplaysForLocation(selectedLocation))
                            {
                                var hasDisplayDimensions = display.DisplayWidth > 0 && display.DisplayHeight > 0;
                                <div class="location-item @(hasDisplayDimensions ? "" : "disabled")"
                                     @onclick="() => AddZoneFromDisplay(selectedLocation, display)">
                                    <span>@display.DisplayName</span>
                                    @if (hasDisplayDimensions)
                                    {
                                        <span>@display.DisplayWidth x @display.DisplayHeight</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning small">No dimensions</span>
                                    }
                                </div>
                            }
                            <button class="dx-btn dx-btn-gray btn-sm mt-2" @onclick="ClearSelectedLocation">Cancel</button>
                        </div>
                    }

                    @if (layoutZones.Any())
                    {
                        <div class="layout-zones">
                            <label class="form-label fw-bold">Layout Zones (@layoutZones.Count)</label>
                            @foreach (var zone in layoutZones)
                            {
                                <div class="zone-item">
                                    <div class="zone-item-header">
                                        <span>Zone @zone.ZoneNumber: @zone.SourceLocationName</span>
                                        @if (!string.IsNullOrEmpty(zone.DisplayName))
                                        {
                                            <small class="text-muted">(@zone.DisplayName)</small>
                                        }
                                        <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => RemoveZone(zone)">x</button>
                                    </div>
                                    <div class="zone-item-position">
                                        <div class="position-field">
                                            <label>Left px</label>
                                            <input type="number" class="dx-form-control form-control-sm" @bind="zone.Left" min="0" step="1" />
                                        </div>
                                        <div class="position-field">
                                            <label>Top px</label>
                                            <input type="number" class="dx-form-control form-control-sm" @bind="zone.Top" min="0" step="1" />
                                        </div>
                                        <div class="position-field">
                                            <label>Width px</label>
                                            <input type="number" class="dx-form-control form-control-sm" @bind="zone.Width" min="1" step="1" />
                                        </div>
                                        <div class="position-field">
                                            <label>Height px</label>
                                            <input type="number" class="dx-form-control form-control-sm" @bind="zone.Height" min="1" step="1" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                else if (currentStep == Step.ConfigureAssetLibrary)
                {
                    <p class="text-muted mb-3">Configure the resolution for this asset library.</p>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label fw-bold">Width</label>
                            <input type="number" class="dx-form-control" @bind="resolutionWidth" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Height</label>
                            <input type="number" class="dx-form-control" @bind="resolutionHeight" min="1" />
                        </div>
                    </div>
                    <div class="mt-2 mb-3">
                        <small class="text-muted">Common: 1920x1080 (16:9), 1080x1920 (9:16 portrait), 3840x2160 (4K)</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Resolution Mode</label>
                        <select class="dx-form-control" @bind="assetLibraryResolutionMode">
                            <option value="aspect-ratio">Aspect Ratio (scales to fit)</option>
                            <option value="exact">Exact Match (pixel-perfect)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Metadata Filters</label>
                        <small class="text-muted d-block mb-2">Add metadata filters to tag and categorize assets</small>
                        @for (var i = 0; i < assetLibraryMetadataKeys.Count; i++)
                        {
                            var idx = i;
                            <div style="display:flex; gap:8px; margin-bottom:8px; align-items:center;">
                                <select class="dx-form-control" style="flex:1;"
                                        value="@assetLibraryMetadataKeys[idx]"
                                        @onchange="@((ChangeEventArgs e) => assetLibraryMetadataKeys[idx] = e.Value?.ToString() ?? "")">
                                    <option value="">— Select field —</option>
                                    @if (metadataDefinitions != null)
                                    {
                                        @foreach (var def in metadataDefinitions)
                                        {
                                            <option value="@def.MetadataKey">@def.DisplayName (@def.MetadataKey)</option>
                                        }
                                    }
                                </select>
                                <button class="dx-btn dx-btn-outline-red dx-btn-sm" @onclick="() => assetLibraryMetadataKeys.RemoveAt(idx)">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                        }
                        <button class="dx-btn dx-btn-outline-blue dx-btn-sm" @onclick='() => assetLibraryMetadataKeys.Add("")'>
                            <i class="fa fa-plus"></i> Add Filter
                        </button>
                    </div>
                }
                else if (currentStep == Step.ConfigureFloorPlan)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Background Mode</label>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <button class="mode-btn @(visualBackgroundMode == "image" ? "mode-active" : "")" @onclick='() => visualBackgroundMode = "image"'>
                                <i class="fa fa-image"></i> Static Image
                            </button>
                            <button class="mode-btn @(visualBackgroundMode == "googlemap" ? "mode-active" : "")" @onclick='() => visualBackgroundMode = "googlemap"'>
                                <i class="fa fa-map-marked-alt"></i> Google Map
                            </button>
                            <button class="mode-btn @(visualBackgroundMode == "offlinemap" ? "mode-active" : "")" @onclick='() => visualBackgroundMode = "offlinemap"'>
                                <i class="fa fa-globe"></i> Offline Map
                            </button>
                            <button class="mode-btn @(visualBackgroundMode == "3dmodel" ? "mode-active" : "")" @onclick='() => visualBackgroundMode = "3dmodel"'>
                                <i class="fa fa-cube"></i> 3D Model
                            </button>
                        </div>
                    </div>

                    @if (visualBackgroundMode == "image")
                    {
                        <p class="text-muted mb-3">Upload a background image and set canvas dimensions.</p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Background Image</label>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <label class="dx-btn dx-btn-blue dx-btn-sm" style="cursor:pointer; margin:0;">
                                    <i class="fa fa-upload"></i> Choose Image
                                    <InputFile OnChange="OnVisualBackgroundUpload" accept=".jpg,.jpeg,.png,.gif,.svg" style="display:none;" />
                                </label>
                                @if (visualBackgroundFile != null)
                                {
                                    <span class="text-muted" style="font-size:13px;">@visualBackgroundFile.Name</span>
                                }
                            </div>
                            <small class="text-muted">Accepted: JPG, PNG, GIF, SVG (max 20 MB)</small>
                        </div>

                        @if (!string.IsNullOrEmpty(visualBackgroundPreviewUrl))
                        {
                            <div class="mb-3" style="text-align:center;">
                                <img src="@visualBackgroundPreviewUrl" alt="Background preview" style="max-height:200px; max-width:100%; border:1px solid #ddd; border-radius:6px;" />
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold">Canvas Width</label>
                                <input type="number" class="dx-form-control" @bind="resolutionWidth" min="1" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Canvas Height</label>
                                <input type="number" class="dx-form-control" @bind="resolutionHeight" min="1" />
                            </div>
                        </div>
                    }
                    else if (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap")
                    {
                        <p class="text-muted mb-3">Configure map center, zoom, and bounds.</p>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold">Center Latitude</label>
                                <input type="number" class="dx-form-control" @bind="mapCenterLatitude" step="0.0001" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Center Longitude</label>
                                <input type="number" class="dx-form-control" @bind="mapCenterLongitude" step="0.0001" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4">
                                <label class="form-label fw-bold">Zoom Level</label>
                                <input type="number" class="dx-form-control" @bind="mapZoomLevel" min="1" max="22" />
                            </div>
                            <div class="col-4">
                                <label class="form-label fw-bold">Canvas Width</label>
                                <input type="number" class="dx-form-control" @bind="resolutionWidth" min="1" />
                            </div>
                            <div class="col-4">
                                <label class="form-label fw-bold">Canvas Height</label>
                                <input type="number" class="dx-form-control" @bind="resolutionHeight" min="1" />
                            </div>
                        </div>
                        @if (visualBackgroundMode == "offlinemap")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tile Path</label>
                                <input type="text" class="dx-form-control" @bind="offlineTilePath" placeholder="/tiles/{z}/{x}/{y}.png" />
                            </div>
                        }
                    }
                    else if (visualBackgroundMode == "3dmodel")
                    {
                        <p class="text-muted mb-3">Upload a GLB 3D model file.</p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">3D Model (GLB)</label>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <label class="dx-btn dx-btn-blue dx-btn-sm" style="cursor:pointer; margin:0;">
                                    <i class="fa fa-cube"></i> Choose Model
                                    <InputFile OnChange="OnModelFileUpload" accept=".glb" style="display:none;" />
                                </label>
                                @if (modelFile != null)
                                {
                                    <span class="text-muted" style="font-size:13px;">@modelFile.Name</span>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Hotspot Scale</label>
                            <input type="number" class="dx-form-control" style="width:120px;" @bind="hotspotScale" step="0.1" min="0.1" />
                        </div>
                    }

                    @* ── ELEMENT MANAGEMENT ── *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Add Element</label>
                        <div class="row g-2 mb-1">
                            <div class="col-3">
                                <label class="small">Type</label>
                                <select class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualType">
                                    <option value="display">Display</option>
                                    <option value="location">Location</option>
                                </select>
                            </div>
                            <div class="col-5">
                                @if (addVisualType == "display")
                                {
                                    <label class="small">Display</label>
                                    <select class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualDisplayId">
                                        <option value="0">— Select —</option>
                                        @foreach (var d in allDisplays)
                                        {
                                            <option value="@d.DisplayId">@d.DisplayName</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <label class="small">Location</label>
                                    <select class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualLocationId">
                                        <option value="0">— Select —</option>
                                        @foreach (var l in allLocations.Where(l => l.LocationId != editingLocationId))
                                        {
                                            <option value="@l.LocationId">@l.LocationName</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="col-4">
                                <label class="small">Icon URL</label>
                                <input type="text" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualIconPath" placeholder="optional" />
                            </div>
                        </div>
                        @if (addVisualType == "display")
                        {
                            <div style="margin-bottom:6px;">
                                <input type="checkbox" id="chkLivePreview" @bind="addVisualShowLivePreview" />
                                <label class="small" for="chkLivePreview" style="cursor:pointer;">Show live preview instead of icon</label>
                            </div>
                        }
                        <div class="row g-1 mb-2">
                            @if (visualBackgroundMode == "image")
                            {
                                <div class="col-2">
                                    <label class="small">Left</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualLeft" />
                                </div>
                                <div class="col-2">
                                    <label class="small">Top</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualTop" />
                                </div>
                                <div class="col-2">
                                    <label class="small">Width</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualWidth" />
                                </div>
                                <div class="col-2">
                                    <label class="small">Height</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualHeight" />
                                </div>
                            }
                            else if (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap")
                            {
                                <div class="col-3">
                                    <label class="small">Latitude</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualLatitude" step="0.000001" />
                                </div>
                                <div class="col-3">
                                    <label class="small">Longitude</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisualLongitude" step="0.000001" />
                                </div>
                            }
                            else if (visualBackgroundMode == "3dmodel")
                            {
                                <div class="col-2">
                                    <label class="small">X</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisual3DX" step="0.1" />
                                </div>
                                <div class="col-2">
                                    <label class="small">Y</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisual3DY" step="0.1" />
                                </div>
                                <div class="col-2">
                                    <label class="small">Z</label>
                                    <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="addVisual3DZ" step="0.1" />
                                </div>
                            }
                            <div class="col-2 d-flex align-items-end">
                                <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="AddVisualElement">Add</button>
                            </div>
                        </div>
                    </div>

                    @if (visualElements.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Elements (@visualElements.Count)</label>
                            @foreach (var el in visualElements)
                            {
                                <div class="pano-item-card">
                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                                        <span>
                                            <span class="badge @(el.Type == "display" ? "bg-primary" : "bg-secondary")" style="font-size:0.7rem;">@el.Type</span>
                                            <strong class="small">@el.DisplayOrLocationName</strong>
                                        </span>
                                        <button class="dx-btn dx-btn-outline-red dx-btn-sm" @onclick="() => RemoveVisualElement(el)">×</button>
                                    </div>
                                    @if (visualBackgroundMode == "image")
                                    {
                                        <div class="row g-1">
                                            <div class="col-3">
                                                <label class="small">Left</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Left" min="0" />
                                            </div>
                                            <div class="col-3">
                                                <label class="small">Top</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Top" min="0" />
                                            </div>
                                            <div class="col-3">
                                                <label class="small">Width</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Width" min="1" />
                                            </div>
                                            <div class="col-3">
                                                <label class="small">Height</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Height" min="1" />
                                            </div>
                                        </div>
                                    }
                                    else if (visualBackgroundMode == "googlemap" || visualBackgroundMode == "offlinemap")
                                    {
                                        <div class="row g-1">
                                            <div class="col-4">
                                                <label class="small">Latitude</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Latitude" step="0.000001" />
                                            </div>
                                            <div class="col-4">
                                                <label class="small">Longitude</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Longitude" step="0.000001" />
                                            </div>
                                        </div>
                                    }
                                    else if (visualBackgroundMode == "3dmodel")
                                    {
                                        <div class="row g-1">
                                            <div class="col-2">
                                                <label class="small">X</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Position3DX" step="0.1" />
                                            </div>
                                            <div class="col-2">
                                                <label class="small">Y</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Position3DY" step="0.1" />
                                            </div>
                                            <div class="col-2">
                                                <label class="small">Z</label>
                                                <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="el.Position3DZ" step="0.1" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else if (currentStep == Step.ConfigurePanorama)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Background Image</label>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <label class="dx-btn dx-btn-blue dx-btn-sm" style="cursor:pointer; margin:0;">
                                Choose Image
                                <InputFile OnChange="OnPanoramaBackgroundUpload" accept=".jpg,.jpeg,.png,.gif,.svg" style="display:none;" />
                            </label>
                            @if (panoBackgroundPreviewUrl != null)
                            {
                                <span class="text-success small"><i class="fa fa-check"></i> @resolutionWidth × @resolutionHeight</span>
                            }
                        </div>
                        @if (panoBackgroundPreviewUrl != null)
                        {
                            <img src="@panoBackgroundPreviewUrl" class="mt-2" style="max-width:100%;max-height:120px;border:1px solid #ddd;border-radius:4px;" />
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Scale Factor</label>
                        <input type="number" class="dx-form-control" style="width:100px;" @bind="panoScaleFactor" step="0.1" min="0.1" max="2.0" />
                        <small class="text-muted">Controls preview zoom (0.4 = 40% of native resolution)</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Displays</label>
                        <div style="display:flex; gap:8px; margin-bottom:8px;">
                            <button class="dx-btn dx-btn-outline-blue dx-btn-sm" @onclick="AddPanoDisplay">
                                <i class="fa fa-plus"></i> Add Display
                            </button>
                            <button class="dx-btn dx-btn-outline-blue dx-btn-sm" @onclick="AddPanoGroup">
                                <i class="fa fa-plus"></i> Add Group
                            </button>
                        </div>

                        @foreach (var item in panoDisplayItems)
                        {
                            <div class="pano-item-card">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                                    <strong class="small">@(item.IsGroup ? "Group" : "Display"): @item.Name</strong>
                                    <button class="dx-btn dx-btn-outline-red dx-btn-sm" @onclick="() => panoDisplayItems.Remove(item)">×</button>
                                </div>
                                <div class="row g-1">
                                    <div class="col-4">
                                        <label class="small">Name</label>
                                        <input type="text" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.Name" />
                                    </div>
                                    @if (item.IsGroup)
                                    {
                                        <div class="col-2">
                                            <label class="small">Count</label>
                                            <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.Count" min="1" max="50" />
                                        </div>
                                        <div class="col-2">
                                            <label class="small">Spacing</label>
                                            <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.Spacing" />
                                        </div>
                                        <div class="col-4">
                                            <label class="small">Direction</label>
                                            <select class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.Direction">
                                                <option value="horizontal">Horizontal</option>
                                                <option value="vertical">Vertical</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                                <div class="row g-1 mt-1">
                                    <div class="col-2">
                                        <label class="small">Width</label>
                                        <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.DisplayWidth" min="1" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small">Height</label>
                                        <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.DisplayHeight" min="1" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small">Top</label>
                                        <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.PositionTop" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small">Left</label>
                                        <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.PositionLeft" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small">Z-Index</label>
                                        <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.ZIndex" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small">Scale</label>
                                        <input type="number" class="dx-form-control" style="font-size:0.85rem;padding:4px 8px;" @bind="item.DisplayScale" step="0.1" min="0.1" max="5.0" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (panoBackgroundPreviewUrl != null && panoDisplayItems.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Preview</label>
                            <div style="position:relative; width:100%; max-height:200px; overflow:auto; border:1px solid #ddd; border-radius:4px;">
                                <div style="position:relative; width:@(resolutionWidth * 0.1)px; height:@(resolutionHeight * 0.1)px; background-image:url('@panoBackgroundPreviewUrl'); background-size:100% 100%;">
                                    @foreach (var item in panoDisplayItems)
                                    {
                                        if (item.IsGroup)
                                        {
                                            for (int gi = 0; gi < item.Count; gi++)
                                            {
                                                var scaledW = item.DisplayWidth * item.DisplayScale * 0.1;
                                                var scaledH = item.DisplayHeight * item.DisplayScale * 0.1;
                                                var gTop = item.Direction == "vertical"
                                                    ? item.PositionTop * 0.1 + gi * (scaledH + item.Spacing * 0.1)
                                                    : item.PositionTop * 0.1;
                                                var gLeft = item.Direction == "horizontal"
                                                    ? item.PositionLeft * 0.1 + gi * (scaledW + item.Spacing * 0.1)
                                                    : item.PositionLeft * 0.1;
                                                <div style="position:absolute;top:@(gTop)px;left:@(gLeft)px;width:@(scaledW)px;height:@(scaledH)px;border:1px solid #16FF00;background:rgba(22,255,0,0.15);z-index:@item.ZIndex;" title="@item.Name @(gi + 1)"></div>
                                            }
                                        }
                                        else
                                        {
                                            <div style="position:absolute;top:@(item.PositionTop * 0.1)px;left:@(item.PositionLeft * 0.1)px;width:@(item.DisplayWidth * item.DisplayScale * 0.1)px;height:@(item.DisplayHeight * item.DisplayScale * 0.1)px;border:1px solid #16FF00;background:rgba(22,255,0,0.15);z-index:@item.ZIndex;" title="@item.Name"></div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (currentStep == Step.ConfigureVideoWall)
                {
                    <p class="text-muted mb-3">Configure a video wall with rows of counter displays for airline scheduling.</p>

                    <div class="mb-3">
                        <label class="form-label small mb-1">Context Background Image (optional)</label>
                        <InputFile OnChange="OnWallBackgroundUpload" accept="image/*" class="form-control" />
                        @if (wallBgPreviewUrl != null)
                        {
                            <img src="@wallBgPreviewUrl" style="max-height:120px;max-width:100%;margin-top:8px;border-radius:4px;border:1px solid #444;" alt="Background preview" />
                        }
                    </div>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-3">
                            <label class="form-label small mb-1">Counter Width (px)</label>
                            <input type="number" class="dx-form-control dx-form-control-sm" @bind="wallCounterWidthPx" min="1" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-1">
                                Content Top Offset
                                <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                   title="Shifts all wall content (rows, layers, logo zones) down against the context background in DXSuite's preview surfaces. Players ignore it — each element's own Top offset is relative to the content canvas."></i>
                            </label>
                            <input type="number" class="dx-form-control dx-form-control-sm" @bind="wallContentTopOffsetPx" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-1">
                                Background Scale
                                <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                   title="Scales only the context background image, independently of the content. Tune it so the background's on-screen width matches the content: BackgroundImageWidth × BackgroundScale ≈ wall content width × Content Scale. Use values above 1 to enlarge a background image smaller than the content."></i>
                            </label>
                            <input type="number" class="dx-form-control dx-form-control-sm" @bind="wallBackgroundScaleFactor" min="0.01" max="20" step="0.01" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-1">
                                Content Scale
                                <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                   title="Scales all video wall content (counter rows, wall layers) in the admin UI preview. All native pixel coordinates are multiplied by this value. Lower values zoom out to see more of the wall at once."></i>
                            </label>
                            <input type="number" class="dx-form-control dx-form-control-sm" @bind="wallContentScaleFactor" min="0.01" max="1" step="0.01" />
                        </div>
                    </div>

                    <div class="pano-item-card mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <input type="checkbox" id="wallWrappedOutputs" @bind="wallWrappedOutputsEnabled" />
                            <label class="form-label fw-bold mb-0" for="wallWrappedOutputs">
                                Wrapped Outputs
                                <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                   title="Enable when this wall is driven by fixed-size player outputs (e.g. Moxie 4K) that wrap the canvas row into stacked strips. Background videos get per-output pre-wrapped renditions generated in the background, and each output gets a consolidated layer URL. Strip height comes from the background layer's height."></i>
                            </label>
                        </div>
                        @if (wallWrappedOutputsEnabled)
                        {
                            <div class="row g-2 mb-2">
                                <div class="col-3">
                                    <label class="form-label small mb-1">Output Width (px)</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="wallOutputWidth" min="640" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small mb-1">Output Height (px)</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="wallOutputHeight" min="360" />
                                </div>
                            </div>
                            @if (GetWrappedOutputUrls().ToList() is { Count: > 0 } outputUrls)
                            {
                                <label class="form-label small fw-bold mb-1">Per-Output URLs (click to select)</label>
                                @foreach (var url in outputUrls)
                                {
                                    <div class="small text-muted" style="font-family:monospace; user-select:all; white-space:nowrap; overflow-x:auto;">@url</div>
                                }
                            }
                            @if (GetRenditionStatuses() is { Count: > 0 } renditionStatuses)
                            {
                                <label class="form-label small fw-bold mb-1 mt-2">Background Renditions</label>
                                @foreach (var r in renditionStatuses)
                                {
                                    <div class="small">
                                        <span class="@(r.Status == "done" ? "text-success" : r.Status == "failed" ? "text-danger" : "text-warning")">@r.Status</span>
                                        <span class="text-muted"> @r.OutputsReady/@r.OutputsTotal outputs — @string.Join(", ", r.Inputs.Select(System.IO.Path.GetFileName))</span>
                                        @if (r.Error != null)
                                        {
                                            <span class="text-danger"> @r.Error</span>
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label fw-bold mb-0">Counter Rows</label>
                        <button type="button" class="dx-btn dx-btn-outline-blue dx-btn-sm"
                                @onclick="AddWallRow">
                            + Add Row
                        </button>
                    </div>

                    @if (!wallRows.Any())
                    {
                        <p class="text-muted small">Add at least one counter row.</p>
                    }
                    @foreach (var row in wallRows)
                    {
                        <div class="pano-item-card">
                            <div class="row g-2 align-items-end mb-1">
                                <div class="col-4">
                                    <label class="form-label small mb-1">Row Name</label>
                                    <input type="text" class="dx-form-control dx-form-control-sm" @bind="row.Name" />
                                </div>
                                <div class="col-2">
                                    <label class="form-label small mb-1">Counters</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.CounterCount" min="1" />
                                </div>
                                <div class="col-2">
                                    <label class="form-label small mb-1">Height (px)</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.CounterHeightPx" min="1" />
                                </div>
                                <div class="col-2 text-end">
                                    <button type="button" class="dx-btn dx-btn-outline-red dx-btn-sm"
                                            @onclick="() => wallRows.Remove(row)">× Remove</button>
                                </div>
                            </div>
                            <div class="row g-2 align-items-start mb-1">
                                <div class="col-12">
                                    <label class="form-label small mb-1">
                                        Gap Pattern (px)
                                        <span class="text-muted fw-normal" style="font-size:0.75rem;">
                                            — Gap[i] is inserted after display i→i+1, cycling through the list
                                        </span>
                                    </label>
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        @for (int gi = 0; gi < row.Gaps.Count; gi++)
                                        {
                                            var gidx = gi;
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="text-muted small">[@(gidx + 1)]</span>
                                                <input type="number" class="dx-form-control dx-form-control-sm"
                                                       style="width:80px;"
                                                       value="@row.Gaps[gidx]"
                                                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) { row.Gaps[gidx] = v; StateHasChanged(); } }" min="0" />
                                                @if (row.Gaps.Count > 1)
                                                {
                                                    <button type="button" class="dx-btn dx-btn-outline-red dx-btn-sm"
                                                            @onclick="() => { row.Gaps.RemoveAt(gidx); StateHasChanged(); }">×</button>
                                                }
                                            </div>
                                        }
                                        <button type="button" class="dx-btn dx-btn-outline-blue dx-btn-sm"
                                                @onclick="() => { row.Gaps.Add(0); StateHasChanged(); }">+ Gap</button>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-3">
                                    <label class="form-label small mb-1">Top offset (px)</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.VerticalPositionPx" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small mb-1">Left offset (px)</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.HorizontalStartPx" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small mb-1">
                                        Display Scale
                                        <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                           title="Per-row multiplier applied on top of Content Scale. The final render scale for this row's displays is Content Scale × Display Scale. Set to 1.0 for standard layouts where all counter rows share the same canvas pixel density."></i>
                                    </label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.DisplayScale" min="0.01" max="2" step="0.01" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small mb-1">Z-Index</label>
                                    <input type="number" class="dx-form-control dx-form-control-sm no-spinner" @bind="row.ZIndex" />
                                </div>
                            </div>
                            <div class="row g-2 align-items-end mt-1">
                                <div class="col-3">
                                    <label class="form-label small mb-1">
                                        Allocation Left (px)
                                        <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                           title="Pins the left edge of mask/background coverage for whichever airline cluster contains this row's first counter. Empty keeps the derived behavior (extend to x=0 / inherit the boundary)."></i>
                                    </label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.AllocationLeftPx" />
                                </div>
                                <div class="col-3">
                                    <label class="form-label small mb-1">
                                        Allocation Right (px)
                                        <i class="bi bi-info-circle text-muted ms-1" style="font-size:0.85em; cursor:default;"
                                           title="Pins the right edge of coverage for the cluster containing this row's last counter (and stops the wall's last cluster from extending to the output edge). Empty keeps the derived behavior."></i>
                                    </label>
                                    <input type="number" class="dx-form-control dx-form-control-sm" @bind="row.AllocationRightPx" />
                                </div>
                                <div class="col-6 d-flex align-items-end pb-1">
                                    <span class="text-muted" style="font-size:0.78rem;">
                                        Optional coverage bounds in canvas px. Values apply to whichever airline reaches this row's edge.
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                    @if (AllocationBoundsWarning() is string allocWarning)
                    {
                        <div class="alert alert-warning py-2 mt-2" style="font-size:0.85rem;">@allocWarning</div>
                    }

                    <hr class="my-3" />

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label fw-bold mb-0">Wall Layers <span class="text-muted fw-normal small">(mask, background)</span></label>
                        <button type="button" class="dx-btn dx-btn-outline-blue dx-btn-sm"
                                @onclick="AddWallLayer">
                            + Add Layer
                        </button>
                    </div>

                    @if (!wallLayers.Any())
                    {
                        <p class="text-muted small">Optional. Add mask or background layers that span the full wall.</p>
                    }
                    @foreach (var layer in wallLayers)
                    {
                        <div class="pano-item-card" style="border-left:3px solid var(--dx-blue,#0071BC)">
                            <div class="row g-2 align-items-end mb-1">
                                <div class="col-3">
                                    <label class="form-label small mb-1">Layer Name</label>
                                    <input type="text" class="dx-form-control dx-form-control-sm" @bind="layer.Name" />
                                </div>
                                <div class="col-2">
                                    <label class="form-label small mb-1">Role</label>
                                    <select class="form-select form-select-sm" @bind="layer.Role">
                                        <option value="mask">Mask</option>
                                        <option value="background">Background</option>
                                        <option value="custom">Custom</option>
