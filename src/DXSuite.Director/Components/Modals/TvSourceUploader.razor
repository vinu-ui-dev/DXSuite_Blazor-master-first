@using DXSuite.Director.Entities
@using DXSuite.Director.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using static DXSuite.Director.Models.Types
@inject IDirectorDBContext dbContext
@inject IWebHostEnvironment env
@inject ITenantMediaPathResolver MediaPaths
@inject ISessionState sessionState
@inject IUploadIdentityService uploadIdentity
@inject IContentMetadataService contentMetadataService
@inject ILogger<TvSourceUploader> Logger
@inject IPublicationInvalidator publicationInvalidator

@if (isVisible)
{
    <div class="dx-modal-overlay" @onclick="Close">
        <div class="dx-modal" style="max-width:520px; position:relative;" @onclick:stopPropagation="true">

            <div class="dx-modal-header">
                <h5>@(editingAssetId.HasValue ? "Edit TV Source" : "Add TV Source")</h5>
                @if (!isLoading)
                {
                    <button class="dx-btn dx-btn-gray" @onclick="Close">×</button>
                }
            </div>

            <div class="dx-modal-body">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Channel Name</label>
                    <input type="text" class="dx-form-control" placeholder="ESPN"
                           maxlength="100"
                           @bind="channelName" @bind:event="oninput" />
                    <small class="dx-text-muted">Stored for reference; the logo image is what users see.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Stream URL</label>
                    <input type="text" class="dx-form-control" placeholder="udp://@@239.0.10.26:1026"
                           maxlength="255"
                           @bind="streamUrl" @bind:event="oninput" />
                    <small class="dx-text-muted">UDP multicast or other Ink-readable source. Saved to AssetInkPath.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Channel Logo</label>
                    <InputFile class="dx-form-control" OnChange="@OnLogoSelected"
                               accept=".png,.jpg,.jpeg,.gif,.webp"
                               style="@(isLoading ? "pointer-events: none;" : "")" />
                    <small class="dx-text-muted">
                        PNG, JPG, GIF, or WebP. Displayed on the Director scheduling UI.
                        @if (editingAssetId.HasValue)
                        {
                            <text>Leave blank to keep the current logo.</text>
                        }
                    </small>

                    @if (!string.IsNullOrEmpty(logoPreviewUrl))
                    {
                        <div style="margin-top:10px; text-align:center;">
                            <img src="@logoPreviewUrl"
                                 style="max-width:160px; max-height:120px; object-fit:contain; border:1px solid #CCC; border-radius:4px; background:#F2F2F2; padding:6px;" />
                        </div>
                    }
                </div>

                @if (ShowsUploadingAs)
                {
                    <div class="mb-3">
                        <UploadingAsSection @ref="uploadingAs" LocationId="@(locationId ?? 0)" OnChanged="StateHasChanged" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-2">@errorMessage</div>
                }

            </div>

            <div class="dx-modal-footer">
                @if (UploadBlockReason is { } blockReason)
                {
                    <span class="dx-text-red" style="font-size:0.8rem; margin-right:auto;">@blockReason</span>
                }
                <button class="dx-btn dx-btn-blue" @onclick="HandleSubmit"
                        disabled="@(UploadBlockReason != null)" title="@UploadBlockReason"
                        style="@(isLoading ? "pointer-events:none;" : "")">
                    @(editingAssetId.HasValue ? "Update TV Source" : "Save TV Source")
                </button>
                <button class="dx-btn dx-btn-gray" @onclick="Close"
                        style="@(isLoading ? "pointer-events:none;" : "")">
                    Cancel
                </button>
            </div>

            @if (isLoading)
            {
                <div style="position:absolute; inset:0; background:rgba(255,255,255,0.8); display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:inherit; z-index:10;">
                    <div class="dx-spinner"></div>
                    <p class="dx-text-muted mt-2" style="font-size:13px;">@(editingAssetId.HasValue ? "Updating TV source…" : "Adding TV source…")</p>
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSubmit { get; set; }

    private bool isVisible;
    private bool isLoading;

    private int? locationId;
    private int? constraintId;

    private string channelName = "";
    private string streamUrl = "";
    private string? errorMessage;

    private IBrowserFile? selectedLogo;
    private string? logoPreviewUrl;
    private byte[]? logoBytes;

    // Edit-mode state: when set, HandleSubmit updates the existing asset instead of inserting a new one.
    private int? editingAssetId;
    private string? existingAssetPath;

    private const long MaxLogoBytes = 5 * 1024 * 1024;

    public void Open(int? locationId = null, int? constraintId = null)
    {
        this.locationId = locationId;
        this.constraintId = constraintId;

        editingAssetId = null;
        existingAssetPath = null;
        channelName = "";
        streamUrl = "";
        errorMessage = null;
        selectedLogo = null;
        logoPreviewUrl = null;
        logoBytes = null;
        isLoading = false;
        isVisible = true;

        StateHasChanged();
    }

    public void OpenForEdit(TblAsset asset, int? constraintId = null)
    {
        this.locationId = asset.LocationId;
        this.constraintId = constraintId ?? asset.ConstraintId;

        editingAssetId = asset.AssetId;
        existingAssetPath = asset.AssetPath;
        channelName = asset.AssetName ?? "";
        streamUrl = asset.AssetInkPath ?? "";
        errorMessage = null;
        selectedLogo = null;
        logoBytes = null;
        // Show the current logo so the user can see what's already saved without re-uploading.
        logoPreviewUrl = asset.AssetPath;
        isLoading = false;
        isVisible = true;

        StateHasChanged();
    }

    public void Close()
    {
        isVisible = false;
        editingAssetId = null;
        existingAssetPath = null;
        channelName = "";
        streamUrl = "";
        errorMessage = null;
        selectedLogo = null;
        logoPreviewUrl = null;
        logoBytes = null;

        StateHasChanged();
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        selectedLogo = e.File;

        if (selectedLogo == null) return;

        if (selectedLogo.Size > MaxLogoBytes)
        {
            errorMessage = "Logo must be 5 MB or smaller.";
            selectedLogo = null;
            logoBytes = null;
            logoPreviewUrl = null;
            return;
        }

        using var ms = new MemoryStream();
        await selectedLogo.OpenReadStream(MaxLogoBytes).CopyToAsync(ms);
        logoBytes = ms.ToArray();
        logoPreviewUrl = $"data:{selectedLogo.ContentType};base64,{Convert.ToBase64String(logoBytes)}";

        await InvokeAsync(StateHasChanged);
    }

    private bool IsValidStreamUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;

        // Accepted schemes for Ink-readable TV channels.
        // UDP multicast uses the udp://@<group>:<port> form; @ joins the multicast group.
        return url.StartsWith("udp://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("rtp://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("rtsp://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
    }

    private UploadingAsSection? uploadingAs;

    private bool ShowsUploadingAs => !editingAssetId.HasValue && (locationId ?? 0) > 0;

    private string? UploadBlockReason => ShowsUploadingAs && uploadingAs is { IsBlocked: true } section ? section.BlockReason : null;

    private async Task HandleSubmit()
    {
        errorMessage = null;

        // Server-side role gate: belt-and-suspenders with the UI hiding in ScheduleEditor_TVController.
        // Without this, a determined caller could still invoke the save path even with the buttons hidden.
        if (sessionState?.User == null || sessionState.RoleEnum != Roles.Role.Admin)
        {
            errorMessage = "You don't have permission to modify TV sources.";
            return;
        }

        if (locationId == null || locationId == 0)
        {
            errorMessage = "No location context. Reopen the dialog and try again.";
            return;
        }

        if (string.IsNullOrWhiteSpace(channelName))
        {
            errorMessage = "Please enter a channel name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(streamUrl))
        {
            errorMessage = "Please enter a stream URL.";
            return;
        }

        if (!IsValidStreamUrl(streamUrl))
        {
            errorMessage = "Stream URL must start with udp://, rtp://, rtsp://, http:// or https://.";
            return;
        }

        // Logo upload is required when creating, optional when editing (existing AssetPath is reused if no new file)
        if (!editingAssetId.HasValue && (logoBytes == null || selectedLogo == null))
        {
            errorMessage = "Please select a channel logo image.";
            return;
        }

        PreparedUpload? prepared = null;
        if (!editingAssetId.HasValue)
        {
            prepared = await uploadIdentity.PrepareAsync(sessionState.User.UserId, locationId.Value,
                uploadingAs?.PickedGroupId, uploadingAs?.Picks);
            if (!prepared.IsValid)
            {
                errorMessage = prepared.Error;
                if (uploadingAs != null)
                    await uploadingAs.ReloadAfterRefusalAsync(prepared.Error);
                return;
            }
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            string? webPath = null;
            if (logoBytes != null && selectedLogo != null)
            {
                // Persist logo under wwwroot/MediaAssets/{locationId}/ matching the project's existing asset folder layout
                var baseDirectory = MediaPaths.GetRoot();
                var folderPath = Path.Combine(baseDirectory, "MediaAssets", locationId.Value.ToString());
                Directory.CreateDirectory(folderPath);

                var originalName = Path.GetFileName(selectedLogo.Name);
                var ext = Path.GetExtension(originalName);
                var fileName = $"{Path.GetFileNameWithoutExtension(originalName)}_{DateTime.UtcNow.Ticks}{ext}";
                var filePath = Path.Combine(folderPath, fileName);

                await File.WriteAllBytesAsync(filePath, logoBytes);

                webPath = $"/MediaAssets/{locationId}/{fileName}";
            }

            if (editingAssetId.HasValue)
            {
                var existing = await dbContext.TblAssets.FirstOrDefaultAsync(a => a.AssetId == editingAssetId.Value);
                if (existing == null)
                {
                    errorMessage = "The TV source no longer exists.";
                    return;
                }

                existing.AssetName = channelName.Trim();
                existing.AssetInkPath = streamUrl.Trim();
                if (webPath != null)
                {
                    existing.AssetPath = webPath;
                }

                await dbContext.SaveChangesAsync();
                publicationInvalidator.AssetsChanged([existing.LocationId]);
            }
            else
            {
                var asset = new TblAsset
                {
                    LocationId = locationId.Value,
                    ConstraintId = constraintId ?? 0,
                    AssetName = channelName.Trim(),
                    AssetPath = webPath!,
                    AssetInkPath = streamUrl.Trim(),
                    AssetTypeId = (int)AssetType.Image,
                    AssetGroupId = 1,
                    Duration = 0,
                    AssetHeight = 0,
                    AssetWidth = 0,
                    SortOrder = 0,
                    CreateDate = DateTime.UtcNow,
                    IsDeleted = false,
                    UploadedByUserId = prepared!.OwnerUserId,
                    UploadedByUserGroupId = prepared.OwnerGroupId
                };

                dbContext.TblAssets.Add(asset);
                await dbContext.SaveChangesAsync();
                publicationInvalidator.AssetsChanged([asset.LocationId]);

                foreach (var (key, values) in prepared.Tags)
                    await contentMetadataService.SetMetadataAsync(asset.AssetId, key, values, sessionState.User.UserId);
            }

            await OnSubmit.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving TV source: {ex.Message}";
            Logger.LogError(ex, "Error saving TV source asset for location {LocationId}", locationId);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
