@using DXSuite.Director.Entities
@using DXSuite.Director.Models
@using DXSuite.Director.Services
@using DXSuite.Shared.Multitenancy
@inject IContentOverwriteService overwriteService
@inject ISessionState sessionState
@inject IConfiguration config
@inject ITenantMediaPathResolver MediaPaths
@inject ILogger<ContentReplaceModal> Logger
@rendermode InteractiveServer

@if (isOpen)
{
    <div class="dx-modal-overlay">
        <div class="dx-modal" style="max-width: 520px;">
            <div class="dx-modal-header">
                <h4>Replace Content</h4>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="dx-modal-body">
                <p style="margin-bottom: 8px;">
                    Replacing <strong>@targetName</strong>.
                    The new file keeps this item's schedule, order, and plays per loop.
                </p>
                @if (stagedApproval)
                {
                    <p class="dx-text-muted" style="font-size: 0.85rem;">
                        This location requires approval for replacements. The current content keeps
                        playing until the new file is approved.
                    </p>
                }
                <div style="margin: 12px 0;">
                    <InputFile OnChange="OnFileSelected" accept="image/*,video/*" />
                </div>
                @if (isStaging)
                {
                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                        <div class="dx-spinner dx-spinner-sm"></div>
                        <span style="font-size: 0.85rem;">Loading preview…</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(previewWebPath))
                {
                    <div style="margin-top: 8px; text-align: center;">
                        @if (previewIsVideo)
                        {
                            <video @key="previewWebPath" src="@previewWebPath" muted preload="metadata" playsinline controls
                                   controlslist="nodownload noplaybackrate"
                                   style="max-width: 100%; max-height: 260px; border: 1px solid #e0e2e6; border-radius: 4px; background: #000;"></video>
                        }
                        else
                        {
                            <img src="@previewWebPath" alt="Replacement preview"
                                 style="max-width: 100%; max-height: 260px; border: 1px solid #e0e2e6; border-radius: 4px; background: #eceef1;" />
                        }
                        <div class="dx-text-muted" style="font-size: 0.78rem; margin-top: 4px;">@selectedFileName</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(error))
                {
                    <div style="color: #c0392b; font-size: 0.85rem; margin-top: 8px;">@error</div>
                }
                @if (isBusy)
                {
                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                        <div class="dx-spinner dx-spinner-sm"></div>
                        <span style="font-size: 0.85rem;">Replacing content…</span>
                    </div>
                }
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px; padding: 12px 16px; border-top: 1px solid #e0e2e6;">
                <button class="dx-btn dx-btn-gray" disabled="@isBusy" @onclick="Close">Cancel</button>
                <button class="dx-btn dx-btn-blue" disabled="@(isBusy || isStaging || stagedDiskPath == null)" @onclick="ExecuteReplace">Replace</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnReplaced { get; set; }

    private static readonly HashSet<string> VideoExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".mp4", ".webm", ".mov", ".avi", ".mkv", ".m4v", ".wmv"
    };

    private bool isOpen;
    private bool isBusy;
    private bool isStaging;
    private bool stagedApproval;
    private string targetName = "";
    private string? error;
    private string? selectedFileName;

    private int locationId;
    private string? playlistDiskPath;
    private int? libraryAssetId;

    // The picked file is staged to TempFiles immediately (a browser file streams once),
    // which also gives the preview a servable web path, matching the uploader's approach
    private string? stagedDiskPath;
    private string? previewWebPath;
    private bool previewIsVideo;

    private long MaxUploadBytes =>
        long.TryParse(config["Uploads:MaxBytes"], out var max) && max > 0 ? max : 10_000_000_000L;

    public void OpenForPlaylistFile(int forLocationId, MediaFile mediaFile, bool requireReapproval)
    {
        locationId = forLocationId;
        playlistDiskPath = mediaFile.DiskPath;
        libraryAssetId = null;
        stagedApproval = requireReapproval;
        targetName = mediaFile.Metadata.FirstOrDefault(m => m.Name == "FileName")?.Value
            ?? Path.GetFileName(mediaFile.DiskPath);
        ResetAndShow();
    }

    public void OpenForAsset(TblAsset asset)
    {
        locationId = asset.LocationId;
        playlistDiskPath = null;
        libraryAssetId = asset.AssetId;
        stagedApproval = false;
        targetName = asset.AssetName ?? Path.GetFileName(asset.AssetPath);
        ResetAndShow();
    }

    private void ResetAndShow()
    {
        DeleteStagedFile();
        selectedFileName = null;
        previewWebPath = null;
        error = null;
        isBusy = false;
        isStaging = false;
        isOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        if (isBusy) return;
        DeleteStagedFile();
        isOpen = false;
        StateHasChanged();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        DeleteStagedFile();
        previewWebPath = null;
        error = null;
        selectedFileName = e.File.Name;
        isStaging = true;
        StateHasChanged();

        try
        {
            var safeName = Path.GetFileName(e.File.Name);
            foreach (var c in Path.GetInvalidFileNameChars())
                safeName = safeName.Replace(c, '_');

            var tempFolder = Path.Combine(MediaPaths.GetRoot(), "TempFiles", locationId.ToString());
            Directory.CreateDirectory(tempFolder);
            var tempName = $"replace_{Guid.NewGuid().ToString("N")[..8]}_{safeName}";
            var tempPath = Path.Combine(tempFolder, tempName);

            await using (var target = new FileStream(tempPath, FileMode.Create, FileAccess.Write, FileShare.None,
                             bufferSize: 81920, useAsync: true))
            {
                await using var source = e.File.OpenReadStream(MaxUploadBytes);
                await source.CopyToAsync(target);
            }

            stagedDiskPath = tempPath;
            previewWebPath = $"/TempFiles/{locationId}/{tempName}";
            previewIsVideo = VideoExtensions.Contains(Path.GetExtension(tempName));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to stage replacement file");
            error = "Could not read the selected file: " + ex.Message;
            DeleteStagedFile();
        }
        finally
        {
            isStaging = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteReplace()
    {
        if (stagedDiskPath == null || selectedFileName == null) return;

        isBusy = true;
        error = null;
        StateHasChanged();

        try
        {
            await using var stream = new FileStream(stagedDiskPath, FileMode.Open, FileAccess.Read, FileShare.Read,
                bufferSize: 81920, useAsync: true);
            var userId = sessionState.User?.UserId ?? 0;

            ContentOverwriteResult result;
            if (playlistDiskPath != null)
            {
                result = await overwriteService.OverwritePlaylistFileAsync(
                    locationId, playlistDiskPath, stream, selectedFileName, userId, stagedApproval);
            }
            else if (libraryAssetId.HasValue)
            {
                result = await overwriteService.OverwriteLibraryAssetAsync(
                    libraryAssetId.Value, stream, selectedFileName, userId);
            }
            else
            {
                return;
            }

            if (!result.Success)
            {
                error = result.Error ?? "Replace failed.";
                return;
            }

            DeleteStagedFile();
            isOpen = false;
            await OnReplaced.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Content replace failed");
            error = "Replace failed: " + ex.Message;
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private void DeleteStagedFile()
    {
        if (stagedDiskPath == null) return;
        try { if (File.Exists(stagedDiskPath)) File.Delete(stagedDiskPath); }
        catch { /* TempFileCleanupService sweeps leftovers */ }
        stagedDiskPath = null;
    }
}
