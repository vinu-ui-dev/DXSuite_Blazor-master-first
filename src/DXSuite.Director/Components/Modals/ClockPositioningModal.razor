@code {
    [Parameter] public EventCallback<ContentAssignment?> OnClockPositionSaved { get; set; }

    private bool isVisible;

    public Task Open(object? display = null, object? contentAssignment = null) { isVisible = true; StateHasChanged(); return Task.CompletedTask; }
    public void Close() { isVisible = false; StateHasChanged(); }
}
