@* Stub — full implementation will be migrated from RIADirector *@

@if (isVisible)
{
    <div class="dx-modal-overlay" @onclick="Close">
        <div class="dx-modal" @onclick:stopPropagation="true">
            <div class="dx-modal-header">
                <h5>Delete Schedule Entry</h5>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="dx-modal-body">
                <p>Are you sure you want to delete this schedule entry?</p>
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn dx-btn-red" @onclick="Confirm">Delete</button>
                <button class="dx-btn dx-btn-gray" @onclick="Close">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<int> OnScheduleEntryDeleted { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool isVisible;
    private int? scheduleEventId;

    public void Open(int scheduleEventId) { this.scheduleEventId = scheduleEventId; isVisible = true; StateHasChanged(); }
    public void Close() { isVisible = false; StateHasChanged(); }
    private async Task Confirm()
    {
        if (scheduleEventId.HasValue)
            await OnScheduleEntryDeleted.InvokeAsync(scheduleEventId.Value);
        Close();
    }
}
