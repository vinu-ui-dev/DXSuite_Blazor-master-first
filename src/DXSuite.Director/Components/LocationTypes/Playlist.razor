    private async Task UpdateMediaFiles()
    {
        try
        {
            DateTime now = DateTime.Now;
            baseDirectory = MediaPaths.GetRoot();

            if (baseDirectory != null && Location != null)
            {
                string uploadDirectory = Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString());

                List<MediaFile> tempMediaFiles = new List<MediaFile>();

                Directory.CreateDirectory(uploadDirectory);

                foreach (string file in Directory.GetFiles(uploadDirectory, "", SearchOption.AllDirectories).Where(s => s.EndsWith(".metadata") == false && s.EndsWith(".db") == false))
                {
                    List<MetadataField> metadata = new List<MetadataField>();
                    string metadataFilePath = file + ".metadata";

                    if (File.Exists(metadataFilePath))
                    {
                        XmlDocument doc = new XmlDocument();
                        doc.Load(metadataFilePath);
                        XmlNodeList nodes = doc.SelectNodes("usermetadata");

                        foreach (XmlNode node in nodes)
                        {
                            foreach (XmlNode line in node.ChildNodes)
                            {
                                if (line.NodeType == XmlNodeType.Element && line.Name == "field")
                                {
                                    var nameAttr = line.Attributes["name"];
                                    var dataTypeAttr = line.Attributes["datatype"];
                                    var valueAttr = line.Attributes["value"];

                                    if (nameAttr != null && dataTypeAttr != null && valueAttr != null)
                                    {
                                        MetadataField mdf = new MetadataField()
                                            {
                                                Name = nameAttr.Value,
                                                DataType = dataTypeAttr.Value,
                                                Value = valueAttr.Value
                                            };
                                        metadata.Add(mdf);
                                    }
                                }
                            }
                        }
                    }

                    MetadataField? location = metadata.Where(x => x.Name == "Location").FirstOrDefault();

                    if (location != null && location.Value == Location.LocationId.ToString())
                    {
                        bool isExpired = false;
                        DateTime? parsedEndDate = null;

                        MetadataField? endDate = metadata.Where(x => x.Name == "EndDate").FirstOrDefault();
                        if (endDate != null && DateTime.TryParse(endDate.Value, out DateTime parsedDate))
                        {
                            parsedEndDate = parsedDate;
                            // Expire only after the end date has fully passed (compare date only)
                            if (parsedDate.Date < now.Date)
                            {
                                isExpired = true;
                            }
                        }
                        MediaFile mf = new MediaFile()
                            {
                                WebPath = String.Format(@"/MediaAssets/{0}/{1}", Location.LocationId, Path.GetFileName(file)),
                                DiskPath = file,
                                Metadata = metadata,
                                IsExpired = isExpired,
                                EndDate = parsedEndDate
                            };
                        tempMediaFiles.Add(mf);
                    }
                }

                // Sort by PlayOrder first, then by existing criteria
                MediaFiles = tempMediaFiles
                    .OrderBy(x =>
                    {
                        var playOrderMetadata = x.Metadata.FirstOrDefault(m => m.Name == "PlayOrder");
                        if (playOrderMetadata != null && int.TryParse(playOrderMetadata.Value, out int order))
                        {
                            return order;
                        }
                        return int.MaxValue;
                    })
                    .ThenBy(x => x.EndDate.HasValue ? 0 : 1)
                    .ThenBy(x => x.EndDate ?? DateTime.MaxValue)
                    .ThenBy(x => x.Metadata.FirstOrDefault(m => m.Name == "FileName")?.Value)
                    .ToList();

                await AssignMissingPlayOrders();

                if (participatingKeys.Count > 0 || contentScope?.IsEvaluated == true)
                {
                    await LoadContentMetadataMapAsync();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating media files");
        }
    }

    private void UpdateAspectRatio()
