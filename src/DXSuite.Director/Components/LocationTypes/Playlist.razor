    // --- Drag-drop reorder ---

    // Drop target is passed as the MediaFile itself: the rendered card index is
    // relative to the filtered/limited visible list, not MediaFiles, so indexes
    // must be resolved against the master list here.
    private async Task HandlePlaylistDrop(MediaFile targetFile)
    {
        if (draggedMediaFile != null && !ReferenceEquals(draggedMediaFile, targetFile))
        {
            try
            {
                var fromIndex = MediaFiles.IndexOf(draggedMediaFile);
                var toIndex = MediaFiles.IndexOf(targetFile);
                if (fromIndex >= 0 && toIndex >= 0)
                {
                    await ReorderMediaFiles(fromIndex, toIndex);
                    await UpdateMediaFiles();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Playlist - reorder failed");
            }
        }

        draggedMediaFile = null;
        draggedFromIndex = -1;
        dropTargetIndex = -1;
        StateHasChanged();
    }

    private async Task ReorderMediaFiles(int fromIndex, int toIndex)
    {
        if (fromIndex < 0 || toIndex < 0 || fromIndex >= MediaFiles.Count) return;

        var reorderedFiles = new List<MediaFile>(MediaFiles);

        var draggedFile = reorderedFiles[fromIndex];
        reorderedFiles.RemoveAt(fromIndex);

        var insertIndex = toIndex;

        if (toIndex >= reorderedFiles.Count)
        {
            insertIndex = reorderedFiles.Count;
        }
        else if (toIndex > fromIndex)
        {
            insertIndex = toIndex - 1;
        }

        insertIndex = Math.Max(0, Math.Min(insertIndex, reorderedFiles.Count));

        reorderedFiles.Insert(insertIndex, draggedFile);

        for (int i = 0; i < reorderedFiles.Count; i++)
        {
            await UpdatePlayOrder(reorderedFiles[i], (i + 1).ToString());
        }
    }

    // Button-based reordering for touch devices. Moving an item down one slot is
    // expressed as moving its visible successor up, which matches ReorderMediaFiles'
    // insert-before semantics. Indexes arrive relative to the filtered visible list,
    // so both endpoints are mapped back to MediaFiles before reordering.
    private async Task MoveMediaFile(int index, int direction)
    {
        var visibleFiles = GetFilteredMediaFiles();
        var visibleFrom = direction > 0 ? index + 1 : index;
        var visibleTo = visibleFrom - 1;
        if (visibleTo < 0 || visibleFrom >= visibleFiles.Count) return;

        try
        {
            var fromIndex = MediaFiles.IndexOf(visibleFiles[visibleFrom]);
            var toIndex = MediaFiles.IndexOf(visibleFiles[visibleTo]);
            if (fromIndex >= 0 && toIndex >= 0)
            {
                await ReorderMediaFiles(fromIndex, toIndex);
                await UpdateMediaFiles();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Playlist - move failed");
        }

        StateHasChanged();
    }

    // --- Play order management ---

    private async Task AssignMissingPlayOrders()
    {
        try
        {
            int nextOrder = 1;

            foreach (var mediaFile in MediaFiles)
            {
                var playOrderMetadata = mediaFile.Metadata.FirstOrDefault(m => m.Name == "PlayOrder");
                if (playOrderMetadata != null && int.TryParse(playOrderMetadata.Value, out int order))
                {
                    if (order >= nextOrder)
                    {
                        nextOrder = order + 1;
                    }
                }
            }

            foreach (var mediaFile in MediaFiles)
            {
                var playOrderMetadata = mediaFile.Metadata.FirstOrDefault(m => m.Name == "PlayOrder");
                if (playOrderMetadata == null)
                {
                    await UpdatePlayOrder(mediaFile, nextOrder.ToString());
                    nextOrder++;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error assigning missing play orders");
        }
    }

    private async Task UpdatePlayOrder(MediaFile mediaFile, string newOrder)
    {
        try
        {
            await UpdateMetadataFile(mediaFile.DiskPath, "PlayOrder", newOrder, "ovx_String");

            var playOrderMetadata = mediaFile.Metadata.FirstOrDefault(m => m.Name == "PlayOrder");
            if (playOrderMetadata != null)
            {
                playOrderMetadata.Value = newOrder;
            }
            else
            {
                mediaFile.Metadata.Add(new MetadataField
                    {
                        Name = "PlayOrder",
                        DataType = "ovx_String",
                        Value = newOrder
                    });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating play order for {DiskPath}", mediaFile.DiskPath);
        }
    }

    private static readonly HashSet<string> VideoLoopExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".mp4", ".webm", ".mov", ".avi", ".mkv", ".m4v", ".wmv"
    };

    private static int GetWeight(MediaFile mediaFile)
    {
        var value = mediaFile.Metadata.FirstOrDefault(m => m.Name == "Weight")?.Value;
        return int.TryParse(value, out var w) ? Math.Clamp(w, 1, 10) : 1;
    }

    private async Task ChangeWeightAsync(MediaFile mediaFile, int delta)
    {
        var current = GetWeight(mediaFile);
        var next = Math.Clamp(current + delta, 1, 10);
        if (next == current) return;

        await UpdateMetadataFile(mediaFile.DiskPath, "Weight", next.ToString(), "ovx_String");

        var field = mediaFile.Metadata.FirstOrDefault(m => m.Name == "Weight");
        if (field != null)
        {
            field.Value = next.ToString();
        }
        else
        {
            mediaFile.Metadata.Add(new MetadataField { Name = "Weight", DataType = "ovx_String", Value = next.ToString() });
        }
        StateHasChanged();
    }

    // Mirrors the durations the player actually uses: probed length for videos, the
    // location's image duration for images, the 7-second player default otherwise
    private int GetItemDurationSeconds(MediaFile mediaFile)
    {
        var sidecarValue = mediaFile.Metadata.FirstOrDefault(m => m.Name == "Duration")?.Value;
        var hasSidecarDuration = int.TryParse(sidecarValue, out var sidecarSeconds) && sidecarSeconds > 0;
        var extension = Path.GetExtension(mediaFile.WebPath ?? "");

        if (VideoLoopExtensions.Contains(extension))
            return hasSidecarDuration ? sidecarSeconds : 7;
        if (imageDurationSeconds is > 0 && !extension.Equals(".json", StringComparison.OrdinalIgnoreCase))
            return imageDurationSeconds.Value;
        return hasSidecarDuration ? sidecarSeconds : 7;
    }

    private (int Seconds, int Plays) ComputeLoopStats()
    {
        var seconds = 0;
        var plays = 0;
        foreach (var mediaFile in GetFilteredMediaFiles())
        {
            if (mediaFile.IsExpired) continue;
            var weight = isShuffleEnabled ? GetWeight(mediaFile) : 1;
            seconds += weight * GetItemDurationSeconds(mediaFile);
            plays += weight;
        }
        return (seconds, plays);
    }

    private static string FormatLoopSeconds(int totalSeconds)
    {
        var span = TimeSpan.FromSeconds(totalSeconds);
        if (span.TotalHours >= 1)
            return $"{(int)span.TotalHours}h {span.Minutes}m";
        if (span.TotalMinutes >= 1)
            return $"{span.Minutes}m {span.Seconds}s";
        return $"{span.Seconds}s";
    }

    private async Task UpdateMetadataFile(string diskPath, string metadataName, string metadataValue, string metadataType, bool deleteValue = false)
    {
        try
        {
            string metadataFilePath = diskPath + ".metadata";
            bool updateProcessed = false;

            if (File.Exists(metadataFilePath))
            {
                var doc = new XmlDocument();
                doc.Load(metadataFilePath);
                var nodes = doc.SelectNodes("usermetadata");

                foreach (XmlNode node in nodes)
                {
                    foreach (XmlNode line in node.ChildNodes)
                    {
                        if (line.Attributes?["name"]?.Value == metadataName)
                        {
                            if (deleteValue)
                            {
                                node.RemoveChild(line);
                            }
                            else
                            {
                                line.Attributes["value"].Value = metadataValue;
                            }
                            updateProcessed = true;
                            break;
                        }
                    }

                    if (!updateProcessed && !deleteValue)
                    {
                        var newElement = doc.CreateElement("field");
                        newElement.SetAttribute("name", metadataName);
                        newElement.SetAttribute("datatype", metadataType);
                        newElement.SetAttribute("value", metadataValue);
                        node.AppendChild(newElement);
                    }
                }

                doc.Save(metadataFilePath);
            }
            else if (!deleteValue)
            {
                using (var writer = new StreamWriter(metadataFilePath))
                {
                    await writer.WriteLineAsync("<usermetadata>");
                    await writer.WriteLineAsync($"  <field name=\"{metadataName}\" datatype=\"{metadataType}\" value=\"{metadataValue}\" />");
                    await writer.WriteLineAsync("</usermetadata>");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating metadata file {DiskPath}", diskPath);
        }
    }

