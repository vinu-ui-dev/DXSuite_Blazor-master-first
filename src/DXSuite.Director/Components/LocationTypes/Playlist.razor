    private string? GetThumbnailPath(string mediaDiskPath, string mediaWebPath)
    {
        var directory = Path.GetDirectoryName(mediaDiskPath);
        var fileNameWithoutExt = Path.GetFileNameWithoutExtension(mediaDiskPath);
        var thumbnailPath = Path.Combine(directory!, "Thumbnails", $"{fileNameWithoutExt}.png");

        if (System.IO.File.Exists(thumbnailPath))
        {
            var webThumbnailPath = Path.Combine(Path.GetDirectoryName(mediaWebPath)!, "Thumbnails", $"{fileNameWithoutExt}.png").Replace("\\", "/");
            return webThumbnailPath;
        }

        return null;
    }

