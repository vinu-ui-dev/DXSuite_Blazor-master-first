                .Include(a => a.Asset)
                .Where(a => a.Asset != null && a.Asset.LocationId == Location.LocationId)
                .ToListAsync();

            assetApprovals = allApprovals
                .Where(a => !string.IsNullOrEmpty(a.Asset?.AssetPath))
                .ToDictionary(
                    a => Path.GetFileName(a.Asset!.AssetPath),
                    a => a,
                    StringComparer.OrdinalIgnoreCase
                );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading approval data");
        }
    }

