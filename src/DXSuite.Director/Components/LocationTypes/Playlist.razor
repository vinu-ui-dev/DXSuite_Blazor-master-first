    }

    // --- Metadata-based content filtering ---

    private async Task LoadContentScopeAsync()
    {
        if (Location == null) return;

        try
        {
            contentScope = await contentScopeService.GetAsync(sessionState.User?.UserId ?? 0, Location.LocationId,
                sessionState.RoleEnum == Roles.Role.Admin ? null : userAccess);
            participatingKeys = contentScope.ParticipatingKeys;
            foreach (var key in participatingKeys)
            {
                customFieldSelectedFilters[key] = null;
                customFieldSelectedLabels[key] = "";
                customFieldDropdownOpen[key] = false;
                customFieldFilterValues[key] = new List<string>();
            }

            if (participatingKeys.Count > 0 || contentScope.IsEvaluated)
                await LoadContentMetadataMapAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading content scope");
        }
    }

    private async Task LoadContentMetadataMapAsync()
    {
        assetValuesLoaded = false;

        var assets = await dbContext.TblAssets.AsNoTracking()
            .Where(a => a.LocationId == Location!.LocationId && !a.IsDeleted)
            .OrderBy(a => a.AssetId)
            .Select(a => new { a.AssetId, a.AssetPath })
            .ToListAsync();

        var pathToId = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var asset in assets.Where(a => !string.IsNullOrEmpty(a.AssetPath)))
            pathToId[asset.AssetPath] = asset.AssetId;

        var values = (await contentScopeService.GetAssetValuesAsync(assets.Select(a => a.AssetId).ToList()))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        assetPathToIdMap = pathToId;
        assetValuesMap = values;
        assetValuesLoaded = true;

        BuildCustomFieldFilterValues();
    }

    private void BuildCustomFieldFilterValues()
    {
        foreach (var key in participatingKeys)
        {
            customFieldFilterValues[key] = assetValuesMap.Values
                .SelectMany(values => values.TryGetValue(key, out var set) ? set : Enumerable.Empty<string>())
                .Distinct(MetadataEvaluator.ValueComparer)
                .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    // Null for a file with no asset row, which scope treats as legacy content.
    private IReadOnlyDictionary<string, IReadOnlySet<string>>? GetAssetValuesForMediaFile(MediaFile mediaFile)
    {
        var expectedPath = $"/MediaAssets/{Location?.LocationId}/{Path.GetFileName(mediaFile.DiskPath)}";
        if (!assetPathToIdMap.TryGetValue(expectedPath, out var assetId))
            return null;
        return assetValuesMap.TryGetValue(assetId, out var values)
            ? values
            : new Dictionary<string, IReadOnlySet<string>>(MetadataEvaluator.KeyComparer);
    }

    /// <summary>
    /// How many values of one key a card spells out before falling back to a count. A key may hold
    /// any number of values, and the card is a fixed 300px, so the whole set would run to dozens of
    /// wrapped lines and push everything below it down. The full set is in Edit metadata.
    /// </summary>
    private const int CardMetadataValuesShown = 2;

    private (string Shown, int Hidden)? GetCardMetadataForMediaFile(MediaFile mediaFile, string fieldKey)
    {
        var values = GetAssetValuesForMediaFile(mediaFile);
        if (values == null || !values.TryGetValue(fieldKey, out var set) || set.Count == 0)
            return null;

        var ordered = set.Order(StringComparer.OrdinalIgnoreCase).ToList();
        return (string.Join(", ", ordered.Take(CardMetadataValuesShown)),
                Math.Max(0, ordered.Count - CardMetadataValuesShown));
    }

    // --- Content visibility filtering ---

    private bool IsMediaFileVisible(MediaFile mediaFile)
    {
        if (Location?.EnableContentApproval != true) return true;

        var approval = GetApprovalForMediaFile(mediaFile);
        return approval != null;
    }

    private List<MediaFile> GetFilteredMediaFiles()
    {
        IEnumerable<MediaFile> result = MediaFiles;

        // Scope never ANDs approval: a scoped manager sees Pending content in her scope, and ownership decides
        // what she may do with it. The approval-row check below hides files still mid-upload for everyone.
        if ((contentScope == null || !assetValuesLoaded) && sessionState.RoleEnum != Roles.Role.Admin && ContentScope.IsEvaluated(userAccess))
            result = [];
        else if (contentScope?.IsEvaluated == true)
            result = result.Where(mf => contentScope.IsVisible(GetAssetValuesForMediaFile(mf)));

        if (Location?.EnableContentApproval == true)
            result = result.Where(IsMediaFileVisible);

        return ApplyCustomFieldFilters(result.ToList());
    }

    private void ToggleCustomFieldDropdown(string fieldName)
    {
        var current = customFieldDropdownOpen.GetValueOrDefault(fieldName);
        // Close all other custom field dropdowns before toggling this one
        foreach (var key in customFieldDropdownOpen.Keys.ToList())
            customFieldDropdownOpen[key] = false;
        customFieldDropdownOpen[fieldName] = !current;
        StateHasChanged();
    }

    private void ApplyCustomFieldFilter(string fieldName, string? value)
    {
        customFieldSelectedFilters[fieldName] = value;
        customFieldSelectedLabels[fieldName] = value ?? "";
        customFieldDropdownOpen[fieldName] = false;
        displayLimit = DefaultDisplayLimit;
        StateHasChanged();
    }

    private void ShowAllItems()
    {
        displayLimit = int.MaxValue;
        StateHasChanged();
    }

    private List<MediaFile> ApplyCustomFieldFilters(List<MediaFile> files)
    {
        foreach (var key in participatingKeys)
        {
            if (!customFieldSelectedFilters.TryGetValue(key, out var selectedValue) || string.IsNullOrEmpty(selectedValue))
                continue;

            files = files
                .Where(mf => GetAssetValuesForMediaFile(mf) is { } values
                             && values.TryGetValue(key, out var set) && set.Contains(selectedValue))
                .ToList();
        }
        return files;
    }
}
