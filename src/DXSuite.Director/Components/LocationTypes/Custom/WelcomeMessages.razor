@code {
    [Parameter] public TblLocation? Location { get; set; }

    // Background images (constraint 1)
    private List<MediaFile> backgroundImages = new List<MediaFile>();
    private MediaFile? selectedBackgroundImage = null;
    private bool showBackgroundDropdown = false;
    private bool showDeleteConfirmation = false;
    private MediaFile? imageToDelete = null;

    // Message configuration
    private int activeMessageTab = 1;
    private string sharedTextColor = "black";

    private string message1Text = "";
    private bool message1Show = true;
    private string message1Color = "black";
    private bool message1Bold = false;
    private bool message1Italic = false;
    private int message1Top = 400;
    private bool message1EditPosition = false;

    private string message2Text = "";
    private bool message2Show = true;
    private string message2Color = "black";
    private bool message2Bold = false;
    private bool message2Italic = false;
    private int message2Top = 500;
    private bool message2EditPosition = false;

    private string message3Text = "";
    private bool message3Show = true;
    private string message3Color = "black";
    private bool message3Bold = false;
    private bool message3Italic = false;
    private int message3Top = 600;
    private bool message3EditPosition = false;

    // Schedule
    private DateTime? scheduleStartDate = null;
    private DateTime? scheduleEndDate = null;
    private TimeOnly? scheduleStartTime = null;
    private TimeOnly? scheduleEndTime = null;

    // Override Content
    private bool overrideContent = false;

    // State
    private bool isConfigExpanded = false; // Collapsed by default
    private bool isGenerating = false;
    private MediaAssetUploader? backgroundUploaderModal;
    private DXSuite.Director.Components.Playlists.AssetPlaylist_Indirect? assetPlaylist;
    private string? baseDirectory;

    protected override async Task OnInitializedAsync()
    {
        baseDirectory = MediaPaths.GetRoot();
        await LoadBackgroundImages();
    }

    private void UpdateBothTextColors()
    {
        message1Color = sharedTextColor;
        message2Color = sharedTextColor;
        message3Color = sharedTextColor;
        StateHasChanged();
    }

    private async Task LoadBackgroundImages()
    {
        try
        {
            if (baseDirectory == null || Location == null) return;

            // Background images are in constraint folder 1
            string backgroundDirectory = Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString(), "1");

            if (!Directory.Exists(backgroundDirectory))
            {
                Directory.CreateDirectory(backgroundDirectory);
                return;
            }

            var tempImages = new List<MediaFile>();

            foreach (string file in Directory.GetFiles(backgroundDirectory)
                .Where(s => !s.EndsWith(".metadata") && !s.EndsWith(".db")))
            {
                var imageFile = new MediaFile
                {
                    WebPath = $"/MediaAssets/{Location.LocationId}/1/{Path.GetFileName(file)}",
                    DiskPath = file,
                    Metadata = new List<MetadataField>()
                };

                tempImages.Add(imageFile);
            }

            backgroundImages = tempImages.OrderBy(x => Path.GetFileName(x.DiskPath)).ToList();

            // Select first image by default
            if (backgroundImages.Any() && selectedBackgroundImage == null)
            {
                selectedBackgroundImage = backgroundImages.First();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading background images");
        }
    }

    private void SelectBackgroundImage(MediaFile image)
    {
        selectedBackgroundImage = image;
        showBackgroundDropdown = false;
        StateHasChanged();
    }

    private void OpenBackgroundImageUploader()
    {
        showBackgroundDropdown = false;

        var uploadConfig = new MediaUploadConfig
        {
            UploadFolder = baseDirectory,
            LocationId = Location.LocationId,
            ConstraintId = 1, // Hardcoded to constraint 1 for backgrounds
            ExpectedWidth = 1920,
            ExpectedHeight = 1080,
            EditMediaFile = null,
            AddToSql = false,
            IsSchedulable = false
        };

        backgroundUploaderModal?.Open(uploadConfig);
    }

    private async Task OnBackgroundImageUploaded()
    {
        await LoadBackgroundImages();
        StateHasChanged();
    }

    private void ShowDeleteBackgroundConfirmation(MediaFile image)
    {
        imageToDelete = image;
        showDeleteConfirmation = true;
        showBackgroundDropdown = false;
        StateHasChanged();
    }

    private async Task DeleteBackgroundImage()
    {
        if (imageToDelete != null)
        {
            try
            {
                if (File.Exists(imageToDelete.DiskPath))
                {
                    File.Delete(imageToDelete.DiskPath);
                }

                if (File.Exists(imageToDelete.DiskPath + ".metadata"))
                {
                    File.Delete(imageToDelete.DiskPath + ".metadata");
                }

                if (selectedBackgroundImage == imageToDelete)
                {
                    selectedBackgroundImage = null;
                }

                await LoadBackgroundImages();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting background image");
            }
        }

        CloseDeleteConfirmation();
    }

    private void CloseDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        imageToDelete = null;
        StateHasChanged();
    }

    private async Task GenerateWelcomeMessage()
    {
        if (selectedBackgroundImage == null)
        {
            return;
        }

        isGenerating = true;
        StateHasChanged();

        try
        {
            // Load background image as base64
            var bgImageBytes = await File.ReadAllBytesAsync(selectedBackgroundImage.DiskPath);
            var bgBase64 = $"data:image/png;base64,{Convert.ToBase64String(bgImageBytes)}";

            // Create canvas with background and text overlays using SkiaSharp
            var imageInfo = new SKImageInfo(1920, 1080);
            using var surface = SKSurface.Create(imageInfo);
            var canvas = surface.Canvas;
            canvas.Clear(SKColors.Black);

            // Draw background image
            using var bgImage = SKImage.FromEncodedData(bgImageBytes);
            if (bgImage != null)
            {
                canvas.DrawImage(bgImage, new SKRect(0, 0, 1920, 1080));
            }

            // Draw message 1
            if (message1Show && !string.IsNullOrWhiteSpace(message1Text))
            {
                // Determine font style based on bold/italic checkboxes
                var fontStyle1 = SKFontStyle.Normal;
                if (message1Bold && message1Italic)
                    fontStyle1 = SKFontStyle.BoldItalic;
                else if (message1Bold)
                    fontStyle1 = SKFontStyle.Bold;
                else if (message1Italic)
                    fontStyle1 = SKFontStyle.Italic;

                using var paint1 = new SKPaint
                {
                    Color = message1Color == "white" ? SKColors.White : SKColors.Black,
                    IsAntialias = true,
                    TextSize = 72,
                    Typeface = SKTypeface.FromFamilyName("Arial", fontStyle1),
                    TextAlign = SKTextAlign.Center
                };

                // Calculate proper baseline offset using font metrics
                // In CSS, 'top' positions the top of the text box, but DrawText uses baseline
                // We need to offset by the ascent to match CSS behavior
                var fontMetrics = paint1.FontMetrics;
                var baselineOffset = -fontMetrics.Ascent; // Ascent is negative, so negate it to get positive offset



                // Add shadow (black for white text, white for black text)
                var shadowColor = message1Color == "white" ? new SKColor(0, 0, 0, 204) : new SKColor(255, 255, 255, 204);
                paint1.ImageFilter = SKImageFilter.CreateDropShadow(3, 3, 6, 6, shadowColor);

                canvas.DrawText(message1Text, 960, message1Top + baselineOffset, paint1);
            }

            // Draw message 2
            if (message2Show && !string.IsNullOrWhiteSpace(message2Text))
            {
                // Determine font style based on bold/italic checkboxes
                var fontStyle2 = SKFontStyle.Normal;
                if (message2Bold && message2Italic)
                    fontStyle2 = SKFontStyle.BoldItalic;
                else if (message2Bold)
                    fontStyle2 = SKFontStyle.Bold;
                else if (message2Italic)
                    fontStyle2 = SKFontStyle.Italic;

                using var paint2 = new SKPaint
                {
                    Color = message2Color == "white" ? SKColors.White : SKColors.Black,
                    IsAntialias = true,
                    TextSize = 72,
                    Typeface = SKTypeface.FromFamilyName("Arial", fontStyle2),
                    TextAlign = SKTextAlign.Center
                };

                // Calculate proper baseline offset using font metrics
                var fontMetrics = paint2.FontMetrics;
                var baselineOffset = -fontMetrics.Ascent;

                // Add shadow (black for white text, white for black text)
                var shadowColor = message2Color == "white" ? new SKColor(0, 0, 0, 204) : new SKColor(255, 255, 255, 204);
                paint2.ImageFilter = SKImageFilter.CreateDropShadow(3, 3, 6, 6, shadowColor);

                canvas.DrawText(message2Text, 960, message2Top + baselineOffset, paint2);
            }

            // Draw message 3
            if (message3Show && !string.IsNullOrWhiteSpace(message3Text))
            {
                // Determine font style based on bold/italic checkboxes
                var fontStyle3 = SKFontStyle.Normal;
                if (message3Bold && message3Italic)
                    fontStyle3 = SKFontStyle.BoldItalic;
                else if (message3Bold)
                    fontStyle3 = SKFontStyle.Bold;
                else if (message3Italic)
                    fontStyle3 = SKFontStyle.Italic;

                using var paint3 = new SKPaint
                {
                    Color = message3Color == "white" ? SKColors.White : SKColors.Black,
                    IsAntialias = true,
                    TextSize = 72,
                    Typeface = SKTypeface.FromFamilyName("Arial", fontStyle3),
                    TextAlign = SKTextAlign.Center
                };

                // Calculate proper baseline offset using font metrics
                var fontMetrics = paint3.FontMetrics;
                var baselineOffset = -fontMetrics.Ascent;

                // Add shadow (black for white text, white for black text)
                var shadowColor = message3Color == "white" ? new SKColor(0, 0, 0, 204) : new SKColor(255, 255, 255, 204);
                paint3.ImageFilter = SKImageFilter.CreateDropShadow(3, 3, 6, 6, shadowColor);

                canvas.DrawText(message3Text, 960, message3Top + baselineOffset, paint3);
            }

            // Save image
            using var snapshot = surface.Snapshot();
            using var data = snapshot.Encode(SKEncodedImageFormat.Png, 100);
            var imageBytes = data.ToArray();

            // Save to location root folder
            var locationPath = Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString());
            Directory.CreateDirectory(locationPath);

            var fileName = $"{Guid.NewGuid().ToString("N")[..8]}_Welcome_Message.png";
            var filePath = Path.Combine(locationPath, fileName);

            await File.WriteAllBytesAsync(filePath, imageBytes);

            // Create metadata file
            await CreateMetadataFile(filePath);




            // Refresh the playlist to show the new image
            if (assetPlaylist != null)
            {
                await assetPlaylist.UpdateMediaFiles();
            }

            // Clear all fields after successful generation
            selectedBackgroundImage = null;
            activeMessageTab = 1;
            sharedTextColor = "black";
            message1Text = "";
            message1Show = true;
            message1Color = "black";
            message1Bold = false;
            message1Italic = false;
            message1Top = 400;
            message1EditPosition = false;
            message2Text = "";
            message2Show = true;
            message2Color = "black";
            message2Bold = false;
            message2Italic = false;
            message2Top = 500;
            message2EditPosition = false;
            message3Text = "";
            message3Show = true;
            message3Color = "black";
            message3Bold = false;
            message3Italic = false;
            message3Top = 600;
            message3EditPosition = false;
            scheduleStartDate = null;
            scheduleEndDate = null;
            scheduleStartTime = null;
            scheduleEndTime = null;
            overrideContent = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating welcome message");
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task CreateMetadataFile(string imagePath)
    {
        try
        {
            var metadataPath = imagePath + ".metadata";

            using (var writer = new StreamWriter(metadataPath))
            {
                await writer.WriteLineAsync("<usermetadata>");

                // Location
                await writer.WriteLineAsync($"  <field name=\"Location\" datatype=\"ovx_String\" value=\"{Location.LocationId}\" />");

                // FileName
                await writer.WriteLineAsync($"  <field name=\"FileName\" datatype=\"ovx_String\" value=\"{Path.GetFileName(imagePath)}\" />");

                // Schedule dates if provided
                if (scheduleStartDate.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"StartDate\" datatype=\"ovx_String\" value=\"{scheduleStartDate.Value:yyyy-MM-dd}\" />");
                }

                if (scheduleEndDate.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"EndDate\" datatype=\"ovx_String\" value=\"{scheduleEndDate.Value:yyyy-MM-dd}\" />");
                }

                // Schedule times if provided
                if (scheduleStartTime.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"StartTime\" datatype=\"ovx_String\" value=\"{scheduleStartTime.Value:HH:mm:ss}\" />");
                }

                if (scheduleEndTime.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"EndTime\" datatype=\"ovx_String\" value=\"{scheduleEndTime.Value:HH:mm:ss}\" />");
                }

                // Override Content
                await writer.WriteLineAsync($"  <field name=\"Override\" datatype=\"ovx_String\" value=\"{(overrideContent ? "True" : "False")}\" />");

                await writer.WriteLineAsync("</usermetadata>");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating metadata file");
        }
    }
