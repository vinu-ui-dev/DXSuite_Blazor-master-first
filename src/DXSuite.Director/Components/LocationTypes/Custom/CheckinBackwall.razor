@using DXSuite.Director.Entities
@using DXSuite.Director.Models
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory scopeFactory;
@inject NavigationManager navMan;
@inject IDisplayOverrideService displayOverrides
@rendermode InteractiveServer


@if(Location != null){
    <section class="body">
        <div class="scroll-container">
            <div class="image-container" style="@((Location.BackgroundImageHeight != 0.0)? "height:" + (Location.BackgroundImageHeight * scaleFactor).ToString() + "px;":"") @((Location.BackgroundImageWidth != 0)? "width:" + (Location.BackgroundImageWidth * scaleFactor).ToString() + "px;":"") background-image:url('@((Location.BackgroundImagePath != null)?(Location.BackgroundImagePath):"")')">

                @{
                    TblDisplay? backgroundDisplay = displays?.FirstOrDefault(x => x.DisplayTypeId == (int)Types.DisplayType.BackwallDisplay);
                    TblDisplay? backgroundMask = displays?.FirstOrDefault(x => x.DisplayTypeId == (int)Types.DisplayType.BackwallMask);
                }

                @* Shared button row — flex ensures a natural 10px gap regardless of button widths *@
                @if (backgroundDisplay != null || backgroundMask != null)
                {
                    <div style="position:absolute; display:flex; gap:10px; @((Location.DisplayAnchorTop != 0.0)? "top:" + ((Location.DisplayAnchorTop * scaleFactor) - 38).ToString() + "px;":"top:-38px;") left:10px; z-index:10;">
                        @if (backgroundDisplay != null)
                        {
                            <button class="dx-btn dx-btn-blue" style="padding-top:5px; padding-bottom:5px;" @onclick="@(()=> navMan.NavigateTo("/schedule/" + backgroundDisplay.DisplayId.ToString()))">
                                EDIT BACKGROUND
                            </button>
                        }
                        @if (backgroundMask != null)
                        {
                            <button class="dx-btn dx-btn-blue" style="padding-top:5px; padding-bottom:5px;" @onclick="@(()=> navMan.NavigateTo("/schedule/" + backgroundMask.DisplayId.ToString()))">
                                EDIT MASK
                            </button>
                        }
                    </div>
                }

                <div style="position:absolute; display:inline-block; @((Location.DisplayAnchorTop != 0.0)? "top:" + (Location.DisplayAnchorTop * scaleFactor).ToString() + "px;":"") @((Location.DisplayAnchorLeft != 0.0)? "left:" + (0).ToString() + "px;":"")">
                    @if (backgroundDisplay != null)
                    {
                        <div id="ticketCounterBackwall" class="flex-column">
                            <DXSuite.Director.Components.DisplayTypes.StandardDisplay Display="backgroundDisplay" ScaleFactor="scaleFactor"></DXSuite.Director.Components.DisplayTypes.StandardDisplay>
                        </div>
                    }
                </div>

                <div style="position:absolute; display:inline-block; @((Location.DisplayAnchorTop != 0.0)? "top:" + (Location.DisplayAnchorTop * scaleFactor).ToString() + "px;":"") @((Location.DisplayAnchorLeft != 0.0)? "left:" + (0).ToString() + "px;":"")">
                    @if (backgroundMask != null)
                    {
                        <div id="ticketCounterBackwall" class="flex-column">
                            <DXSuite.Director.Components.DisplayTypes.StandardDisplay Display="backgroundMask" ScaleFactor="scaleFactor"></DXSuite.Director.Components.DisplayTypes.StandardDisplay>
                        </div>
                    }
                </div>

                <div style="position:absolute; display:inline-block; @((Location.DisplayAnchorTop != 0.0)? "top:" + (Location.DisplayAnchorTop * scaleFactor).ToString() + "px;":"") @((Location.DisplayAnchorLeft != 0.0)? "left:" + (Location.DisplayAnchorLeft * scaleFactor).ToString() + "px;":"")">

                    <div class="d-flex">
                        @if (displays != null)
                        {

                            bool firstDisplay = true;

                            foreach (TblDisplay display in displays.Where(x => x.DisplayTypeId == (int)Types.DisplayType.StandardDisplay).OrderBy(x => x.SortOrder))
                            {
                                @if (firstDisplay == false)
                                {
                                    <div style="@String.Format("width:{0}px;",Location.DisplayOffset * scaleFactor)"></div>
                                }
                                @code {
                                    private int? hoverDisplayId = null;

                                    private void OnMouseOver(int id) => hoverDisplayId = id;
                                    private void OnMouseOut() => hoverDisplayId = null;
                                }
                                <div id="ticketCounterDisplays" class="flex-column">

                                     <div style="position:relative; display:inline-block; vertical-align:top;"

                                         @onmouseover="(() => OnMouseOver(display.DisplayId))"
                                         @onmouseout="OnMouseOut">


                                        <DXSuite.Director.Components.DisplayTypes.StandardDisplay Display="display" ScaleFactor="scaleFactor"></DXSuite.Director.Components.DisplayTypes.StandardDisplay>

                                        @if(display.DisplayId == hoverDisplayId && SelectedAsset != null)
                                        {
                                            @* <button class="disable"
                                                    style="z-index: 150; position: relative; text-align:center; padding:0; left: 0; bottom:0; @((display.DisplayHeight != 0.0)? "height:" + (display.DisplayHeight * scaleFactor * .1).ToString() + "px;":"") width:100%;">
                                                Override Display
                                            </button> *@
                                            <div class="hoverOverlay" style="border: 2px dashed red;"></div>
                                            <div class="topBanner" style="background-color: var(--dx-red);">@(display.DisplayName.ToUpper())</div>
                                            <div class="bottomBanner" style="background-color: var(--dx-red);"
                                                 @onclick="@(()=> OnOverride(display.DisplayId))">
                                                OVERRIDE
                                            </div>
                                        }
                                                        else if (display.DisplayId == hoverDisplayId)
                                        {
                                            <div class="hoverOverlay" style="border: 2px solid #16FF00;"></div>
                                            <div class="cb-top-banner">@(display.DisplayName.ToUpper())</div>
                                            <div class="cb-edit-btn"
                                                @onclick="@(()=> navMan.NavigateTo("/schedule/" + display.DisplayId.ToString()))">
                                                EDIT SCHEDULE
                                            </div>
                                        }
                                    </div>
                                    <div style="min-height: 40px; position:relative; display:flex; justify-content:center;">
                                        @if (display.DisplayMode == (int)Types.DisplayMode.Override)
                                        {
                                            <div class="overrideBanner"
                                                style="width:90%; align-content:center; font-size: 11px; white-space: nowrap;"
                                                 @onclick="(() => BackToSchedule(display.DisplayId))">
                                                CANCEL OVERRIDE
                                            </div>
                                        }
                                        else
                                        {

                                        }
                                    </div>
                                </div>
                                firstDisplay = false;
                            }
                        }
                    </div>

                </div>

            </div>
        </div>
    </section>
}

<style>
    .cb-top-banner { position: absolute; top: 0; left: 0; right: 0; background: rgba(0,0,0,0.7); color: white; text-align: center; font-size: 11px; padding: 2px 4px; z-index: 101; pointer-events: none; font-weight: bold; letter-spacing: 0.5px; }
    .cb-edit-btn { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,113,188,0.9); color: white; text-align: center; font-size: 11px; padding: 4px; z-index: 101; cursor: pointer; font-weight: bold; }
    .cb-edit-btn:hover { background: rgba(0,90,150,1); }
</style>

@code {
    [Parameter] public TblLocation? Location { get; set; }
    [Parameter] public int? SelectedAsset { get; set; }
    public IList<TblAsset>? assets { get; set; }
    public IList<TblDisplay>? displays { get; set; }

    public TblDisplay? backwallDisplay { get; set; }
    public IList<TblDisplay>? stationDisplays { get; set; }

    public double scaleFactor { get; set; } = 0.4; //2.5 works well for HD resolution, 1.0 is good for QHD

    //For Future Use: background-size:1920px 1080px; background-repeat:no-repeat;

    protected override async Task OnInitializedAsync()
    {
        if (Location != null)
        {
            using (var scope = scopeFactory.CreateScope())
            {
                var dataContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();
                await RefreshData(dataContext);
            }

        }
    }

    private async Task RefreshData(IDirectorDBContext dataContext)
    {
        if (Location != null)
        {
            assets = await dataContext.TblAssets.Where(x => x.LocationId == Location.LocationId).Include(d => d.AssetGroup).Include(e => e.AssetType).Include(f => f.Constraint).ToListAsync();
            displays = await dataContext.TblDisplays.Where(x => x.LocationId == Location.LocationId).Include(d => d.OverrideAsset).Include(e => e.TblScheduleEvents).Include(f => f.Constraint).ToListAsync();
        }
    }


    private async Task OnOverride(int displayId)
    {
        if (SelectedAsset != null)
        {
            using (var scope = scopeFactory.CreateScope())
            {
                var dataContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();
                if (await displayOverrides.SetOverrideAsync(displayId, SelectedAsset!.Value))
                {
                    await RefreshData(dataContext);
                }
            }
        }
    }

    private async Task BackToSchedule(int displayId)
    {

        using (var scope = scopeFactory.CreateScope())
        {
            var dataContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();

            if (await displayOverrides.ReturnToScheduleAsync(displayId))
            {
                await RefreshData(dataContext);
            }
        }
    }

}