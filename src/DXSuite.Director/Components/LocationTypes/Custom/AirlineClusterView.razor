    .vw-bottom-banner { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,113,188,0.9); color: white; text-align: center; font-size: 11px; padding: 4px; z-index: 101; cursor: pointer; font-weight: bold; }

    /* Mobile-scale only: mark editable displays with a corner chip and hairline
