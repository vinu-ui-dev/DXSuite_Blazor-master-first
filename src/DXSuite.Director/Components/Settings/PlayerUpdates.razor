    private void ShowStatus(string message, bool error)
    {
        statusMessage = message;
        isError = error;
        StateHasChanged();
    }

    private string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue) return "-";
        var kb = bytes.Value / 1024.0;
        if (kb < 1024) return $"{kb:F1} KB";
        var mb = kb / 1024.0;
        return $"{mb:F1} MB";
    }

    private string GetBatchBadgeClass(string? status) => status switch
    {
        "IN_PROGRESS" => "dx-badge-blue",
        "PAUSED" => "dx-badge-yellow",
        "COMPLETED" => "dx-badge-green",
        "FAILED" => "dx-badge-red",
        "PENDING" => "dx-badge-gray",
        _ => "dx-badge-gray"
    };

    private async Task StartBatchDeployment(TblUpdateDeployment deployment)
    {
        try
        {
            var result = await batchDeploymentService.StartBatchDeploymentAsync(deployment.DeploymentId);
            if (result.Success)
            {
                ShowStatus($"Batch deployment started: {result.TotalDevices} devices in {result.TotalBatches} batches", false);
                await batchDeploymentStateService.ShowModalAsync(deployment.DeploymentId);
                await LoadDeployments();
            }
            else
            {
                ShowStatus($"Failed to start batch deployment: {result.ErrorMessage}", true);
            }
        }
        catch (Exception ex)
        {
            ShowStatus($"Error starting batch deployment: {ex.Message}", true);
        }
    }

    private async Task ResumeBatchDeployment(TblUpdateDeployment deployment)
    {
        try
        {
            var success = await batchDeploymentService.ResumeBatchDeploymentAsync(deployment.DeploymentId);
            if (success)
            {
                ShowStatus("Batch deployment resumed", false);
                await batchDeploymentStateService.ShowModalAsync(deployment.DeploymentId);
                await LoadDeployments();
            }
            else
            {
                ShowStatus("Failed to resume batch deployment", true);
            }
        }
        catch (Exception ex)
        {
            ShowStatus($"Error resuming batch deployment: {ex.Message}", true);
        }
    }

    private async Task ShowBatchProgress(TblUpdateDeployment deployment)
    {
        await batchDeploymentStateService.ShowModalAsync(deployment.DeploymentId);
    }
