@code {
    /// <summary>
    /// The location to save generated images to
    /// </summary>
    [Parameter] public TblLocation? Location { get; set; }

    /// <summary>
    /// Optional display - when provided, a TblAsset record will be created
    /// </summary>
    [Parameter] public TblDisplay? Display { get; set; }

    /// <summary>
    /// Optional constraint ID for background images folder
    /// </summary>
    [Parameter] public int BackgroundConstraintId { get; set; } = 1;

    /// <summary>
    /// Event callback when an image is successfully generated (file path)
    /// </summary>
    [Parameter] public EventCallback<string> OnImageGenerated { get; set; }

    /// <summary>
    /// Event callback when a TblAsset is created (only when Display is provided)
    /// </summary>
    [Parameter] public EventCallback<TblAsset> OnAssetCreated { get; set; }

    /// <summary>
    /// When false (e.g. inside a modal), the collapsible header is hidden and the creator opens fully expanded.
    /// </summary>
    [Parameter] public bool ShowCollapsibleHeader { get; set; } = true;

    // Background images
    private List<MediaFile> backgroundImages = new List<MediaFile>();
    private MediaFile? selectedBackgroundImage = null;
    private bool showBackgroundDropdown = false;
    private bool showDeleteConfirmation = false;
    private MediaFile? imageToDelete = null;

    // Message configuration
    private int activeMessageTab = 1;
    private string sharedTextColor = "black";

    private string message1Text = "";
    private bool message1Show = true;
    private string message1Color = "black";
    private bool message1Bold = false;
    private bool message1Italic = false;
    private int message1Top = 400;
    private bool message1EditPosition = false;

    private string message2Text = "";
    private bool message2Show = true;
    private string message2Color = "black";
    private bool message2Bold = false;
    private bool message2Italic = false;
    private int message2Top = 500;
    private bool message2EditPosition = false;

    private string message3Text = "";
    private bool message3Show = true;
    private string message3Color = "black";
    private bool message3Bold = false;
    private bool message3Italic = false;
    private int message3Top = 600;
    private bool message3EditPosition = false;

    // Schedule
    private DateTime? scheduleStartDate = null;
    private DateTime? scheduleEndDate = null;
    private TimeOnly? scheduleStartTime = null;
    private TimeOnly? scheduleEndTime = null;

    // Override Content
    private bool overrideContent = false;

    // State — expanded by default when ShowCollapsibleHeader is false (e.g. modal context)
    private bool isConfigExpanded = false;
    private bool isGenerating = false;
    private MediaAssetUploader? backgroundUploaderModal;
    private string? baseDirectory;
    private ContentModerationModal? moderationModal;
    private bool pendingApproval = false;
    private ModerationResult? currentModerationResult = null;

    protected override async Task OnInitializedAsync()
    {
        if (!ShowCollapsibleHeader)
            isConfigExpanded = true;
        baseDirectory = MediaPaths.GetRoot();
        await LoadBackgroundImages();
    }

    /// <summary>
    /// Programmatically expand or collapse the template creator
    /// </summary>
    public void SetExpanded(bool expanded)
    {
        isConfigExpanded = expanded;
        StateHasChanged();
    }

    private void ToggleExpanded()
    {
        isConfigExpanded = !isConfigExpanded;
    }

    private void UpdateBothTextColors()
    {
        message1Color = sharedTextColor;
        message2Color = sharedTextColor;
        message3Color = sharedTextColor;
        StateHasChanged();
    }

    private async Task LoadBackgroundImages()
    {
        try
        {
            if (baseDirectory == null || Location == null) return;

            // Background images are in the constraint folder
            string backgroundDirectory = Path.Combine(baseDirectory, "MediaAssets", Location.LocationId.ToString(), BackgroundConstraintId.ToString());

            if (!Directory.Exists(backgroundDirectory))
            {
                Directory.CreateDirectory(backgroundDirectory);
                return;
            }

            var tempImages = new List<MediaFile>();

            foreach (string file in Directory.GetFiles(backgroundDirectory)
                .Where(s => !s.EndsWith(".metadata") && !s.EndsWith(".db")))
            {
                var imageFile = new MediaFile
                {
                    WebPath = $"/MediaAssets/{Location.LocationId}/{BackgroundConstraintId}/{Path.GetFileName(file)}",
                    DiskPath = file,
                    Metadata = new List<MetadataField>()
                };

                tempImages.Add(imageFile);
            }

            backgroundImages = tempImages.OrderBy(x => Path.GetFileName(x.DiskPath)).ToList();

            // Select first image by default
            if (backgroundImages.Any() && selectedBackgroundImage == null)
            {
                selectedBackgroundImage = backgroundImages.First();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading background images");
        }
    }

    private void SelectBackgroundImage(MediaFile image)
    {
        selectedBackgroundImage = image;
        showBackgroundDropdown = false;
        StateHasChanged();
    }

    private void OpenBackgroundImageUploader()
    {
        showBackgroundDropdown = false;

        var uploadConfig = new MediaUploadConfig
        {
            UploadFolder = baseDirectory,
            LocationId = Location?.LocationId ?? 0,
            ConstraintId = BackgroundConstraintId,
            ExpectedWidth = 1920,
            ExpectedHeight = 1080,
            EditMediaFile = null,
            AddToSql = false,
            IsSchedulable = false
        };

        backgroundUploaderModal?.Open(uploadConfig);
    }

    private async Task OnBackgroundImageUploaded()
    {
        await LoadBackgroundImages();
        StateHasChanged();
    }

    private void ShowDeleteBackgroundConfirmation(MediaFile image)
    {
        imageToDelete = image;
        showDeleteConfirmation = true;
        showBackgroundDropdown = false;
        StateHasChanged();
    }

    private async Task DeleteBackgroundImage()
    {
        if (imageToDelete != null)
        {
            try
            {
                if (File.Exists(imageToDelete.DiskPath))
                {
                    File.Delete(imageToDelete.DiskPath);
                }

                if (File.Exists(imageToDelete.DiskPath + ".metadata"))
                {
                    File.Delete(imageToDelete.DiskPath + ".metadata");
                }

                if (selectedBackgroundImage == imageToDelete)
                {
                    selectedBackgroundImage = null;
                }

                await LoadBackgroundImages();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting background image");
            }
        }

        CloseDeleteConfirmation();
    }

    private void CloseDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        imageToDelete = null;
        StateHasChanged();
    }

    private UploadingAsSection? uploadingAs;

    // Only a display-bound template creates an asset row, which is what carries an owner and tags.
    private bool ShowsUploadingAs => Display != null && Location != null && Location.LocationId > 0;

    private string? UploadBlockReason => ShowsUploadingAs && uploadingAs is { IsBlocked: true } section ? section.BlockReason : null;

    private PreparedUpload? preparedUpload;

    private async Task GenerateTemplateImage()
    {
        if (selectedBackgroundImage == null)
        {
            return;
        }

        if (Location == null)
        {
            return;
        }

        preparedUpload = null;
        if (ShowsUploadingAs)
        {
            preparedUpload = await UploadIdentity.PrepareAsync(SessionState.User?.UserId ?? 0, Location.LocationId,
                uploadingAs?.PickedGroupId, uploadingAs?.Picks);
            if (!preparedUpload.IsValid)
            {
                Logger.LogWarning("Template upload refused: {Error}", preparedUpload.Error);
                if (uploadingAs != null)
                    await uploadingAs.ReloadAfterRefusalAsync(preparedUpload.Error);
                return;
            }
        }

        // Content moderation check (skip if already approved for submission OR the role
        // holds the approval/moderation bypass permission)
        if (!pendingApproval && !await SessionState.HasPermissionAsync(PermissionKeys.ContentApprovalBypass))
        {
            var moderationContext = new ModerationContext
            {
                UserId = SessionState.User?.UserId,
                DisplayId = Display?.DisplayId,
                LocationId = Location?.LocationId
            };

            // Text moderation
            var textsToScan = new List<string>();
            if (!string.IsNullOrWhiteSpace(message1Text)) textsToScan.Add(message1Text);
            if (!string.IsNullOrWhiteSpace(message2Text)) textsToScan.Add(message2Text);
            if (!string.IsNullOrWhiteSpace(message3Text)) textsToScan.Add(message3Text);

            if (textsToScan.Any())
            {
                var moderationResult = await ModerationService.ScanTextAsync(moderationContext, textsToScan.ToArray());

                if (moderationResult?.IsInappropriate == true)
                {
                    currentModerationResult = moderationResult;
                    moderationModal?.Open(moderationResult);
                    return;
                }
                else if (moderationResult == null && Display?.EnableContentApproval == true)
                {
                    pendingApproval = true;
                }
            }

            // Image moderation — scan the background image if text passed and LLM is available
            if (!pendingApproval && selectedBackgroundImage != null)
            {
                var ext = Path.GetExtension(selectedBackgroundImage.DiskPath).ToLowerInvariant();
                var mimeType = ext switch
                {
                    ".jpg" or ".jpeg" => "image/jpeg",
                    ".gif" => "image/gif",
                    ".webp" => "image/webp",
                    ".bmp" => "image/bmp",
                    _ => "image/png"
                };

                var imageBytes = await File.ReadAllBytesAsync(selectedBackgroundImage.DiskPath);
                var imageResult = await ModerationService.ScanImageAsync(imageBytes, mimeType, moderationContext);

                if (imageResult?.IsInappropriate == true)
                {
                    currentModerationResult = imageResult;
                    moderationModal?.Open(imageResult);
                    return;
                }
                else if (imageResult == null && Display?.EnableContentApproval == true)
                {
                    pendingApproval = true;
                }
            }
        }

        isGenerating = true;
        StateHasChanged();

        try
        {
            // Load background image as bytes
            var bgImageBytes = await File.ReadAllBytesAsync(selectedBackgroundImage.DiskPath);

            // Create canvas with background and text overlays using SkiaSharp
            var imageInfo = new SKImageInfo(1920, 1080);
            using var surface = SKSurface.Create(imageInfo);
            var canvas = surface.Canvas;
            canvas.Clear(SKColors.Black);

            // Draw background image
            using var bgImage = SKImage.FromEncodedData(bgImageBytes);
            if (bgImage != null)
            {
                canvas.DrawImage(bgImage, new SKRect(0, 0, 1920, 1080));
            }

            // Draw message 1
            if (message1Show && !string.IsNullOrWhiteSpace(message1Text))
            {
                DrawMessage(canvas, message1Text, message1Top, message1Color, message1Bold, message1Italic);
            }

            // Draw message 2
            if (message2Show && !string.IsNullOrWhiteSpace(message2Text))
            {
                DrawMessage(canvas, message2Text, message2Top, message2Color, message2Bold, message2Italic);
            }

            // Draw message 3
            if (message3Show && !string.IsNullOrWhiteSpace(message3Text))
            {
                DrawMessage(canvas, message3Text, message3Top, message3Color, message3Bold, message3Italic);
            }

            // Save image
            using var snapshot = surface.Snapshot();
            using var data = snapshot.Encode(SKEncodedImageFormat.Png, 100);
            var imageBytes = data.ToArray();

            // Save to location root folder
            var locationPath = Path.Combine(baseDirectory!, "MediaAssets", Location.LocationId.ToString());
            Directory.CreateDirectory(locationPath);

            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var fileName = $"Template_{timestamp}.png";
            var filePath = Path.Combine(locationPath, fileName);

            // The manifest builder treats a media file with no asset row as legacy content that
            // predates approvals, so it would serve this unapproved in the window before the rows
            // land. The image is staged where the location watcher cannot see it and revealed below.
            var stagingFolder = Path.Combine(baseDirectory!, "MediaAssets", "_staging", Guid.NewGuid().ToString("N"));
            Directory.CreateDirectory(stagingFolder);
            var stagedPath = Path.Combine(stagingFolder, fileName);

            await File.WriteAllBytesAsync(stagedPath, imageBytes);

            // Create metadata file (for file-based workflows)
            await CreateMetadataFile(stagedPath);

            // If Display is provided, create a TblAsset record
            if (Display != null)
            {
                var webPath = $"/MediaAssets/{Location.LocationId}/{fileName}";
                var newAsset = new TblAsset
                {
                    LocationId = Location.LocationId,
                    AssetName = fileName,
                    AssetPath = webPath,
                    AssetTypeId = (int)Types.AssetType.Image,
                    AssetHeight = 1080,
                    AssetWidth = 1920,
                    ConstraintId = 0,
                    AssetGroupId = 1,
                    Duration = 7,
                    SortOrder = 0,
                    CreateDate = DateTime.UtcNow,
                    IsDeleted = false,
                    UploadedByUserId = preparedUpload?.OwnerUserId,
                    UploadedByUserGroupId = preparedUpload?.OwnerGroupId
                };

                using (var scope = scopeFactory.CreateScope())
                {
                    var dbContext = scope.ServiceProvider.GetRequiredService<IDirectorDBContext>();
                    dbContext.TblAssets.Add(newAsset);
                    await dbContext.SaveChangesAsync();
                    PublicationInvalidator.AssetsChanged([newAsset.LocationId]);

                    foreach (var (key, values) in preparedUpload?.Tags ?? new Dictionary<string, List<string>>())
                        await ContentMetadataService.SetMetadataAsync(newAsset.AssetId, key, values, SessionState.User?.UserId);

                    // Create approval record for hotel content when EnableContentApproval is on
                    if (Display != null && Display.EnableContentApproval && SessionState.User != null)
                    {
                        // Flagged content = Pending, Safe content = Auto-approved
                        var approvalStatus = pendingApproval ? ApprovalStatus.Pending : ApprovalStatus.Approved;

                        await CreateApprovalRecord(newAsset.AssetId, dbContext, approvalStatus);
                        PublicationInvalidator.AssetsChanged([newAsset.LocationId]);

                        // Submit to approval chain if one exists for this location
                        if (Display.LocationId > 0)
                        {
                            var lastApproval = await dbContext.TblAssetApprovals
                                .FirstOrDefaultAsync(a => a.AssetId == newAsset.AssetId);
                            if (lastApproval != null)
                            {
                                var passedModeration = approvalStatus == ApprovalStatus.Approved;
                                var chainRequest = await ApprovalChainService.SubmitToChainAsync(lastApproval.AssetApprovalId, Display.LocationId, passedModeration,
                                    uploadingUserId: null, pickedRuleId: preparedUpload?.PickedRuleId);
                            }
                        }
                    }
                }

                // Notify parent that asset was created
                await OnAssetCreated.InvokeAsync(newAsset);
            }

            // Reveal the image now that its rows exist. The sidecar moves first so the gate never
            // sees the image without the approval state that belongs to it.
            if (File.Exists(stagedPath + ".metadata"))
            {
                if (File.Exists(filePath + ".metadata")) File.Delete(filePath + ".metadata");
                File.Move(stagedPath + ".metadata", filePath + ".metadata");
            }
            if (File.Exists(filePath)) File.Delete(filePath);
            File.Move(stagedPath, filePath);

            try { Directory.Delete(stagingFolder, recursive: true); } catch { }

            // Notify parent component (file path callback)
            await OnImageGenerated.InvokeAsync(filePath);

            // Reset form after successful generation
            ResetForm();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating template image");
        }
        finally
        {
            isGenerating = false;
            var wasPendingApproval = pendingApproval;
            pendingApproval = false;
            currentModerationResult = null;

            StateHasChanged();
        }
    }

    private void DrawMessage(SKCanvas canvas, string text, int topPosition, string color, bool isBold, bool isItalic)
    {
        var fontStyle = SKFontStyle.Normal;
        if (isBold && isItalic)
            fontStyle = SKFontStyle.BoldItalic;
        else if (isBold)
            fontStyle = SKFontStyle.Bold;
        else if (isItalic)
            fontStyle = SKFontStyle.Italic;

        using var paint = new SKPaint
        {
            Color = color == "white" ? SKColors.White : SKColors.Black,
            IsAntialias = true,
            TextSize = 72,
            Typeface = SKTypeface.FromFamilyName("Arial", fontStyle),
            TextAlign = SKTextAlign.Center
        };

        // Calculate proper baseline offset using font metrics
        var fontMetrics = paint.FontMetrics;
        var baselineOffset = -fontMetrics.Ascent;

        // Add shadow (black for white text, white for black text)
        var shadowColor = color == "white" ? new SKColor(0, 0, 0, 204) : new SKColor(255, 255, 255, 204);
        paint.ImageFilter = SKImageFilter.CreateDropShadow(3, 3, 6, 6, shadowColor);

        canvas.DrawText(text, 960, topPosition + baselineOffset, paint);
    }

