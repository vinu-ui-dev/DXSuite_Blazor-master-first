    {
        selectedBackgroundImage = null;
        activeMessageTab = 1;
        sharedTextColor = "black";
        message1Text = "";
        message1Show = true;
        message1Color = "black";
        message1Bold = false;
        message1Italic = false;
        message1Top = 400;
        message1EditPosition = false;
        message2Text = "";
        message2Show = true;
        message2Color = "black";
        message2Bold = false;
        message2Italic = false;
        message2Top = 500;
        message2EditPosition = false;
        message3Text = "";
        message3Show = true;
        message3Color = "black";
        message3Bold = false;
        message3Italic = false;
        message3Top = 600;
