    }

    private void HandleModerationCancel()
    {
        // User cancelled, stop generation
        pendingApproval = false;
        currentModerationResult = null;
        isGenerating = false;
        StateHasChanged();
    }

    private async Task HandleModerationApproval()
    {
        // User chose to submit for approval, proceed with generation
        pendingApproval = true;

        await GenerateTemplateImage(); // Re-enter method, skips moderation check
    }

    private async Task CreateApprovalRecord(int assetId, IDirectorDBContext dbContext, ApprovalStatus status)
    {
        if (SessionState.User == null) return;

        string metadataTag = "TEMPLATE";

        // Store moderation context in ExtendedData
        var extendedData = new
        {
            metadataTag = metadataTag,
            moderationReason = currentModerationResult?.Reason ?? (status == ApprovalStatus.Approved ? "Content approved by AI moderation" : "Content flagged"),
            policyViolation = currentModerationResult?.PolicyViolation ?? "None",
            flaggedTexts = new[]
            {
                message1Text,
                message2Text,
                message3Text
            }.Where(t => !string.IsNullOrWhiteSpace(t)).ToArray(),
            source = "TemplateCreator",
            generatedDate = DateTime.UtcNow,
            autoApproved = status == ApprovalStatus.Approved
        };

        var approval = new TblAssetApproval
        {
            AssetId = assetId,
            UploadedByUserId = SessionState.User.UserId,
            ApprovalStatus = (int)status,
            SubmittedDate = DateTime.UtcNow,
            ExtendedData = System.Text.Json.JsonSerializer.Serialize(extendedData)
        };

        // For auto-approved content, set reviewed fields to indicate AI approval
        if (status == ApprovalStatus.Approved)
        {
            approval.ReviewedByUserId = SessionState.User.UserId; // Same user who uploaded
            approval.ReviewedDate = DateTime.UtcNow;
            approval.ReviewNotes = "Automatically approved by AI content moderation";
        }

        dbContext.TblAssetApprovals.Add(approval);
        await dbContext.SaveChangesAsync();
    }

    private async Task CreateMetadataFile(string imagePath)
    {
        try
        {
            var metadataPath = imagePath + ".metadata";

            using (var writer = new StreamWriter(metadataPath))
            {
                await writer.WriteLineAsync("<usermetadata>");

                // Location
                await writer.WriteLineAsync($"  <field name=\"Location\" datatype=\"ovx_String\" value=\"{Location!.LocationId}\" />");

                // FileName
                await writer.WriteLineAsync($"  <field name=\"FileName\" datatype=\"ovx_String\" value=\"{Path.GetFileName(imagePath)}\" />");

                // Schedule dates if provided
                if (scheduleStartDate.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"StartDate\" datatype=\"ovx_String\" value=\"{scheduleStartDate.Value:yyyy-MM-dd}\" />");
                }

                if (scheduleEndDate.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"EndDate\" datatype=\"ovx_String\" value=\"{scheduleEndDate.Value:yyyy-MM-dd}\" />");
                }

                // Schedule times if provided
                if (scheduleStartTime.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"StartTime\" datatype=\"ovx_String\" value=\"{scheduleStartTime.Value:HH:mm:ss}\" />");
                }

                if (scheduleEndTime.HasValue)
                {
                    await writer.WriteLineAsync($"  <field name=\"EndTime\" datatype=\"ovx_String\" value=\"{scheduleEndTime.Value:HH:mm:ss}\" />");
                }

                // Override Content
                await writer.WriteLineAsync($"  <field name=\"Override\" datatype=\"ovx_String\" value=\"{(overrideContent ? "True" : "False")}\" />");

                await writer.WriteLineAsync("</usermetadata>");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating metadata file");
        }
    }
