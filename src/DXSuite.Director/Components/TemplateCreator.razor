@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore
@using Newtonsoft.Json
@using System.Text.Json
@using DXSuite.Director.Entities
@using DXSuite.Director.Models
@using static DXSuite.Director.Models.Types
@using DXSuite.Director.Services
@using System.Xml
@using SkiaSharp
@inject NavigationManager navMan;
@inject IServiceScopeFactory scopeFactory;
@inject IConfiguration config;
@inject IWebHostEnvironment env;
@inject ITenantMediaPathResolver MediaPaths
@inject CanvasImageGenerationService ImageGenerator;
@inject IFontService FontService;
@inject IContentModerationService ModerationService;
@inject IAssetApprovalService ApprovalService;
@inject IApprovalChainService ApprovalChainService;
@inject ISessionState SessionState;
@inject IUploadIdentityService UploadIdentity
@inject IContentMetadataService ContentMetadataService
@inject ILogger<TemplateCreator> Logger;
@inject IPublicationInvalidator PublicationInvalidator
@rendermode InteractiveServer

<!-- Collapsible Header — hidden when rendered inside a modal (ShowCollapsibleHeader=false) -->
@if (ShowCollapsibleHeader)
{
    <div class="collapsible-header @(isConfigExpanded ? "open" : "")" @onclick="ToggleExpanded">
        <h3>Template Creator</h3>
        <span class="toggle-icon">@(isConfigExpanded ? "▼" : "▶")</span>
    </div>
}

@if (isConfigExpanded)
{
    <div class="template-background">
        <div class="template-container">
            <!-- Left Configuration Panel -->
            <div class="config-panel">

                <!-- Background Image Section -->
                <div class="form-section">
                    <h5>Background Image</h5>
                    <div class="dropdown" style="width: 100%;">
                        <button class="dx-btn dx-btn-gray dropdown-toggle w-100" type="button" @onclick="() => showBackgroundDropdown = !showBackgroundDropdown">
                            @if (selectedBackgroundImage != null)
                            {
                                <span>@Path.GetFileName(selectedBackgroundImage.DiskPath)</span>
                            }
                            else
                            {
                                <span>Select Background...</span>
                            }
                        </button>
                        @if (showBackgroundDropdown)
                        {
                            <div class="dropdown-menu show w-100" style="max-height: 300px; overflow-y: auto;">
                                @foreach (var bgImage in backgroundImages)
                                {
                                    <div class="dropdown-item d-flex justify-content-between align-items-center" style="padding: 5px 10px;">
                                        <div class="d-flex align-items-center" @onclick="() => SelectBackgroundImage(bgImage)" style="cursor: pointer; flex: 1; gap: 10px;">
                                            <img src="@bgImage.WebPath" style="width: 106px; height: 60px; object-fit: cover; border-radius: 3px; border: 1px solid #ddd;" />
                                            <span style="margin-right:10px;">@Path.GetFileName(bgImage.DiskPath)</span>
                                        </div>
                                        <button class="dx-btn dx-btn-red" @onclick="() => ShowDeleteBackgroundConfirmation(bgImage)" @onclick:stopPropagation="true">
                                            ✕
                                        </button>
                                    </div>
                                }
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item" @onclick="OpenBackgroundImageUploader">
                                    Add new image...
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Messages Section with Tabs -->
                <div class="form-section">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 style="margin: 0;">Messages</h5>
                        <div class="form-group" style="margin: 0; width: 150px;">
                            <label style="font-size: 12px; margin-bottom: 3px;">Text Color:</label>
                            <select class="dx-form-control form-control-sm" @bind="sharedTextColor" @bind:after="UpdateBothTextColors">
                                <option value="white">White</option>
                                <option value="black">Black</option>
                            </select>
                        </div>
                    </div>

                    <!-- Tab Navigation -->
                    <div class="tab-nav">
                        <button class="tab-button @(activeMessageTab == 1 ? "active" : "")" @onclick="() => activeMessageTab = 1">
                            Message 1
                        </button>
                        <button class="tab-button @(activeMessageTab == 2 ? "active" : "")" @onclick="() => activeMessageTab = 2">
                            Message 2
                        </button>
                        <button class="tab-button @(activeMessageTab == 3 ? "active" : "")" @onclick="() => activeMessageTab = 3">
                            Message 3
                        </button>
                    </div>

                    <!-- Tab Content -->
                    <div class="tab-content">
                        @if (activeMessageTab == 1)
                        {
                            <div class="form-group">
                                <label>Text (max 50 characters):</label>
                                <input type="text" class="dx-form-control" @bind="message1Text" maxlength="50" />
                            </div>
                            <div class="form-group" style="display: flex; gap: 15px; align-items: center;">
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message1Show" />
                                    Show Message
                                </label>
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message1Bold" />
                                    Bold
                                </label>
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message1Italic" />
                                    Italic
                                </label>
                            </div>
                            @if (!message1EditPosition)
                            {
                                <button class="dx-btn dx-btn-blue" style="width: 100%; margin-top: 10px;" @onclick="() => message1EditPosition = true">
                                    EDIT POSITION
                                </button>
                            }
                            else
                            {
                                <div class="form-group">
                                    <label>Top Position (px):</label>
                                    <input type="number" class="dx-form-control" @bind="message1Top" />
                                </div>
                            }
                        }
                        else if (activeMessageTab == 2)
                        {
                            <div class="form-group">
                                <label>Text (max 50 characters):</label>
                                <input type="text" class="dx-form-control" @bind="message2Text" maxlength="50" />
                            </div>
                            <div class="form-group" style="display: flex; gap: 15px; align-items: center;">
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message2Show" />
                                    Show Message
                                </label>
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message2Bold" />
                                    Bold
                                </label>
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message2Italic" />
                                    Italic
                                </label>
                            </div>
                            @if (!message2EditPosition)
                            {
                                <button class="dx-btn dx-btn-blue" style="width: 100%; margin-top: 10px;" @onclick="() => message2EditPosition = true">
                                    EDIT POSITION
                                </button>
                            }
                            else
                            {
                                <div class="form-group">
                                    <label>Top Position (px):</label>
                                    <input type="number" class="dx-form-control" @bind="message2Top" />
                                </div>
                            }
                        }
                        else if (activeMessageTab == 3)
                        {
                            <div class="form-group">
                                <label>Text (max 50 characters):</label>
                                <input type="text" class="dx-form-control" @bind="message3Text" maxlength="50" />
                            </div>
                            <div class="form-group" style="display: flex; gap: 15px; align-items: center;">
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message3Show" />
                                    Show Message
                                </label>
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message3Bold" />
                                    Bold
                                </label>
                                <label style="margin: 0;">
                                    <input type="checkbox" @bind="message3Italic" />
                                    Italic
                                </label>
                            </div>
                            @if (!message3EditPosition)
                            {
                                <button class="dx-btn dx-btn-blue" style="width: 100%; margin-top: 10px;" @onclick="() => message3EditPosition = true">
                                    EDIT POSITION
                                </button>
                            }
                            else
                            {
                                <div class="form-group">
                                    <label>Top Position (px):</label>
                                    <input type="number" class="dx-form-control" @bind="message3Top" />
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Schedule Section (only for file-based workflows without Display) -->
                @if (Display == null)
                {
                    <div class="form-section">
                        <h5>Schedule</h5>
                        <div class="schedule-grid">
                            <div class="form-group">
                                <label>Start Date:</label>
                                <input type="date" class="dx-form-control" @bind="scheduleStartDate" />
                            </div>
                            <div class="form-group">
                                <label>End Date:</label>
                                <input type="date" class="dx-form-control" @bind="scheduleEndDate" />
                            </div>
                            <div class="form-group">
                                <label>Start Time:</label>
                                <input type="time" class="dx-form-control" @bind="scheduleStartTime" />
                            </div>
                            <div class="form-group">
                                <label>End Time:</label>
                                <input type="time" class="dx-form-control" @bind="scheduleEndTime" />
                            </div>
                        </div>
                    </div>
                }

                @if (ShowsUploadingAs)
                {
                    <UploadingAsSection @ref="uploadingAs" LocationId="@Location!.LocationId" OnChanged="StateHasChanged" />
                }
                @if (UploadBlockReason is { } blockReason)
                {
                    <div class="dx-text-red" style="font-size:0.8rem; margin-bottom:6px;">@blockReason</div>
                }

                <!-- Submit Button -->
                <button class="dx-btn dx-btn-blue w-100" @onclick="GenerateTemplateImage" disabled="@(isGenerating || UploadBlockReason != null)" title="@UploadBlockReason">
                    @if (isGenerating)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate Image</span>
                    }
                </button>
            </div>

            <!-- Right Visualization Panel -->
            <div class="visualization-panel">
                <h3>Preview (1920x1080)</h3>
                <div class="preview-wrapper">
                    <div class="preview-container" style="width: 1920px; height: 1080px; transform: scale(0.26); transform-origin: top left; position: relative; border: 1px solid #ccc; background-color: #000;">
                        @if (selectedBackgroundImage != null)
                        {
                            <img src="@selectedBackgroundImage.WebPath" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" />
                        }

                        @if (message1Show && !string.IsNullOrWhiteSpace(message1Text))
                        {
                            <div style="position: absolute; left: 0; right: 0; top: @(message1Top)px; color: @message1Color; font-size: 72px; font-family: Arial; font-weight: @(message1Bold ? "bold" : "normal"); font-style: @(message1Italic ? "italic" : "normal"); text-shadow: 3px 3px 6px rgba(@(message1Color == "white" ? "0,0,0" : "255,255,255"),0.8); text-align: center; line-height: 1;">
                                @message1Text
                            </div>
                        }

                        @if (message2Show && !string.IsNullOrWhiteSpace(message2Text))
                        {
                            <div style="position: absolute; left: 0; right: 0; top: @(message2Top)px; color: @message2Color; font-size: 72px; font-family: Arial; font-weight: @(message2Bold ? "bold" : "normal"); font-style: @(message2Italic ? "italic" : "normal"); text-shadow: 3px 3px 6px rgba(@(message2Color == "white" ? "0,0,0" : "255,255,255"),0.8); text-align: center; line-height: 1;">
                                @message2Text
                            </div>
                        }

                        @if (message3Show && !string.IsNullOrWhiteSpace(message3Text))
                        {
                            <div style="position: absolute; left: 0; right: 0; top: @(message3Top)px; color: @message3Color; font-size: 72px; font-family: Arial; font-weight: @(message3Bold ? "bold" : "normal"); font-style: @(message3Italic ? "italic" : "normal"); text-shadow: 3px 3px 6px rgba(@(message3Color == "white" ? "0,0,0" : "255,255,255"),0.8); text-align: center; line-height: 1;">
                                @message3Text
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Background Image Upload Modal -->
<MediaAssetUploader @ref="backgroundUploaderModal" OnAssetSubmit="OnBackgroundImageUploaded" />

<!-- Content Moderation Modal -->
<ContentModerationModal @ref="moderationModal"
                        OnCancel="HandleModerationCancel"
                        OnSubmitForApproval="HandleModerationApproval" />

<!-- Delete Confirmation Modal -->
@if (showDeleteConfirmation)
{
    <div class="tc-modal-backdrop" @onclick="CloseDeleteConfirmation">
        <div class="tc-modal-content" @onclick:stopPropagation="true">
            <div class="tc-modal-header">
                <h4>Delete Background Image</h4>
                <button class="tc-modal-close" @onclick="CloseDeleteConfirmation">&times;</button>
            </div>
            <div class="tc-modal-body">
                <p>Are you sure you want to delete this background image?</p>
                <p class="text-muted">@(imageToDelete != null ? Path.GetFileName(imageToDelete.DiskPath) : "")</p>
            </div>
            <div class="tc-modal-footer">
                <button class="dx-btn dx-btn-gray" @onclick="CloseDeleteConfirmation">CANCEL</button>
                <button class="dx-btn dx-btn-red" @onclick="DeleteBackgroundImage">DELETE</button>
            </div>
        </div>
    </div>
}

