    private class DeviceRow
    {
        public string DeviceId { get; set; } = null!;
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? Manufacturer { get; set; }
        public string? Model { get; set; }
        public string? SerialNumber { get; set; }
        public string? IpAddress { get; set; }
        // LocationId is not displayed in Device Management but is retained to determine Platform badge
        public int? LocationId { get; set; }
        public DateTime Heartbeat { get; set; }
        public string? ClientVersion { get; set; }
        public string? UpdateStatus { get; set; }
        public string? ContentHealthStatus { get; set; }
        public string? BrowserType { get; set; }
        public string? BrowserVersion { get; set; }
        // Derived from LocationId, and never a platform: an assigned location means an active
        // Engage player. Named for what it is, because "Platform" here collided with the flavour.
        public string? EngageBadge { get; set; }
        // Lowercase platform name from TblAppPlatform (e.g., "avalonia", "signageos").
        // Drives platform-specific controls in the device settings modal.
        public string? ClientPlatform { get; set; }
        // The flavour this device was enrolled with, from its TblAppPlatform row.
        public string? Flavour { get; set; }
        // The flavour it last declared on a heartbeat. Compared against Flavour on read.
        public string? DeclaredFlavour { get; set; }
        public FlavourState FlavourCheck { get; set; }
        // Null means the player is still on the package's shared bootstrap DWS password, which is
        // a visible state rather than a silent one: a leaked card opens every player made from it
        // until each has rotated.
        public DateTime? DwsPasswordRotatedAt { get; set; }
        // Manifest version the player last echoed, compared against the location's
        // current cached manifest: true = current, false = stale, null = can't compare
        public string? ManifestVersion { get; set; }
        public bool? ContentCurrent { get; set; }
        public bool LiveSocket { get; set; }
        public string? TimeZone { get; set; }
        public string? TimeZoneSource { get; set; }
        public TimeZoneFingerprintData? Fingerprint { get; set; }
        public TimeZoneVerificationState TimeZoneCheck { get; set; }
        public string Orientation { get; set; } = DeviceOrientation.Landscape;
        public string VideoPath { get; set; } = DeviceVideoPath.Hardware;
        public int? SiteId { get; set; }
        public string? SiteName { get; set; }
        public string? City { get; set; }
        public string? StateProvince { get; set; }
    }
}
