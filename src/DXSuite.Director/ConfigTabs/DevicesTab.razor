    private static string FormatCommandType(TblDeviceCommand cmd)
    {
        if (cmd.CommandType == DeviceCommandTypes.Cec && !string.IsNullOrEmpty(cmd.PayloadJson))
        {
            try
            {
                var payload = System.Text.Json.JsonSerializer.Deserialize<CecCommandPayload>(cmd.PayloadJson);
                if (payload != null) return $"CEC {payload.Action}";
            }
            catch { }
        }
        return cmd.CommandType switch
        {
            DeviceCommandTypes.Screenshot => "Screenshot",
            DeviceCommandTypes.FlushCache => "Flush cache",
            _ => cmd.CommandType
        };
    }

