    private static TimeZoneVerificationState ResolveTimeZoneCheck(string? ianaId, TimeZoneFingerprintData? reported)
        => TimeZoneVerification.Evaluate(
            ianaId,
            TimeZoneCatalog.FindSetTimeZoneArgument(ianaId),
            reported is null
                ? null
                : new TimeZoneFingerprint(
                    reported.OffsetJanuaryHours, reported.OffsetJulyHours, reported.Year,
                    reported.PosixString, reported.AppliedLiteral));

