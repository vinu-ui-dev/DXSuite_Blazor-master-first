    // Widths live as custom properties on the table and the header and rows size themselves from
    // those, so a resize drag can repaint by setting one property on one element instead of
    // pushing a new style onto every row.
    private string GetColumnVars() =>
        string.Join(" ", columnOrder.Select(c => $"--dxcol-{c}:{columnWidths.GetValueOrDefault(c, "100px")};"));

    private string GetGridStyle() =>
        "grid-template-columns: " + string.Join(" ", columnOrder.Select(c => $"var(--dxcol-{c})")) + ";";

    private async Task StartColumnResize(PointerEventArgs e, string col)
    {
        selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("dxStartColumnResize", col, e.ClientX, selfRef);
    }

    [JSInvokable]
    public void OnColumnResized(string col, string width)
    {
        columnWidths[col] = width;
        StateHasChanged();
    }

    private void OnColumnDragStart(string col) => draggedColumn = col;
    private void OnColumnDragOver(string col) => dragOverColumn = col;
    private void OnColumnDragEnd() { draggedColumn = null; dragOverColumn = null; }

    private void OnColumnDrop(string targetCol)
    {
        if (draggedColumn != null && draggedColumn != targetCol)
        {
            var fromIdx = columnOrder.IndexOf(draggedColumn);
            var toIdx = columnOrder.IndexOf(targetCol);
            if (fromIdx >= 0 && toIdx >= 0)
            {
                columnOrder.RemoveAt(fromIdx);
                columnOrder.Insert(toIdx, draggedColumn);
            }
        }
        draggedColumn = null;
        dragOverColumn = null;
    }

    private void ToggleColumn(string col)
    {
        if (columnOrder.Contains(col))
            columnOrder.Remove(col);
        else
            columnOrder.Add(col);
    }

    private void ToggleColumnDropdown() => showColumnDropdown = !showColumnDropdown;

    private RenderFragment RenderCell(DeviceRow d, string col, bool isOnline) => col switch
    {
        "status" => @<div style="text-align:center;"><span class="dx-status-indicator @(isOnline ? "online" : "offline")">●</span>@if (d.LiveSocket) { <span title="Live wake channel connected" style="font-size:0.7rem; margin-left:2px;">⚡</span> }</div>,
        "deviceId" => @<div class="dx-truncate" style="font-weight:600; color:var(--dx-blue);">@d.DeviceId</div>,
        "name" => RenderNameCell(d),
        "description" => RenderDescriptionCell(d),
        "manufacturer" => @<div class="dx-truncate">@d.Manufacturer</div>,
        "model" => @<div class="dx-truncate">@d.Model</div>,
        "serial" => @<div class="dx-truncate">@d.SerialNumber</div>,
        "ip" => @<div>@if (!string.IsNullOrEmpty(d.IpAddress)) { <a class="dx-col-link" href="http://@d.IpAddress" target="_blank">@d.IpAddress</a> }</div>,
        "lastSeen" => @<div><span title="@d.Heartbeat.ToString("g")">@FormatHeartbeat(d.Heartbeat)</span></div>,
        "contentSync" => @<div style="text-align:center;">
            @if (d.ContentCurrent == true) { <span class="dx-badge dx-badge-green" title="Playing current content (@d.ManifestVersion)">Current</span> }
            else if (d.ContentCurrent == false) { <span class="dx-badge dx-badge-yellow" title="Device reports @d.ManifestVersion">Stale</span> }
            else if (!string.IsNullOrEmpty(d.ManifestVersion)) { <span class="dx-badge dx-badge-gray" title="Reported @d.ManifestVersion; no built manifest to compare against yet">Reported</span> }
            else { <span style="opacity:0.4;">—</span> }
        </div>,
        "timeZone" => RenderTimeZoneCell(d),
        "timeZoneSource" => @<div class="dx-truncate" title="Seeded means nobody has confirmed this device's zone, so no zone is sent to it">@d.TimeZoneSource</div>,
        "timeZoneCheck" => @<div style="text-align:center;">
            @switch (d.TimeZoneCheck)
            {
                case TimeZoneVerificationState.Verified:
                    <span class="dx-badge dx-badge-green" title="The player applied this zone and its rules agree">Verified</span>;
                    break;
                case TimeZoneVerificationState.Pending:
                    <span class="dx-badge dx-badge-gray" title="The player has not applied this zone yet">Pending</span>;
                    break;
                case TimeZoneVerificationState.Mismatch:
                    <span class="dx-badge dx-badge-yellow" title="The player applied this zone and is running different rules">Mismatch</span>;
                    break;
                default:
                    <span style="opacity:0.4;" title="This player reports no time zone fingerprint">—</span>;
                    break;
            }
        </div>,
        "site" => RenderSiteCell(d),
        "city" => @<div class="dx-truncate">@d.City</div>,
        "state" => @<div class="dx-truncate">@d.StateProvince</div>,
        "contentHealth" => @<div style="text-align:center;">@if (d.ContentHealthStatus != null) { <span class="dx-badge @GetHealthBadge(d.ContentHealthStatus)">@d.ContentHealthStatus</span> }</div>,
        "browser" => @<div class="dx-truncate">@(d.BrowserType != null ? $"{d.BrowserType} {d.BrowserVersion}" : "—")</div>,
        "clientVersion" => @<div class="dx-truncate">@d.ClientVersion</div>,
        "platform" => RenderFlavourCell(d),
        "settings" => @<div style="text-align:center;"><button class="dx-btn dx-btn-gray dx-btn-sm" title="Device settings" @onclick="@(() => ShowDeviceSettingsModal(d))">⚙</button></div>,
        _ => @<div></div>,
    };

    // The real enrolled flavour, not the literal "Engage" this column used to render from
    // LocationId. A mismatch is surfaced and never acted on: a device declaring a flavour it was
    // not enrolled with is either mis-provisioned or not ours, and both want a human.
    private RenderFragment RenderFlavourCell(DeviceRow d) => __builder =>
    {
        <div class="dx-truncate">
            @if (!string.IsNullOrEmpty(d.Flavour))
            {
                <span class="dx-badge dx-badge-blue">@d.Flavour</span>
            }
            else
            {
                <span style="opacity:0.4;" title="No flavour enrolled">—</span>
            }

            @if (d.FlavourCheck == FlavourState.Mismatched)
            {
                <span class="dx-badge dx-badge-yellow"
                      title="@($"Enrolled as {d.Flavour}, but this player declares {d.DeclaredFlavour}")">Mismatch</span>
            }
            @if (!string.IsNullOrEmpty(d.Flavour) && d.DwsPasswordRotatedAt == null)
            {
                <span class="dx-badge dx-badge-gray"
                      title="Still on the provisioning package's shared bootstrap password. It rotates to a per-device secret on enrollment, and again after any config re-apply.">Bootstrap DWS</span>
            }
        </div>;
    };

    // A curated list rather than free text, and this is the highest-risk operator action in the
    // whole effort: somebody reasoning "Phoenix is Mountain" and picking Mountain Time gets
    // America/Denver, which tracks Denver's daylight saving and is wrong for eight months a year
    // while looking correct all winter.
    private RenderFragment RenderTimeZoneCell(DeviceRow d) => __builder =>
    {
        if (editingTimeZoneDeviceId == d.DeviceId)
        {
            <div>
                <select class="dx-form-control" style="font-size:0.85rem; padding:2px 6px;"
                        @bind="editingTimeZoneValue"
                        @bind:after="async () => await SaveTimeZone(d)">
                    @foreach (var option in TimeZoneCatalog.Options)
                    {
                        <option value="@option.IanaId">@option.Label</option>
                    }
                </select>
            </div>
        }
        else
        {
            var unconfirmed = !DeviceProvisioning.IsOperatorConfirmed(d.TimeZoneSource);
            var label = TimeZoneCatalog.Options.FirstOrDefault(o => o.IanaId == d.TimeZone).Label ?? d.TimeZone;
            <div class="dx-editable-cell dx-truncate" @onclick="() => StartEditTimeZone(d)"
                 style="@(unconfirmed ? "opacity:0.55; font-style:italic;" : "")"
                 title="@(unconfirmed ? "Not confirmed by an operator, so no zone is sent to this player. Click to set." : "Click to change")">@label</div>
        }
    };

    private void StartEditTimeZone(DeviceRow d)
    {
        editingTimeZoneDeviceId = d.DeviceId;
        editingTimeZoneValue = d.TimeZone ?? "";
    }

    private async Task SaveTimeZone(DeviceRow d)
    {
        if (editingTimeZoneDeviceId != d.DeviceId) return;
        editingTimeZoneDeviceId = null;

        var newZone = editingTimeZoneValue;
        if (string.IsNullOrEmpty(newZone) || newZone == d.TimeZone) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var device = await db.TblDevices.FirstOrDefaultAsync(x => x.DeviceId == d.DeviceId);
            if (device != null)
            {
                device.TimeZone = newZone;

                // Setting it here is an operator confirming it, which is what unlocks sending the
                // zone to the player at all.
                device.TimeZoneSource = DeviceProvisioning.OperatorSource;
                await db.SaveChangesAsync();
                d.TimeZone = newZone;
                d.TimeZoneSource = DeviceProvisioning.OperatorSource;
                d.TimeZoneCheck = ResolveTimeZoneCheck(d.TimeZone, d.Fingerprint);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving time zone: {ex.Message}");
        }
    }

