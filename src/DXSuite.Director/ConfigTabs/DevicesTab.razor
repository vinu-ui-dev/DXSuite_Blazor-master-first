    private async Task SaveWindowMode()
    {
        if (selectedSettingsDevice == null || windowModeSettings == null) return;

        isSavingWindowMode = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var device = await db.TblDevices.FirstOrDefaultAsync(d => d.DeviceId == selectedSettingsDevice.DeviceId);
            if (device != null)
            {
                var snapshot = windowModeSettings;
                device.ExtendedData = ExtendedDataHelper.UpdateProperty<DeviceExtendedData>(
                    device.ExtendedData,
                    d => d.WindowMode = snapshot);
                await db.SaveChangesAsync();
                ShowToast($"Window mode saved for {selectedSettingsDevice.DeviceId}.");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving window mode: {ex.Message}");
            ShowToast("Error saving window mode.");
