    private async Task SaveSite(DeviceRow d)
    {
        if (editingSiteDeviceId != d.DeviceId) return;
        editingSiteDeviceId = null;

        int? newSiteId = int.TryParse(editingSiteValue, out var parsed) ? parsed : null;
        if (newSiteId == d.SiteId) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var device = await db.TblDevices.FirstOrDefaultAsync(x => x.DeviceId == d.DeviceId);
            if (device != null)
            {
                device.SiteId = newSiteId;
                await db.SaveChangesAsync();

                var site = sites.FirstOrDefault(x => x.SiteId == newSiteId);
                d.SiteId = newSiteId;
                d.SiteName = site?.SiteName;
                d.City = site?.City;
                d.StateProvince = site?.StateProvince;
            }
        }
        catch (Exception ex)
