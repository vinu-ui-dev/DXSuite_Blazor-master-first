    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
        await LoadSavedView();
    }

    private async Task LoadSavedView()
    {
        try
        {
            var saved = await UserPreferenceService.GetConfigurationViewSettingsAsync(SessionState.User!.UserId);
            if (saved?.DeviceColumnOrder?.Count > 0)
            {
                var validated = saved.DeviceColumnOrder.Where(c => allColumns.ContainsKey(c)).ToList();
                if (validated.Count > 0)
                    columnOrder = validated;
            }

            if (saved?.DeviceColumnWidths != null)
            {
                foreach (var (col, width) in saved.DeviceColumnWidths.Where(w => allColumns.ContainsKey(w.Key)))
                    columnWidths[col] = width;
            }
        }
        catch { /* Fall back to defaults */ }
    }

    private async Task SaveDeviceView()
    {
        try
        {
            // Read first and write the whole object back: the saved settings also carry the
            // Locations grid's column order, which a fresh object would drop.
            var settings = await UserPreferenceService.GetConfigurationViewSettingsAsync(SessionState.User!.UserId)
                           ?? new ConfigurationViewSettings();
            settings.DeviceColumnOrder = new List<string>(columnOrder);
            settings.DeviceColumnWidths = columnWidths
                .Where(w => DefaultColumnWidths.GetValueOrDefault(w.Key) != w.Value)
                .ToDictionary(w => w.Key, w => w.Value);
            await UserPreferenceService.SaveConfigurationViewSettingsAsync(SessionState.User!.UserId, settings);
            ShowToast("View saved");
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to save view: {ex.Message}");
        }
    }

    private async Task ResetDeviceView()
    {
        columnOrder = new List<string>(DefaultColumnOrder);
        columnWidths = new Dictionary<string, string>(DefaultColumnWidths);
        try
        {
            await UserPreferenceService.ClearConfigurationViewSettingsAsync(SessionState.User!.UserId);
        }
        catch { /* Ignore — local state already reset */ }
        ShowToast("View reset to defaults");
    }

    private async Task LoadDevices()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // Ink folder entries (inkf-* prefix) are managed in Content Channels — exclude from Device Management
            var deviceList = await db.TblDevices
                .AsNoTracking()
                .Include(d => d.Platform)
                .Include(d => d.Site)
                .Where(d => !d.DeviceId.StartsWith("inkf-"))
                .OrderBy(d => d.DeviceId)
                .ToListAsync();

            sites = await db.TblSites.AsNoTracking().OrderBy(x => x.SiteName).ToListAsync();

            devices = deviceList.Select(d =>
            {
                var extData = ExtendedDataHelper.Parse<DeviceExtendedData>(d.ExtendedData);

                // Compare the echoed manifest version to the current cached manifest for the
                // device's bucket (displayId when display-assigned, locationId otherwise)
                var echoedVersion = extData?.ContentSync?.ManifestVersion;
                bool? contentCurrent = null;
                var bucketId = d.DisplayId ?? d.LocationId;
                if (!string.IsNullOrEmpty(echoedVersion))
                {
                    // Compared against the delivery version this device was last served, not against
                    // the cached publication: a publication is shared by every device at a location
                    // while a delivery is resolved per device, so those two versions are different
                    // values by design and comparing them would call every device stale.
                    var delivered = ManifestCache.GetDeliveredVersion(TenantContext.TenantId, d.DeviceId);
                    if (!string.IsNullOrEmpty(delivered))
                        contentCurrent = echoedVersion == delivered;
                }

                return new DeviceRow
                {
                    DeviceId = d.DeviceId,
                    Name = d.Name,
                    Description = d.Description,
                    Manufacturer = d.Manufacturer,
                    Model = d.Model,
                    SerialNumber = d.SerialNumber,
                    IpAddress = d.Ipaddress,
                    LocationId = d.LocationId,
                    Heartbeat = d.Heartbeat,
                    ClientVersion = d.ClientAppVersion,
                    UpdateStatus = d.LastUpdateStatus,
                    ContentHealthStatus = extData?.ContentHealth?.Status,
                    BrowserType = extData?.Browser?.Type,
                    BrowserVersion = extData?.Browser?.Version,
                    // A device with an assigned location is an active Engage player
                    EngageBadge = d.LocationId.HasValue ? "Engage" : null,
                    ClientPlatform = d.Platform?.PlatformName?.ToLowerInvariant(),
                    Flavour = d.Platform?.PlatformName,
                    DeclaredFlavour = extData?.DeclaredFlavour?.PlatformName,
                    FlavourCheck = FlavourVerification.Evaluate(
                        d.Platform?.PlatformName, extData?.DeclaredFlavour?.PlatformName),
                    DwsPasswordRotatedAt = d.DwsPasswordRotatedAt,
                    ManifestVersion = echoedVersion,
                    ContentCurrent = contentCurrent,
                    TimeZone = d.TimeZone,
                    TimeZoneSource = d.TimeZoneSource,
                    Fingerprint = extData?.TimeZoneFingerprint,
                    TimeZoneCheck = ResolveTimeZoneCheck(d.TimeZone, extData?.TimeZoneFingerprint),
                    Orientation = d.Orientation,
                    VideoPath = d.VideoPath,
                    SiteId = d.SiteId,
                    SiteName = d.Site?.SiteName,
                    City = d.Site?.City,
                    StateProvince = d.Site?.StateProvince,
                    LiveSocket = WakeTracker.IsConnected(d.DeviceId),
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading devices: {ex.Message}");
            devices = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<DeviceRow> FilteredDevices
    {
        get
        {
            if (devices == null) return Enumerable.Empty<DeviceRow>();
            var filtered = devices.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchFilter))
            {
                var term = searchFilter.Trim();
                filtered = filtered.Where(d =>
                    (d.DeviceId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.IpAddress?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.SerialNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            filtered = sortColumn switch
            {
                "name" => sortAsc ? filtered.OrderBy(d => d.Name ?? d.DeviceId) : filtered.OrderByDescending(d => d.Name ?? d.DeviceId),
                "description" => sortAsc ? filtered.OrderBy(d => d.Description) : filtered.OrderByDescending(d => d.Description),
                "lastSeen" => sortAsc ? filtered.OrderBy(d => d.Heartbeat) : filtered.OrderByDescending(d => d.Heartbeat),
                "manufacturer" => sortAsc ? filtered.OrderBy(d => d.Manufacturer) : filtered.OrderByDescending(d => d.Manufacturer),
                "model" => sortAsc ? filtered.OrderBy(d => d.Model) : filtered.OrderByDescending(d => d.Model),
                "serial" => sortAsc ? filtered.OrderBy(d => d.SerialNumber) : filtered.OrderByDescending(d => d.SerialNumber),
                "ip" => sortAsc ? filtered.OrderBy(d => d.IpAddress) : filtered.OrderByDescending(d => d.IpAddress),
                _ => sortAsc ? filtered.OrderBy(d => d.DeviceId) : filtered.OrderByDescending(d => d.DeviceId),
            };

            return filtered;
        }
    }

    private void SetSort(string col)
    {
        if (sortColumn == col)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = col;
            sortAsc = true;
        }
    }

    private string SortCaret(string col) =>
        sortColumn != col ? "" : sortAsc ? "▲" : "▼";

    private void OnSearchChanged() { }

    private static bool IsOnline(DateTime heartbeat) =>
        (DateTime.UtcNow - heartbeat).TotalMinutes <= 2;

    private static string FormatHeartbeat(DateTime hb)
    {
        var ago = DateTime.UtcNow - hb;
        if (ago.TotalMinutes < 2) return "Just now";
        if (ago.TotalHours < 1) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalDays < 1) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    private static string GetHealthBadge(string? status) => status?.ToLower() switch
    {
        "healthy" => "dx-badge-green",
        "unresponsive" => "dx-badge-yellow",
        "failed" => "dx-badge-red",
        _ => "dx-badge-gray"
    };

    private void ShowToast(string message)
    {
        toastMessage = message;
        toastVisible = true;
        toastTimer?.Dispose();
        toastTimer = new Timer(_ =>
        {
            toastVisible = false;
            _ = InvokeAsync(StateHasChanged);
        }, null, 3000, Timeout.Infinite);
    }

    public void Dispose()
    {
        toastTimer?.Dispose();
        selfRef?.Dispose();
    }

    private async Task LoadDeviceSettings()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var setting = await db.TblSystemSettings
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.SettingKey == "engage:allowHttpFallback");
        settingAllowHttpFallback = setting?.SettingValue != "false";
        deviceSettingsSaveMessage = null;
    }

    private async Task SaveDeviceSettings()
    {
        deviceSettingsSaving = true;
        deviceSettingsSaveMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.TblSystemSettings.FindAsync("engage:allowHttpFallback");
            var value = settingAllowHttpFallback ? "true" : "false";
            if (existing != null)
            {
                existing.SettingValue = value;
                existing.LastEditDate = DateTime.UtcNow;
                existing.LastEditUser = SessionState.UserName ?? "system";
            }
            else
            {
                db.TblSystemSettings.Add(new TblSystemSetting
                {
                    SettingKey = "engage:allowHttpFallback",
                    SettingValue = value,
                    LastEditDate = DateTime.UtcNow,
                    LastEditUser = SessionState.UserName ?? "system"
                });
            }
            await db.SaveChangesAsync();
            deviceSettingsSaveMessage = "Saved.";
            deviceSettingsSaveError = false;
        }
        catch (Exception ex)
        {
            deviceSettingsSaveMessage = $"Error: {ex.Message}";
            deviceSettingsSaveError = true;
        }
        deviceSettingsSaving = false;
    }

    // Device settings modal methods
    private bool isClearingFlavour;

    private static bool CanClearFlavour(DeviceRow d)
        => FlavourVerification.CanClearFlavour(d.Flavour, d.DeclaredFlavour);

    /// <summary>
    /// Returns a device to the applet by clearing its enrolled flavour.
    ///
    /// An operator action rather than a pairing, because going back to the applet means clearing
    /// PlatformId to null and the applet's pairing request carries no flavour to approve.
    /// Clearing is safe where setting is not, since null already means "no flavour enrolled".
    /// </summary>
    private async Task ClearFlavour()
    {
        if (selectedSettingsDevice == null || isClearingFlavour) return;

        if (!CanClearFlavour(selectedSettingsDevice))
        {
            ShowToast($"{selectedSettingsDevice.DeviceId} still declares {selectedSettingsDevice.DeclaredFlavour}. Move it back to the applet before clearing.");
            return;
        }

        isClearingFlavour = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var device = await db.TblDevices
                .Include(d => d.Platform)
                .FirstOrDefaultAsync(d => d.DeviceId == selectedSettingsDevice.DeviceId);

            if (device == null) return;

            var previousPlatformName = device.Platform?.PlatformName;
            var previousPlatformId = device.PlatformId;

            device.PlatformId = null;
            // The pin outlives the flavour and is returned ahead of any platform check, so it goes
            // with it rather than being left to resolve against a flavour the device no longer has.
            device.TargetAppVersionId = null;
            device.TargetBootloaderVersionId = null;

            db.TblEventLogs.Add(new TblEventLog
            {
                EventSource = "DevicesTab",
                EventTypeId = 1,
                EventSeverityId = 1,
                EventTitle = $"Cleared flavour on {device.DeviceId}",
                EventMessage = $"Returned to the applet from {previousPlatformName ?? previousPlatformId?.ToString() ?? "none"}.",
                DeviceId = device.DeviceId,
                CreateDate = DateTime.UtcNow,
                Details = System.Text.Json.JsonSerializer.Serialize(new
                {
                    previousPlatformId,
                    previousPlatformName,
                    clearedBy = SessionState.UserName
                })
            });

            await db.SaveChangesAsync();

            selectedSettingsDevice.Flavour = null;
            selectedSettingsDevice.FlavourCheck = FlavourState.NotEnrolled;

            ShowToast($"Flavour cleared on {device.DeviceId}.");
            await LoadDevices();
        }
        finally
        {
            isClearingFlavour = false;
        }
    }

    private async Task ShowDeviceSettingsModal(DeviceRow device)
    {
        selectedSettingsDevice = device;
        showDeviceSettingsModal = true;
        consoleLogs = new List<ConsoleLogEntry>();
        consoleLoggingEnabled = false;
        forceHtml5Video = false;
        isFlushingCache = false;
        flushCacheQueued = false;
        windowModeSettings = null;
        isSavingWindowMode = false;
        editingOrientation = device.Orientation;
        isSavingOrientation = false;
        commandHistory = null;
        StateHasChanged();
        await LoadCommandHistory();
        await RefreshConsoleLogs();
        await LoadVideoMode();
        await LoadWindowMode();
    }

    private void CloseDeviceSettingsModal()
    {
        showDeviceSettingsModal = false;
        selectedSettingsDevice = null;
        consoleLogs = new List<ConsoleLogEntry>();
        StateHasChanged();
    }

    private async Task LoadVideoMode()
    {
        if (selectedSettingsDevice == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var device = await db.TblDevices.FirstOrDefaultAsync(d => d.DeviceId == selectedSettingsDevice.DeviceId);
            var extData = ExtendedDataHelper.Parse<DeviceExtendedData>(device?.ExtendedData);
            forceHtml5Video = extData?.VideoMode?.ForceHtml5 == true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading video mode: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task SaveVideoMode(bool value)
    {
        if (selectedSettingsDevice == null) return;

        isSavingVideoMode = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var device = await db.TblDevices.FirstOrDefaultAsync(d => d.DeviceId == selectedSettingsDevice.DeviceId);
            if (device != null)
            {
                device.ExtendedData = ExtendedDataHelper.UpdateProperty<DeviceExtendedData>(
                    device.ExtendedData,
                    d => d.VideoMode = new VideoModeData { ForceHtml5 = value });
                await db.SaveChangesAsync();
                forceHtml5Video = value;
                ShowToast($"Video mode set to {(value ? "HTML5" : "native SOS")} for {selectedSettingsDevice.DeviceId}.");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving video mode: {ex.Message}");
            ShowToast("Error saving video mode setting.");
        }
        finally
        {
            isSavingVideoMode = false;
            StateHasChanged();
        }
    }

    private async Task LoadWindowMode()
    {
        if (selectedSettingsDevice == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var device = await db.TblDevices.FirstOrDefaultAsync(d => d.DeviceId == selectedSettingsDevice.DeviceId);
            var extData = ExtendedDataHelper.Parse<DeviceExtendedData>(device?.ExtendedData);
            windowModeSettings = extData?.WindowMode ?? new WindowModeData { Mode = "fullscreen" };
