@using Microsoft.EntityFrameworkCore
@using DXSuite.Shared.Authorization
@using DXSuite.Shared.Multitenancy
@using System.Threading
@inject IDbContextFactory<DirectorDbContext> DbFactory
@inject ISessionState SessionState
@inject IDirectorUserPreferenceService UserPreferenceService
@inject IUpdateService UpdateService
@inject IScreenshotService ScreenshotService
@inject IContentHealthService ContentHealthService
@inject IConsoleLoggingService ConsoleLoggingService
@inject IDeviceCommandService DeviceCommands
@inject IManifestCacheService ManifestCache
@inject PlayerWakeConnectionTracker WakeTracker
@inject ITenantContext TenantContext
@inject NavigationManager NavMan
@inject IJSRuntime JS
@implements IDisposable
@rendermode InteractiveServer

<div class="dx-card" style="display:flex; flex-direction:column; height:100%;">
    <div class="dx-tab-nav" style="border-radius:0; overflow:hidden;">
        <button class="dx-tab-btn @(activeDeviceSubTab == "devices" ? "active" : "")"
                @onclick="@(() => activeDeviceSubTab = "devices")">Device Management</button>
        <button class="dx-tab-btn @(activeDeviceSubTab == "screenshots" ? "active" : "")"
                @onclick="@(() => activeDeviceSubTab = "screenshots")">Screenshots</button>
        <button class="dx-tab-btn @(activeDeviceSubTab == "models" ? "active" : "")"
                @onclick="@(() => activeDeviceSubTab = "models")">Model Configuration</button>
        <button class="dx-tab-btn @(activeDeviceSubTab == "settings" ? "active" : "")"
                @onclick="@(() => { activeDeviceSubTab = "settings"; _ = LoadDeviceSettings(); })">Settings</button>
    </div>
    @if (activeDeviceSubTab == "devices")
    {
    <div class="dx-panel-header">
        <h4>Device Management</h4>
        <div class="dx-panel-controls">
            <input @bind="searchFilter" @bind:event="oninput" @onkeyup="OnSearchChanged"
                   class="dx-search-input"
                   placeholder="Search devices..." />

            @* Column visibility dropdown *@
            <div class="dx-column-dropdown-wrapper">
                <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="ToggleColumnDropdown" @onclick:stopPropagation="true">
                    Columns
                </button>
                @if (showColumnDropdown)
                {
                    <div class="dx-column-dropdown">
                        @foreach (var col in allColumns)
                        {
                            <label class="dx-column-option">
                                <input type="checkbox" class="dx-checkbox" checked="@columnOrder.Contains(col.Key)"
                                       @onchange="() => ToggleColumn(col.Key)" />
                                @col.Value
                            </label>
                        }
                    </div>
                }
            </div>

            <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="SaveDeviceView">
                Save View
            </button>
            <button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="ResetDeviceView">
                Reset View
            </button>
            <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="LoadDevices">
                Refresh
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="position:relative; min-height:120px;">
            <div class="dx-loading-overlay"><div class="dx-spinner"></div></div>
        </div>
    }
    else if (FilteredDevices?.Any() == true)
    {
        <div class="dx-panel-content">
            <div class="dx-table dx-sticky-first" style="min-width:max-content; @GetColumnVars()">
                <div class="dx-table-header" style="@GetGridStyle()">
                    @foreach (var col in columnOrder)
                    {
                        var label = allColumns.GetValueOrDefault(col, col);
                        var isSortable = sortableColumns.Contains(col);
                        var resizeCol = col;
                        <div draggable="true"
                             class="@(draggedColumn == col ? "dragging" : "") @(dragOverColumn == col ? "drag-over" : "")"
                             @ondragstart="() => OnColumnDragStart(col)"
                             @ondragover:preventDefault
                             @ondragover="() => OnColumnDragOver(col)"
                             @ondrop="() => OnColumnDrop(col)"
                             @ondragend="OnColumnDragEnd"
                             role="@(isSortable ? "button" : "")"
                             @onclick="() => { if (isSortable) SetSort(col); }"
                             style="@(col == "status" || col == "contentHealth" ? "text-align:center;" : "")">
                            @label @(isSortable ? SortCaret(col) : "")
                            <span class="dx-col-resize"
                                  data-resize-col="@col"
                                  title="Drag to resize"
                                  @onpointerdown="@(e => StartColumnResize(e, resizeCol))"
                                  @onpointerdown:stopPropagation="true"
                                  @onclick:stopPropagation="true"></span>
                        </div>
                    }
                </div>
                @foreach (var d in FilteredDevices)
                {
                    var isOnline = IsOnline(d.Heartbeat);
                    <div class="dx-table-row" style="@GetGridStyle()">
                        @foreach (var col in columnOrder)
                        {
                            @RenderCell(d, col, isOnline)
                        }
                    </div>
                }
            </div>
        </div>
        <div class="dx-text-muted" style="padding:8px 20px; font-size:0.85rem;">
            Showing @FilteredDevices.Count() of @(devices?.Count ?? 0) devices
        </div>
    }
    else
    {
        <div style="text-align:center; padding:40px 20px;">
            <h5>No devices found</h5>
            <p class="dx-text-muted">No devices have registered with this Director instance.</p>
        </div>
    }
    }
    else if (activeDeviceSubTab == "screenshots")
    {
        <DeviceScreenshotsTab />
    }
    else if (activeDeviceSubTab == "models")
    {
        <DeviceModelConfigTab />
    }
    else if (activeDeviceSubTab == "settings")
    {
        <div class="dx-panel-header">
            <h4>Device Settings</h4>
        </div>
        <div class="dx-panel-content" style="max-width:640px;">
            <h5>Playback</h5>
            <div class="dx-form-row" style="align-items:flex-start;">
                <div style="flex:1;">
                    <label class="dx-label">Allow HTTP fallback during initial download</label>
                    <p class="text-muted small mb-0">
                        When enabled, players start displaying content immediately using the original
                        server URLs while assets are being cached locally. Disable this for
                        cloud-hosted deployments where serving the same content twice generates
                        billable egress — players will wait until all files are cached before
                        starting display.
                    </p>
                </div>
                <div style="padding-top:4px;">
                    <input type="checkbox" class="dx-checkbox" @bind="settingAllowHttpFallback" />
                </div>
            </div>
            <div class="mt-3">
                @if (deviceSettingsSaveMessage != null)
                {
                    <span class="@(deviceSettingsSaveError ? "text-danger" : "text-success") small me-3">@deviceSettingsSaveMessage</span>
                }
                <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="SaveDeviceSettings" disabled="@deviceSettingsSaving">
                    @(deviceSettingsSaving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    }
</div>

@* Click-outside handler to close column dropdown *@
@if (showColumnDropdown)
{
    <div class="dx-dropdown-overlay" @onclick="() => showColumnDropdown = false"></div>
}

@if (toastVisible)
{
    <div class="dx-toast">@toastMessage</div>
}

@if (showDeviceSettingsModal && selectedSettingsDevice != null)
{
    <div class="dx-modal-overlay" @onclick="CloseDeviceSettingsModal">
        <div class="dx-modal" style="max-width:700px; width:90%; max-height:85vh; display:flex; flex-direction:column;" @onclick:stopPropagation="true">
            <div class="dx-modal-header">
                <h5 style="margin:0;">Device Settings — @selectedSettingsDevice.DeviceId</h5>
                <button class="dx-modal-close" @onclick="CloseDeviceSettingsModal">×</button>
            </div>
            <div class="dx-modal-body" style="display:flex; flex-direction:column; gap:16px; flex:1; overflow-y:auto;">

                @* Flavour *@
                @if (!string.IsNullOrEmpty(selectedSettingsDevice.Flavour))
                {
                    <div>
                        <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Flavour</div>
                        <div style="display:flex; align-items:center; gap:12px;">
                            <span class="dx-badge dx-badge-blue">@selectedSettingsDevice.Flavour</span>
                            @if (selectedSettingsDevice.FlavourCheck == FlavourState.Mismatched)
                            {
                                <span class="dx-badge dx-badge-yellow">Declares @selectedSettingsDevice.DeclaredFlavour</span>
                            }
                            <div style="margin-left:auto;">
                                <button class="dx-btn dx-btn-gray dx-btn-sm"
                                        title="@(CanClearFlavour(selectedSettingsDevice)
                                                 ? "Return this device to the applet by clearing its flavour"
                                                 : $"This player is still running {selectedSettingsDevice.Flavour}. Move it back to the applet first.")"
                                        disabled="@(!CanClearFlavour(selectedSettingsDevice) || isClearingFlavour)"
                                        @onclick="ClearFlavour">
                                    @(isClearingFlavour ? "Clearing..." : "Clear Flavour")
                                </button>
                            </div>
                        </div>
                        <div class="dx-text-muted" style="font-size:0.8rem; margin-top:8px;">
                            Clearing is the last step of moving a player back to the applet, not the first.
                            A cleared device raises no mismatch and receives no deployments.
                        </div>
                    </div>
                }

                @* Orientation: Engage for BrightSign only. LG and Samsung take their viewport from the panel. *@
                @if (selectedSettingsDevice.Flavour == RecoveryHandlerService.EngageBrightSignPlatformName)
                {
                    <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                        <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Orientation</div>
                        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                            <select class="dx-form-control" style="width:340px;" @bind="editingOrientation"
                                    disabled="@isSavingOrientation">
                                @foreach (var orientation in DeviceOrientation.All)
                                {
                                    <option value="@orientation">@OrientationLabels[orientation]</option>
                                }
                            </select>
                            <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="SaveOrientation"
                                    disabled="@(isSavingOrientation || editingOrientation == selectedSettingsDevice.Orientation)">
                                @(isSavingOrientation ? "Saving…" : "Apply Orientation")
                            </button>
                        </div>
                        <div class="dx-text-muted" style="font-size:0.8rem; margin-top:8px;">
                            Takes effect at the player's next check-in, within a minute. The screen goes blank for about two seconds while it turns.
                        </div>
                    </div>

                    var seamlessSupported = DeviceVideoPath.SupportsPage(selectedSettingsDevice.Model);
                    var seamlessOn = selectedSettingsDevice.VideoPath == DeviceVideoPath.Page && seamlessSupported;
                    <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                        <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Video Transitions</div>
                        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                            <label class="dx-toggle" title="@(seamlessSupported ? "Seamless transitions between clips" : $"Not available on {selectedSettingsDevice.Model}")">
                                <input type="checkbox" checked="@seamlessOn" disabled="@(!seamlessSupported || isSavingVideoPath)"
                                       @onchange="@(e => SaveVideoPath((bool)e.Value!))" />
                                <span class="dx-toggle-slider"></span>
                            </label>
                            <span style="font-size:0.9rem;">
                                @(isSavingVideoPath ? "Saving..." : seamlessOn ? "Seamless transitions" : "Standard transitions")
                            </span>
                            @if (!seamlessSupported)
                            {
                                <span class="dx-badge dx-badge-gray">Not available on @selectedSettingsDevice.Model</span>
                            }
                        </div>
                        <div class="dx-text-muted" style="font-size:0.8rem; margin-top:8px;">
                            @if (seamlessSupported)
                            {
                                <text>Cuts straight from one clip to the next with no black frame. For Full HD content; leave off for 4K. Applies from the next clip after the player checks in.</text>
                            }
                            else
                            {
                                <text>This model always plays video on its hardware video layer, so there is a brief dark moment between clips.</text>
                            }
                        </div>
                    </div>
                }

                @* Console Logging *@
                <div>
                    <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Console Logging</div>
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                        <label class="dx-toggle" title="@(consoleLoggingEnabled ? "Disable logging" : "Enable logging")">
                            <input type="checkbox" checked="@consoleLoggingEnabled"
                                   @onchange="@(e => ToggleConsoleLogging((bool)e.Value!))"
                                   disabled="@isTogglingConsoleLogging" />
                            <span class="dx-toggle-slider"></span>
                        </label>
                        <span class="dx-text-muted" style="font-size:0.9rem;">
                            @(isTogglingConsoleLogging ? "Saving..." : consoleLoggingEnabled ? "Logging enabled" : "Logging disabled")
                        </span>
                        <div style="margin-left:auto; display:flex; gap:8px;">
                            <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="RefreshConsoleLogs" disabled="@isLoadingConsoleLogs">
                                @(isLoadingConsoleLogs ? "Refreshing..." : "Refresh")
                            </button>
                            <button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="ClearConsoleLogs"
                                    disabled="@(consoleLogs.Count == 0 || isClearingConsoleLogs)">
                                @(isClearingConsoleLogs ? "Clearing..." : "Clear Logs")
                            </button>
                        </div>
                    </div>
                    <div style="flex:1; overflow-y:auto; background:#1e1e1e; border-radius:6px; padding:10px; font-family:monospace; font-size:0.8rem; min-height:200px; max-height:300px;">
                        @if (consoleLogs.Count == 0)
                        {
                            <div style="color:#888; padding:20px; text-align:center;">
                                @(consoleLoggingEnabled ? "No logs yet — logs will appear after the next sync cycle." : "Enable logging above to start capturing console output.")
                            </div>
                        }
                        else
                        {
                            @foreach (var entry in consoleLogs)
                            {
                                var levelColor = entry.Level switch {
                                    "error" => "#f88",
                                    "warn"  => "#fd8",
                                    _ => "#aaa"
                                };
                                var msgColor = entry.Level switch {
                                    "error" => "#fcc",
                                    "warn"  => "#ffe",
                                    _ => "#eee"
                                };
                                <div style="display:flex; gap:8px; margin-bottom:3px; line-height:1.4;">
                                    <span style="color:#666; white-space:nowrap;">@entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                                    <span style="color:@levelColor; white-space:nowrap; font-weight:600;">[@entry.Level.ToUpper()]</span>
                                    <span style="color:@msgColor; word-break:break-all;">@entry.Message</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                @* Video Settings — temporarily hidden. Restore by changing the guard back to
                   (selectedSettingsDevice.EngageBadge == "Engage"); SignageOS devices only. *@
                @if (false)
                {
                    <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                        <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Video Settings</div>
                        <div style="display:flex; align-items:center; gap:12px;">
                            <label class="dx-toggle" title="Force HTML5 video instead of native SOS API">
                                <input type="checkbox" checked="@forceHtml5Video"
                                       @onchange="@(e => SaveVideoMode((bool)e.Value!))"
                                       disabled="@isSavingVideoMode" />
                                <span class="dx-toggle-slider"></span>
                            </label>
                            <div>
                                <div style="font-size:0.9rem;">@(isSavingVideoMode ? "Saving..." : forceHtml5Video ? "HTML5 video (forced)" : "Native SOS video (default)")</div>
                                <div style="font-size:0.8rem; color:var(--dx-text-muted);">Force HTML5 video path — use when native SOS video freezes on loop (common on WebOS/Tizen)</div>
                            </div>
                        </div>
                    </div>
                }

                @* Window Mode — Avalonia thick-client players only *@
                @if (selectedSettingsDevice?.ClientPlatform == "avalonia" && windowModeSettings != null)
                {
                    <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                        <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Window Mode</div>

                        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px; flex-wrap:wrap;">
                            <label class="dx-label" style="min-width:80px;">Mode</label>
                            <select class="dx-form-control" style="width:190px;"
                                    @bind="windowModeSettings.Mode">
                                <option value="fullscreen">Fullscreen</option>
                                <option value="windowed">Windowed</option>
                                <option value="borderless">Borderless Windowed</option>
                            </select>
                        </div>

                        @if (windowModeSettings.Mode is "windowed" or "borderless")
                        {
                            <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px; flex-wrap:wrap;">
                                <label class="dx-label" style="min-width:80px;">Position</label>
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <span class="dx-text-muted" style="font-size:0.85rem;">X</span>
                                    <input type="number" class="dx-form-control" style="width:80px;"
                                           @bind="windowModeSettings.X" placeholder="0" />
                                    <span class="dx-text-muted" style="font-size:0.85rem;">Y</span>
                                    <input type="number" class="dx-form-control" style="width:80px;"
                                           @bind="windowModeSettings.Y" placeholder="0" />
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px; flex-wrap:wrap;">
                                <label class="dx-label" style="min-width:80px;">Resolution</label>
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <input type="number" class="dx-form-control" style="width:80px;"
                                           @bind="windowModeSettings.Width" placeholder="1920" />
                                    <span class="dx-text-muted">×</span>
                                    <input type="number" class="dx-form-control" style="width:80px;"
                                           @bind="windowModeSettings.Height" placeholder="1080" />
                                </div>
                            </div>
                        }

                        <div style="display:flex; align-items:center; gap:12px;">
                            <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="SaveWindowMode"
                                    disabled="@isSavingWindowMode">
                                @(isSavingWindowMode ? "Saving…" : "Apply Window Mode")
                            </button>
                            <span class="dx-text-muted" style="font-size:0.8rem;">
                                Takes effect on the player's next sync (up to 30 seconds).
                            </span>
                        </div>
                    </div>
                }

                <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                    <DXSuite.Director.Components.DeviceMetadata.DeviceMetadataSection DeviceId="@selectedSettingsDevice.DeviceId"
                                                                                  LocationId="@selectedSettingsDevice.LocationId" />
                </div>

                @* Cache Management *@
                <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                    <div style="font-weight:600; margin-bottom:8px; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Cache Management</div>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="QueueFlushCache" disabled="@(isFlushingCache || flushCacheQueued)">
                            @if (isFlushingCache)
                            {
                                <span>Queuing…</span>
                            }
                            else if (flushCacheQueued)
                            {
                                <span>✓ Flush queued</span>
                            }
                            else
                            {
                                <span>Flush Cache</span>
                            }
                        </button>
                        <div style="font-size:0.8rem; color:var(--dx-text-muted);">
                            Clears all locally cached media on the device. Takes effect on the next sync heartbeat (up to 30 seconds).
                        </div>
                    </div>
                </div>

                @* Command History *@
                <div style="border-top:1px solid var(--dx-border); padding-top:16px;">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                        <div style="font-weight:600; font-size:0.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--dx-text-muted);">Recent Commands</div>
                        <button class="dx-btn dx-btn-gray dx-btn-sm" @onclick="LoadCommandHistory" disabled="@isLoadingCommandHistory">
                            @(isLoadingCommandHistory ? "Loading…" : "Refresh")
                        </button>
                    </div>
                    @if (commandHistory == null || commandHistory.Count == 0)
                    {
                        <div style="font-size:0.8rem; color:var(--dx-text-muted);">No commands recorded for this device.</div>
                    }
                    else
                    {
                        <table class="dx-table" style="font-size:0.8rem;">
                            <thead>
                                <tr>
                                    <th>Command</th>
                                    <th>Status</th>
                                    <th>Issued</th>
                                    <th>By</th>
                                    <th>Delivered</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cmd in commandHistory)
                                {
                                    <tr>
                                        <td>@FormatCommandType(cmd)</td>
                                        <td>@cmd.Status</td>
                                        <td title="@cmd.IssuedAt UTC">@cmd.IssuedAt.ToLocalTime().ToString("g")</td>
                                        <td>@(cmd.IssuedBy ?? "-")</td>
                                        <td>@(cmd.DeliveredAt?.ToLocalTime().ToString("g") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    private string activeDeviceSubTab = "devices";

    // Device Settings tab state
    private bool settingAllowHttpFallback = true;
    private bool deviceSettingsSaving;
    private string? deviceSettingsSaveMessage;
    private bool deviceSettingsSaveError;
    private List<DeviceRow>? devices;
    private string searchFilter = "";
    private bool isLoading = true;
    private string sortColumn = "id";
    private bool sortAsc = true;
    private bool showColumnDropdown;
    private string? editingTimeZoneDeviceId;
    private string editingTimeZoneValue = "";
    private string? editingSiteDeviceId;
    private string editingSiteValue = "";
    private List<TblSite> sites = new();

    // Inline editing — description
    private string? editingDeviceId;
    private string editingValue = "";

    // Inline editing — name
    private string? editingNameDeviceId;
    private string editingNameValue = "";

    // Column system
    private static readonly string[] DefaultColumnOrder = ["status", "deviceId", "model", "name", "description", "serial", "ip", "lastSeen", "contentSync", "timeZone"];

    private List<string> columnOrder = new(DefaultColumnOrder);

    private static readonly Dictionary<string, string> allColumns = new()
    {
        ["status"] = "Status",
        ["deviceId"] = "Device ID",
        ["name"] = "Name",
        ["description"] = "Description",
        ["manufacturer"] = "Manufacturer",
        ["model"] = "Model",
        ["serial"] = "Serial",
        ["ip"] = "IP Address",
        ["lastSeen"] = "Heartbeat",
        ["contentSync"] = "Content Sync",
        ["timeZone"] = "Time Zone",
        ["timeZoneSource"] = "Zone Set By",
        ["timeZoneCheck"] = "Zone Check",
        ["site"] = "Site",
        ["city"] = "City",
        ["state"] = "State",
        ["contentHealth"] = "Content",
        ["browser"] = "Browser",
        ["clientVersion"] = "Version",
        ["platform"] = "Flavour",
        ["settings"] = "Settings",
    };

    private static readonly Dictionary<string, string> DefaultColumnWidths = new()
    {
        ["status"] = "60px",
        ["deviceId"] = "150px",
        ["name"] = "180px",
        ["description"] = "200px",
        ["manufacturer"] = "120px",
        ["model"] = "120px",
        ["serial"] = "150px",
        ["ip"] = "120px",
        ["lastSeen"] = "100px",
        ["contentSync"] = "110px",
        ["timeZone"] = "220px",
        ["timeZoneSource"] = "100px",
        ["timeZoneCheck"] = "110px",
        ["site"] = "160px",
        ["city"] = "120px",
        ["state"] = "80px",
        ["contentHealth"] = "80px",
        ["browser"] = "160px",
        ["clientVersion"] = "120px",
        ["platform"] = "150px",
        ["settings"] = "70px",
    };

    // Per-circuit, because a width is a user's own adjustment. Seeded from the defaults and
    // persisted alongside the column order by Save View.
    private Dictionary<string, string> columnWidths = new(DefaultColumnWidths);

