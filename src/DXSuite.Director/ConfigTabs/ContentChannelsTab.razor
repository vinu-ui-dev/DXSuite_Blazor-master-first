    private void ShowToast(string message)
    {
        toastMessage = message;
        toastVisible = true;
        toastTimer?.Dispose();
        toastTimer = new Timer(_ =>
        {
            toastVisible = false;
            _ = InvokeAsync(StateHasChanged);
        }, null, 3000, Timeout.Infinite);
    }

    public void Dispose() => toastTimer?.Dispose();

