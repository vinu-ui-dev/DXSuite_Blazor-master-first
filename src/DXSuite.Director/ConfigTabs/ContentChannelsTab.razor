    private async Task SaveTimelineSettings()
    {
        if (selectedTimelineChannel == null) return;
        timelineSettingsError = null;
        timelineSettingsSuccess = null;
        timelineSettingsSaving = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var channel = await db.TblContentChannels.FindAsync(selectedTimelineChannel.ChannelId);
            if (channel == null) { timelineSettingsError = "Channel not found."; return; }

            JObject root;
            try
            {
                root = string.IsNullOrEmpty(channel.ExtendedData)
                    ? new JObject()
                    : JObject.Parse(channel.ExtendedData);
            }
            catch { root = new JObject(); }

            root["pixeraTimelineSettings"] = new JObject
            {
                ["controlEnabled"] = timelineControlEnabled,
            };
            channel.ExtendedData = root.ToString(Newtonsoft.Json.Formatting.None);
            await db.SaveChangesAsync();

            timelineSettingsSuccess = "Settings saved.";
        }
        catch (Exception ex)
        {
            timelineSettingsError = $"Save failed: {ex.Message}";
        }
        finally
        {
            timelineSettingsSaving = false;
        }

        StateHasChanged();
    }

    // Timeline control defaults to DISABLED: newly imported timelines must be
    // explicitly opted in before the watchdog will touch their transport.
    private static bool ParseTimelineControlEnabled(string? extendedData)
    {
        if (string.IsNullOrEmpty(extendedData)) return false;
        try
        {
            var root = JObject.Parse(extendedData);
            return (root["pixeraTimelineSettings"] as JObject)?["controlEnabled"]?.Value<bool>() ?? false;
        }
        catch { return false; }
    }

    private void ClosePixeraSettingsModal()
    {
        showPixeraSettingsModal = false;
        selectedSettingsChannel = null;
        availableLayers = new();
        pixeraLayerPaths = new();
        settingsError = null;
        settingsSuccess = null;
        StateHasChanged();
    }

    private async Task SavePixeraSettings()
    {
        if (selectedSettingsChannel == null) return;
        settingsError = null;
        settingsSuccess = null;
        settingsSaving = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var channel = await db.TblContentChannels.FindAsync(selectedSettingsChannel.ChannelId);
            if (channel == null) { settingsError = "Channel not found."; return; }

            // Merge layer settings into ExtendedData, preserving pixeraHandleMap and any other fields
            channel.ExtendedData = MergePixeraLayerSettings(
                channel.ExtendedData, pixeraLayerPaths, pixeraTransportMode, pixeraTransportLoop,
                pixeraTransportEnabled);
            await db.SaveChangesAsync();

            settingsSuccess = "Settings saved.";
        }
        catch (Exception ex)
        {
            settingsError = $"Save failed: {ex.Message}";
        }
        finally
        {
            settingsSaving = false;
        }

        StateHasChanged();
    }

    private static PixeraLayerSettingsData? ParsePixeraLayerSettings(string? extendedData)
    {
        if (string.IsNullOrEmpty(extendedData)) return null;
        try
        {
            var root = JObject.Parse(extendedData);
            var s = root["pixeraLayerSettings"] as JObject;
            if (s == null) return null;

            // Support both the new list format (assignedLayerPaths) and the old single-path format
            // (assignedLayerPath) so existing channel records migrate transparently on next save.
            List<string> paths;
            if (s["assignedLayerPaths"] is JArray arr)
                paths = arr.Select(t => t.ToString()).Where(p => !string.IsNullOrEmpty(p)).ToList();
            else
            {
                var single = s["assignedLayerPath"]?.ToString();
                paths = string.IsNullOrEmpty(single) ? [] : [single];
            }

            return new PixeraLayerSettingsData
            {
                AssignedLayerPaths = paths,
                TransportMode      = s["transportMode"]?.Value<int>() ?? 1,
                TransportLoop      = s["transportLoop"]?.Value<bool>() ?? true,
                TransportEnabled   = s["transportEnabled"]?.Value<bool>() ?? true,
            };
        }
        catch { return null; }
    }

    private static string MergePixeraLayerSettings(
        string? existingExtendedData, List<string> assignedLayerPaths, int transportMode, bool transportLoop,
        bool transportEnabled)
    {
        JObject root;
        try
        {
            root = string.IsNullOrEmpty(existingExtendedData)
                ? new JObject()
                : JObject.Parse(existingExtendedData);
        }
        catch { root = new JObject(); }

        // Omit lastSyncedAt so PixeraLayerSyncService picks up the change immediately.
        // Filter out blank entries the user may have left in the list.
        var filtered = assignedLayerPaths.Where(p => !string.IsNullOrEmpty(p)).ToList();
        root["pixeraLayerSettings"] = new JObject
        {
            ["assignedLayerPaths"] = new JArray(filtered),
            ["transportMode"]      = transportMode,
            ["transportLoop"]      = transportLoop,
            ["transportEnabled"]   = transportEnabled,
        };

        return root.ToString(Newtonsoft.Json.Formatting.None);
    }

    // ── Metadata modal ──────────────────────────────────────────────────────

    private async Task ShowMetadataModal(ChannelRow ch)
    {
        selectedMetadataChannel = ch;
        metadataError = null;
        metadataSuccess = null;
        metadataAddKey = "";
        metadataAddValue = "";
        metadataAddFieldType = "string";
        metadataAddOptions = new();
        engageMetadataRecords = new();
        inkMetadataRecords = new();
        showMetadataModal = true;
        StateHasChanged();

        try
        {
            if (ch.SourceType == "engage" && ch.DeviceId != null)
            {
                metadataDefs = await MetadataDefinitionService.GetAllDefinitionsAsync();
                engageMetadataRecords = await DeviceMetadataService.GetMetadataRecordsAsync(ch.DeviceId);
            }
            else if (ch.SourceType == "ink-folder")
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                inkMetadataRecords = await db.TblContentChannelMetadata
                    .AsNoTracking()
                    .Where(m => m.ChannelId == ch.ChannelId)
                    .OrderBy(m => m.MetadataKey)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            metadataError = $"Failed to load metadata: {ex.Message}";
        }

        StateHasChanged();
    }

    private void CloseMetadataModal()
    {
        showMetadataModal = false;
        selectedMetadataChannel = null;
        engageMetadataRecords = new();
        inkMetadataRecords = new();
        metadataError = null;
        metadataSuccess = null;
        StateHasChanged();
    }

    private void OnMetadataKeyChanged(ChangeEventArgs e)
    {
        metadataAddKey = e.Value?.ToString() ?? "";
        metadataSuccess = null;
        metadataError = null;
        var def = metadataDefs.FirstOrDefault(d => d.MetadataKey == metadataAddKey);
        if (def != null)
        {
            metadataAddFieldType = def.FieldType;
            metadataAddOptions = def.Options;
        }
        else
        {
            metadataAddFieldType = "string";
            metadataAddOptions = new();
        }
        metadataAddValue = "";
    }

    private async Task AddEngageMetadata()
    {
        metadataError = null;
        metadataSuccess = null;
        if (string.IsNullOrWhiteSpace(metadataAddKey)) { metadataError = "Please select a key."; return; }
        if (string.IsNullOrWhiteSpace(metadataAddValue)) { metadataError = "Please enter a value."; return; }
        if (selectedMetadataChannel?.DeviceId == null) return;

        metadataSaving = true;
        StateHasChanged();
        try
        {
            await DeviceMetadataService.SetMetadataAsync(selectedMetadataChannel.DeviceId, metadataAddKey, metadataAddValue);
            engageMetadataRecords = await DeviceMetadataService.GetMetadataRecordsAsync(selectedMetadataChannel.DeviceId);
            metadataAddKey = "";
            metadataAddValue = "";
            metadataAddFieldType = "string";
            metadataAddOptions = new();
            metadataSuccess = "Metadata saved.";
        }
        catch (Exception ex) { metadataError = ex.Message; }
        finally { metadataSaving = false; }
        StateHasChanged();
    }

    private async Task DeleteEngageMetadata(TblDeviceMetadata record)
    {
        metadataError = null;
        metadataSuccess = null;
        try
        {
            await DeviceMetadataService.DeleteMetadataByIdAsync(record.DeviceMetadataId);
            if (selectedMetadataChannel?.DeviceId != null)
                engageMetadataRecords = await DeviceMetadataService.GetMetadataRecordsAsync(selectedMetadataChannel.DeviceId);
            metadataSuccess = $"'{record.MetadataKey}' removed.";
        }
        catch (Exception ex) { metadataError = ex.Message; }
        StateHasChanged();
    }

    private async Task AddInkMetadata()
    {
        metadataError = null;
        metadataSuccess = null;
        if (string.IsNullOrWhiteSpace(metadataAddKey)) { metadataError = "Please enter a key."; return; }
        if (string.IsNullOrWhiteSpace(metadataAddValue)) { metadataError = "Please enter a value."; return; }
        if (selectedMetadataChannel == null) return;

        metadataSaving = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.TblContentChannelMetadata
                .FirstOrDefaultAsync(m => m.ChannelId == selectedMetadataChannel.ChannelId &&
                                          m.MetadataKey == metadataAddKey);
            if (existing != null)
            {
                existing.MetadataValue = metadataAddValue.Trim();
            }
            else
            {
                db.TblContentChannelMetadata.Add(new TblContentChannelMetadata
                {
                    ChannelId     = selectedMetadataChannel.ChannelId,
                    MetadataKey   = metadataAddKey.Trim(),
                    MetadataValue = metadataAddValue.Trim(),
                    CreateDate    = DateTime.UtcNow,
                });
            }
            await db.SaveChangesAsync();

            inkMetadataRecords = await db.TblContentChannelMetadata
                .AsNoTracking()
                .Where(m => m.ChannelId == selectedMetadataChannel.ChannelId)
                .OrderBy(m => m.MetadataKey)
                .ToListAsync();

            metadataAddKey = "";
            metadataAddValue = "";
            metadataSuccess = "Metadata saved.";
        }
        catch (Exception ex) { metadataError = ex.Message; }
        finally { metadataSaving = false; }
        StateHasChanged();
    }

    private async Task DeleteInkMetadata(TblContentChannelMetadata record)
    {
        metadataError = null;
        metadataSuccess = null;
        if (selectedMetadataChannel == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.TblContentChannelMetadata.FindAsync(record.MetadataId);
            if (entity != null) db.TblContentChannelMetadata.Remove(entity);
            await db.SaveChangesAsync();

            inkMetadataRecords = await db.TblContentChannelMetadata
                .AsNoTracking()
                .Where(m => m.ChannelId == selectedMetadataChannel.ChannelId)
                .OrderBy(m => m.MetadataKey)
                .ToListAsync();

            metadataSuccess = $"'{record.MetadataKey}' removed.";
        }
        catch (Exception ex) { metadataError = ex.Message; }
        StateHasChanged();
    }

