    // ── Location / Display dropdowns ────────────────────────────────────────

    private RenderFragment RenderLocationCell(ChannelRow ch) => __builder =>
    {
        @* Timeline channels carry no content — location/display assignment does not apply *@
        @if (ch.SourceType == "pixera-timeline")
        {
            <div class="dx-col-break" style="padding: 0 8px;">
                <span class="dx-text-muted" style="font-size:0.85rem;">—</span>
            </div>
            return;
        }
        <div class="dx-col-break" style="padding: 0 8px;">
            <select class="dx-form-control dx-cell-select"
                    value="@ch.LocationId?.ToString()"
                    @onchange="async e => await OnLocationChanged(ch, e)">
                <option value="">— None —</option>
                @if (allLocations != null)
                {
                    @foreach (var loc in allLocations)
                    {
                        <option value="@loc.LocationId">@loc.LocationName</option>
                    }
                }
            </select>
        </div>
    };

    private RenderFragment RenderDisplayCell(ChannelRow ch) => __builder =>
    {
        <div class="dx-col-break" style="padding: 0 8px;">
            @if (ch.SourceType == "pixera-timeline")
            {
                <span class="dx-text-muted" style="font-size:0.85rem;">—</span>
            }
            else if (ch.LocationId.HasValue && IsLinkedToDisplay(ch.LocationId))
            {
                <select class="dx-form-control dx-cell-select"
                        value="@ch.DisplayId?.ToString()"
                        @onchange="async e => await OnDisplayChanged(ch, e)">
                    <option value="">— None —</option>
                    @foreach (var disp in GetDisplaysForLocation(ch.LocationId.Value))
                    {
                        <option value="@disp.DisplayId">@disp.DisplayName</option>
                    }
                </select>
            }
            else
            {
                <span class="dx-text-muted" style="font-size:0.85rem;">—</span>
            }
        </div>
    };

    private bool IsLinkedToDisplay(int? locationId)
    {
        if (!locationId.HasValue) return false;
        var loc = allLocations?.FirstOrDefault(l => l.LocationId == locationId.Value);
        return loc?.LocationType?.LinkedToDisplay == true;
    }

    private List<TblDisplay> GetDisplaysForLocation(int locationId) =>
        allDisplays?.Where(d => d.LocationId == locationId).ToList() ?? new();

    private async Task OnLocationChanged(ChannelRow ch, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? newLocationId = string.IsNullOrEmpty(raw) ? null : int.Parse(raw);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var channel = await db.TblContentChannels.FindAsync(ch.ChannelId);
            if (channel != null)
            {
                channel.LocationId = newLocationId;
                channel.DisplayId  = null;

                // Write-through: TblDevice.LocationId drives SignageController and access control
                if (channel.DeviceId != null)
                {
                    var device = await db.TblDevices.FirstOrDefaultAsync(d => d.DeviceId == channel.DeviceId);
                    if (device != null)
                    {
                        device.LocationId = newLocationId;
                        device.DisplayId  = null;
                    }
                }

                await db.SaveChangesAsync();
            }

            ch.LocationId  = newLocationId;
            ch.LocationName = allLocations?.FirstOrDefault(l => l.LocationId == newLocationId)?.LocationName;
            ch.DisplayId   = null;
            ch.DisplayName = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving location for channel {ch.ChannelId}: {ex.Message}");
        }
    }

    private async Task OnDisplayChanged(ChannelRow ch, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? newDisplayId = string.IsNullOrEmpty(raw) ? null : int.Parse(raw);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var channel = await db.TblContentChannels.FindAsync(ch.ChannelId);
            if (channel != null)
            {
                channel.DisplayId = newDisplayId;

                if (channel.DeviceId != null)
                {
                    var device = await db.TblDevices.FirstOrDefaultAsync(d => d.DeviceId == channel.DeviceId);
                    if (device != null)
                        device.DisplayId = newDisplayId;
                }

                await db.SaveChangesAsync();
            }

            ch.DisplayId  = newDisplayId;
            ch.DisplayName = allDisplays?.FirstOrDefault(d => d.DisplayId == newDisplayId)?.DisplayName;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving display for channel {ch.ChannelId}: {ex.Message}");
        }
    }

    // ── Pixera Settings modal ───────────────────────────────────────────────

    private void OnLayerPathChanged(int index, ChangeEventArgs e)
    {
        if (index < pixeraLayerPaths.Count)
            pixeraLayerPaths[index] = e.Value?.ToString() ?? "";
    }

    private void AddLayerPath() => pixeraLayerPaths.Add("");

    private void RemoveLayerPath(int index)
    {
        if (index >= 0 && index < pixeraLayerPaths.Count)
            pixeraLayerPaths.RemoveAt(index);
    }

    private async Task ShowPixeraSettingsModal(ChannelRow ch)
    {
        selectedSettingsChannel = ch;
        settingsError = null;
        settingsSuccess = null;
        showPixeraSettingsModal = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Load all layer channels to populate the dropdown grouped by connector
            var layerChannels = await db.TblContentChannels
                .AsNoTracking()
                .Where(c => c.SourceType == "pixera-layer")
                .OrderBy(c => c.ConnectorId).ThenBy(c => c.Name)
                .ToListAsync();

            var connectorIdSet = layerChannels
                .Where(l => l.ConnectorId.HasValue)
                .Select(l => l.ConnectorId!.Value)
                .Distinct()
                .ToList();
            var connectorNames = connectorIdSet.Count > 0
                ? await db.TblCloudPlatformConnectors
                    .AsNoTracking()
                    .Where(c => connectorIdSet.Contains(c.ConnectorId))
                    .ToDictionaryAsync(c => c.ConnectorId, c => c.DisplayName)
                : new Dictionary<int, string>();

            availableLayers = layerChannels.Select(l => new LayerOption
            {
                ExternalId    = l.ExternalId ?? "",
                Name          = l.Name,
                ConnectorId   = l.ConnectorId ?? 0,
                ConnectorName = l.ConnectorId.HasValue &&
                                connectorNames.TryGetValue(l.ConnectorId.Value, out var n) ? n : "Unknown"
            }).ToList();

            // Read current settings from the channel's ExtendedData
            var channel = await db.TblContentChannels.FindAsync(ch.ChannelId);
            var settings = ParsePixeraLayerSettings(channel?.ExtendedData);
            pixeraLayerPaths       = settings?.AssignedLayerPaths ?? new();
            pixeraTransportMode    = settings?.TransportMode ?? 1;
            pixeraTransportLoop    = settings?.TransportLoop ?? true;
            pixeraTransportEnabled = settings?.TransportEnabled ?? true;
        }
        catch (Exception ex)
        {
            settingsError = $"Failed to load settings: {ex.Message}";
        }

        StateHasChanged();
    }

