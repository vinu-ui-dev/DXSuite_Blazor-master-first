@* The CoreAPI connection settings tab (CAPI-10): the key page and, for a tenant with the Flight Data Editor, the
   editor's instance-wide field settings (FDE-01). *@
@using DXSuite.Shared.Authorization
@using DXSuite.Shared.Multitenancy
@inject ITenantContext tenantContext
@inject ICoreApiSettingsStore coreApiSettings

@* Tab bar on desktop; the select replaces it below the tablet breakpoint *@
<div class="dx-tab-nav dx-tab-nav-collapsible">
    @foreach (var tab in tabs) {
        <button class="dx-tab-btn @(activeTab == tab.Key ? "active" : "")"
                @onclick="@(() => activeTab = tab.Key)">
            @tab.Label
        </button>
    }
</div>
<select class="dx-form-control dx-tab-select" @bind="activeTab">
    @foreach (var tab in tabs) {
        <option value="@tab.Key">@tab.Label</option>
    }
</select>

<div>
    @if (activeTab == KeyManagementTab.Key) {
        <CoreAPIKey />
    } else if (activeTab == FieldSettingsTab.Key && flightDataEditorOn) {
        <FlightDataEditorUserSettings NavigateToManagement="@NavigateToManagement" />
    }
</div>

@code {
    private sealed record ConnectionTab(string Key, string Label);

    private static readonly ConnectionTab FieldSettingsTab = new("Settings", "Flight Editor Settings");
    private static readonly ConnectionTab KeyManagementTab = new("CoreApiKey", "API Key Management");

    private List<ConnectionTab> tabs = new();
    private string? activeTab;

    // The field settings belong to the Flight Data Editor, so they follow its tenant flag even if another
    // capability later shows this tab.
    private bool flightDataEditorOn;

    protected override async Task OnInitializedAsync() {
        await SetTabs();
    }

    public async Task NavigateToManagement() {
        activeTab = KeyManagementTab.Key;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> CheckConfig() {
        return (await coreApiSettings.ReadAsync(default))?.IsConfigured == true;
    }

    private async Task SetTabs() {
        flightDataEditorOn = tenantContext.IsPopulated && tenantContext.Features.IsEnabled(nameof(TenantFeatureFlags.FlightDataEditor));

        tabs = new();
        if (flightDataEditorOn) tabs.Add(FieldSettingsTab);
        tabs.Add(KeyManagementTab);

        activeTab = flightDataEditorOn && await CheckConfig() ? FieldSettingsTab.Key : KeyManagementTab.Key;
    }
}
