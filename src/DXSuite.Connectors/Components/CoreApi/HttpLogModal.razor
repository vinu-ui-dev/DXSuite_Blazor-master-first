@using DXSuite.Connectors.Services.CoreApi
@using DXSuite.Connectors.Services.CoreApi.Models
@using DXSuite.Shared.Components
@inject CoreApiClient coreApi
@rendermode InteractiveServer

@if (showDialog) {
    <div class="dx-modal-overlay">
        @*Pop up Div*@
        <div class="dx-modal" style="width:85vw; height:75vh">
            @* Row Layout Div *@
            <div class="dx-modal-header">
                @* row div Flight# and Close button *@
                <span>Http Response Log for User "@apiKeyName"</span>
                <button class="dx-modal-close" type="button" @onclick="() => showDialog = false">&times;</button>
            </div>
            <div class="dx-modal-body">
                <div class="dx-card dx-card-fill" style="box-shadow:none; border:none">
                    <div class="dx-panel-header" style="padding: 0px; justify-content:flex-start">
                        <div class="dx-form-group" style="margin-bottom: 0px;">
                            <div class="item">
                                <div class="dx-form-label">Start Date</div>
                                <input type="date" class="dx-form-control" @bind="startDate" style="width:100%;" />
                            </div>
                        </div>
                        <div class="dx-form-group" style="margin-bottom: 0px;">
                            <div class="item">
                                <div class="dx-form-label">End Date</div>
                                <input type="date" class="dx-form-control" @bind="endDate" style="width:100%;" />
                            </div>
                        </div>
                        <div class="dx-form-group" style="margin-bottom: 0px;">
                            <div class="item" style="align-content:center">
                                <button class="dx-btn dx-btn-blue" @onclick="GetHttpResponseLogs">Refresh</button>
                            </div>
                        </div>
                        <div class="dx-form-group" />
                        <div class="dx-form-group" />
                        <div class="dx-form-group" />
                    </div>
                    <div class="dx-panel-content">
                        <div class="dx-table">
                            @if (!loading) {
                                <div class="dx-table-header" style="grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;">
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden; cursor: pointer; color: @(StatusSort ? "var(--dx-blue)" : "");" @onclick="() => SortByStatus()">Status <span style="display: @(StatusSort ? "inline" : "none");">@(StatusSortByDesc ? "\u25B2" : "\u25BC")</span></div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Requestor IP</div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Request Route</div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Parameters</div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Response Code</div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Response Message</div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Response Time (ms)</div>
                                    <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden; cursor: pointer; color: @(TimeSort ? "var(--dx-blue)" : "");" @onclick="() => SortByTime()">Timestamp <span style="display: @(TimeSort ? "inline" : "none");">@(TimeSortByDesc ? "\u25BC" : "\u25B2")</span></div>
                                </div>
                            }
                            @if (!loading && httpResponseLogs != null) {
                                @foreach (HttpLogEntry responseLog in httpResponseLogs.Skip(paginator.PageSize * (paginator.CurrentPage - 1)).Take(paginator.PageSize)) {
                                    <div class="dx-table-row" style="grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;">
                                        <div>
                                            @if (responseLog.ErrorCode == 200) {
                                                <span class="dx-badge dx-badge-green" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Success</span>
                                            } else {
                                                <span class="dx-badge dx-badge-red" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">Failure</span>
                                            }
                                        </div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">@responseLog.RequestorIp</div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden; color: var(--dx-blue); text-decoration: underline; cursor:help;" title="@responseLog.HttpRequestRoute">@responseLog.HttpRequestRoute</div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden; color: var(--dx-blue); text-decoration: underline; cursor:help;" title="@responseLog.Params">@responseLog.Params</div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">@responseLog.ErrorCode</div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden; color: var(--dx-blue); text-decoration: underline; cursor:help;" title="@responseLog.ErrorMessage">@responseLog.ErrorMessage</div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">@responseLog.ResponseTime.ToString("F2")</div>
                                        <div style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">@responseLog.CreateDate.ToString("h:mm tt M/d/yyyy")</div>
                                    </div>
                                }
                            } else if (loading) {
                                <div class="dx-spinner" style="display: flex; margin: 5px auto; justify-content: center;"></div>
                            }
                        </div>
                    </div>
                    <div class="dx-panel-footer" style="padding: 0px">
                        @if (!loading && httpResponseLogs != null) {
                            <Paginator @ref="paginator" CurrentPage="1" PageSize="20" TotalItems="@httpResponseLogs.Count" Scale="10" OnChanged="() => InvokeAsync(StateHasChanged)" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    public CoreAPIKey? apiKeyPage { get; set; }

    public string? apiKeyID { get; set; }
    public string? apiKeyName { get; set; }
    public List<HttpLogEntry> httpResponseLogs { get; set; } = new();

    public bool showDialog = false;
    public bool loading = false;

    public Paginator paginator { get; set; } = new();

    public DateTime? startDate { get; set; } = null;
    public DateTime? endDate { get; set; } = null;

    public bool TimeSortByDesc = true;
    public bool StatusSortByDesc = true;
    public bool TimeSort = false;
    public bool StatusSort = false;

    public async Task ShowDialog(string apiName) {
        startDate = null;
        endDate = null;
        apiKeyName = apiName;
        loading = true;
        await InvokeAsync(StateHasChanged);
        showDialog = true;
        await GetHttpResponseLogs();
        await InvokeAsync(StateHasChanged);
    }

    public async Task Close() {
        httpResponseLogs = new();
        showDialog = false;
        TimeSort = false;
        StatusSort = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task GetHttpResponseLogs() {
        loading = true;
        await InvokeAsync(StateHasChanged);
        if (apiKeyID != null) {
            httpResponseLogs = (await coreApi.GetResponseLogsAsync(apiKeyID, startDate, endDate, null)).Value!;
        }
        ClearSort();
        TimeSortByDesc = false;
        await SortByTime();
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SortByTime() {
        if (TimeSortByDesc) {
            httpResponseLogs = httpResponseLogs.OrderBy(x => x!.CreateDate).ToList();
        } else {
            httpResponseLogs = httpResponseLogs.OrderByDescending(x => x!.CreateDate).ToList();
            ClearSort();
        }

        TimeSort = true;
        TimeSortByDesc = !TimeSortByDesc;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SortByStatus() {
        if (StatusSortByDesc) {
            httpResponseLogs = httpResponseLogs.OrderBy(x => x!.ErrorCode == 200 ? 0 : 1).ToList();
            ClearSort();
        } else {
            httpResponseLogs = httpResponseLogs.OrderByDescending(x => x!.ErrorCode == 200 ? 0 : 1).ToList();
        }

        StatusSort = true;
        StatusSortByDesc = !StatusSortByDesc;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearSort() {
        TimeSortByDesc = false;
        StatusSortByDesc = true;
        TimeSort = false;
        StatusSort = false;
    }
}
