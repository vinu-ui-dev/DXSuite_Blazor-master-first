@page "/style-guide"
@rendermode InteractiveServer

<PageTitle>DXSuite Style Guide</PageTitle>

<h1 class="mb-2">DXSuite Style Guide</h1>
<p class="dx-text-muted mb-4">Living reference for UI components. All examples render live using the shared design system CSS.</p>

<!-- ============================================================ -->
<!-- COLOR PALETTE -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Color Palette</h2>
    <p class="dx-text-muted">CSS variables defined in <code>dxsuite.css</code> under <code>:root</code>.</p>
    <div class="sg-color-grid">
        <div class="sg-color-swatch" style="background:#0071BC;">
            <span>Blue (Primary)</span>
            <code>#0071BC</code>
            <code>--dx-blue</code>
        </div>
        <div class="sg-color-swatch" style="background:#990000;">
            <span>Red (Danger)</span>
            <code>#990000</code>
            <code>--dx-red</code>
        </div>
        <div class="sg-color-swatch" style="background:#39B54A;">
            <span>Green (Success)</span>
            <code>#39B54A</code>
            <code>--dx-green</code>
        </div>
        <div class="sg-color-swatch" style="background:#FD8204;">
            <span>Orange (Accent)</span>
            <code>#FD8204</code>
            <code>--dx-orange</code>
        </div>
        <div class="sg-color-swatch" style="background:#BBB;color:#333;">
            <span>Gray (Neutral)</span>
            <code>#BBB</code>
            <code>--dx-gray</code>
        </div>
        <div class="sg-color-swatch" style="background:#f0f0f0;color:#333;">
            <span>Background Alt</span>
            <code>#f0f0f0</code>
            <code>--dx-bg-alt</code>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- BUTTONS -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Buttons</h2>
    <p class="dx-text-muted">
        All buttons use the <code>.dx-btn</code> base class plus a variant.
        Avoid Bootstrap <code>.btn-primary</code> / <code>.btn-danger</code> — use the DXSuite classes instead.
    </p>

    <h4>Solid Variants</h4>
    <div class="sg-example">
        <button class="dx-btn dx-btn-blue">Blue (Primary)</button>
        <button class="dx-btn dx-btn-red">Red (Danger)</button>
        <button class="dx-btn dx-btn-green">Green (Success)</button>
        <button class="dx-btn dx-btn-gray">Gray (Neutral)</button>
    </div>
    <pre class="sg-code"><code>&lt;button class="dx-btn dx-btn-blue"&gt;Blue (Primary)&lt;/button&gt;
&lt;button class="dx-btn dx-btn-red"&gt;Red (Danger)&lt;/button&gt;
&lt;button class="dx-btn dx-btn-green"&gt;Green (Success)&lt;/button&gt;
&lt;button class="dx-btn dx-btn-gray"&gt;Gray (Neutral)&lt;/button&gt;</code></pre>

    <h4>Outline Variants</h4>
    <div class="sg-example">
        <button class="dx-btn dx-btn-outline-blue">Outline Blue</button>
        <button class="dx-btn dx-btn-outline-red">Outline Red</button>
    </div>
    <pre class="sg-code"><code>&lt;button class="dx-btn dx-btn-outline-blue"&gt;Outline Blue&lt;/button&gt;
&lt;button class="dx-btn dx-btn-outline-red"&gt;Outline Red&lt;/button&gt;</code></pre>

    <h4>Sizes</h4>
    <div class="sg-example" style="align-items:center;">
        <button class="dx-btn dx-btn-blue dx-btn-sm">Small</button>
        <button class="dx-btn dx-btn-blue">Default</button>
        <button class="dx-btn dx-btn-blue dx-btn-lg">Large</button>
    </div>
    <pre class="sg-code"><code>&lt;button class="dx-btn dx-btn-blue dx-btn-sm"&gt;Small&lt;/button&gt;
&lt;button class="dx-btn dx-btn-blue"&gt;Default&lt;/button&gt;
&lt;button class="dx-btn dx-btn-blue dx-btn-lg"&gt;Large&lt;/button&gt;</code></pre>

    <h4>With Icons</h4>
    <div class="sg-example">
        <button class="dx-btn dx-btn-blue"><i class="bi bi-plus-lg"></i> Add Device</button>
        <button class="dx-btn dx-btn-red"><i class="bi bi-trash"></i> Delete</button>
        <button class="dx-btn dx-btn-green"><i class="bi bi-check-lg"></i> Save</button>
    </div>
    <pre class="sg-code"><code>&lt;button class="dx-btn dx-btn-blue"&gt;&lt;i class="bi bi-plus-lg"&gt;&lt;/i&gt; Add Device&lt;/button&gt;
&lt;button class="dx-btn dx-btn-red"&gt;&lt;i class="bi bi-trash"&gt;&lt;/i&gt; Delete&lt;/button&gt;
&lt;button class="dx-btn dx-btn-green"&gt;&lt;i class="bi bi-check-lg"&gt;&lt;/i&gt; Save&lt;/button&gt;</code></pre>

    <h4>Disabled State</h4>
    <div class="sg-example">
        <button class="dx-btn dx-btn-blue" disabled>Disabled Blue</button>
        <button class="dx-btn dx-btn-red" disabled>Disabled Red</button>
    </div>
    <pre class="sg-code"><code>&lt;button class="dx-btn dx-btn-blue" disabled&gt;Disabled Blue&lt;/button&gt;</code></pre>
</section>

<!-- ============================================================ -->
<!-- BADGES & STATUS -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Badges &amp; Status Indicators</h2>
    <p class="dx-text-muted">Badges for status labels, counts, and inline indicators.</p>

    <h4>Status Badges</h4>
    <div class="sg-example">
        <span class="dx-badge dx-badge-green">Healthy</span>
        <span class="dx-badge dx-badge-yellow">Degraded</span>
        <span class="dx-badge dx-badge-red">Failed</span>
        <span class="dx-badge dx-badge-gray">Unknown</span>
        <span class="dx-badge dx-badge-blue">Info</span>
        <span class="dx-badge dx-badge-orange">Warning</span>
    </div>
    <pre class="sg-code"><code>&lt;span class="dx-badge dx-badge-green"&gt;Healthy&lt;/span&gt;
&lt;span class="dx-badge dx-badge-yellow"&gt;Degraded&lt;/span&gt;
&lt;span class="dx-badge dx-badge-red"&gt;Failed&lt;/span&gt;
&lt;span class="dx-badge dx-badge-gray"&gt;Unknown&lt;/span&gt;
&lt;span class="dx-badge dx-badge-blue"&gt;Info&lt;/span&gt;
&lt;span class="dx-badge dx-badge-orange"&gt;Warning&lt;/span&gt;</code></pre>

    <h4>Pill Badge (Counts)</h4>
    <div class="sg-example">
        <span>Devices <span class="dx-badge-pill">42</span></span>
        <span>Locations <span class="dx-badge-pill">7</span></span>
    </div>
    <pre class="sg-code"><code>Devices &lt;span class="dx-badge-pill"&gt;42&lt;/span&gt;</code></pre>

    <h4>Status Dots</h4>
    <div class="sg-example" style="align-items:center;">
        <span><span class="dx-status-dot dx-status-dot-green"></span> Online</span>
        <span><span class="dx-status-dot dx-status-dot-red"></span> Offline</span>
        <span><span class="dx-status-dot dx-status-dot-yellow"></span> Degraded</span>
        <span><span class="dx-status-dot dx-status-dot-orange"></span> Powered Off</span>
        <span><span class="dx-status-dot dx-status-dot-gray"></span> Unknown</span>
    </div>
    <pre class="sg-code"><code>&lt;span class="dx-status-dot dx-status-dot-green"&gt;&lt;/span&gt; Online
&lt;span class="dx-status-dot dx-status-dot-red"&gt;&lt;/span&gt; Offline</code></pre>
</section>

<!-- ============================================================ -->
<!-- CARDS -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Cards</h2>
    <p class="dx-text-muted">Container pattern for grouped content. Use accent variants for status-linked cards.</p>

    <div class="sg-example" style="flex-direction:column;gap:16px;">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
            <div class="dx-card">
                <div class="dx-card-header">Default Card</div>
                <div class="dx-card-body">Standard card with header, body, and footer sections.</div>
                <div class="dx-card-footer">
                    <button class="dx-btn dx-btn-blue dx-btn-sm">Action</button>
                </div>
            </div>
            <div class="dx-card dx-card-accent-green">
                <div class="dx-card-body">
                    <strong>Connected</strong>
                    <p class="dx-text-muted" style="margin:4px 0 0;">Green left-accent for healthy/connected state.</p>
                </div>
            </div>
            <div class="dx-card dx-card-accent-red">
                <div class="dx-card-body">
                    <strong>Disconnected</strong>
                    <p class="dx-text-muted" style="margin:4px 0 0;">Red left-accent for error/disconnected state.</p>
                </div>
            </div>
        </div>
    </div>
    <pre class="sg-code"><code>&lt;div class="dx-card"&gt;
    &lt;div class="dx-card-header"&gt;Title&lt;/div&gt;
    &lt;div class="dx-card-body"&gt;Content&lt;/div&gt;
    &lt;div class="dx-card-footer"&gt;Footer&lt;/div&gt;
&lt;/div&gt;

&lt;!-- Accent variants: dx-card-accent-green, dx-card-accent-red, dx-card-accent-orange --&gt;
&lt;div class="dx-card dx-card-accent-green"&gt;...&lt;/div&gt;</code></pre>
</section>

<!-- ============================================================ -->
<!-- ASSET CARDS (Playlist / Media) -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Asset Cards</h2>
    <p class="dx-text-muted">Media asset cards used in Playlist, Card, and other location type views. Supports drag-and-drop reordering.</p>

    <h4>Section Layout</h4>
    <div class="dx-section" style="margin-bottom:16px;">
        <div class="dx-section-header">
            <h3 class="dx-section-title">Example Section</h3>
            <div style="display:flex; gap:8px;">
                <button class="dx-btn dx-btn-blue">Action</button>
            </div>
        </div>
        <div class="dx-asset-container">
            <div class="dx-asset-card" style="pointer-events:auto;">
                <div class="dx-play-order">1</div>
                <div class="dx-drag-handle" style="opacity:1;">⋮⋮</div>
                <div class="dx-asset-preview">
                    <h3>Sample Media Asset</h3>
                    <div style="height:100px; background:#eee; display:flex; align-items:center; justify-content:center; color:#999;">Preview</div>
                </div>
                <div class="dx-asset-info">
                    <div style="display:flex; gap:4px; margin-bottom:4px;">
                        <span class="dx-day-badge">Mon</span>
                        <span class="dx-day-badge">Tue</span>
                        <span class="dx-day-badge">Wed</span>
                    </div>
                    <div class="dx-metadata-divider">METADATA</div>
                    <div class="dx-text-muted" style="font-size:0.8rem;">Hotel: 12345</div>
                </div>
            </div>
            <div class="dx-asset-card" style="pointer-events:auto;">
                <div class="dx-play-order">2</div>
                <div class="dx-asset-preview">
                    <h3>Another Asset</h3>
                    <div style="height:100px; background:#eee; display:flex; align-items:center; justify-content:center; color:#999;">Preview</div>
                </div>
                <div class="dx-asset-info">
                    <span class="dx-text-muted" style="font-size:0.8rem;">No schedule</span>
                </div>
            </div>
        </div>
    </div>

    <h4>Key Classes</h4>
    <pre class="sg-code"><code>.dx-section             — Container with background and padding
.dx-section-header      — Flex header with title and action buttons
.dx-section-title       — Section heading (uppercase, bold)
.dx-asset-container     — Wrapping grid of asset cards (gray background)
.dx-asset-card          — Individual media card (300px, draggable)
.dx-play-order          — Circular play order badge (top-left)
.dx-drag-handle         — Drag grip icon (top-right, appears on hover)
.dx-asset-preview       — Card image/preview area
.dx-asset-info          — Card metadata/schedule area
.dx-day-badge           — Day-of-week pill badge
.dx-metadata-divider    — Section divider within card
.dx-readonly-badge      — "VIEW ONLY" overlay badge
.dx-no-media            — Empty state message
.dx-filter-btn          — Content filter dropdown trigger
.dx-filter-menu         — Content filter dropdown menu</code></pre>
</section>

<!-- ============================================================ -->
<!-- TABLES -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Tables (CSS Grid)</h2>
    <p class="dx-text-muted">
        Use the CSS Grid table pattern (<code>.dx-table</code>) for data tables.
        Define column widths via <code>grid-template-columns</code> on both header and rows.
        Avoid Bootstrap <code>.table</code> classes for data grids.
    </p>

    <div class="sg-example" style="flex-direction:column;">
        <div class="dx-table">
            <div class="dx-table-header" style="grid-template-columns: 2fr 1fr 120px 100px;">
                <div>Name</div>
                <div>IP Address</div>
                <div>Platform</div>
                <div>Status</div>
            </div>
            <div class="dx-table-row" style="grid-template-columns: 2fr 1fr 120px 100px;">
                <div>Lobby Display</div>
                <div>192.168.1.10</div>
                <div><span class="dx-badge dx-badge-blue">Engage</span></div>
                <div><span class="dx-badge dx-badge-green">Healthy</span></div>
            </div>
            <div class="dx-table-row" style="grid-template-columns: 2fr 1fr 120px 100px;">
                <div>Conference Room A</div>
                <div>192.168.1.11</div>
                <div><span class="dx-badge dx-badge-orange">Ink</span></div>
                <div><span class="dx-badge dx-badge-yellow">Degraded</span></div>
            </div>
            <div class="dx-table-row" style="grid-template-columns: 2fr 1fr 120px 100px;">
                <div>Wayfinding Kiosk</div>
                <div>192.168.1.12</div>
                <div><span class="dx-badge dx-badge-blue">Engage</span></div>
                <div><span class="dx-badge dx-badge-red">Failed</span></div>
            </div>
        </div>
    </div>
    <pre class="sg-code"><code>&lt;div class="dx-table"&gt;
    &lt;div class="dx-table-header" style="grid-template-columns: 2fr 1fr 120px 100px;"&gt;
        &lt;div&gt;Name&lt;/div&gt;
        &lt;div&gt;IP Address&lt;/div&gt;
        &lt;div&gt;Platform&lt;/div&gt;
        &lt;div&gt;Status&lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="dx-table-row" style="grid-template-columns: 2fr 1fr 120px 100px;"&gt;
        &lt;div&gt;Lobby Display&lt;/div&gt;
        &lt;div&gt;192.168.1.10&lt;/div&gt;
        &lt;div&gt;&lt;span class="dx-badge dx-badge-blue"&gt;Engage&lt;/span&gt;&lt;/div&gt;
        &lt;div&gt;&lt;span class="dx-badge dx-badge-green"&gt;Healthy&lt;/span&gt;&lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;</code></pre>

    <h4 style="margin-top:24px;">Grouped Rows, Inline Edits and Phone Collapse</h4>
    <p class="dx-text-muted">
        A <code>.dx-table-group</code> band heads each group of rows; it spans the full width, so it needs no
        <code>grid-template-columns</code>. Selects inside a row use <code>.dx-form-control-sm</code>, and a note under one uses
        <code>.dx-form-hint</code>. Mark a row edited but not saved with an orange <em>Unsaved</em> badge, and a saved change
        with a blue <em>Overridden</em> badge. Add <code>.dx-collapse</code> so each row becomes a card on phones:
        <code>.dx-collapse-header</code> hides the header, <code>.dx-col-break</code> starts a new line and
        <code>.dx-col-label</code> names a cell once the header is gone, and <code>.dx-cell-actions</code> spaces badges and buttons that share a cell. Keep columns flexible (<code>minmax</code>) and never set
        <code>min-width:max-content</code>, so the table fits without horizontal scroll. Resize the window to see the collapse.
    </p>

    <div class="sg-example" style="flex-direction:column;">
        <div class="dx-table dx-collapse">
            <div class="dx-table-header dx-collapse-header" style="grid-template-columns: minmax(140px, 1.2fr) 90px minmax(150px, 1fr) 160px;">
                <div>Issue type</div>
                <div>Severity</div>
                <div>Level</div>
                <div></div>
            </div>
            <div class="dx-table-group">Engage player</div>
            <div class="dx-table-row dx-collapse-row" style="grid-template-columns: minmax(140px, 1.2fr) 90px minmax(150px, 1fr) 160px;">
                <div class="dx-col-primary">Web content status</div>
                <div class="dx-text-muted">Warning</div>
                <div class="dx-col-break">
                    <label class="dx-col-label">Level</label>
                    <select class="dx-form-control dx-form-control-sm" aria-label="Level">
                        <option>Default (Warning, 2)</option>
                        <option selected>Error, 3</option>
                    </select>
                </div>
                <div class="dx-col-actions dx-cell-actions"><span class="dx-badge dx-badge-orange">Unsaved</span></div>
            </div>
            <div class="dx-table-group">Director</div>
            <div class="dx-table-row dx-collapse-row" style="grid-template-columns: minmax(140px, 1.2fr) 90px minmax(150px, 1fr) 160px;">
                <div class="dx-col-primary">URL missing</div>
                <div class="dx-text-muted">Error</div>
                <div class="dx-col-break">
                    <label class="dx-col-label">Level</label>
                    <select class="dx-form-control dx-form-control-sm" aria-label="Level">
                        <option selected>Warning, 2</option>
                    </select>
                    <div class="dx-form-hint dx-text-orange"><i class="bi bi-exclamation-triangle"></i> A note about this choice</div>
                </div>
                <div class="dx-col-actions dx-cell-actions">
                    <span class="dx-badge dx-badge-blue">Overridden</span>
                    <button class="dx-btn dx-btn-outline-blue dx-btn-sm">Reset</button>
                </div>
            </div>
        </div>
    </div>
    <pre class="sg-code"><code>&lt;div class="dx-table dx-collapse"&gt;
    &lt;div class="dx-table-header dx-collapse-header" style="grid-template-columns: minmax(140px, 1.2fr) 90px minmax(150px, 1fr) 160px;"&gt;...&lt;/div&gt;
    &lt;div class="dx-table-group"&gt;Director&lt;/div&gt;
    &lt;div class="dx-table-row dx-collapse-row" style="grid-template-columns: ...same..."&gt;
        &lt;div class="dx-col-primary"&gt;URL missing&lt;/div&gt;
        &lt;div class="dx-text-muted"&gt;Error&lt;/div&gt;
        &lt;div class="dx-col-break"&gt;
            &lt;label class="dx-col-label"&gt;Level&lt;/label&gt;
            &lt;select class="dx-form-control dx-form-control-sm" aria-label="Level"&gt;...&lt;/select&gt;
            &lt;div class="dx-form-hint dx-text-orange"&gt;&lt;i class="bi bi-exclamation-triangle"&gt;&lt;/i&gt; Note&lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="dx-col-actions dx-cell-actions"&gt;
            &lt;span class="dx-badge dx-badge-blue"&gt;Overridden&lt;/span&gt;
            &lt;button class="dx-btn dx-btn-outline-blue dx-btn-sm"&gt;Reset&lt;/button&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;</code></pre>
</section>

<!-- ============================================================ -->
<!-- TABS -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Tabs</h2>
    <p class="dx-text-muted">Tab navigation with active state. Used in Configuration and multi-section pages.</p>

    <div class="sg-example" style="flex-direction:column;">
        <div class="dx-tab-nav">
            @foreach (var tab in demoTabs)
            {
                <button class="dx-tab-btn @(activeDemoTab == tab ? "active" : "")"
                        @onclick="@(() => activeDemoTab = tab)">
                    @tab
                </button>
            }
        </div>
        <div class="dx-tab-content">
            Content for the <strong>@activeDemoTab</strong> tab.
        </div>
    </div>
    <pre class="sg-code"><code>&lt;div class="dx-tab-nav"&gt;
    &lt;button class="dx-tab-btn active"&gt;Devices&lt;/button&gt;
    &lt;button class="dx-tab-btn"&gt;Locations&lt;/button&gt;
    &lt;button class="dx-tab-btn"&gt;Connectors&lt;/button&gt;
&lt;/div&gt;
&lt;div class="dx-tab-content"&gt;
    Tab content here.
&lt;/div&gt;</code></pre>
</section>

<!-- ============================================================ -->
<!-- FORMS -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Forms</h2>
    <p class="dx-text-muted">Form groups with labels, hints, and validation states.</p>

    <div class="sg-example" style="flex-direction:column;max-width:600px;">
        <div class="dx-form-row">
            <div class="dx-form-group">
                <label class="dx-form-label">Device Name</label>
                <input type="text" class="dx-form-control" placeholder="e.g. Lobby Display" />
            </div>
            <div class="dx-form-group">
                <label class="dx-form-label">IP Address</label>
                <input type="text" class="dx-form-control" placeholder="192.168.1.x" />
            </div>
        </div>
        <div class="dx-form-group">
            <label class="dx-form-label">Platform</label>
            <select class="dx-form-control">
                <option value="">Select a platform...</option>
                <option>Engage</option>
                <option>Ink</option>
                <option>Q-SYS Reflect</option>
            </select>
            <span class="dx-form-hint">Cloud platform this device is managed by.</span>
        </div>
        <div class="dx-form-group">
            <label class="dx-form-label">Description</label>
            <textarea class="dx-form-control" rows="3" placeholder="Optional notes..."></textarea>
        </div>
        <div class="dx-form-group">
            <label class="dx-form-label">Invalid Field Example</label>
            <input type="text" class="dx-form-control invalid" value="bad value" />
            <span class="dx-form-validation">This field is required.</span>
        </div>
    </div>
    <pre class="sg-code"><code>&lt;div class="dx-form-row"&gt;
    &lt;div class="dx-form-group"&gt;
        &lt;label class="dx-form-label"&gt;Device Name&lt;/label&gt;
        &lt;input type="text" class="dx-form-control" placeholder="..." /&gt;
    &lt;/div&gt;
    &lt;div class="dx-form-group"&gt;
        &lt;label class="dx-form-label"&gt;IP Address&lt;/label&gt;
        &lt;input type="text" class="dx-form-control" /&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;div class="dx-form-group"&gt;
    &lt;label class="dx-form-label"&gt;Platform&lt;/label&gt;
    &lt;select class="dx-form-control"&gt;...&lt;/select&gt;
    &lt;span class="dx-form-hint"&gt;Hint text&lt;/span&gt;
&lt;/div&gt;

&lt;!-- Validation state --&gt;
&lt;input class="dx-form-control invalid" /&gt;
&lt;span class="dx-form-validation"&gt;Error message&lt;/span&gt;</code></pre>
</section>

<!-- ============================================================ -->
<!-- TOGGLE SWITCHES -->
<!-- ============================================================ -->
<section class="sg-section">
    <h2>Toggle Switches</h2>
    <p class="dx-text-muted">For boolean settings like enable/disable flags.</p>

    <div class="sg-example" style="align-items:center;">
        <label style="display:flex;align-items:center;gap:8px;">
            <label class="dx-toggle">
                <input type="checkbox" checked="@toggleOn" @onchange="@(() => toggleOn = !toggleOn)" />
                <span class="dx-toggle-slider"></span>
            </label>
            <span>@(toggleOn ? "Enabled" : "Disabled")</span>
        </label>

        <label style="display:flex;align-items:center;gap:8px;margin-left:24px;">
            <label class="dx-toggle">
                <input type="checkbox" />
