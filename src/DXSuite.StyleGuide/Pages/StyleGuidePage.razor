@code {
    private string activeDemoTab = "Devices";
    private string[] demoTabs = ["Devices", "Locations", "Connectors"];

    private bool toggleOn = true;
    private bool dropdownOpen = false;
    private bool modalOpen = false;
    private bool sgGroupCollapsed = false;
    private bool sgOverrideVisible = false;
    private bool sgOverrideSelected = false;

    private void ToggleSgOverride() => sgOverrideVisible = !sgOverrideVisible;

    private void ToggleSgGroup() => sgGroupCollapsed = !sgGroupCollapsed;
    private bool toastVisible = false;
    private System.Threading.Timer? toastTimer;

    private void ShowToast()
    {
        toastVisible = true;
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            toastVisible = false;
            _ = InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        toastTimer?.Dispose();
    }
}

