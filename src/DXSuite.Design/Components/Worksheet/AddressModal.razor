@using DXSuite.Design.Models
@using DXSuite.Design.Services
@inject INetsuiteService NetsuiteService

<div class="dx-modal-overlay" style="z-index:10000">
    <div class="dx-modal" style="min-width:520px;max-width:620px">
        <div class="dx-modal-header">
            <span>@Title</span>
            <button class="dx-modal-close" @onclick="OnClose">&times;</button>
        </div>

        <div class="dx-modal-body">
            @if (_error is not null)
            {
                <div class="dx-alert dx-alert-danger" style="margin-bottom:14px">@_error</div>
            }

            <div class="adm-grid">
                <!-- Label -->
                <div class="dx-form-group adm-full" style="margin-bottom:0">
                    <label class="dx-form-label">Label <span class="adm-req">*</span></label>
                    <input class="dx-form-control" @bind="_label" placeholder="e.g. Main Office" />
                </div>

                <!-- Country -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">Country <span class="adm-req">*</span></label>
                    <select class="dx-form-control" @bind="_countryId">
                        <option value="US">United States</option>
                        <option value="CA">Canada</option>
                        <option value="MX">Mexico</option>
                        <option value="GB">United Kingdom</option>
                        <option value="AU">Australia</option>
                        <option value="DE">Germany</option>
                        <option value="FR">France</option>
                        <option value="JP">Japan</option>
                        <option value="CN">China</option>
                        <option value="IN">India</option>
                        <option value="BR">Brazil</option>
                        <option value="AR">Argentina</option>
                        <option value="AT">Austria</option>
                        <option value="BE">Belgium</option>
                        <option value="CH">Switzerland</option>
                        <option value="CL">Chile</option>
                        <option value="CO">Colombia</option>
                        <option value="CZ">Czech Republic</option>
                        <option value="DK">Denmark</option>
                        <option value="ES">Spain</option>
                        <option value="FI">Finland</option>
                        <option value="GR">Greece</option>
                        <option value="HK">Hong Kong</option>
                        <option value="HU">Hungary</option>
                        <option value="ID">Indonesia</option>
                        <option value="IE">Ireland</option>
                        <option value="IL">Israel</option>
                        <option value="IT">Italy</option>
                        <option value="KR">South Korea</option>
                        <option value="MY">Malaysia</option>
                        <option value="NL">Netherlands</option>
                        <option value="NO">Norway</option>
                        <option value="NZ">New Zealand</option>
                        <option value="PE">Peru</option>
                        <option value="PH">Philippines</option>
                        <option value="PL">Poland</option>
                        <option value="PT">Portugal</option>
                        <option value="RO">Romania</option>
                        <option value="RU">Russia</option>
                        <option value="SA">Saudi Arabia</option>
                        <option value="SE">Sweden</option>
                        <option value="SG">Singapore</option>
                        <option value="TH">Thailand</option>
                        <option value="TR">Turkey</option>
                        <option value="TW">Taiwan</option>
                        <option value="UA">Ukraine</option>
                        <option value="AE">United Arab Emirates</option>
                        <option value="VN">Vietnam</option>
                        <option value="ZA">South Africa</option>
                    </select>
                </div>

                <!-- Phone -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">Phone</label>
                    <input class="dx-form-control" @bind="_phone" placeholder="(555) 000-0000" />
                </div>

                <!-- Attention -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">Attention</label>
                    <input class="dx-form-control" @bind="_attention" placeholder="c/o Name" />
                </div>

                <!-- Addressee -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">Addressee</label>
                    <input class="dx-form-control" @bind="_addressee" placeholder="Company or Person Name" />
                </div>

                <!-- Address 1 -->
                <div class="dx-form-group adm-full" style="margin-bottom:0">
                    <label class="dx-form-label">Address 1 <span class="adm-req">*</span></label>
                    <input class="dx-form-control" @bind="_addr1" placeholder="Street address" />
                </div>

                <!-- Address 2 -->
                <div class="dx-form-group adm-full" style="margin-bottom:0">
                    <label class="dx-form-label">Address 2</label>
                    <input class="dx-form-control" @bind="_addr2" placeholder="Suite, floor, etc." />
                </div>

                <!-- City -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">City <span class="adm-req">*</span></label>
                    <input class="dx-form-control" @bind="_city" />
                </div>

                <!-- State -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">
                        @(_countryId == "US" ? "State" : "State / Province")
                        @if (_stateRequired) { <span class="adm-req">*</span> }
                    </label>
                    @if (_countryId == "US")
                    {
                        <select class="dx-form-control" @bind="_state">
                            <option value="">— Select —</option>
                            <option value="AL">AL – Alabama</option>
                            <option value="AK">AK – Alaska</option>
                            <option value="AZ">AZ – Arizona</option>
                            <option value="AR">AR – Arkansas</option>
                            <option value="CA">CA – California</option>
                            <option value="CO">CO – Colorado</option>
                            <option value="CT">CT – Connecticut</option>
                            <option value="DE">DE – Delaware</option>
                            <option value="DC">DC – District of Columbia</option>
                            <option value="FL">FL – Florida</option>
                            <option value="GA">GA – Georgia</option>
                            <option value="HI">HI – Hawaii</option>
                            <option value="ID">ID – Idaho</option>
                            <option value="IL">IL – Illinois</option>
                            <option value="IN">IN – Indiana</option>
                            <option value="IA">IA – Iowa</option>
                            <option value="KS">KS – Kansas</option>
                            <option value="KY">KY – Kentucky</option>
                            <option value="LA">LA – Louisiana</option>
                            <option value="ME">ME – Maine</option>
                            <option value="MD">MD – Maryland</option>
                            <option value="MA">MA – Massachusetts</option>
                            <option value="MI">MI – Michigan</option>
                            <option value="MN">MN – Minnesota</option>
                            <option value="MS">MS – Mississippi</option>
                            <option value="MO">MO – Missouri</option>
                            <option value="MT">MT – Montana</option>
                            <option value="NE">NE – Nebraska</option>
                            <option value="NV">NV – Nevada</option>
                            <option value="NH">NH – New Hampshire</option>
                            <option value="NJ">NJ – New Jersey</option>
                            <option value="NM">NM – New Mexico</option>
                            <option value="NY">NY – New York</option>
                            <option value="NC">NC – North Carolina</option>
                            <option value="ND">ND – North Dakota</option>
                            <option value="OH">OH – Ohio</option>
                            <option value="OK">OK – Oklahoma</option>
                            <option value="OR">OR – Oregon</option>
                            <option value="PA">PA – Pennsylvania</option>
                            <option value="RI">RI – Rhode Island</option>
                            <option value="SC">SC – South Carolina</option>
                            <option value="SD">SD – South Dakota</option>
                            <option value="TN">TN – Tennessee</option>
                            <option value="TX">TX – Texas</option>
                            <option value="UT">UT – Utah</option>
                            <option value="VT">VT – Vermont</option>
                            <option value="VA">VA – Virginia</option>
                            <option value="WA">WA – Washington</option>
                            <option value="WV">WV – West Virginia</option>
                            <option value="WI">WI – Wisconsin</option>
                            <option value="WY">WY – Wyoming</option>
                            <option value="AS">AS – American Samoa</option>
                            <option value="GU">GU – Guam</option>
                            <option value="MP">MP – Northern Mariana Islands</option>
                            <option value="PR">PR – Puerto Rico</option>
                            <option value="VI">VI – U.S. Virgin Islands</option>
                        </select>
                    }
                    else
                    {
                        <input class="dx-form-control" @bind="_state" placeholder="State or province" />
                    }
                </div>

                <!-- Zip -->
                <div class="dx-form-group" style="margin-bottom:0">
                    <label class="dx-form-label">Zip / Postal Code <span class="adm-req">*</span></label>
                    <input class="dx-form-control" @bind="_zip" placeholder="12345" />
                </div>
            </div>
        </div>

        <div class="dx-modal-footer">
            <button class="dx-btn dx-btn-gray" @onclick="OnClose" disabled="@_saving">Cancel</button>
            <button class="dx-btn dx-btn-blue" @onclick="SaveAsync" disabled="@(!CanSave || _saving)">
                @if (_saving)
                {
                    <span class="adm-spinner"></span>
                    <span>Saving…</span>
                }
                else
                {
                    <span>Save Address</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string CustomerId { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback<NetsuiteAddressEntry> OnCreated { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private bool _saving;
    private string? _error;

    private string _label = "";
    private string _countryId = "US";
    private string? _attention;
    private string? _addressee;
    private string? _phone;
    private string _addr1 = "";
    private string? _addr2;
    private string _city = "";
    private string _state = "";
    private string _zip = "";

    // State is required for US addresses
    private bool _stateRequired => _countryId == "US";

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_label) &&
        !string.IsNullOrWhiteSpace(_addr1) &&
        !string.IsNullOrWhiteSpace(_city) &&
        (!_stateRequired || !string.IsNullOrWhiteSpace(_state)) &&
        !string.IsNullOrWhiteSpace(_zip);

    private async Task SaveAsync()
    {
        if (!CanSave) return;
        _saving = true;
        _error = null;

        try
        {
            var req = new CreateAddressRequest
            {
                Label     = _label.Trim(),
                CountryId = _countryId,
                Attention = string.IsNullOrWhiteSpace(_attention) ? null : _attention.Trim(),
                Addressee = string.IsNullOrWhiteSpace(_addressee) ? null : _addressee.Trim(),
                Phone     = string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
                Addr1     = _addr1.Trim(),
                Addr2     = string.IsNullOrWhiteSpace(_addr2) ? null : _addr2.Trim(),
                City      = _city.Trim(),
                State     = string.IsNullOrWhiteSpace(_state) ? null : _state.Trim(),
                Zip       = _zip.Trim(),
            };

            var result = await NetsuiteService.CreateCustomerAddressAsync(CustomerId, req);
            if (!result.Success)
            {
                _error = result.Error ?? "Unknown error creating address.";
                return;
            }

            // Build a local AddressEntry so the parent can immediately display/select it
            var newEntry = new NetsuiteAddressEntry
            {
                Id       = result.NewAddressId ?? "",
                Label    = req.Label,
                AddrText = BuildAddrText(req),
            };
            await OnCreated.InvokeAsync(newEntry);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string BuildAddrText(CreateAddressRequest r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(r.Addr1)) parts.Add(r.Addr1);
        if (!string.IsNullOrEmpty(r.Addr2)) parts.Add(r.Addr2);
        var cityStateZip = string.Join(", ", new[] { r.City, r.State }.Where(s => !string.IsNullOrEmpty(s)));
        if (!string.IsNullOrEmpty(r.Zip)) cityStateZip += " " + r.Zip;
        if (!string.IsNullOrEmpty(cityStateZip)) parts.Add(cityStateZip);
        return string.Join("\n", parts);
    }
}

<style>
    .adm-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px 20px;
    }

    .adm-full { grid-column: 1 / -1; }

    .adm-req { color: var(--dx-red, #dc3545); font-size: .85em; }

    .adm-spinner {
        display: inline-block;
        width: 12px;
        height: 12px;
        border: 2px solid rgba(255,255,255,.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: adm-spin .7s linear infinite;
        vertical-align: middle;
    }

    @@keyframes adm-spin { to { transform: rotate(360deg); } }
</style>
