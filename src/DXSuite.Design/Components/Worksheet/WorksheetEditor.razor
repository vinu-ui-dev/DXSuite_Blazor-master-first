    /// <summary>Handles item selection from the inline search strip; auto-creates a catalog item if needed.</summary>
    private async Task OnInlineItemSelected(NetsuiteItem item)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var catalogItem = await db.TblDesignCatalogItems
            .FirstOrDefaultAsync(c => c.CustomerId == Tenant.CustomerCode && c.NetsuiteItemId == item.Id);
        if (catalogItem is null)
        {
            catalogItem = new TblDesignCatalogItem
            {
                CustomerId = Tenant.CustomerCode,
                NetsuiteItemId = item.Id,
                SnapshotJson = System.Text.Json.JsonSerializer.Serialize(item),
                LastSyncDate = DateTime.UtcNow,
                Description = item.PurchaseDescription,
                Manufacturer = item.Manufacturer,
                ModelName = item.ItemId,
                Cost = item.Cost,
            };
            db.TblDesignCatalogItems.Add(catalogItem);
            await db.SaveChangesAsync();
        }
        var cost = catalogItem.Cost > 0 ? catalogItem.Cost : item.Cost;
        // Initial margin derived from NetSuite sell price so the worksheet sell matches catalog pricing by default
        var initialMargin = item.Rate > cost && cost > 0 ? Math.Round(1m - cost / item.Rate, 4) : 0m;
        var calc = WorksheetCalculator.ComputeLineItem(cost, 0, initialMargin, 1);
        var catName = catalogItem.CategoryId.HasValue
            ? _categoryDict.GetValueOrDefault(catalogItem.CategoryId.Value, "Uncategorized") : "Uncategorized";
        var (groupId, groupName) = catalogItem.CategoryId.HasValue &&
            _categoryGroupDict.TryGetValue(catalogItem.CategoryId.Value, out var grp)
            ? ((int?)grp.GroupId, grp.GroupName) : ((int?)null, "");
        int? catDefaultGroup = catalogItem.CategoryId.HasValue &&
            _categoryGroupDict.TryGetValue(catalogItem.CategoryId.Value, out var cgr) && cgr.GroupId > 0
            ? cgr.GroupId : null;

        // INSERT immediately so the row has a real DB ID from the start.
        var entity = new TblDesignWorksheetLineItem
        {
            WorksheetId   = WorksheetId,
            CatalogItemId = catalogItem.ItemId,
            Qty           = 1,
            DiscountPct   = 0,
            MarginPct     = initialMargin,
            SortOrder     = (lineItemRows.Count + 1) * 10,
            IsDisabled    = false,
            PrintInPdf    = false,
            CategoryGroupIdOverride = (int?)groupId != catDefaultGroup ? groupId : null,
        };
        db.TblDesignWorksheetLineItems.Add(entity);
        await db.SaveChangesAsync();

        lineItemRows.Add(new LineItemRow(
            entity.LineItemId, catalogItem.ItemId, catalogItem.CategoryId, catName, groupId, groupName,
            catalogItem.CategoryId, // OriginalCategoryId
            "", item.PurchaseDescription, item.Manufacturer, item.ItemId,
            1, cost, 0, initialMargin, calc.DiscCost, calc.SellPrice,
            new Dictionary<int, string>(),
            new Dictionary<int, decimal>(), // OriginalColumnHoursPerUnit — no catalog history yet
            new Dictionary<int, string>())); // OriginalAttrValues — no catalog history yet
        Recalculate();
    }

    /// <summary>Toggles a row's disabled state, which excludes it from calculations and NetSuite push.</summary>
    private async Task OnToggleDisabled(int lineItemId)
    {
        var idx = lineItemRows.FindIndex(r => r.LineItemId == lineItemId);
        if (idx < 0) return;
        var r = lineItemRows[idx];
        lineItemRows[idx] = r with { IsDisabled = !r.IsDisabled };
        Recalculate();
        await PersistLineItemAsync(lineItemId);
    }

