    /// <summary>Updates a line item's category (and derives its group from the catalog) then recalculates.</summary>
    private void UpdateItemCategory((int LineItemId, int? CategoryId) args)
    {
        var idx = lineItemRows.FindIndex(r => r.LineItemId == args.LineItemId);
        if (idx < 0) return;
        var catName = args.CategoryId.HasValue
            ? _categoryDict.GetValueOrDefault(args.CategoryId.Value, "") : "";
        var (groupId, groupName) = args.CategoryId.HasValue &&
            _categoryGroupDict.TryGetValue(args.CategoryId.Value, out var g)
            ? ((int?)g.GroupId, g.GroupName) : ((int?)null, "");
        lineItemRows[idx] = lineItemRows[idx] with
        {
            CategoryId = args.CategoryId,
            CategoryName = catName,
            CategoryGroupId = groupId,
            CategoryGroupName = groupName ?? "",
        };
        Recalculate();
    }

    /// <summary>
    /// Updates a line item's CategoryGroupId independently of the category, allowing the user
    /// to propose a different group assignment for the category entity without changing the category.
    /// </summary>
    private async Task UpdateItemCategoryGroup((int LineItemId, int? GroupId) args)
    {
        var idx = lineItemRows.FindIndex(r => r.LineItemId == args.LineItemId);
        if (idx < 0) return;
        var groupName = args.GroupId.HasValue
            ? (_allCategoryGroups.FirstOrDefault(g => g.CategoryGroupId == args.GroupId.Value)?.Name ?? "")
            : "";
        lineItemRows[idx] = lineItemRows[idx] with
        {
            CategoryGroupId = args.GroupId,
            CategoryGroupName = groupName,
        };
        // Persist the override immediately so it survives any LoadAsync calls (e.g. from row-level saves).
        // Skip attr sync for rows without a real DB ID (shouldn't occur with immediate-persist, but guard defensively).
        if (args.LineItemId > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.TblDesignWorksheetLineItems.FindAsync(args.LineItemId);
            if (entity is not null)
            {
                entity.CategoryGroupIdOverride = args.GroupId;
                await db.SaveChangesAsync();
            }
        }
    }

    /// <summary>Persists a category change to the catalog item entity.</summary>
    private async Task SaveCategoryToItemAsync((int LineItemId, int? CategoryId) args)
    {
        var li = lineItemRows.FirstOrDefault(r => r.LineItemId == args.LineItemId);
        if (li?.CatalogItemId is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var item = await db.TblDesignCatalogItems.FindAsync(li.CatalogItemId.Value);
        if (item is null) return;
        item.CategoryId = args.CategoryId;
        await db.SaveChangesAsync();
        // Update OriginalCategoryId so the row is no longer dirty
        var idx = lineItemRows.FindIndex(r => r.LineItemId == args.LineItemId);
        if (idx >= 0) lineItemRows[idx] = lineItemRows[idx] with { OriginalCategoryId = args.CategoryId };
    }

    /// <summary>Persists a category group change to the category entity itself.</summary>
    private async Task SaveCatGroupToCategoryAsync((int LineItemId, int? GroupId) args)
    {
        var li = lineItemRows.FirstOrDefault(r => r.LineItemId == args.LineItemId);
        if (li?.CategoryId is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var cat = await db.TblDesignCategories.FindAsync(li.CategoryId.Value);
        if (cat is null) return;
        cat.CategoryGroupId = args.GroupId;
        await db.SaveChangesAsync();
        // Refresh the in-memory dict so future rows reflect the new group.
        _categoryGroupDict[li.CategoryId.Value] = args.GroupId.HasValue
            ? (args.GroupId.Value, _allCategoryGroups.FirstOrDefault(g => g.CategoryGroupId == args.GroupId.Value)?.Name ?? "")
            : (0, "");
        // Update the category object in _allCategories so IsCatGroupDirty reflects the change immediately.
        var catObj = _allCategories.FirstOrDefault(c => c.CategoryId == li.CategoryId.Value);
        if (catObj is not null) catObj.CategoryGroupId = args.GroupId;
    }

