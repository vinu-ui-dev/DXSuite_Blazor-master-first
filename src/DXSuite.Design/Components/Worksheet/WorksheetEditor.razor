    // ── Save to catalog item ─────────────────────────────────────────────────

    /// <summary>
    /// Fires immediately on every column hour cell blur so the labor calculation stays live.
    /// Persists a per-design override row so the edit survives page refresh without touching the
    /// shared catalog item. The catalog item is only written when the user confirms with SaveLabor=true.
    /// </summary>
    private void OnColumnHoursEdited((int LineItemId, int CatalogItemId, Dictionary<int, decimal> PerUnitHours) args)
    {
        var updatedEntries = args.PerUnitHours
            .Where(kv => kv.Value > 0)
            .Select(kv => new TblDesignCatalogItemColumn
                { ItemId = args.CatalogItemId, ColumnId = kv.Key, Hours = kv.Value });
        var otherEntries = itemColumnLookup.SelectMany(g => g)
            .Where(o => o.ItemId != args.CatalogItemId);
        itemColumnLookup = otherEntries.Concat(updatedEntries).ToLookup(o => o.ItemId);

        // Persist worksheet-level overrides asynchronously so they survive refresh
        _ = PersistWorksheetColumnHourOverridesAsync(args.LineItemId, args.PerUnitHours);

        Recalculate();
    }

    /// <summary>Upserts the per-design column hour overrides for a single line item.</summary>
    private async Task PersistWorksheetColumnHourOverridesAsync(int lineItemId, Dictionary<int, decimal> perUnitHours)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // Remove all existing overrides for this line item then reinsert the current values.
            var existing = await db.TblDesignWorksheetLineItemColumnHours
                .Where(h => h.WorksheetId == WorksheetId && h.LineItemId == lineItemId)
                .ToListAsync();
            db.TblDesignWorksheetLineItemColumnHours.RemoveRange(existing);
            foreach (var (colId, hrs) in perUnitHours.Where(kv => kv.Value > 0))
                db.TblDesignWorksheetLineItemColumnHours.Add(new TblDesignWorksheetLineItemColumnHours
                    { WorksheetId = WorksheetId, LineItemId = lineItemId, ColumnId = colId, Hours = hrs });
            await db.SaveChangesAsync();

            // Keep in-memory list in sync
            _worksheetColumnHourOverrides.RemoveAll(h => h.LineItemId == lineItemId);
            _worksheetColumnHourOverrides.AddRange(
                perUnitHours.Where(kv => kv.Value > 0)
                    .Select(kv => new TblDesignWorksheetLineItemColumnHours
                        { WorksheetId = WorksheetId, LineItemId = lineItemId, ColumnId = kv.Key, Hours = kv.Value }));
        }
        catch (Exception ex) { _persistError = ex.Message; }
    }

    /// <summary>
    /// Merges catalog-level and worksheet-level column hour entries into a single lookup.
    /// For any (catalogItemId, columnId) pair that has a per-design override, the worksheet value wins.
    /// </summary>
    private static ILookup<int, TblDesignCatalogItemColumn> MergeWorksheetColumnHourOverrides(
        List<TblDesignCatalogItemColumn> catalogOverrides,
        List<TblDesignWorksheetLineItemColumnHours> worksheetOverrides,
        List<TblDesignWorksheetLineItem> lineItems)
    {
        if (worksheetOverrides.Count == 0)
            return catalogOverrides.ToLookup(o => o.ItemId);

        // Map lineItemId → catalogItemId so worksheet overrides can be projected as catalog entries
        var lineItemToCatalog = lineItems
            .Where(li => li.CatalogItemId.HasValue)
            .ToDictionary(li => li.LineItemId, li => li.CatalogItemId!.Value);

        // Build synthetic catalog column entries from worksheet overrides
        var worksheetCatalogEntries = worksheetOverrides
            .Where(h => lineItemToCatalog.ContainsKey(h.LineItemId))
            .Select(h => new TblDesignCatalogItemColumn
                { ItemId = lineItemToCatalog[h.LineItemId], ColumnId = h.ColumnId, Hours = h.Hours })
            .ToList();

        // Determine which catalogItemIds have worksheet overrides (their catalog entries are fully replaced)
        var overriddenItemIds = worksheetCatalogEntries.Select(e => e.ItemId).ToHashSet();
        var baseEntries = catalogOverrides.Where(o => !overriddenItemIds.Contains(o.ItemId));

        return baseEntries.Concat(worksheetCatalogEntries).ToLookup(o => o.ItemId);
    }

    /// <summary>Persists per-unit column hours and/or attribute values back to the catalog item.</summary>
    private async Task OnSaveToItem((int LineItemId, bool SaveLabor, bool SaveAttrs,
        Dictionary<int, decimal> ColumnHoursPerUnit, Dictionary<int, string> AttrValues) args)
    {
        var row = lineItemRows.FirstOrDefault(r => r.LineItemId == args.LineItemId);
        if (row?.CatalogItemId is null) return;
        var catalogItemId = row.CatalogItemId.Value;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (args.SaveLabor)
        {
            // Replace column hour overrides on the catalog item
            var existing = await db.TblDesignCatalogItemColumns
                .Where(l => l.ItemId == catalogItemId).ToListAsync();
            db.TblDesignCatalogItemColumns.RemoveRange(existing);
            foreach (var (colId, hrs) in args.ColumnHoursPerUnit.Where(kv => kv.Value > 0))
                db.TblDesignCatalogItemColumns.Add(new TblDesignCatalogItemColumn
                    { ItemId = catalogItemId, ColumnId = colId, Hours = hrs });
        }

        if (args.SaveAttrs)
        {
            // Write to catalog item — these become the new defaults for future worksheet rows
            var existingCatalog = await db.TblDesignCatalogItemAttributes
                .Where(a => a.ItemId == catalogItemId).ToListAsync();
            foreach (var e in existingCatalog) db.TblDesignCatalogItemAttributes.Remove(e);
            foreach (var (attrId, val) in args.AttrValues.Where(kv => !string.IsNullOrEmpty(kv.Value)))
                db.TblDesignCatalogItemAttributes.Add(new TblDesignCatalogItemAttribute
                    { ItemId = catalogItemId, AttributeId = attrId, Value = val });

            // Also sync attribute values to the worksheet line item row in DB.
            // Temp rows (negative IDs) haven't been persisted yet, so skip them.
            if (args.LineItemId > 0)
            {
                var existingLineAttrs = await db.TblDesignWorksheetLineItemAttrs
                    .Where(a => a.LineItemId == args.LineItemId).ToListAsync();
                foreach (var e in existingLineAttrs) db.TblDesignWorksheetLineItemAttrs.Remove(e);
                foreach (var (attrId, val) in args.AttrValues.Where(kv => !string.IsNullOrEmpty(kv.Value)))
                    db.TblDesignWorksheetLineItemAttrs.Add(new TblDesignWorksheetLineItemAttr
                        { LineItemId = args.LineItemId, AttributeId = attrId, Value = val });
            }
        }

        await db.SaveChangesAsync();

        // Update in-memory state in place — avoids a full LoadAsync which would re-read the DB and
        // could clobber concurrent in-memory changes (e.g. a category change not yet committed to DB).
        var rowIdx = lineItemRows.FindIndex(r => r.LineItemId == args.LineItemId);
        if (rowIdx >= 0)
        {
            var cur = lineItemRows[rowIdx];

            if (args.SaveLabor)
            {
                // Rebuild the item column lookup so Recalculate() picks up the new hours immediately.
                var updatedColEntries = args.ColumnHoursPerUnit
                    .Where(kv => kv.Value > 0)
                    .Select(kv => new TblDesignCatalogItemColumn
                        { ItemId = catalogItemId, ColumnId = kv.Key, Hours = kv.Value });
                var otherEntries = itemColumnLookup.SelectMany(g => g)
                    .Where(o => o.ItemId != catalogItemId);
                itemColumnLookup = otherEntries.Concat(updatedColEntries).ToLookup(o => o.ItemId);

                lineItemRows[rowIdx] = cur with
                {
                    OriginalColumnHoursPerUnit = (IReadOnlyDictionary<int, decimal>)args.ColumnHoursPerUnit
                };
                cur = lineItemRows[rowIdx];
            }

            if (args.SaveAttrs)
            {
                var savedAttrs = (IReadOnlyDictionary<int, string>)args.AttrValues
                    .Where(kv => !string.IsNullOrEmpty(kv.Value))
                    .ToDictionary(kv => kv.Key, kv => kv.Value);
                lineItemRows[rowIdx] = cur with
                {
                    AttributeValues  = savedAttrs,
                    OriginalAttrValues = savedAttrs,
                };
            }
        }

        if (args.SaveLabor) Recalculate();
    }

    // ── Catalog item selection ────────────────────────────────────────────────

    /// <summary>Handles item selection from the catalog search results in the inline add strip.</summary>
    private async Task OnCatalogItemSelected(TblDesignCatalogItem item)
    {
        var cost = item.Cost;
        var snap = DeserializeSnapshot(item.SnapshotJson);
        if (cost == 0) cost = snap?.Cost ?? 0;
        var rate = snap?.Rate ?? 0;
        var initialMargin = rate > cost && cost > 0 ? Math.Round(1m - cost / rate, 4) : 0m;
        var calc = WorksheetCalculator.ComputeLineItem(cost, 0, initialMargin, 1);
        var catName = item.CategoryId.HasValue
            ? _categoryDict.GetValueOrDefault(item.CategoryId.Value, "Uncategorized") : "Uncategorized";
        var (groupId, groupName) = item.CategoryId.HasValue &&
            _categoryGroupDict.TryGetValue(item.CategoryId.Value, out var grp)
            ? ((int?)grp.GroupId, grp.GroupName) : ((int?)null, "");
        var attrs = item.AttributeValues
            .Where(v => v.Value is not null)
            .ToDictionary(v => v.AttributeId, v => v.Value!);

        // Compute per-unit column hours for this item (uses item column overrides + category defaults)
        var itemColOverridesLookup = item.ColumnOverrides.ToLookup(o => o.ItemId);
        var allColIds = allColumns.Select(c => c.ColumnId).ToList();
        var perUnitColHours = WorksheetCalculator.ComputeItemColumnHours(
            item.ItemId, item.CategoryId, catColumnLookup, itemColOverridesLookup, allColIds);

        int? catDefaultGroup = item.CategoryId.HasValue &&
            _categoryGroupDict.TryGetValue(item.CategoryId.Value, out var cgr) && cgr.GroupId > 0
            ? cgr.GroupId : null;

        // INSERT immediately so the row has a real DB ID from the start.
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = new TblDesignWorksheetLineItem
        {
            WorksheetId   = WorksheetId,
            CatalogItemId = item.ItemId,
            Qty           = 1,
            DiscountPct   = 0,
            MarginPct     = initialMargin,
            SortOrder     = (lineItemRows.Count + 1) * 10,
            IsDisabled    = false,
            PrintInPdf    = false,
            CategoryGroupIdOverride = (int?)groupId != catDefaultGroup ? groupId : null,
        };
        db.TblDesignWorksheetLineItems.Add(entity);
        await db.SaveChangesAsync();

        // Persist any catalog-item attribute values to the new line item row.
        foreach (var (attrId, val) in attrs.Where(kv => !string.IsNullOrEmpty(kv.Value)))
            db.TblDesignWorksheetLineItemAttrs.Add(new TblDesignWorksheetLineItemAttr
                { LineItemId = entity.LineItemId, AttributeId = attrId, Value = val });
        if (attrs.Count > 0) await db.SaveChangesAsync();

        lineItemRows.Add(new LineItemRow(
            entity.LineItemId, item.ItemId, item.CategoryId, catName, groupId, groupName,
            item.CategoryId, // OriginalCategoryId
            "", item.Description ?? "", item.Manufacturer ?? "", item.ModelName ?? "",
            1, cost, 0, initialMargin, calc.DiscCost, calc.SellPrice,
            attrs,
            perUnitColHours,  // OriginalColumnHoursPerUnit
            attrs.ToDictionary(kv => kv.Key, kv => kv.Value), // OriginalAttrValues (copy)
            false)); // PrintInPdf = false for new items
        Recalculate();
    }

    // ── Push to NetSuite ─────────────────────────────────────────────────────

    /// <summary>
    /// Called when the user clicks "Push to NetSuite". Shows the config modal on first push;
    /// skips it when an estimate ID already exists.
    /// </summary>
    private async Task InitiatePushAsync()
    {
        if (pushing) return;
        pushing = true;
        saveMsg = null;

        // Re-push path: estimate already exists, no modal needed
        if (!string.IsNullOrEmpty(worksheet?.NetsuiteEstimateId))
        {
            await DoPushAsync(null);
            return;
        }

        // First push: show the config modal to collect required fields
        _showPushModal = true;
        // pushing remains true so the button stays disabled while modal is open
    }

    /// <summary>
    /// Executes the actual NetSuite push. Called directly on re-push or by the modal on first push.
    /// Assembles all line items in the correct push order: hardware (grouped), misc, labor, travel —
    /// with optional description rows interspersed before each section/group.
    /// </summary>
    private async Task DoPushAsync(EstimateConfig? config)
    {
        _showPushModal = false;
        try
        {
            // Load the NetSuite item IDs for all active catalog items in this worksheet
            var catalogItemIds = lineItemRows
                .Where(r => r.CatalogItemId.HasValue && !r.IsDisabled)
                .Select(r => r.CatalogItemId!.Value).Distinct().ToList();
            await using var db = await DbFactory.CreateDbContextAsync();
            var catalogNsIds = await db.TblDesignCatalogItems
                .Where(i => catalogItemIds.Contains(i.ItemId))
                .ToDictionaryAsync(i => i.ItemId, i => i.NetsuiteItemId ?? "");

            var allPushItems = new List<PushLineItem>();

            // ── 1. Hardware — by CategoryGroup (ungrouped items last) ─────────
            foreach (var grp in lineItemRows
                .Where(r => !r.IsDisabled)
                .GroupBy(r => r.CategoryGroupId ?? 0)
                .OrderBy(g => g.Key == 0 ? int.MaxValue : g.Key))
            {
                var groupId = grp.Key;
                if (groupId != 0 && _groupDescriptions.TryGetValue(groupId, out var gd) &&
                    gd is { IsEnabled: true, LocationId: not null })
                {
                    // "__desc__" is a sentinel; NetsuiteEstimatePusher substitutes the real
                    // NS description item ID (auto-fetched from the account) at push time.
                    // ItemRefName carries the group name so NS shows it in the estimate's item column.
                    var groupName = grp.First().CategoryGroupName;
                    allPushItems.Add(new PushLineItem("__desc__", 0, 0, 0,
                        gd.Description, gd.LocationId, PrintInPdf: true,
                        IsDescriptionItem: true, ItemRefName: groupName));
                }
                foreach (var li in grp.OrderBy(r => r.CategoryName).ThenBy(r => r.LineItemId))
                {
                    var nsId = catalogNsIds.GetValueOrDefault(li.CatalogItemId ?? 0, "");
                    if (string.IsNullOrEmpty(nsId)) continue;
                    var effectiveLoc = li.LocationId ?? worksheet!.DefaultLocationId;
                    allPushItems.Add(new PushLineItem(
                        nsId, li.Qty, li.DiscCost, li.SellPrice,
                        li.Description, effectiveLoc, li.PrintInPdf));
                }
            }

            // Helper: prepend description row then add section items.
            // ItemRefName carries the human-readable section name so NS shows it in the item column.
            void AddSection(string section, string sectionLabel, IEnumerable<PushLineItem> items)
            {
                if (_sectionDescriptions.TryGetValue(section, out var sd) &&
                    sd is { IsEnabled: true, LocationId: not null })
                {
                    allPushItems.Add(new PushLineItem("__desc__", 0, 0, 0,
                        sd.Description, sd.LocationId, PrintInPdf: true,
                        IsDescriptionItem: true, ItemRefName: sectionLabel));
                }
                allPushItems.AddRange(items);
            }

            // ── 2. Materials — each item pushes individually, grouped by category ─
            // Build a lookup of ItemId → catalog item for the items with qty > 0
            var matItemIds = worksheetMaterialsRows.Select(r => r.ItemId).ToHashSet();
            var matCatalogLookup = materialsCatalogItems
                .Where(i => matItemIds.Contains(i.ItemId))
                .ToDictionary(i => i.ItemId);

            foreach (var cat in materialsCatalogCategories)
            {
                var catItems = materialsCatalogItemsByCategory[cat.CategoryId]
                    .Where(i => matItemIds.Contains(i.ItemId))
                    .OrderBy(i => i.SortOrder)
                    .ToList();
                if (catItems.Count == 0) continue;

                // Optional description row before this category's items
                materialsCategoryConfigs.TryGetValue(cat.CategoryId, out var cfg);
                if (cfg is { IsDescEnabled: true, LocationId: not null })
                {
                    allPushItems.Add(new PushLineItem("__desc__", 0, 0, 0,
                        cfg.Description, cfg.LocationId, PrintInPdf: true,
                        IsDescriptionItem: true, ItemRefName: cat.Name));
                }

                foreach (var catItem in catItems)
                {
                    var row = worksheetMaterialsRows.FirstOrDefault(r => r.ItemId == catItem.ItemId);
                    if (row is null || row.Qty == 0) continue;

                    // Use the item's own NS item when available; otherwise fall back to the
                    // category-level NS item and send the item's name as the description override
                    // so the estimator can identify it on the NS estimate line.
                    var nsId = catItem.NetsuiteItemId;
                    var description = catItem.Name;
                    if (string.IsNullOrEmpty(nsId))
                    {
                        if (string.IsNullOrEmpty(cat.NetsuiteItemId)) continue;
                        nsId = cat.NetsuiteItemId;
                    }

                    var matEffectiveLoc = row.LocationId ?? worksheet!.DefaultLocationId;
                    allPushItems.Add(new PushLineItem(
                        nsId, row.Qty, row.Cost, row.SellPrice,
                        description, matEffectiveLoc, cfg?.PrintInPdf ?? false));
                }
            }

            // ── 3. Misc ───────────────────────────────────────────────────────
            AddSection("Misc", "Miscellaneous", miscRows
                .Where(r => !string.IsNullOrEmpty(r.NetsuiteItemId) && r.Qty > 0)
                .Select(r => new PushLineItem(r.NetsuiteItemId!, r.Qty, r.Cost, r.SellPrice,
                    r.Name, r.LocationId ?? worksheet!.DefaultLocationId, r.PrintInPdf)));

            // ── 4. Labor ──────────────────────────────────────────────────────
            // Labor rows with a linked NS item and non-zero estimated hours are pushed
            // as line items — quantity = hours, cost/rate = per-hour rates.
            AddSection("Labor", "Labor", laborRowViews
                .Where(v => !string.IsNullOrEmpty(v.LaborType.NetsuiteItemId))
                .Select(v =>
                {
                    var computed = computedLaborHours.GetValueOrDefault(v.LaborType.LaborTypeId);
                    var hrs = v.Entity.IsOverridden ? v.Entity.OverrideHours : computed;
                    return (v, hrs);
                })
                .Where(x => x.hrs > 0)
                .Select(x => new PushLineItem(
                    x.v.LaborType.NetsuiteItemId!,
                    x.hrs,
                    x.v.LaborType.InternalCostPerHr,
                    x.v.LaborType.InternalPricePerHr,
                    x.v.LaborType.TypeName,
                    x.v.Entity.LocationId ?? worksheet!.DefaultLocationId,
                    x.v.Entity.PrintInPdf)));

            // ── 5. Travel ─────────────────────────────────────────────────────
            AddSection("Travel", "Travel", travelRows
                .Where(r => !string.IsNullOrEmpty(r.NetsuiteItemId) && r.Qty > 0)
                .Select(r => new PushLineItem(r.NetsuiteItemId!, r.Qty, r.Cost, r.SellPrice,
                    r.Name, r.LocationId ?? worksheet!.DefaultLocationId, r.PrintInPdf)));

            var estimateId = await Pusher.PushAsync(WorksheetId, allPushItems, config);
            if (worksheet is not null)
            {
                worksheet.NetsuiteEstimateId = estimateId;
                // Re-read tranId from DB since the Pusher persisted it there.
                await using var db2 = await DbFactory.CreateDbContextAsync();
                var fresh = await db2.TblDesignWorksheets.FindAsync(WorksheetId);
                if (fresh?.NetsuiteEstimateTranId is not null)
                    worksheet.NetsuiteEstimateTranId = fresh.NetsuiteEstimateTranId;
            }
            saveMsg = worksheet?.NetsuiteEstimateTranId is not null
                ? $"Pushed to NetSuite. Estimate: {worksheet.NetsuiteEstimateTranId}"
                : $"Pushed to NetSuite. Estimate ID: {estimateId}";
            saveSuccess = true;
        }
        catch (Exception ex)
        {
            saveMsg = $"Push failed: {ex.Message}";
            saveSuccess = false;
        }
        finally { pushing = false; }
    }

    /// <summary>
    /// Ensures a WorksheetLaborRow exists for every active labor type on this worksheet.
    /// Covers worksheets created before certain labor types existed, or types added later.
    /// </summary>
    private async Task EnsureLaborRowsAsync(DesignDbContext db, List<TblDesignWorksheetLaborRow> existing)
    {
        var existingTypeIds = existing.Select(r => r.LaborTypeId).ToHashSet();
        var added = false;
        foreach (var lt in allLaborTypes)
        {
            if (!existingTypeIds.Contains(lt.LaborTypeId))
            {
                db.TblDesignWorksheetLaborRows.Add(new TblDesignWorksheetLaborRow
                {
                    WorksheetId     = WorksheetId,
                    LaborTypeId     = lt.LaborTypeId,
                    CalculatedHours = 0,
                    OverrideHours   = 0,
                    IsOverridden    = false,
                });
                added = true;
            }
        }
        if (added) await db.SaveChangesAsync();
    }

    /// <summary>
    /// Ensures a LaborCalculatorRow exists for every (active labor type with column assignment) × column pair.
    /// Runs once per worksheet when new columns or labor types are introduced.
    /// </summary>
    private async Task EnsureCalculatorRowsAsync(
        DesignDbContext db,
        List<TblDesignWorksheetLaborCalculatorRow> existing,
        Dictionary<int, List<int>> ltColMap)
    {
        var existingSet = existing.Select(r => (r.LaborTypeId, r.ColumnId)).ToHashSet();
        var added = false;
        foreach (var lt in allLaborTypes.Where(l => !l.IsPercentageOfColumns))
        {
            if (!ltColMap.TryGetValue(lt.LaborTypeId, out var colIds)) continue;
            foreach (var colId in colIds)
            {
                if (!existingSet.Contains((lt.LaborTypeId, colId)))
                {
                    db.TblDesignWorksheetLaborCalculatorRows.Add(new TblDesignWorksheetLaborCalculatorRow
                    {
                        WorksheetId = WorksheetId,
                        LaborTypeId = lt.LaborTypeId,
                        ColumnId = colId,
                        PersonCount = 1,
                    });
                    added = true;
                }
            }
        }
        if (added) await db.SaveChangesAsync();
    }

    private static NetsuiteItem? DeserializeSnapshot(string? json)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try { return System.Text.Json.JsonSerializer.Deserialize<NetsuiteItem>(json); }
        catch { return null; }
    }

