    private async Task UpdateShipping((int LineItemId, string Val) args)
    {
        var idx = lineItemRows.FindIndex(r => r.LineItemId == args.LineItemId);
        if (idx < 0 || _shippingAttrId == 0) return;
        var current = new Dictionary<int, string>(lineItemRows[idx].AttributeValues);
        if (string.IsNullOrEmpty(args.Val)) current.Remove(_shippingAttrId);
        else current[_shippingAttrId] = args.Val;
        lineItemRows[idx] = lineItemRows[idx] with { AttributeValues = current };
        Recalculate();
        await PersistLineItemAttrAsync(args.LineItemId, _shippingAttrId, args.Val);
    }

    private async Task RemoveItem(int lineItemId)
    {
        lineItemRows.RemoveAll(r => r.LineItemId == lineItemId);
        _worksheetColumnHourOverrides.RemoveAll(h => h.LineItemId == lineItemId);
        Recalculate();
        try
        {
            _persistError = null;
            await using var db = await DbFactory.CreateDbContextAsync();
            // Delete worksheet column hour overrides first (FK uses NoAction, no cascade)
            var overrides = await db.TblDesignWorksheetLineItemColumnHours
                .Where(h => h.LineItemId == lineItemId).ToListAsync();
            db.TblDesignWorksheetLineItemColumnHours.RemoveRange(overrides);
            var entity = await db.TblDesignWorksheetLineItems.FindAsync(lineItemId);
            if (entity is not null) db.TblDesignWorksheetLineItems.Remove(entity);
            await db.SaveChangesAsync();
        }
        catch (Exception ex) { _persistError = ex.Message; }
    }

