    private async Task SaveConfigAsync()
    {
        if (string.IsNullOrWhiteSpace(_saveConfigName)) return;
        _showSaveConfigModal = false;

        var dto = new WorksheetConfigDto
        {
            Version = 1,
            LineItems = lineItemRows.Select(li => new ConfigLineItemDto
            {
                CatalogItemId = li.CatalogItemId ?? 0,
                Qty           = li.Qty,
                Disc          = li.DiscountPct,
                Margin        = li.MarginPct,
                SystemName    = li.SystemName,
                PrintInPdf    = li.PrintInPdf,
                LocationId    = li.LocationId,
                LocationName  = li.LocationName,
                // Capture any worksheet-level column hour overrides for this line item
                ColumnHours   = _worksheetColumnHourOverrides
                    .Where(h => h.LineItemId == li.LineItemId)
                    .ToDictionary(h => h.ColumnId.ToString(), h => h.Hours),
            }).Where(d => d.CatalogItemId != 0).ToList(),
            LaborRows = laborRows.Select(r => new ConfigLaborRowDto
            {
                LaborTypeId   = r.LaborTypeId,
                IsOverridden  = r.IsOverridden,
                OverrideHours = r.OverrideHours,
                SubCostPerHr  = r.SubCostPerHr,
                SubPricePerHr = r.SubPricePerHr,
                PrintInPdf    = r.PrintInPdf,
                LocationId    = r.LocationId,
                LocationName  = r.LocationName,
            }).ToList(),
            MiscRows = miscRows.Select(r => new ConfigMiscRowDto
            {
                MiscItemId     = r.MiscItemId,
                NetsuiteItemId = r.NetsuiteItemId,
                Name           = r.Name,
                Description    = r.Description,
                Qty            = r.Qty,
                Cost           = r.Cost,
                SellPrice      = r.SellPrice,
                PrintInPdf     = r.PrintInPdf,
                LocationId     = r.LocationId,
                LocationName   = r.LocationName,
            }).ToList(),
            TravelRows = travelRows.Select(r => new ConfigMiscRowDto
            {
                MiscItemId     = r.MiscItemId,
                NetsuiteItemId = r.NetsuiteItemId,
                Name           = r.Name,
                Description    = r.Description,
                Qty            = r.Qty,
                Cost           = r.Cost,
                SellPrice      = r.SellPrice,
                PrintInPdf     = r.PrintInPdf,
                LocationId     = r.LocationId,
                LocationName   = r.LocationName,
            }).ToList(),
            MaterialsRows = worksheetMaterialsRows.Select(r => new ConfigMaterialsRowDto
            {
                ItemId      = r.ItemId,
                Qty         = r.Qty,
                Cost        = r.Cost,
                SellPrice   = r.SellPrice,
                LocationId  = r.LocationId,
                LocationName= r.LocationName,
            }).ToList(),
            PersonCounts = laborRows.ToDictionary(r => r.LaborTypeId, r => r.PersonCount),
        };

        var json = System.Text.Json.JsonSerializer.Serialize(dto);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.TblDesignWorksheetConfigs.Add(new TblDesignWorksheetConfig
            {
                CustomerId = Tenant.CustomerCode,
                Name       = _saveConfigName.Trim(),
                CreatedBy  = string.Empty,
                ConfigJson = json,
            });
            await db.SaveChangesAsync();
            saveMsg     = $"Config \"{_saveConfigName.Trim()}\" saved.";
            saveSuccess = true;
        }
        catch (Exception ex)
        {
            saveMsg     = $"Failed to save config: {ex.Message}";
            saveSuccess = false;
        }
        _saveConfigName = "";
    }

