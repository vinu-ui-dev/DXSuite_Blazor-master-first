    private async Task InitiateLoadConfigAsync(TblDesignWorksheetConfig config)
    {
        _showLoadConfigModal = false;
        WorksheetConfigDto? dto;
        try { dto = System.Text.Json.JsonSerializer.Deserialize<WorksheetConfigDto>(config.ConfigJson); }
        catch { saveMsg = "Config JSON is invalid."; saveSuccess = false; return; }
        if (dto is null) return;

        // Cross-reference: find any catalog item IDs no longer in this customer's catalog
        var allCatalogItemIds = await GetLiveCatalogItemIdsAsync();
        var allMiscItemIds    = GetLiveMiscItemIds();
        var allLaborTypeIds   = allLaborTypes.Select(lt => lt.LaborTypeId).ToHashSet();
        var allMaterialsItemIds = materialsCatalogItems.Select(i => i.ItemId).ToHashSet();

        var missing = new List<WorksheetConfigMissingItem>();
        foreach (var li in dto.LineItems)
            if (!allCatalogItemIds.Contains(li.CatalogItemId))
                missing.Add(new("Hardware", $"Catalog item #{li.CatalogItemId}"));
        foreach (var lr in dto.LaborRows)
            if (!allLaborTypeIds.Contains(lr.LaborTypeId))
                missing.Add(new("Labor", $"Labor type #{lr.LaborTypeId}"));
        foreach (var mr in dto.MiscRows)
            if (mr.MiscItemId.HasValue && !allMiscItemIds.Contains(mr.MiscItemId.Value))
                missing.Add(new("Misc", mr.Name));
        foreach (var tr in dto.TravelRows)
            if (tr.MiscItemId.HasValue && !allMiscItemIds.Contains(tr.MiscItemId.Value))
                missing.Add(new("Travel", tr.Name));
        foreach (var mat in dto.MaterialsRows)
            if (!allMaterialsItemIds.Contains(mat.ItemId))
                missing.Add(new("Materials", $"Materials item #{mat.ItemId}"));

        _pendingConfigLoad = dto;
        if (missing.Count > 0)
        {
            _conflictConfigName  = config.Name;
            _conflictMissingItems = missing;
            _showConfigConflictModal = true;
        }
        else
        {
            await DoLoadConfigAsync();
        }
    }

    private async Task DoLoadConfigAsync()
    {
        _showConfigConflictModal = false;
        if (_pendingConfigLoad is null) return;
        var dto = _pendingConfigLoad;
        _pendingConfigLoad = null;

        // Build live-catalog lookup sets for filtering
        var allCatalogItemIds   = await GetLiveCatalogItemIdsAsync();
        var allMiscItemIds      = GetLiveMiscItemIds();
        var allLaborTypeIds     = allLaborTypes.Select(lt => lt.LaborTypeId).ToHashSet();
        var allMaterialsItemIds = materialsCatalogItems.Select(i => i.ItemId).ToHashSet();

        try
        {
            _persistError = null;
            await using var db = await DbFactory.CreateDbContextAsync();

            // ── Clear existing worksheet rows ──────────────────────────────
            var existingLineItems = await db.TblDesignWorksheetLineItems
                .Where(l => l.WorksheetId == WorksheetId).ToListAsync();
            // Delete column hour overrides first (NoAction FK; must go before line item delete)
            var existingOverrides = await db.TblDesignWorksheetLineItemColumnHours
                .Where(h => h.WorksheetId == WorksheetId).ToListAsync();
            db.TblDesignWorksheetLineItemColumnHours.RemoveRange(existingOverrides);
            await db.SaveChangesAsync();
            db.TblDesignWorksheetLineItems.RemoveRange(existingLineItems);

            var existingMisc   = await db.TblDesignWorksheetMiscRows  .Where(r => r.WorksheetId == WorksheetId).ToListAsync();
            var existingTravel = await db.TblDesignWorksheetTravelRows .Where(r => r.WorksheetId == WorksheetId).ToListAsync();
            var existingMats   = await db.TblDesignWorksheetMaterialsRows.Where(r => r.WorksheetId == WorksheetId).ToListAsync();
            db.TblDesignWorksheetMiscRows    .RemoveRange(existingMisc);
            db.TblDesignWorksheetTravelRows  .RemoveRange(existingTravel);
            db.TblDesignWorksheetMaterialsRows.RemoveRange(existingMats);
            await db.SaveChangesAsync();

            // ── Insert loaded rows (skipping missing catalog references) ──
            int sortOrder = 10;
            var newColumnHourOverrides = new List<TblDesignWorksheetLineItemColumnHours>();

            foreach (var li in dto.LineItems.Where(l => allCatalogItemIds.Contains(l.CatalogItemId)))
            {
                var entity = new TblDesignWorksheetLineItem
                {
                    WorksheetId   = WorksheetId,
                    CatalogItemId = li.CatalogItemId,
                    Qty           = li.Qty,
                    DiscountPct   = li.Disc,
                    MarginPct     = li.Margin,
                    SystemName    = li.SystemName,
                    SortOrder     = sortOrder,
                    PrintInPdf    = li.PrintInPdf,
                    LocationId    = li.LocationId,
                    LocationName  = li.LocationName,
                };
                db.TblDesignWorksheetLineItems.Add(entity);
                await db.SaveChangesAsync(); // get real LineItemId

                foreach (var (colIdStr, hrs) in li.ColumnHours)
                {
                    if (int.TryParse(colIdStr, out var colId))
                        newColumnHourOverrides.Add(new TblDesignWorksheetLineItemColumnHours
                        {
                            WorksheetId = WorksheetId,
                            LineItemId  = entity.LineItemId,
                            ColumnId    = colId,
                            Hours       = hrs,
                        });
                }
                sortOrder += 10;
            }
            if (newColumnHourOverrides.Count > 0)
            {
                db.TblDesignWorksheetLineItemColumnHours.AddRange(newColumnHourOverrides);
                await db.SaveChangesAsync();
            }

            // Labor rows — update existing (always present from pre-seed), don't insert new ones
            var existingLaborRows = await db.TblDesignWorksheetLaborRows
                .Where(r => r.WorksheetId == WorksheetId).ToListAsync();
            var lrByType = existingLaborRows.ToDictionary(r => r.LaborTypeId);
            foreach (var lr in dto.LaborRows.Where(r => allLaborTypeIds.Contains(r.LaborTypeId)))
            {
                if (lrByType.TryGetValue(lr.LaborTypeId, out var entity))
                {
                    entity.IsOverridden  = lr.IsOverridden;
                    entity.OverrideHours = lr.OverrideHours;
                    entity.SubCostPerHr  = lr.SubCostPerHr;
                    entity.SubPricePerHr = lr.SubPricePerHr;
                    entity.PrintInPdf    = lr.PrintInPdf;
                    entity.LocationId    = lr.LocationId;
                    entity.LocationName  = lr.LocationName;
                }
            }
            // Restore PersonCounts via PersonCount field on LaborRow
            foreach (var (ltId, count) in dto.PersonCounts)
                if (lrByType.TryGetValue(ltId, out var entity))
                    entity.PersonCount = count;
            await db.SaveChangesAsync();

            // Misc rows
            int mSort = 10;
            foreach (var mr in dto.MiscRows.Where(r => !r.MiscItemId.HasValue || allMiscItemIds.Contains(r.MiscItemId.Value)))
            {
                db.TblDesignWorksheetMiscRows.Add(new TblDesignWorksheetMiscRow
                {
                    WorksheetId    = WorksheetId,
                    MiscItemId     = mr.MiscItemId,
                    NetsuiteItemId = mr.NetsuiteItemId,
                    Name           = mr.Name,
                    Description    = mr.Description,
                    Qty            = mr.Qty,
                    Cost           = mr.Cost,
                    SellPrice      = mr.SellPrice,
                    SortOrder      = mSort,
                    PrintInPdf     = mr.PrintInPdf,
                    LocationId     = mr.LocationId,
                    LocationName   = mr.LocationName,
                });
                mSort += 10;
            }

            // Travel rows
            int tSort = 10;
            foreach (var tr in dto.TravelRows.Where(r => !r.MiscItemId.HasValue || allMiscItemIds.Contains(r.MiscItemId.Value)))
            {
                db.TblDesignWorksheetTravelRows.Add(new TblDesignWorksheetTravelRow
                {
                    WorksheetId    = WorksheetId,
                    MiscItemId     = tr.MiscItemId,
                    NetsuiteItemId = tr.NetsuiteItemId,
                    Name           = tr.Name,
                    Description    = tr.Description,
                    Qty            = tr.Qty,
                    Cost           = tr.Cost,
                    SellPrice      = tr.SellPrice,
                    SortOrder      = tSort,
                    PrintInPdf     = tr.PrintInPdf,
                    LocationId     = tr.LocationId,
                    LocationName   = tr.LocationName,
                });
                tSort += 10;
            }

            // Materials rows
            foreach (var mat in dto.MaterialsRows.Where(r => allMaterialsItemIds.Contains(r.ItemId)))
            {
                db.TblDesignWorksheetMaterialsRows.Add(new TblDesignWorksheetMaterialsRow
                {
                    WorksheetId = WorksheetId,
                    ItemId      = mat.ItemId,
                    Qty         = mat.Qty,
                    Cost        = mat.Cost,
                    SellPrice   = mat.SellPrice,
                    LocationId  = mat.LocationId,
                    LocationName= mat.LocationName,
                });
            }
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _persistError = $"Config load failed: {ex.Message}";
            return;
        }

        // Reload everything fresh from DB
        await LoadAsync();
        saveMsg     = "Config loaded.";
        saveSuccess = true;
    }

    private async Task<HashSet<int>> GetLiveCatalogItemIdsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return (await db.TblDesignCatalogItems
            .Where(i => i.CustomerId == Tenant.CustomerCode)
            .Select(i => i.ItemId)
            .ToListAsync()).ToHashSet();
    }

    private HashSet<int> GetLiveMiscItemIds() =>
        miscCatalogItems.Select(i => i.MiscItemId)
            .Concat(travelCatalogItems.Select(i => i.MiscItemId))
            .ToHashSet();
}

