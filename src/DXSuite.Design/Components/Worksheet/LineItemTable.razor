    // ── Column show/hide state ─────────────────────────────────────────────────
    private bool _showCategoryCol = true;
    private bool _showCatGroupCol = true;

    private void OnCategoryChanged(WorksheetEditor.LineItemRow li, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? catId = int.TryParse(raw, out var id) ? id : (int?)null;
        OnUpdateCategory.InvokeAsync((li.LineItemId, catId));
    }

    private void OnGroupFilterChanged(WorksheetEditor.LineItemRow li, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? groupId = int.TryParse(raw, out var id) ? id : (int?)null;
        OnUpdateCategoryGroup.InvokeAsync((li.LineItemId, groupId));
    }

    // ── Category/Cat.Group dirty helpers ─────────────────────────────────────

    // Category is dirty when the user has chosen a different category than what the catalog item has in DB.
    private bool IsCategoryDirty(WorksheetEditor.LineItemRow li)
        => li.CategoryId != li.OriginalCategoryId;

    // Cat.Group is dirty when the group shown in the row differs from the group the current category entity has.
    private bool IsCatGroupDirty(WorksheetEditor.LineItemRow li)
    {
        if (!li.CategoryId.HasValue) return false;
        var cat = AllCategories.FirstOrDefault(c => c.CategoryId == li.CategoryId.Value);
        return li.CategoryGroupId != cat?.CategoryGroupId;
    }

    // ── Create-new-item modal state ───────────────────────────────────────────
    private bool _showCreateModal;

    private async Task OnItemCreatedFromWorksheet(CreatedItemInfo info)
    {
        _showCreateModal = false;
        _addSearch = "";
        _addResults = null;
        _catalogResults = null;

        // Load the full catalog entity (with includes) so WorksheetEditor can build a line item row.
        await using var db = await DbFactory.CreateDbContextAsync();
        var catalogItem = await db.TblDesignCatalogItems
            .Include(i => i.Category)
            .Include(i => i.ColumnOverrides)
            .Include(i => i.AttributeValues)
            .FirstOrDefaultAsync(i => i.ItemId == info.CatalogItemId);

        if (catalogItem is not null)
            await OnAddCatalogItem.InvokeAsync(catalogItem);
    }

    // ── Inline search state ────────────────────────────────────────────────────
    private string _addSearch = "";
    private List<NetsuiteItem>? _addResults;
    private List<TblDesignCatalogItem>? _catalogResults;
    private bool _addSearching;
    private string? _addError;
    private CancellationTokenSource? _addCts;
    private bool _hasSearch => _addSearch.Length >= 2;

    // ── Per-row pending edit state (not yet saved to catalog) ─────────────────
    private Dictionary<int, Dictionary<int, string>> _attrEdits = [];   // lineItemId → attrId → per-unit value string
    private Dictionary<int, Dictionary<int, decimal>> _laborEdits = [];  // lineItemId → ltId → TOTAL hours (not per-unit)

    // ── Attribute display/edit focus tracking ──────────────────────────────────
    // Attr cells show total (per-unit × qty) until clicked; click reveals per-unit input.
    private (int LineItemId, int AttrId)? _editingAttr;

    private void StartEditAttr(int lineItemId, int attrId)
    {
        _editingAttr = (lineItemId, attrId);
    }

    // ── Save modal state ───────────────────────────────────────────────────────
    private WorksheetEditor.LineItemRow? _saveModalRow;
    private bool _saveModalLabor = true;
    private bool _saveModalAttrs = true;
    private bool _saveModalCategory = false;
    private bool _saveModalCatGroup = false;
    private bool _saveModalSaving = false;

    private async Task OnAddSearchInput(ChangeEventArgs e)
    {
        _addSearch = e.Value?.ToString() ?? "";
        _addResults = null;
        _catalogResults = null;
        _addError = null;

        _addCts?.Cancel();
        _addCts?.Dispose();
        _addCts = new CancellationTokenSource();
        var cts = _addCts;

        if (_addSearch.Length < 2)
        {
            _addSearching = false;
            return;
        }

        _addSearching = true;
        try
        {
            // 300 ms debounce so we don't fire on every keystroke
            await Task.Delay(300, cts.Token);

            // Parallel: search both catalog items and NetSuite
            var term = _addSearch;
            var catalogTask = SearchCatalogAsync(term, cts.Token);
            var netsuiteTask = NetsuiteService.SearchItemsAsync(term, cts.Token);
            await Task.WhenAll(catalogTask, netsuiteTask);
            _catalogResults = catalogTask.Result;
            _addResults = netsuiteTask.Result;
        }
        catch (OperationCanceledException)
        {
            // superseded by a newer keystroke — ignore
        }
        catch (Exception ex)
        {
            _addError = $"Search failed: {ex.Message}";
        }
        finally
        {
            _addSearching = false;
        }
    }

    private async Task<List<TblDesignCatalogItem>> SearchCatalogAsync(string term, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.TblDesignCatalogItems
            .Include(i => i.Category)
            .Include(i => i.ColumnOverrides)
            .Include(i => i.AttributeValues)
            .Where(i => i.CustomerId == Tenant.CustomerCode &&
                (i.Description!.Contains(term) || i.ModelName!.Contains(term) || i.Manufacturer!.Contains(term)))
            .Take(20)
            .ToListAsync(ct);
    }

    private async Task SelectAddItem(NetsuiteItem item)
    {
        _addSearch = "";
        _addResults = null;
        _catalogResults = null;
        await OnAddItem.InvokeAsync(item);
    }

    private async Task SelectCatalogItem(TblDesignCatalogItem item)
    {
        _addSearch = "";
        _addResults = null;
        _catalogResults = null;
        await OnAddCatalogItem.InvokeAsync(item);
    }

    // Clears the dropdown when the search input loses focus (click-outside behavior).
    // @onmousedown:preventDefault on the dropdown divs ensures item clicks fire before blur.
    private void CloseAddDropdown()
    {
        _addSearch = "";
        _addResults = null;
        _catalogResults = null;
    }

    private void DiscChanged(WorksheetEditor.LineItemRow li, string? raw)
    {
        if (!decimal.TryParse(raw, out var pct)) return;
        var newDisc = Math.Clamp(pct, 0, 100) / 100m;
        var newDiscCost = li.Cost * (1 - newDisc);
        // Preserve the current sell price — back-calculate what margin achieves it at the new disc cost.
        var newMargin = newDiscCost > 0 && li.SellPrice > newDiscCost
            ? Math.Clamp((li.SellPrice - newDiscCost) / li.SellPrice, 0, 0.99m)
            : li.MarginPct;
        OnUpdateDiscountMargin.InvokeAsync((li.LineItemId, newDisc, newMargin));
    }

    private void MarginChanged(WorksheetEditor.LineItemRow li, string? raw)
    {
        if (decimal.TryParse(raw, out var pct))
            OnUpdateDiscountMargin.InvokeAsync((li.LineItemId, li.DiscountPct, Math.Clamp(pct, 0, 99) / 100m));
    }

    private void SellChanged(WorksheetEditor.LineItemRow li, string? raw)
    {
        if (!decimal.TryParse(raw, out var sell) || sell < 0) return;
        // Back-calculate the margin that produces this sell price at the current disc cost.
        var newMargin = li.DiscCost > 0 && sell > li.DiscCost
            ? Math.Clamp((sell - li.DiscCost) / sell, 0, 0.99m)
            : li.MarginPct;
        OnUpdateDiscountMargin.InvokeAsync((li.LineItemId, li.DiscountPct, newMargin));
    }

    // ── Attribute edit helpers ────────────────────────────────────────────────

    private string GetAttrValue(WorksheetEditor.LineItemRow li, int attrId)
    {
        if (attrId == 0) return "";
        if (_attrEdits.TryGetValue(li.LineItemId, out var edits) && edits.TryGetValue(attrId, out var v)) return v;
        return li.AttributeValues.TryGetValue(attrId, out var ov) ? ov : "";
    }

    // Returns the per-unit decimal for an attribute (for both display math and dirty comparison).
    private decimal GetAttrDecimal(WorksheetEditor.LineItemRow li, int attrId)
        => decimal.TryParse(GetAttrValue(li, attrId), out var d) ? d : 0m;

    private bool IsAttrDirty(WorksheetEditor.LineItemRow li, int attrId)
    {
        if (attrId == 0) return false;
        var current = GetAttrValue(li, attrId);
        var original = li.OriginalAttrValues.TryGetValue(attrId, out var ov) ? ov : "";
        return current != original;
    }

    private void OnAttrEdit(int lineItemId, int attrId, string val)
    {
        if (attrId == 0) return;
        if (!_attrEdits.ContainsKey(lineItemId)) _attrEdits[lineItemId] = [];
        _attrEdits[lineItemId][attrId] = val;
    }

    // Named wrappers so Razor markup can call them without inline lambda closure issues
    private void AttrEditLan(WorksheetEditor.LineItemRow li, ChangeEventArgs e)
        => OnAttrEdit(li.LineItemId, LanDropsAttributeId, e.Value?.ToString() ?? string.Empty);
    private void AttrEditPower(WorksheetEditor.LineItemRow li, ChangeEventArgs e)
        => OnAttrEdit(li.LineItemId, PowerOutletsAttributeId, e.Value?.ToString() ?? string.Empty);
    private void AttrEditPoe(WorksheetEditor.LineItemRow li, ChangeEventArgs e)
        => OnAttrEdit(li.LineItemId, PoePowerAttributeId, e.Value?.ToString() ?? string.Empty);
    private void AttrEditShipping(WorksheetEditor.LineItemRow li, ChangeEventArgs e)
        => OnAttrEdit(li.LineItemId, ShippingAttributeId, e.Value?.ToString() ?? string.Empty);

    // ── Labor edit helpers ────────────────────────────────────────────────────

    // Returns TOTAL hours for display (per-unit × qty, or the user-entered total override).
    private decimal GetLaborTotal(WorksheetEditor.LineItemRow li, int ltId)
    {
        // _laborEdits stores the total hours the user typed directly
        if (_laborEdits.TryGetValue(li.LineItemId, out var edits) && edits.TryGetValue(ltId, out var v)) return v;
        // LaborHoursByLineItem stores per-unit; multiply by qty to get the total to display
        var perUnit = LaborHoursByLineItem.TryGetValue(li.LineItemId, out var h) && h.TryGetValue(ltId, out var d) ? d : 0;
        return perUnit * li.Qty;
    }

    private bool IsLaborDirty(WorksheetEditor.LineItemRow li, int colId)
    {
        if (!_laborEdits.TryGetValue(li.LineItemId, out var edits) || !edits.TryGetValue(colId, out var v)) return false;
        // Compare user-entered total to original total (per-unit × qty)
        var originalTotal = (li.OriginalColumnHoursPerUnit.TryGetValue(colId, out var o) ? o : 0) * li.Qty;
        return v != originalTotal;
    }

    private void OnLaborEdit(int lineItemId, int colId, string? raw)
    {
        if (!_laborEdits.ContainsKey(lineItemId)) _laborEdits[lineItemId] = [];
        // Store total hours as entered; saving will divide by qty to get per-unit for the catalog item
        _laborEdits[lineItemId][colId] = decimal.TryParse(raw, out var d) ? Math.Max(0, d) : 0;

        // Propagate the edited hours to WorksheetEditor immediately so the labor
        // calculation updates on blur without requiring the save-to-catalog modal.
        var li = LineItems.FirstOrDefault(r => r.LineItemId == lineItemId);
        if (li?.CatalogItemId is null) return;
        var qty = Math.Max(1, li.Qty);

        // Build merged per-unit hours: start from the current catalog defaults for this item,
        // then apply all pending edits (total → per-unit by dividing by qty).
        var perUnit = new Dictionary<int, decimal>(li.OriginalColumnHoursPerUnit);
        foreach (var (col, totalHrs) in _laborEdits[lineItemId])
            perUnit[col] = totalHrs / qty;

        _ = OnColumnHoursEdited.InvokeAsync((lineItemId, li.CatalogItemId.Value, perUnit));
    }

    // ── Row dirty state ───────────────────────────────────────────────────────

    private bool IsRowDirty(WorksheetEditor.LineItemRow li)
    {
        if (_attrEdits.TryGetValue(li.LineItemId, out var ae) && ae.Any(kv => IsAttrDirty(li, kv.Key))) return true;
        if (_laborEdits.TryGetValue(li.LineItemId, out var le) && le.Any(kv => IsLaborDirty(li, kv.Key))) return true;
        if (IsCategoryDirty(li) || IsCatGroupDirty(li)) return true;
        return false;
    }

    // ── Save modal ────────────────────────────────────────────────────────────

    private void OpenSaveModal(WorksheetEditor.LineItemRow li)
    {
        _saveModalRow = li;
        // Pre-check whichever sections have dirty changes
        _saveModalLabor    = _laborEdits.ContainsKey(li.LineItemId) && _laborEdits[li.LineItemId].Any(kv => IsLaborDirty(li, kv.Key));
        _saveModalAttrs    = _attrEdits.ContainsKey(li.LineItemId) && _attrEdits[li.LineItemId].Any(kv => IsAttrDirty(li, kv.Key));
        _saveModalCategory = IsCategoryDirty(li);
        _saveModalCatGroup = IsCatGroupDirty(li);
    }

    private async Task ConfirmSave()
    {
        if (_saveModalRow is null) return;
        var li = _saveModalRow;
        var qty = Math.Max(1, li.Qty);
        _saveModalSaving = true;

        var columnHoursToSave = new Dictionary<int, decimal>();
        if (_saveModalLabor)
        {
            // Start from original per-unit column hours
            foreach (var (colId, hrs) in li.OriginalColumnHoursPerUnit)
                columnHoursToSave[colId] = hrs;
            // Apply edits: _laborEdits holds total hours; divide by qty to store per-unit on the catalog item
            if (_laborEdits.TryGetValue(li.LineItemId, out var le))
                foreach (var (colId, totalHrs) in le)
                    columnHoursToSave[colId] = totalHrs / qty;
        }

        var attrsToSave = new Dictionary<int, string>();
        if (_saveModalAttrs)
        {
            foreach (var (attrId, val) in li.AttributeValues)
                attrsToSave[attrId] = val;
            if (_attrEdits.TryGetValue(li.LineItemId, out var ae))
                foreach (var (attrId, val) in ae)
                    attrsToSave[attrId] = val;
        }

        await OnSaveToItem.InvokeAsync((li.LineItemId, _saveModalLabor, _saveModalAttrs, columnHoursToSave, attrsToSave));
        _laborEdits.Remove(li.LineItemId);
        _attrEdits.Remove(li.LineItemId);

        // Persist category / category-group to catalog if checked
        if (_saveModalCategory)
            await OnSaveCategoryToItem.InvokeAsync((li.LineItemId, li.CategoryId));
        if (_saveModalCatGroup)
            await OnSaveCatGroupToCategory.InvokeAsync((li.LineItemId, li.CategoryGroupId));

        _saveModalRow = null;
        _saveModalSaving = false;
    }

    private static string M(decimal v) => "$" + v.ToString("N2");
    private static string M0(decimal v) => "$" + v.ToString("N0");
}

