@using DXSuite.Design.Entities
@using DXSuite.Design.Models
@inject INetsuiteService NetsuiteService
@inject IDbContextFactory<DesignDbContext> DbFactory
@inject ITenantContext Tenant

<div class="lit-wrapper">
    <h4 class="lit-section-title">Hardware</h4>
    @if (LineItems.Count == 0 && !_hasSearch)
    {
        <p class="ct-empty" style="padding:24px 0; text-align:center">No items yet. Search below to add the first item.</p>
    }
    else
    {
        // Two-level grouping: CategoryGroup (outer) → Category (inner).
        // Items without a group (CategoryGroupId = null) sort last.
        var byGroup = LineItems
            .GroupBy(r => r.CategoryGroupId ?? 0)
            .OrderBy(g => g.Key == 0 ? "￿" : g.First().CategoryGroupName)
            .ToList();

        var totalCols = 21 + ColumnHeaders.Count;

        <div style="overflow-x:auto">
            <table class="lit-table">
                <colgroup>
                    <col style="min-width:200px; width:200px" />@* Description (sticky @ 0) *@
                    <col style="min-width:90px; width:90px" />@* System (sticky @ 200) *@
                    <col style="min-width:110px; width:110px" />@* Manufacturer (sticky @ 290) *@
                    <col style="min-width:110px; width:110px" />@* Model (sticky @ 400) *@
                    @if (_showCategoryCol)
                    {
                        <col style="min-width:130px; width:130px" />@* Category (sticky @ 510) *@
                    }
                    else
                    {
                        <col style="min-width:26px; width:26px" />@* Category collapsed (sticky @ 510) *@
                    }
                    @if (_showCatGroupCol)
                    {
                        <col style="min-width:120px; width:120px" />@* Cat. Group (sticky @ 640 / 536) *@
                    }
                    else
                    {
                        <col style="min-width:26px; width:26px" />@* Cat. Group collapsed (sticky @ 640 / 536) *@
                    }
                    <col style="min-width:55px; width:55px" />@* Qty *@
                    <col style="min-width:75px; width:75px" />@* Cost *@
                    <col style="min-width:60px; width:60px" />@* Disc% *@
                    <col style="min-width:80px; width:80px" />@* Disc.Cost *@
                    <col style="min-width:65px; width:65px" />@* Margin% *@
                    <col style="min-width:80px; width:80px" />@* Sell *@
                    <col style="min-width:85px; width:85px" />@* Ext.Cost *@
                    <col style="min-width:85px; width:85px" />@* Ext.Sell *@
                    <col style="min-width:65px; width:65px" />@* LAN Drops *@
                    <col style="min-width:68px; width:68px" />@* Power Outlets *@
                    <col style="min-width:65px; width:65px" />@* PoE Power *@
                    @foreach (var _ in ColumnHeaders)
                    {
                        <col style="min-width:70px; width:70px" />
                    }
                    <col style="min-width:78px; width:78px" />@* Shipping *@
                    <col style="min-width:84px; width:84px" />@* Loc *@
                    <col style="min-width:74px; width:74px" />@* Actions *@
                </colgroup>
                <thead>
                    <tr class="lit-header-row">
                        <th class="lit-th lit-sticky lit-sticky-0">Description</th>
                        <th class="lit-th lit-sticky lit-sticky-200">System</th>
                        <th class="lit-th lit-sticky lit-sticky-290 lit-muted">Manufacturer</th>
                        <th class="lit-th lit-sticky lit-sticky-400 lit-muted">Model</th>
                        @if (_showCategoryCol)
                        {
                            <th class="lit-th lit-sticky lit-sticky-510">
                                <div class="lit-col-hdr">
                                    <span>Category</span>
                                    <button class="lit-col-hide-btn" title="Hide column" @onclick="() => _showCategoryCol = false">◂</button>
                                </div>
                            </th>
                        }
                        else
                        {
                            <th class="lit-th lit-col-collapsed-hdr lit-sticky lit-sticky-510" title="Show Category column">
                                <button class="lit-col-show-btn" @onclick="() => _showCategoryCol = true">Cat▸</button>
                            </th>
                        }
                        @{
                            var catGrpLeft = _showCategoryCol ? "lit-sticky-640" : "lit-sticky-536";
                        }
                        @if (_showCatGroupCol)
                        {
                            <th class="lit-th lit-sticky @catGrpLeft">
                                <div class="lit-col-hdr">
                                    <span>Cat. Group</span>
                                    <button class="lit-col-hide-btn" title="Hide column" @onclick="() => _showCatGroupCol = false">◂</button>
                                </div>
                            </th>
                        }
                        else
                        {
                            <th class="lit-th lit-col-collapsed-hdr lit-sticky @catGrpLeft" title="Show Cat. Group column">
                                <button class="lit-col-show-btn" @onclick="() => _showCatGroupCol = true">Grp▸</button>
                            </th>
                        }
                        <th class="lit-th lit-num">Qty</th>
                        <th class="lit-th lit-num">Cost</th>
                        <th class="lit-th lit-num">Disc%</th>
                        <th class="lit-th lit-num">Disc.Cost</th>
                        <th class="lit-th lit-num">Margin%</th>
                        <th class="lit-th lit-num">Sell</th>
                        <th class="lit-th lit-num">Ext.Cost</th>
                        <th class="lit-th lit-num">Ext.Sell</th>
                        <th class="lit-th lit-num">LAN Drops</th>
                        <th class="lit-th lit-num">Power Outlets</th>
                        <th class="lit-th lit-num">PoE Power</th>
                        @foreach (var col in ColumnHeaders)
                        {
                            var colLocal = col;
                            <th class="lit-th lit-num lit-labor-th">
                                @col.Name
                                @if (ManualColumnIds.Contains(col.ColumnId))
                                {
                                    <button class="lit-labor-th-dismiss" title="Remove column"
                                            @onclick="() => OnRemoveColumn.InvokeAsync(colLocal.ColumnId)"
                                            @onclick:stopPropagation>×</button>
                                }
                            </th>
                        }
                        <th class="lit-th lit-num">Shipping</th>
                        <th class="lit-th" style="text-align:center">Loc</th>
                        <th class="lit-th"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var outerGroup in byGroup)
                    {
                        var outerGroupId = outerGroup.Key;
                        @if (outerGroupId != 0)
                        {
                            var gd = GroupDescriptions.TryGetValue(outerGroupId, out var gDesc) ? gDesc : null;
                            var grpActiveItems = outerGroup.Where(r => !r.IsDisabled).ToList();
                            var grpExtCost = grpActiveItems.Sum(r => r.DiscCost * r.Qty);
                            var grpExtSell = grpActiveItems.Sum(r => r.SellPrice * r.Qty);
                            <tr class="lit-group-row">
                                <td colspan="@totalCols" class="lit-group-cell">
                                    <div class="lit-group-content">
                                        <span class="lit-group-name">@outerGroup.First().CategoryGroupName.ToUpperInvariant()</span>
                                        <span class="lit-group-sep"></span>
                                        <span class="lit-group-totals">
                                            <span class="lit-group-total-label">Cost</span>
                                            <span class="lit-group-total-val">@M0(grpExtCost)</span>
                                            <span class="lit-group-total-label">Sell</span>
                                            <span class="lit-group-total-val">@M0(grpExtSell)</span>
                                        </span>
                                        <span class="lit-group-actions">
                                            <input type="checkbox"
                                                   checked="@(gd?.IsEnabled ?? false)"
                                                   @onchange="() => OnToggleGroupDescription.InvokeAsync(outerGroupId)"
                                                   title="Include description row before this group in NetSuite push" />
                                            <span class="lit-group-desc-label">Desc.</span>
                                            <button class="lit-pencil-btn"
                                                    @onclick="() => OnEditGroupDescription.InvokeAsync(outerGroupId)"
                                                    title="Edit group description row">✎</button>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var catGroup in outerGroup
                            .GroupBy(r => r.CategoryId ?? 0)
                            .OrderBy(g => g.Key == 0 ? "￿" : g.First().CategoryName))
                        {
                            var catName = catGroup.First().CategoryName;
                            <tr class="lit-cat-row">
                                <td colspan="@totalCols" class="lit-cat-cell">
                                    <span class="lit-cat-label">@catName</span>
                                </td>
                            </tr>
                        @foreach (var li in catGroup)
                        {
                            <tr class="lit-row @(li.IsDisabled ? "lit-row-disabled" : "")">
                                <td class="lit-td lit-sticky lit-sticky-0 lit-desc" title="@li.Description">@li.Description</td>
                                <td class="lit-td lit-sticky lit-sticky-200">
                                    <input type="text" class="lit-input" value="@li.SystemName"
                                           @onchange="e => OnUpdateSystem.InvokeAsync((li.LineItemId, e.Value?.ToString() ?? string.Empty))" />
                                </td>
                                <td class="lit-td lit-sticky lit-sticky-290 lit-muted">@li.Manufacturer</td>
                                <td class="lit-td lit-sticky lit-sticky-400 lit-muted">@li.ModelName</td>

                                @* ── Category dropdown (collapsible, sticky) ───────────────────── *@
                                @if (_showCategoryCol)
                                {
                                    <td class="lit-td lit-sticky lit-sticky-510 @(IsCategoryDirty(li) ? "lit-cell-dirty" : "")">
                                        <div class="lit-select-wrap">
                                            <select class="lit-select" value="@(li.CategoryId?.ToString() ?? "")"
                                                    @onchange="e => OnCategoryChanged(li, e)">
                                                <option value="">— none —</option>
                                                @foreach (var cat in AllCategories.OrderBy(c => c.SortOrder).ThenBy(c => c.Name))
                                                {
                                                    <option value="@cat.CategoryId">@cat.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td class="lit-td lit-sticky lit-sticky-510 lit-col-collapsed-cell @(IsCategoryDirty(li) ? "lit-cell-dirty" : "")"></td>
                                }

                                @* ── Cat. Group dropdown (collapsible, sticky; left offset depends on Category width) ── *@
                                @if (_showCatGroupCol)
                                {
                                    <td class="lit-td lit-sticky @catGrpLeft @(IsCatGroupDirty(li) ? "lit-cell-dirty" : "")">
                                        @if (!li.CategoryId.HasValue)
                                        {
                                            @* No category selected — group is meaningless; show placeholder *@
                                            <div class="lit-select-wrap">
                                                <select class="lit-select" disabled>
                                                    <option value="">— none —</option>
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="lit-select-wrap">
                                                <select class="lit-select" value="@(li.CategoryGroupId?.ToString() ?? "")"
                                                        @onchange="e => OnGroupFilterChanged(li, e)">
                                                    <option value="">— none —</option>
                                                    @foreach (var grp in AllCategoryGroups.OrderBy(g => g.Name))
                                                    {
                                                        <option value="@grp.CategoryGroupId">@grp.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td class="lit-td lit-sticky @catGrpLeft lit-col-collapsed-cell @(IsCatGroupDirty(li) ? "lit-cell-dirty" : "")"></td>
                                }
                                <td class="lit-td lit-num">
                                    <input type="number" class="lit-input lit-num" min="1" value="@li.Qty"
                                           @onchange="e => OnUpdateQty.InvokeAsync((li.LineItemId, int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(1, q) : li.Qty))" />
                                </td>
                                <td class="lit-td lit-num lit-ro">@M(li.Cost)</td>
                                <td class="lit-td lit-num">
                                    <input type="number" class="lit-input lit-num" min="0" max="100" step="0.5"
                                           value="@((li.DiscountPct * 100).ToString("F1"))"
                                           @onchange="e => DiscChanged(li, e.Value?.ToString())" />
                                </td>
                                <td class="lit-td lit-num lit-ro">@M(li.DiscCost)</td>
                                <td class="lit-td lit-num">
                                    <input type="number" class="lit-input lit-num" min="0" max="99" step="0.5"
                                           value="@((li.MarginPct * 100).ToString("F1"))"
                                           @onchange="e => MarginChanged(li, e.Value?.ToString())" />
                                </td>
                                <td class="lit-td lit-num">
                                    <input type="number" class="lit-input lit-num" min="0" step="0.01"
                                           value="@li.SellPrice.ToString("F2")"
                                           @onchange="e => SellChanged(li, e.Value?.ToString())" />
                                </td>
                                <td class="lit-td lit-num lit-ro">@M(li.DiscCost * li.Qty)</td>
                                <td class="lit-td lit-num lit-ro">@M(li.SellPrice * li.Qty)</td>

                                @* Attribute cells: user edits per-unit; cell displays total (per-unit × qty).
                                   Click the cell to reveal the per-unit input; blur commits and returns to total display. *@
                                @{ var editLan   = _editingAttr == (li.LineItemId, LanDropsAttributeId); }
                                @{ var lanPerUnit = GetAttrDecimal(li, LanDropsAttributeId); }
                                <td class="lit-td lit-num @(IsAttrDirty(li, LanDropsAttributeId) ? "lit-cell-dirty" : "")"
                                    @onclick="() => StartEditAttr(li.LineItemId, LanDropsAttributeId)">
                                    @if (editLan)
                                    {
                                        <input type="number" step="any" min="0" class="lit-input lit-num" autofocus
                                               value="@(lanPerUnit > 0 ? lanPerUnit.ToString("G") : string.Empty)"
                                               @onchange="e => AttrEditLan(li, e)"
                                               @onblur="() => _editingAttr = null" />
                                    }
                                    else
                                    {
                                        <span class="lit-attr-total">@(lanPerUnit > 0 ? (lanPerUnit * li.Qty).ToString("G") : "")</span>
                                    }
                                </td>

                                @{ var editPwr   = _editingAttr == (li.LineItemId, PowerOutletsAttributeId); }
                                @{ var pwrPerUnit = GetAttrDecimal(li, PowerOutletsAttributeId); }
                                <td class="lit-td lit-num @(IsAttrDirty(li, PowerOutletsAttributeId) ? "lit-cell-dirty" : "")"
                                    @onclick="() => StartEditAttr(li.LineItemId, PowerOutletsAttributeId)">
                                    @if (editPwr)
                                    {
                                        <input type="number" step="any" min="0" class="lit-input lit-num" autofocus
                                               value="@(pwrPerUnit > 0 ? pwrPerUnit.ToString("G") : string.Empty)"
                                               @onchange="e => AttrEditPower(li, e)"
                                               @onblur="() => _editingAttr = null" />
                                    }
                                    else
                                    {
                                        <span class="lit-attr-total">@(pwrPerUnit > 0 ? (pwrPerUnit * li.Qty).ToString("G") : "")</span>
                                    }
                                </td>

                                @{ var editPoe   = _editingAttr == (li.LineItemId, PoePowerAttributeId); }
                                @{ var poePerUnit = GetAttrDecimal(li, PoePowerAttributeId); }
                                <td class="lit-td lit-num @(IsAttrDirty(li, PoePowerAttributeId) ? "lit-cell-dirty" : "")"
                                    @onclick="() => StartEditAttr(li.LineItemId, PoePowerAttributeId)">
                                    @if (editPoe)
                                    {
                                        <input type="number" step="any" min="0" class="lit-input lit-num" autofocus
                                               value="@(poePerUnit > 0 ? poePerUnit.ToString("G") : string.Empty)"
                                               @onchange="e => AttrEditPoe(li, e)"
                                               @onblur="() => _editingAttr = null" />
                                    }
                                    else
                                    {
                                        <span class="lit-attr-total">@(poePerUnit > 0 ? (poePerUnit * li.Qty).ToString("G") : "")</span>
                                    }
                                </td>

                                @* Column labor cells: user edits and sees TOTAL hours (per-unit × qty).
                                   Saving divides by qty to store the per-unit value on the catalog item. *@
                                @foreach (var col in ColumnHeaders)
                                {
                                    var colId = col.ColumnId;
                                    var totalHrs = GetLaborTotal(li, colId);
                                    <td class="lit-td lit-num @(IsLaborDirty(li, colId) ? "lit-cell-dirty" : "")">
                                        <input type="number" step="0.25" min="0" class="lit-input lit-num"
                                               value="@(totalHrs > 0 ? totalHrs.ToString("G") : string.Empty)"
                                               placeholder="—"
                                               @onchange="e => OnLaborEdit(li.LineItemId, colId, e.Value?.ToString())" />
                                    </td>
                                }

                                <td class="lit-td lit-num @(IsAttrDirty(li, ShippingAttributeId) ? "lit-cell-dirty" : "")">
                                    <div style="display:flex; align-items:center; gap:2px">
                                        <span style="font-size:.75rem; color:var(--text-muted,#6c757d)">$</span>
                                        <input type="number" step="0.01" min="0" class="lit-input lit-num" style="flex:1"
                                               value="@GetAttrValue(li, ShippingAttributeId)"
                                               @onchange="e => AttrEditShipping(li, e)" />
                                    </div>
                                </td>
                                <td class="lit-td" style="text-align:center; position:relative">
                                    <LocationPickerPopover
                                        CurrentLocationId="@li.LocationId"
                                        CurrentLocationName="@li.LocationName"
                                        DefaultLocationId="@WorksheetDefaultLocationId"
                                        DefaultLocationName="@WorksheetDefaultLocationName"
                                        Locations="CachedLocations"
                                        OnSelect="args => OnUpdateLocation.InvokeAsync((li.LineItemId, args.Id, args.Name))" />
                                </td>
                                <td class="lit-td" style="text-align:center">
                                    <div style="display:flex; gap:3px; justify-content:center; align-items:center">
                                        @if (IsRowDirty(li) && li.CatalogItemId.HasValue)
                                        {
                                            <button class="lit-btn-save" title="Save changes to catalog item"
                                                    @onclick="() => OpenSaveModal(li)">💾</button>
                                        }
                                        <button class="lit-btn-toggle @(li.IsDisabled ? "lit-btn-toggle-off" : "lit-btn-toggle-on")"
                                                title="@(li.IsDisabled ? "Re-enable row" : "Disable row")"
                                                @onclick="() => OnToggleDisabled.InvokeAsync(li.LineItemId)">
                                            @(li.IsDisabled ? "On" : "Off")
                                        </button>
                                        <button class="lit-btn-delete"
                                                title="Remove item"
                                                @onclick="() => OnRemoveItem.InvokeAsync(li.LineItemId)">🗑</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        } @* end catGroup loop *@
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Search strip rendered outside the scrollable table so the dropdown is never clipped *@
<div class="lit-add-strip">
    <div class="lit-add-input-wrap">
        <input type="text"
               class="lit-add-input"
               placeholder="+ Search to add item…"
               value="@_addSearch"
               @oninput="OnAddSearchInput"
               @onblur="CloseAddDropdown"
               autocomplete="off" />
        @if (_addSearching)
        {
            <span class="lit-add-spinner">⏳</span>
        }
        @if (_addError is not null)
        {
            <span class="lit-add-error">@_addError</span>
        }
        @if (_catalogResults is { Count: > 0 } || _addResults is { Count: > 0 })
        {
            <div class="lit-add-dropdown" @onmousedown:preventDefault>
                @if (_catalogResults is { Count: > 0 })
                {
                    <div class="lit-add-section-header">Items</div>
                    @foreach (var item in _catalogResults)
                    {
                        var ci = item;
                        <div class="lit-add-result" @onclick="() => SelectCatalogItem(ci)">
                            <span class="lit-add-result-main">@ci.ModelName</span>
                            <span class="lit-add-result-sub">@ci.Manufacturer — @ci.Description</span>
                            <span class="lit-add-result-price">@M(ci.Cost)</span>
                        </div>
                    }
                }
                @if (_addResults is { Count: > 0 })
                {
                    <div class="lit-add-section-header">Import from NetSuite</div>
                    @foreach (var result in _addResults)
                    {
                        var r = result;
                        <div class="lit-add-result" @onclick="() => SelectAddItem(r)">
                            <span class="lit-add-result-main">@r.ItemId</span>
                            <span class="lit-add-result-sub">@r.Manufacturer — @r.PurchaseDescription</span>
                            <span class="lit-add-result-price">@M(r.Cost)</span>
                        </div>
                    }
                }
                <div class="lit-add-new-wrap">
                    <button class="lit-add-new-btn" @onclick="() => _showCreateModal = true">
                        + Create New NetSuite Item
                    </button>
                </div>
            </div>
        }
        else if (_addResults is { Count: 0 } && _catalogResults is { Count: 0 } && !_addSearching && _addSearch.Length >= 2)
        {
            <div class="lit-add-dropdown" @onmousedown:preventDefault>
                <div class="lit-add-result lit-add-result-empty">No items found for "@_addSearch"</div>
                <div class="lit-add-new-wrap">
                    <button class="lit-add-new-btn" @onclick="() => _showCreateModal = true">
                        + Create New NetSuite Item
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (_showCreateModal)
{
    <CreateNetsuiteItemModal OnCreated="OnItemCreatedFromWorksheet"
                             OnClose="() => _showCreateModal = false" />
}

@* Save-to-item confirmation modal *@
@if (_saveModalRow is not null)
{
    <div class="dx-modal-overlay" @onclick="() => _saveModalRow = null">
        <div class="dx-modal" style="min-width:320px" @onclick:stopPropagation>
            <div class="dx-modal-header">
                <span>Save Changes to Catalog Item</span>
                <button class="dx-modal-close" @onclick="() => _saveModalRow = null">&times;</button>
            </div>
            <div class="dx-modal-body">
                <p style="font-size:.85rem; color:var(--text-muted,#6c757d); margin-bottom:12px">
                    Select what to update on <strong>@_saveModalRow.Description</strong>:
                </p>
                <label style="display:flex; align-items:center; gap:8px; margin-bottom:8px">
                    <input type="checkbox" @bind="_saveModalLabor" />
                    Labor hours
                </label>
                <label style="display:flex; align-items:center; gap:8px; margin-bottom:8px">
                    <input type="checkbox" @bind="_saveModalAttrs" />
                    Attribute values
                </label>
                @if (_saveModalRow is not null && IsCategoryDirty(_saveModalRow))
                {
                    <label style="display:flex; align-items:center; gap:8px; margin-bottom:8px">
                        <input type="checkbox" @bind="_saveModalCategory" />
                        Category — update catalog item to <strong>@(_saveModalRow.CategoryName is { Length: > 0 } n ? n : "none")</strong>
                    </label>
                }
                @if (_saveModalRow is not null && IsCatGroupDirty(_saveModalRow))
                {
                    var grpName = _saveModalRow.CategoryGroupId.HasValue
                        ? (AllCategoryGroups.FirstOrDefault(g => g.CategoryGroupId == _saveModalRow.CategoryGroupId.Value)?.Name ?? "?")
                        : "none";
                    <label style="display:flex; align-items:center; gap:8px">
                        <input type="checkbox" @bind="_saveModalCatGroup" />
                        Category Group — update category <strong>@_saveModalRow.CategoryName</strong> to group <strong>@grpName</strong>
                    </label>
                }
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn dx-btn-gray" disabled="@_saveModalSaving"
                        @onclick="() => _saveModalRow = null">Cancel</button>
                <button class="dx-btn dx-btn-blue"
                        disabled="@(!_saveModalLabor && !_saveModalAttrs && !_saveModalCategory && !_saveModalCatGroup || _saveModalSaving)"
                        @onclick="ConfirmSave">
                    @if (_saveModalSaving)
                    {
                        <span class="lit-save-spinner"></span>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>Save to Item</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<WorksheetEditor.LineItemRow> LineItems { get; set; } = [];
    [Parameter] public List<TblDesignLaborColumn> ColumnHeaders { get; set; } = [];
    [Parameter] public HashSet<int> ManualColumnIds { get; set; } = [];
    [Parameter] public EventCallback<int> OnRemoveColumn { get; set; }
    // Key: lineItemId → (columnId → per-unit hours)
    [Parameter] public Dictionary<int, Dictionary<int, decimal>> LaborHoursByLineItem { get; set; } = [];
    [Parameter] public int ShippingAttributeId { get; set; }
    [Parameter] public int LanDropsAttributeId { get; set; }
    [Parameter] public int PowerOutletsAttributeId { get; set; }
    [Parameter] public int PoePowerAttributeId { get; set; }
