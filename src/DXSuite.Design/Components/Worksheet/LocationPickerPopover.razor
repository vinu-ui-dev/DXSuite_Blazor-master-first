@using DXSuite.Design.Models

@* Compact location picker — appears as an inline dropdown anchored to the "Loc" cell.
   Shows "Use Default" as the first option (greyed when no default is set),
   then all NS locations fetched from the account. *@

@if (_open)
{
    <div class="lpp-overlay" @onclick="Close" @onmousedown:preventDefault></div>
    <div class="lpp-popover">
        <div class="lpp-item lpp-default" @onclick="SelectDefault">
            @if (DefaultLocationId is null)
            {
                <span class="lpp-default-label">Use Default <span class="lpp-none">(none set)</span></span>
            }
            else
            {
                <span class="lpp-default-label">Use Default <span class="lpp-default-name">(@DefaultLocationName)</span></span>
            }
            @if (CurrentLocationId is null)
            {
                <span class="lpp-check">✓</span>
            }
        </div>
        <div class="lpp-divider"></div>
        @if (Locations is null)
        {
            <div class="lpp-loading">Loading…</div>
        }
        else
        {
            @foreach (var loc in Locations)
            {
                var locLocal = loc;
                <div class="lpp-item @(CurrentLocationId == loc.Id ? "lpp-selected" : "")"
                     @onclick="() => SelectLocation(locLocal)">
                    @loc.Name
                    @if (CurrentLocationId == loc.Id)
                    {
                        <span class="lpp-check">✓</span>
                    }
                </div>
            }
        }
    </div>
}

<button class="lpp-trigger @(CurrentLocationId is not null ? "lpp-has-value" : "lpp-empty")"
        title="@(CurrentLocationId is null ? (DefaultLocationName is not null ? $"Default: {DefaultLocationName}" : "No location set") : CurrentLocationName)"
        @onclick:stopPropagation
        @onclick="Toggle">
    @if (CurrentLocationId is null)
    {
        <span class="lpp-label-default">@(DefaultLocationName?.Length > 0 ? Abbrev(DefaultLocationName) : "—")</span>
    }
    else
    {
        @Abbrev(CurrentLocationName ?? CurrentLocationId)
    }
</button>

<style>
    .lpp-trigger {
        position: relative;
        font-size: .78rem;
        padding: 2px 5px;
        border-radius: 3px;
        border: 1px solid #d0d5db;
        cursor: pointer;
        white-space: nowrap;
        max-width: 80px;
        overflow: hidden;
        text-overflow: ellipsis;
        background: #fff;
    }
    .lpp-trigger.lpp-empty {
        color: #adb5bd;
        border-style: dashed;
        background: transparent;
    }
    .lpp-trigger.lpp-has-value {
        color: #1a1a2e;
        background: #e8f4fd;
        border-color: #9dc8e8;
    }
    .lpp-label-default { color: #6c757d; }

    .lpp-overlay {
        position: fixed;
        inset: 0;
        z-index: 1998;
    }
    .lpp-popover {
        position: absolute;
        z-index: 1999;
        background: #fff;
        border: 1px solid #d0d5db;
        border-radius: 6px;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
        min-width: 200px;
        max-height: 280px;
        overflow-y: auto;
        padding: 4px 0;
    }
    .lpp-item {
        padding: 6px 14px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .85rem;
        gap: 8px;
    }
    .lpp-item:hover { background: #f0f4ff; }
    .lpp-selected { background: #e8f0fe; font-weight: 500; }
    .lpp-default { color: #495057; }
    .lpp-default-label { flex: 1; }
    .lpp-default-name { color: #0071BC; font-style: italic; }
    .lpp-none { color: #adb5bd; font-style: italic; }
    .lpp-check { color: #0071BC; font-weight: bold; margin-left: 4px; }
    .lpp-divider { height: 1px; background: #e9ecef; margin: 4px 0; }
    .lpp-loading { padding: 8px 14px; color: #6c757d; font-size: .85rem; }
</style>

@code {
    /// <summary>Currently selected location ID — null means "use worksheet default".</summary>
    [Parameter] public string? CurrentLocationId { get; set; }
    /// <summary>Display name for the currently selected location.</summary>
    [Parameter] public string? CurrentLocationName { get; set; }
    /// <summary>Worksheet-level default location ID — shown in the "Use Default" option.</summary>
    [Parameter] public string? DefaultLocationId { get; set; }
    /// <summary>Worksheet-level default location name — shown in the "Use Default" option.</summary>
    [Parameter] public string? DefaultLocationName { get; set; }
    /// <summary>All available NS locations — pass the cached list from WorksheetEditor.</summary>
    [Parameter] public List<NetsuiteLocation>? Locations { get; set; }
    /// <summary>Fired when the user selects a location. Null means "clear override (use default)".</summary>
    [Parameter] public EventCallback<(string? Id, string? Name)> OnSelect { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task SelectDefault()
    {
        _open = false;
        await OnSelect.InvokeAsync((null, null));
    }

    private async Task SelectLocation(NetsuiteLocation loc)
    {
        _open = false;
        await OnSelect.InvokeAsync((loc.Id, loc.Name));
    }

    /// <summary>Abbreviates long location names for the compact trigger button.</summary>
    private static string Abbrev(string name)
    {
        if (name.Length <= 10) return name;
        // Return first word or first 10 chars, whichever is shorter
        var space = name.IndexOf(' ');
        return space > 0 && space <= 10 ? name[..space] : name[..10];
    }
}
