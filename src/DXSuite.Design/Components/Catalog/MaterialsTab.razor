@inject IDbContextFactory<DesignDbContext> DbFactory
@inject ITenantContext Tenant
@inject INetsuiteService NetsuiteService

<div style="height:100%; display:flex; flex-direction:column;">

    <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 16px 12px; flex-shrink:0;">
        <h5 style="margin:0;">Materials Categories</h5>
        <button class="dx-btn dx-btn-blue dx-btn-sm" @onclick="BeginAddCategory">+ Add Category</button>
    </div>

    <div style="flex:1; min-height:0; overflow-y:auto; padding:0 16px 16px;">

    @if (categories is null)
    {
        <div style="position:relative; min-height:120px;">
            <div class="dx-loading-overlay"><div class="dx-spinner"></div></div>
        </div>
    }
    else if (categories.Count == 0)
    {
        <div style="text-align:center; padding:40px 20px;">
            <h5>No categories defined</h5>
            <p class="dx-text-muted">Add a category to get started.</p>
        </div>
    }
    else
    {
        @foreach (var cat in categories.OrderBy(c => c.SortOrder))
        {
            var catId = cat.CategoryId;
            var catItems = itemsByCategory.TryGetValue(catId, out var list) ? list : [];
            var expanded = _expandedCategories.Contains(catId);

            <div class="dx-card mat-cat-card">
                <div class="mat-cat-header" @onclick="() => ToggleExpanded(catId)">
                    <span class="mat-expand-icon">@(expanded ? "▾" : "▸")</span>
                    <strong style="margin:0 8px;">@cat.Name</strong>
                    @if (!string.IsNullOrEmpty(cat.NetsuiteItemName))
                    {
                        <span class="mat-fallback-ns-chip" title="Fallback NS item for items without their own NS item">
                            @cat.NetsuiteItemName
                        </span>
                    }
                    <span style="flex:1"></span>
                    <span style="font-size:.8rem; color:var(--dx-text-muted,#6c757d); margin-right:12px;">
                        @catItems.Count items
                    </span>
                    <button class="dx-btn dx-btn-outline-blue dx-btn-sm" style="margin-left:8px;"
                            @onclick="() => BeginEditCategory(cat)" @onclick:stopPropagation>Edit</button>
                    <button class="dx-btn dx-btn-red dx-btn-sm" style="margin-left:4px;"
                            @onclick="() => DeleteCategoryAsync(cat)" @onclick:stopPropagation>Delete</button>
                </div>

                @if (expanded)
                {
                    <div class="mat-cat-body">
                        @if (catItems.Count > 0)
                        {
                            <div style="overflow-x:auto; margin-bottom:8px;">
                            <div class="dx-table" style="min-width:680px;">
                                <div class="dx-table-header mat-item-cols">
                                    <div>NS Item / SKU</div>
                                    <div>Name</div>
                                    <div style="text-align:right">Default Cost</div>
                                    <div style="text-align:right">Default Sell</div>
                                    <div>Actions</div>
                                </div>
                                @foreach (var item in catItems.OrderBy(i => i.SortOrder))
                                {
                                    <div class="dx-table-row mat-item-cols">
                                        <div style="font-size:.8rem; color:var(--dx-text-muted,#6c757d)">
                                            @if (!string.IsNullOrEmpty(item.NetsuiteItemId))
                                            {
                                                <span class="mat-ns-linked" title="NS ID: @item.NetsuiteItemId">@item.ModelNumber</span>
                                            }
                                            else
                                            {
                                                <span class="mat-ns-unlinked" title="No NetSuite item linked">@item.ModelNumber</span>
                                            }
                                        </div>
                                        <div>@item.Name</div>
                                        <div style="text-align:right">@item.DefaultCost.ToString("N2")</div>
                                        <div style="text-align:right">@item.DefaultSellPrice.ToString("N2")</div>
                                        <div style="display:flex; gap:4px;">
                                            <button class="dx-btn dx-btn-outline-blue dx-btn-sm"
                                                    @onclick="() => BeginEditItem(item, cat)">Edit</button>
                                            <button class="dx-btn dx-btn-red dx-btn-sm"
                                                    @onclick="() => DeleteItemAsync(item)">Delete</button>
                                        </div>
                                    </div>
                                }
                            </div>
                            </div>@* end overflow-x:auto wrapper *@
                        }
                        <div style="padding:4px 0;">
                            <button class="dx-btn dx-btn-outline-blue dx-btn-sm" @onclick="() => BeginAddItem(cat)">+ Add Item</button>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (deleteError is not null)
    {
        <div class="dx-alert dx-alert-danger" style="margin-top:8px;">@deleteError</div>
    }

    </div>@* end scrollable body *@
</div>

@* ── Category add / edit modal ─────────────────────────────────────────────── *@
@if (catFormVisible)
{
    <div class="dx-modal-overlay" @onclick="CloseCatForm">
        <div class="dx-modal" style="min-width:460px; max-width:560px" @onclick:stopPropagation>
            <div class="dx-modal-header">
                <span>@(catEditId == 0 ? "Add Category" : "Edit Category")</span>
                <button class="dx-modal-close" @onclick="CloseCatForm">&times;</button>
            </div>
            <div class="dx-modal-body">
                <div class="dx-form-group">
                    <label class="dx-form-label">Name <span style="color:var(--dx-red,#dc3545)">*</span></label>
                    <input class="dx-form-control" @bind="catFormName" placeholder="e.g. Bulk Cabling & Connectors" />
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">Sort Order</label>
                    <input type="number" class="dx-form-control" @bind="catFormSort" />
                </div>
                <div class="dx-form-group">
                    <label class="dx-form-label">Fallback NS Item</label>
                    <div style="font-size:.78rem; color:var(--dx-text-muted,#6c757d); margin-bottom:5px;">
                        Used when an individual item in this category has no NS item of its own.
                        The item's name is sent as the description override on the estimate line.
                    </div>
                    @if (catFormNsItemId is not null)
                    {
                        <div class="lt-ns-chip">
                            <span>@catFormNsItemName</span>
                            <button class="lt-ns-clear" @onclick="ClearCatNsItem">&times;</button>
                        </div>
                    }
                    else
                    {
                        <div style="position:relative">
                            <input class="dx-form-control" value="@catFormNsSearch"
                                   @oninput="OnCatNsSearchInput"
                                   placeholder="Search NS items (2+ chars)…" />
                            @if (catFormNsSearching)
                            {
                                <div style="font-size:.8rem; color:var(--dx-text-muted,#6c757d); margin-top:3px">Searching…</div>
                            }
                            @if (catFormNsResults is { Count: > 0 })
                            {
                                <div class="ct-search-results">
                                    @foreach (var r in catFormNsResults)
                                    {
                                        <div class="ct-search-result" @onclick="() => SelectCatNsItem(r)">
                                            <div class="ct-search-result-name">@r.ItemId</div>
                                            <div class="ct-search-result-sub">@r.PurchaseDescription</div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (catFormNsResults is { Count: 0 } && !catFormNsSearching)
                            {
                                <div class="ct-search-results">
                                    <div class="ct-search-result" style="color:var(--dx-text-muted,#6c757d); cursor:default">No results</div>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (catFormError is not null)
                {
                    <div class="dx-alert dx-alert-danger">@catFormError</div>
                }
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn dx-btn-gray" @onclick="CloseCatForm">Cancel</button>
                <button class="dx-btn dx-btn-blue" @onclick="SaveCategoryAsync" disabled="@saving">
                    @(saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@* ── Item add / edit modal ────────────────────────────────────────────────── *@
@if (itemFormVisible)
{
    <div class="dx-modal-overlay" @onclick="CloseItemForm">
        <div class="dx-modal" style="min-width:520px; max-width:640px" @onclick:stopPropagation>
            <div class="dx-modal-header">
                <span>@(itemEditId == 0 ? $"Add Item — {itemFormCategoryName}" : "Edit Item")</span>
                <button class="dx-modal-close" @onclick="CloseItemForm">&times;</button>
            </div>
            <div class="dx-modal-body">

                @* NS item search — always shown; drives SKU/name/cost/sell auto-fill *@
                <div class="dx-form-group">
                    <label class="dx-form-label">NetSuite Item / SKU</label>
                    @if (itemFormNsItemId is not null)
                    {
                        <div class="lt-ns-chip">
                            <span>@itemFormNsDisplay</span>
                            <button class="lt-ns-clear" @onclick="ClearNsItem">&times;</button>
                        </div>
                    }
                    else
                    {
                        <div style="position:relative">
                            <input class="dx-form-control" value="@itemFormNsSearch"
                                   @oninput="OnNsSearchInput"
                                   placeholder="Search by SKU or name (2+ chars)…" />
                            @if (itemFormNsSearching)
                            {
                                <div style="font-size:.8rem; color:var(--dx-text-muted,#6c757d); margin-top:3px">Searching…</div>
                            }
                            @if (itemFormNsResults is not null && itemFormNsResults.Count > 0)
                            {
                                <div class="ct-search-results">
                                    @foreach (var r in itemFormNsResults)
                                    {
                                        <div class="ct-search-result" @onclick="() => SelectNsItem(r)">
                                            <div class="ct-search-result-name">@r.ItemId</div>
                                            <div class="ct-search-result-sub">@r.PurchaseDescription — Cost: @r.Cost.ToString("N2") / Sell: @r.Rate.ToString("N2")</div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (itemFormNsResults is not null && itemFormNsResults.Count == 0 && !itemFormNsSearching)
                            {
                                <div class="ct-search-results">
                                    <div class="ct-search-result" style="color:var(--dx-text-muted,#6c757d); cursor:default">No results</div>
                                </div>
                            }
                        </div>
                        <div style="font-size:.78rem; color:var(--dx-text-muted,#6c757d); margin-top:4px;">
                            Select a NS item to auto-fill name, cost, and sell price. You can also fill fields manually below.
                        </div>
                    }
                </div>

                <div class="dx-form-group">
                    <label class="dx-form-label">Name <span style="color:var(--dx-red,#dc3545)">*</span></label>
                    <input class="dx-form-control" @bind="itemFormName" placeholder="e.g. Network Cable Plenum CAT6 (per foot)" />
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px">
                    <div class="dx-form-group">
                        <label class="dx-form-label">Default Cost</label>
                        <input type="number" step="0.01" min="0" class="dx-form-control" @bind="itemFormCost" />
                    </div>
                    <div class="dx-form-group">
                        <label class="dx-form-label">Default Sell Price</label>
                        <input type="number" step="0.01" min="0" class="dx-form-control" @bind="itemFormSell" />
                    </div>
                </div>

                @if (itemFormError is not null)
                {
                    <div class="dx-alert dx-alert-danger">@itemFormError</div>
                }
            </div>
            <div class="dx-modal-footer">
                <button class="dx-btn dx-btn-gray" @onclick="CloseItemForm">Cancel</button>
                <button class="dx-btn dx-btn-blue" @onclick="SaveItemAsync" disabled="@saving">
                    @(saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .mat-cat-card { margin-bottom: 12px; padding: 0; overflow: hidden; }
    .mat-cat-header {
        display: flex;
        align-items: center;
        padding: 10px 16px;
        cursor: pointer;
        user-select: none;
        background: var(--dx-bg-subtle, #f8f9fa);
        border-bottom: 1px solid var(--dx-border, #dee2e6);
    }
    .mat-cat-header:hover { background: var(--dx-hover, #e9ecef); }
    .mat-expand-icon { font-size: .75rem; color: var(--dx-text-muted, #6c757d); width: 12px; flex-shrink: 0; }
    .mat-cat-body { padding: 12px 16px; }
    /* NS SKU | Name | Default Cost | Default Sell | Actions (wide enough for Edit+Delete) */
    .mat-item-cols { grid-template-columns: 150px minmax(160px,2fr) 95px 95px 155px !important; }
    .mat-ns-linked { color: var(--dx-success, #0a3622); font-weight: 500; }
    .mat-ns-unlinked { color: var(--dx-text-muted, #6c757d); font-style: italic; }
    .mat-fallback-ns-chip {
        font-size: .72rem;
        background: #e8f4e8;
        color: #1a6b1a;
        border: 1px solid #b8d8b8;
        border-radius: 10px;
        padding: 1px 8px;
        white-space: nowrap;
        margin-right: 8px;
    }
    .lt-ns-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--dx-bg-subtle, #f8f9fa);
        border: 1px solid var(--dx-border, #dee2e6);
        border-radius: 4px;
        padding: 5px 10px;
        font-size: .88rem;
    }
    .lt-ns-clear {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        color: var(--dx-text-muted, #6c757d);
        line-height: 1;
        padding: 0 2px;
    }
    .lt-ns-clear:hover { color: var(--dx-red, #dc3545); }
</style>

@code {
    private List<TblDesignMaterialsCategory>? categories;
    private Dictionary<int, List<TblDesignMaterialsItem>> itemsByCategory = [];
    private HashSet<int> _expandedCategories = [];
    private string? deleteError;
    private bool saving;

    // Category form
    private bool catFormVisible;
    private int catEditId;
    private string catFormName = "";
    private int catFormSort;
    private string? catFormNsItemId;
    private string? catFormNsItemName;   // chip label shown in the form
    private string catFormNsSearch = "";
    private List<NetsuiteItem>? catFormNsResults;
    private bool catFormNsSearching;
    private CancellationTokenSource? _catNsCts;
    private string? catFormError;

    // Item form
    private bool itemFormVisible;
    private int itemEditId;
    private int itemFormCategoryId;
    private string itemFormCategoryName = "";
    private string itemFormName = "";
    private decimal itemFormCost;
    private decimal itemFormSell;
    private string? itemFormNsItemId;
    private string? itemFormNsDisplay;   // "SKU — Display Name" shown in the chip
    private string? itemFormModelNumber; // the NS item's SKU string stored on the entity
    private string itemFormNsSearch = "";
    private List<NetsuiteItem>? itemFormNsResults;
    private bool itemFormNsSearching;
    private CancellationTokenSource? _nsCts;
    private string? itemFormError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.TblDesignMaterialsCategories
            .Where(c => c.CustomerId == Tenant.CustomerCode)
            .OrderBy(c => c.SortOrder)
            .ToListAsync();

        var items = await db.TblDesignMaterialsItems
            .Where(i => i.CustomerId == Tenant.CustomerCode)
            .OrderBy(i => i.SortOrder)
            .ToListAsync();

        itemsByCategory = items.GroupBy(i => i.CategoryId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void ToggleExpanded(int catId)
    {
        if (!_expandedCategories.Add(catId))
            _expandedCategories.Remove(catId);
    }

    // ── Category CRUD ──────────────────────────────────────────────────────────

    private void BeginAddCategory()
    {
        catEditId = 0;
        catFormName = "";
        catFormSort = categories?.Count > 0 ? categories.Max(c => c.SortOrder) + 10 : 10;
        catFormNsItemId = null; catFormNsItemName = null;
        catFormNsSearch = ""; catFormNsResults = null;
        catFormError = null;
        catFormVisible = true;
    }

    private void BeginEditCategory(TblDesignMaterialsCategory cat)
    {
        catEditId = cat.CategoryId;
        catFormName = cat.Name;
        catFormSort = cat.SortOrder;
        catFormNsItemId = cat.NetsuiteItemId;
        catFormNsItemName = cat.NetsuiteItemName;
        catFormNsSearch = ""; catFormNsResults = null;
        catFormError = null;
        catFormVisible = true;
    }

    private void CloseCatForm()
    {
        catFormVisible = false;
        catFormError = null;
        _catNsCts?.Cancel();
        catFormNsResults = null;
    }

    private async Task SaveCategoryAsync()
    {
        catFormError = null;
        if (string.IsNullOrWhiteSpace(catFormName)) { catFormError = "Name is required."; return; }
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (catEditId == 0)
            {
                db.TblDesignMaterialsCategories.Add(new TblDesignMaterialsCategory
                {
                    CustomerId = Tenant.CustomerCode,
                    Name = catFormName.Trim(),
                    NetsuiteItemId = catFormNsItemId,
                    NetsuiteItemName = catFormNsItemName,
                    SortOrder = catFormSort,
                    IsActive = true,
                });
            }
            else
            {
                var entity = await db.TblDesignMaterialsCategories.FindAsync(catEditId);
                if (entity is not null)
                {
                    entity.Name = catFormName.Trim();
                    entity.SortOrder = catFormSort;
                    entity.NetsuiteItemId = catFormNsItemId;
                    entity.NetsuiteItemName = catFormNsItemName;
                }
            }
            await db.SaveChangesAsync();
            catFormVisible = false;
            await LoadAsync();
        }
        catch (Exception ex) { catFormError = $"Save failed: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task DeleteCategoryAsync(TblDesignMaterialsCategory cat)
    {
        deleteError = null;
        await using var db = await DbFactory.CreateDbContextAsync();

        var catItemIds = await db.TblDesignMaterialsItems
            .Where(i => i.CategoryId == cat.CategoryId)
            .Select(i => i.ItemId)
            .ToListAsync();

        if (catItemIds.Count > 0)
        {
            var hasRows = await db.TblDesignWorksheetMaterialsRows
                .AnyAsync(r => catItemIds.Contains(r.ItemId));
            if (hasRows)
            {
                deleteError = $"Cannot delete \"{cat.Name}\" — items in this category are used in one or more worksheets.";
                return;
            }
            var itemEntities = await db.TblDesignMaterialsItems
                .Where(i => i.CategoryId == cat.CategoryId).ToListAsync();
            db.TblDesignMaterialsItems.RemoveRange(itemEntities);
        }

        db.TblDesignMaterialsCategories.Remove(cat);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    // ── Item CRUD ──────────────────────────────────────────────────────────────

    private void BeginAddItem(TblDesignMaterialsCategory cat)
    {
        itemEditId = 0;
        itemFormCategoryId = cat.CategoryId;
        itemFormCategoryName = cat.Name;
        itemFormName = ""; itemFormCost = 0; itemFormSell = 0;
        itemFormNsItemId = null; itemFormNsDisplay = null; itemFormModelNumber = null;
        itemFormNsSearch = ""; itemFormNsResults = null;
        itemFormError = null;
        itemFormVisible = true;
    }

    private void BeginEditItem(TblDesignMaterialsItem item, TblDesignMaterialsCategory cat)
    {
        itemEditId = item.ItemId;
        itemFormCategoryId = cat.CategoryId;
        itemFormCategoryName = cat.Name;
        itemFormName = item.Name;
        itemFormCost = item.DefaultCost;
        itemFormSell = item.DefaultSellPrice;
        itemFormModelNumber = item.ModelNumber;
        // Restore chip if this item already has a linked NS item
        if (!string.IsNullOrEmpty(item.NetsuiteItemId))
        {
            itemFormNsItemId = item.NetsuiteItemId;
            itemFormNsDisplay = string.IsNullOrEmpty(item.ModelNumber) ? item.NetsuiteItemId : item.ModelNumber;
        }
        else
        {
            itemFormNsItemId = null;
            itemFormNsDisplay = null;
        }
        itemFormNsSearch = ""; itemFormNsResults = null;
        itemFormError = null;
        itemFormVisible = true;
    }

    private void CloseItemForm()
    {
        itemFormVisible = false;
        itemFormError = null;
        _nsCts?.Cancel();
        itemFormNsResults = null;
    }

    private async Task OnNsSearchInput(ChangeEventArgs e)
    {
        itemFormNsSearch = e.Value?.ToString() ?? "";
        _nsCts?.Cancel();
        _nsCts = new CancellationTokenSource();
        var cts = _nsCts;
        itemFormNsResults = null;
        if (itemFormNsSearch.Length < 2) return;
        itemFormNsSearching = true;
        try
        {
            await Task.Delay(300, cts.Token);
            itemFormNsResults = await NetsuiteService.SearchItemsAsync(itemFormNsSearch, cts.Token);
        }
        catch (OperationCanceledException) { return; }
        catch { itemFormNsResults = []; }
        finally { itemFormNsSearching = false; }
        StateHasChanged();
    }

    private void SelectNsItem(NetsuiteItem nsItem)
    {
        itemFormNsItemId   = nsItem.Id;
        itemFormModelNumber = nsItem.ItemId;           // SKU shown in the table
        itemFormNsDisplay  = nsItem.ItemId;
        // Auto-fill name and prices from NS — user can still override below
        if (string.IsNullOrWhiteSpace(itemFormName))
            itemFormName = !string.IsNullOrEmpty(nsItem.PurchaseDescription) ? nsItem.PurchaseDescription : nsItem.ItemId;
        itemFormCost = nsItem.Cost;
        itemFormSell = nsItem.Rate;
        itemFormNsResults = null;
        itemFormNsSearch = "";
    }

    private void ClearNsItem()
    {
        itemFormNsItemId = null;
        itemFormNsDisplay = null;
        itemFormModelNumber = null;
        itemFormNsSearch = "";
    }

    private async Task SaveItemAsync()
    {
        itemFormError = null;
        if (string.IsNullOrWhiteSpace(itemFormName)) { itemFormError = "Name is required."; return; }
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (itemEditId == 0)
            {
                var maxSort = itemsByCategory.TryGetValue(itemFormCategoryId, out var existing) && existing.Count > 0
                    ? existing.Max(i => i.SortOrder) + 10 : 10;
                db.TblDesignMaterialsItems.Add(new TblDesignMaterialsItem
                {
                    CustomerId = Tenant.CustomerCode,
                    CategoryId = itemFormCategoryId,
                    Name = itemFormName.Trim(),
                    NetsuiteItemId = itemFormNsItemId,
                    ModelNumber = itemFormModelNumber,
                    DefaultCost = itemFormCost,
                    DefaultSellPrice = itemFormSell,
                    SortOrder = maxSort,
                    IsActive = true,
                });
            }
            else
            {
                var entity = await db.TblDesignMaterialsItems.FindAsync(itemEditId);
                if (entity is not null)
                {
                    entity.Name = itemFormName.Trim();
                    entity.NetsuiteItemId = itemFormNsItemId;
                    entity.ModelNumber = itemFormModelNumber;
                    entity.DefaultCost = itemFormCost;
                    entity.DefaultSellPrice = itemFormSell;
                }
            }
            await db.SaveChangesAsync();
            itemFormVisible = false;
            await LoadAsync();
        }
        catch (Exception ex) { itemFormError = $"Save failed: {ex.Message}"; }
        finally { saving = false; }
    }

    // ── Category NS item search ────────────────────────────────────────────────

    private async Task OnCatNsSearchInput(ChangeEventArgs e)
    {
        catFormNsSearch = e.Value?.ToString() ?? "";
        _catNsCts?.Cancel();
        _catNsCts = new CancellationTokenSource();
        var cts = _catNsCts;
        catFormNsResults = null;
        if (catFormNsSearch.Length < 2) return;
        catFormNsSearching = true;
        try
        {
            await Task.Delay(300, cts.Token);
            catFormNsResults = await NetsuiteService.SearchItemsAsync(catFormNsSearch, cts.Token);
        }
        catch (OperationCanceledException) { return; }
        catch { catFormNsResults = []; }
        finally { catFormNsSearching = false; }
        StateHasChanged();
    }

    private void SelectCatNsItem(NetsuiteItem nsItem)
    {
        catFormNsItemId   = nsItem.Id;
        catFormNsItemName = nsItem.ItemId;
        catFormNsResults  = null;
        catFormNsSearch   = "";
    }

    private void ClearCatNsItem()
    {
        catFormNsItemId   = null;
        catFormNsItemName = null;
        catFormNsSearch   = "";
    }

    private async Task DeleteItemAsync(TblDesignMaterialsItem item)
    {
        deleteError = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var inWorksheet = await db.TblDesignWorksheetMaterialsRows.AnyAsync(r => r.ItemId == item.ItemId);
        if (inWorksheet)
        {
            deleteError = $"Cannot delete \"{item.Name}\" — it is used in one or more worksheets.";
            return;
        }
        db.TblDesignMaterialsItems.Remove(item);
        await db.SaveChangesAsync();
        await LoadAsync();
    }
}
