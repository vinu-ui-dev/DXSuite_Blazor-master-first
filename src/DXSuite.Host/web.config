<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration. dotnet publish merges its own handler and <aspNetCore> element into this
  file, so it carries only what publish does not generate.

  This mirrors what the deployed sites already run, so publishing no longer overwrites hand-made
  server edits: the header removals below were previously applied on the box after each deploy.

  The WebDAV removals are the reason it is tracked at all. With the WebDAV Publishing role service
  installed, WebDAVModule claims PUT and DELETE before the ASP.NET Core module sees them and
  answers 405 Method Not Allowed, so routing inside the app is never reached and the failure looks
  like a missing endpoint. Every other PUT and DELETE in the product is invoked server-side from a
  Blazor circuit or by a player on its own path; the Location Content API is the first to issue one
  from a browser, which is why location bundles were the first thing able to hit it.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Frame-Options" />
          <remove name="Content-Security-Policy" />
        </customHeaders>
      </httpProtocol>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\DXSuite.Host.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
