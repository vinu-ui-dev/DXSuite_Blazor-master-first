{
  "CustomerInfo": {
    "CustomerCode": "dev"
  },
  // Local dev only. Enabled/DirectorBaseUrl/ClientId/ClientSecret live in user-secrets.
  // RedirectUri must equal EditorBridge:Clients:<ClientId>:RedirectUri in RadiantCoreWebApi byte-for-byte.
  "EditorBridgeClient": {
    "DirectorUiBaseUrl": "http://localhost:4200",
    "RedirectUri": "https://localhost:7112/auth/dxsuite/callback"
  },
  "Authorization": {
    "BypassPermissionChecks": true
  },
  "Aviation": {
    "FlightDataEditor": {
      "AirportTimeZone": "America/Toronto"
    }
  },
  "Screenshots": {
    "RefreshIntervalMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Platform": ""
  },
  "KeyVault": {
    "Uri": "https://dxsuite-blazer.vault.azure.net/"
  },
  "Storage": {
    "BlobEndpoint": "https://dxsuiteblazordev.blob.core.windows.net/"
  }
}
