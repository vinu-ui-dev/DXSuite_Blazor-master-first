{
  "CustomerInfo": {
    "CustomerCode": "dev"
  },
  "Authorization": {
    "BypassPermissionChecks": false
  },
  "CoreApi": {
    "DemoMode": true
  },
  "Aviation": {
    "FlightDataEditor": {
      "AirportTimeZone": "America/Toronto"
    }
  },
  "Screenshots": {
    "RefreshIntervalMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Director": "data source=(localdb)\\MSSQLLocalDB;initial catalog=DXSuite_Director;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_Director;Connection Timeout=30",
    "CoreData": "data source=(localdb)\\MSSQLLocalDB;initial catalog=DCMS_Core;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_CoreData;Connection Timeout=30",
    "Aviation": "data source=(localdb)\\MSSQLLocalDB;initial catalog=DCMS_Core;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_Aviation;Connection Timeout=30",
    "Sentinel": "data source=(localdb)\\MSSQLLocalDB;initial catalog=Sentinel;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_Sentinel;Connection Timeout=30",
    "Platform": "data source=(localdb)\\MSSQLLocalDB;initial catalog=DXSuite_Platform;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_Platform;Connection Timeout=30",
    "Design": "data source=(localdb)\\MSSQLLocalDB;initial catalog=DXSuite_Design;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_Design;Connection Timeout=30",
    "Pulse": "data source=(localdb)\\MSSQLLocalDB;initial catalog=Pulse;integrated security=True;MultipleActiveResultSets=True;TrustServerCertificate=true;App=DXSuite_Pulse;Connection Timeout=30"
  },
  "KeyVault": {
    "Uri": "https://dxsuite-blazer.vault.azure.net/"
  },
  "Storage": {
    "BlobEndpoint": "https://dxsuiteblazordev.blob.core.windows.net/"
  },

  // Local dev only: lets this app redeem the editor-launch handoff from RadiantCoreWebApi
  // (https://localhost:5290). Secret/RedirectUri must match that app's EditorBridge:Clients
  // section exactly (see its appsettings.Development.json).
  "EditorBridgeClient": {
    "Enabled": true,
    "AllowLoopbackHttp": true,
    "DirectorBaseUrl": "http://localhost:5290",
    "ClientId": "director-editor",
    "ClientSecret": "",
    "AllowedUiOrigins": [ "http://localhost:4200" ]
  },
  "DXSuite": {
    "TenantResolution": {
      "AllowEditorBridgeTenantOverride": true
    }
  }
}
