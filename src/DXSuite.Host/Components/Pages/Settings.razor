@page "/settings/{ModuleName?}"
@using DXSuite.Shared.Module
@using DXSuite.Shared.Models
@using DXSuite.Shared.Authorization
@using DXSuite.Shared.Multitenancy
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@inject IReadOnlyList<IBlazorModule> Modules
@inject ISessionState sessionState
@inject ITenantContext tenantContext
@inject IOptions<FeatureFlags> featureFlagsOptions
@inject IServiceProvider serviceProvider
@rendermode InteractiveServer

<PageTitle>Settings</PageTitle>

@if (sessionState.IsDisabled)
{
    <div style="text-align:center; margin-top:80px;">
        <h3>Access Denied</h3>
        <p>You do not have permission to access settings.</p>
    </div>
}
else if (settingsTabs.Length == 0)
{
    <div style="text-align:center; margin-top:80px;">
        <h3>No Settings Available</h3>
        <p>No settings tabs are available for your role.</p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; height:calc(100vh - 5.5rem);">
        <h2 style="margin-bottom:16px; flex-shrink:0;">Settings</h2>

        @* Tab bar on desktop; the select replaces it below the tablet breakpoint *@
        <div class="dx-tab-nav dx-tab-nav-collapsible" style="flex-shrink:0;">
            @foreach (var tab in settingsTabs)
            {
                <button class="dx-tab-btn @(activeTab == tab.Key ? "active" : "")"
                        @onclick="@(() => activeTab = tab.Key)">
                    @tab.Label
                </button>
            }
        </div>
        <select class="dx-form-control dx-tab-select" style="flex-shrink:0;" @bind="activeTab">
            @foreach (var tab in settingsTabs)
            {
                <option value="@tab.Key">@tab.Label</option>
            }
        </select>

        <div class="dx-tab-content dx-tab-content-standalone" style="flex:1;">
            @foreach (var tab in settingsTabs)
            {
                if (activeTab == tab.Key)
                {
                    <DynamicComponent Type="@tab.ComponentType" />
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string? ModuleName { get; set; }

    private SettingsTab[] settingsTabs = Array.Empty<SettingsTab>();
    private string? activeTab;

    protected override async Task OnParametersSetAsync()
    {
        if (!sessionState.SessionLoaded.Task.IsCompleted)
            await sessionState.SessionLoaded.Task;

        // The real Admin role bypasses permission checks (custom roles based on Admin do
        // not — their tab access stays permission-driven); other roles see granted tabs only.
        var perms = sessionState.ActualRoleId == (int)Roles.Role.Admin ? null : await sessionState.GetPermissionsAsync();

        var featureFlags = featureFlagsOptions.Value;
        var moduleNames = Modules.Select(m => m.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        // Unpopulated context (circuit initializer not yet run) falls back to flag defaults,
        // which errs toward hiding tenant-gated tabs rather than exposing them.
        var tenantFeatures = tenantContext.IsPopulated ? tenantContext.Features : new TenantFeatureFlags();
        // Platform identity services are only registered when the Platform connection string is
        // configured; platform-dependent tabs must be hidden on single-tenant deployments.
        var platformAvailable = serviceProvider.GetService<DXSuite.Shared.Services.Identity.IPlatformAuditService>() != null;

        settingsTabs = Modules
            .SelectMany(m => m.GetSettingsTabs())
            .Where(t => perms == null || perms.Contains(PermissionKeys.ForSettingsTab(t.Key)))
            .Where(t => t.Feature == null || typeof(FeatureFlags).GetProperty(t.Feature)?.GetValue(featureFlags) is true)
            .Where(t => t.TenantFeature == null || typeof(TenantFeatureFlags).GetProperty(t.TenantFeature)?.GetValue(tenantFeatures) is true)
            .Where(t => t.Module == null || moduleNames.Contains(t.Module))
            .Where(t => !t.RequiresPlatform || platformAvailable)
            .OrderBy(t => t.Order)
            .ToArray();

        if (settingsTabs.Length > 0 && (activeTab == null || !settingsTabs.Any(t => t.Key == activeTab)))
        {
            activeTab = settingsTabs[0].Key;
        }
    }
}
