@page "/authentication/{action}"
@inject NavigationManager Navigation

@*
    Authentication flow is handled by Microsoft.Identity.Web middleware.
    This page exists as a route target for auth redirects.
*@

<p>Redirecting...</p>

@code {
    [Parameter] public string? Action { get; set; }

    protected override void OnInitialized()
    {
        // Azure AD auth is middleware-driven; redirect to home if user lands here directly
        Navigation.NavigateTo("/", replace: true);
    }
}
