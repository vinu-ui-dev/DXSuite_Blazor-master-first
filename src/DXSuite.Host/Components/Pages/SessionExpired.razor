@page "/session-expired"

<PageTitle>Session Expired</PageTitle>

<div style="display: flex; justify-content: center; align-items: center; height: 80vh;">
    <div style="text-align: center; max-width: 400px;">
        <h2 style="color: #333; font-family: 'BAHNSCHRIFT', sans-serif;">Session Expired</h2>
        <p style="color: #666; margin: 16px 0;">Your session has expired due to inactivity.</p>
        <a href="/" style="display: inline-block; padding: 10px 24px; background: #0071BC; color: white; text-decoration: none; border-radius: 4px; font-family: 'BAHNSCHRIFT', sans-serif;">
            Sign In Again
        </a>
    </div>
</div>
